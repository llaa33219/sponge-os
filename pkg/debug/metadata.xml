<!--
  debug — the SPONGE DEBUG diagnostic package.

  A source-built Qt6 Widgets monitor (repos/sponge/src/sponge_debug).
  The component binary is sponge_debug (differs from the package name
  `debug`), so metadata <binary> is set; the runtime-config generator
  emits <start name="debug"><binary name="sponge_debug"/>.

  Purpose (real-hardware bring-up tooling): a read-only on-desktop
  view of the launch chain's observable state. The app subscribes to
  three report_rom relays — wired by the product scenarios with
  reader policies for `pkg_runtime -> debug -> {installed,
  window_list, launcher_result}` — and renders every update in a
  scrolling log. A Mark button drops a numbered marker so an on-site
  tester can correlate "clicked launcher entry X" with exactly which
  reports followed (launcher_result = pkgd answered, installed =
  entered the running set, window_list = the window reached the wm).

  The metadata <config> below is emitted verbatim into pkg_runtime's
  generated <start> node by sponge_pkgd's runtime-config generator.
  It carries the standard Qt6 wiring (identical to pkg/calculator):

    - libc wiring (stdout/stderr to /dev/log; pipe for Qt; rtc)
    - a <vfs> with /dev/log, /dev/rtc, /pipe, qt6_dejavusans.tar
      (Qt font) and qt6_libqgenode.tar (Qt QPA plugins)

  The component opens four session kinds, all routed by the generated
  default-route to the outer system:
    Gui    — for the Qt window (via the wm: decorated like any app)
    ROM    — installed / window_list / launcher_result (the relays)
    Report — none in v1 (read-only monitor; minimum privilege)
-->
<package>
  <name>debug</name>
  <version>1.0</version>
  <description>On-desktop launch-chain monitor (installed set, window list, launch results) with Mark/Clear markers.</description>
  <binary>sponge_debug</binary>
  <quota ram="64M" caps="1000"/>
  <resizeable>yes</resizeable>
  <launcher category="Utilities"/>
  <!--
    Autostart (docs/12 §9.2.1): the debug tool must be on screen
    WITHOUT any launcher interaction — the launcher path itself is
    one of the things this tool diagnoses (chicken-and-egg guard).
  -->
  <autostart/>
  <dependencies/>
  <config>
    <vfs>
      <dir name="dev"> <log/> <inline name="rtc">2018-01-01 00:01</inline> </dir>
      <dir name="pipe"> <pipe/> </dir>
      <tar name="qt6_dejavusans.tar"/>
      <tar name="qt6_libqgenode.tar"/>
    </vfs>
    <libc stdout="/dev/log" stderr="/dev/log" pipe="/pipe" rtc="/dev/rtc"/>
  </config>
</package>
