#!/usr/bin/env bash
#
# tool/mkdata — Sponge OS SPONGE-DATA (P4) partition creator (launcher).
#
# Thin shim that delegates to the canonical Mojo implementation in
# tool/mkdata.mojo. Resolution order for the mojo binary:
#   1. mojo on PATH
#   2. <repo>/.venv/bin/mojo (repo-local uv/venv install)
# If neither exists, prints install guidance and exits 127.
#
# Usage (see tool/mkdata.mojo for the full contract):
#   ./tool/mkdata <img>                  # add a 1024 MiB SPONGE-DATA P4
#   ./tool/mkdata <img> --data-size 256  # 256 MiB P4
#   ./tool/mkdata help                   # show usage
#
# The tool implements the docs/14-boot-storage-architecture.md §4.3 P4
# creation sequence (truncate + sgdisk delete/move/new/hybrid + mkfs.ext2
# -E offset) and is idempotent: a second run on an image that already
# has a P4 named SPONGE-DATA is a verified no-op. See docs/11 §12 for
# the manual escape hatch (AGENTS.md §3.5).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MOJO_FILE="$SCRIPT_DIR/mkdata.mojo"
VENV_MOJO="$REPO_ROOT/.venv/bin/mojo"

if command -v mojo >/dev/null 2>&1; then
    MOJO_BIN="mojo"
elif [ -x "$VENV_MOJO" ]; then
    MOJO_BIN="$VENV_MOJO"
else
    cat >&2 <<EOF
[sponge-mkdata] mojo SDK not found on PATH and no repo-local install at
$VENV_MOJO.

The canonical Sponge OS tooling is written in Mojo (Modular's language).
Install the Mojo SDK to use this wrapper:

  https://docs.modular.com/mojo/manual/get-started/

Or install it into this repository's virtualenv (pinned by uv.lock):

  uv sync

Once installed, run directly:
  mojo $MOJO_FILE "$@"
EOF
    exit 127
fi

exec "$MOJO_BIN" "$MOJO_FILE" "$@"
