#!/usr/bin/env bash
#
# tool/mojo_objects — pinned-toolchain Mojo object emitter (launcher).
#
# Thin shim that delegates to the canonical Mojo implementation in
# tool/mojo_objects.mojo. Resolution order for the mojo binary that runs
# the script (standard launcher convention):
#   1. mojo on PATH
#   2. <repo>/.venv/bin/mojo (repo-local uv/venv install)
# If neither exists, prints install guidance and exits 127.
#
# Note: the object emission itself always uses the uv.lock-pinned
# <repo>/.venv/bin/mojo toolchain (version-verified against uv.lock),
# never an unpinned system binary (D16C.4).
#
# Usage:
#   ./tool/mojo_objects --emit object --relocation-model=pic -o build/scene.o scene.mojo
#   ./tool/mojo_objects help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MOJO_FILE="$SCRIPT_DIR/mojo_objects.mojo"
VENV_MOJO="$REPO_ROOT/.venv/bin/mojo"

if command -v mojo >/dev/null 2>&1; then
    MOJO_BIN="mojo"
elif [ -x "$VENV_MOJO" ]; then
    MOJO_BIN="$VENV_MOJO"
else
    cat >&2 <<EOF
[sponge-mojo-objects] mojo SDK not found on PATH and no repo-local install at
$VENV_MOJO.

The canonical Sponge OS tooling is written in Mojo (Modular's language).
Install the Mojo SDK to use this wrapper:

  https://docs.modular.com/mojo/manual/get-started/

Or install it into this repository's virtualenv (pinned by uv.lock):

  uv sync

Once installed, run directly:
  mojo $MOJO_FILE "$@"
EOF
    exit 127
fi

exec "$MOJO_BIN" "$MOJO_FILE" "$@"
