#!/usr/bin/env bash
#
# tool/dist — Sponge OS distribution media builder (launcher).
#
# Thin shim that delegates to the canonical Mojo implementation in
# tool/dist.mojo. Resolution order for the mojo binary:
#   1. mojo on PATH
#   2. <repo>/.venv/bin/mojo (repo-local uv/venv install)
# If neither exists, prints install guidance and exits 127.
#
# Usage (see tool/dist.mojo for the full contract):
#   ./tool/dist               # build both .img and .iso media into var/dist/
#   ./tool/dist help          # show usage
#
# The tool checks the media host tools (xorriso, gptfdisk/sgdisk,
# mtools/mcopy, e2tools, dosfstools, e2fsprogs) up front and prints
# the exact apt install line for any missing one before invoking any
# build. See docs/08-development.md §11 for the manual escape hatch.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MOJO_FILE="$SCRIPT_DIR/dist.mojo"
VENV_MOJO="$REPO_ROOT/.venv/bin/mojo"

if command -v mojo >/dev/null 2>&1; then
    MOJO_BIN="mojo"
elif [ -x "$VENV_MOJO" ]; then
    MOJO_BIN="$VENV_MOJO"
else
    cat >&2 <<EOF
[sponge-dist] mojo SDK not found on PATH and no repo-local install at
$VENV_MOJO.

The canonical Sponge OS tooling is written in Mojo (Modular's language).
Install the Mojo SDK to use this wrapper:

  https://docs.modular.com/mojo/manual/get-started/

Or install it into this repository's virtualenv (pinned by uv.lock):

  uv sync

Once installed, run directly:
  mojo $MOJO_FILE "$@"
EOF
    exit 127
fi

exec "$MOJO_BIN" "$MOJO_FILE" "$@"
