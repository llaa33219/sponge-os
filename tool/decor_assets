#!/usr/bin/env bash
#
# tool/decor_assets — Sponge OS themed_decorator theme tar generator
#                      (launcher).
#
# Thin shim that delegates to the canonical Mojo implementation in
# tool/decor_assets.mojo. Resolution order for the mojo binary:
#   1. mojo on PATH
#   2. <repo>/.venv/bin/mojo (repo-local uv/venv install)
# If neither exists, prints install guidance and exits 127.
#
# Usage (see tool/decor_assets.mojo for the full contract):
#   ./tool/decor_assets                       # default: var/sponge/decor.tar
#   ./tool/decor_assets <output-tar>          # custom output path
#   ./tool/decor_assets --regen-pngs          # regenerate PNGs via ImageMagick
#   ./tool/decor_assets help                  # show usage
#
# The tool packs the five-entry themed_decorator theme tar that
# run/sponge-de-themed-chrome.run VFS-mounts under the
# themed_decorator's <vfs><tar name="decor.tar"/></vfs>. The default
# PNGs come from the checked-in upstream asset set under
# tool/decor_assets_data/pngs/ (deterministic, byte-stable). The
# font is re-vendored byte-for-byte from the vendored
# genode/repos/gems/src/app/themed_decorator/theme/font.tff (no host-
# side TFF conversion — risk-register row 16 enforcement).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MOJO_FILE="$SCRIPT_DIR/decor_assets.mojo"
VENV_MOJO="$REPO_ROOT/.venv/bin/mojo"

if command -v mojo >/dev/null 2>&1; then
    MOJO_BIN="mojo"
elif [ -x "$VENV_MOJO" ]; then
    MOJO_BIN="$VENV_MOJO"
else
    cat >&2 <<EOF
[sponge-decor-assets] mojo SDK not found on PATH and no repo-local install at
$VENV_MOJO.

The canonical Sponge OS tooling is written in Mojo (Modular's language).
Install the Mojo SDK to use this wrapper:

  https://docs.modular.com/mojo/manual/get-started/

Or install it into this repository's virtualenv (pinned by uv.lock):

  uv sync

Once installed, run directly:
  mojo $MOJO_FILE "$@"
EOF
    exit 127
fi

exec "$MOJO_BIN" "$MOJO_FILE" "$@"
