#
# \brief  Sponge OS file-manager package scenario (Phase 7, todo 15)
# \author Sponge OS contributors
# \date   2026
#
# Verifies pkg/files end to end in a single headless Genode instance:
# the files_probe drives sponge_pkgd to install and launch the `files`
# package (the in-tree Qt6 file manager repos/sponge/src/sponge_files),
# then proves inside one headless Genode instance (no host display, no
# fb_sdl):
#
#   (a) Window pixel-verified: the Qt6 file-manager window actually
#       renders into nitpicker's composited screen — read back through
#       a Capture session. List + preview + accent buttons + themed
#       background produce a substantial non-bg fraction AND non-
#       trivial color diversity (guards the misleading_success_output
#       class — bare exit-0 is not enough).
#
#   (b) Synthetic double-click navigates into a directory: the probe
#       injects a real double-click on the list's first row via
#       nitpicker's Event service. The component's normal double-click
#       handler runs (QListWidget::itemDoubleClicked -> _navigate ->
#       _refresh -> _publish), and the `files` report's path changes
#       from "/" to "/demo". Asserted via the structural report, NOT
#       by parsing pixels.
#
#   (c) Copy a file within /writable and delete it: the probe drives
#       the request channel (a files_request ROM written by the probe,
#       polled by the component's QTimer) to:
#         1. copy /demo/notes.txt -> /writable/notes.txt
#         2. delete /writable/notes.txt
#       Each operation updates the `files` report's last_action/result;
#       the probe asserts both come back "ok".
#
#   (d) Attempt delete in the read-only area (/demo/notes.txt):
#       refused — the tar-mounted /demo is inherently read-only, so
#       unlink(2) returns EROFS, and the component surfaces the refusal
#       three ways at once (UI status label + Genode::log line + the
#       `files` report's last_action result="refused"). The probe
#       asserts the report path AND the run script gates on the
#       log line "delete /demo/notes.txt refused" appearing.
#
# The package is the in-tree sponge_files Qt6 component (single binary,
# hosted by pkg_runtime after launch). The metadata <config> mounts:
#   - /demo (read-only tar plugin) populated from files_demo.tar
#   - /writable (RAM-backed) for copy/delete operations
# so the libc POSIX API (opendir/open/unlink) inside the component
# reaches both areas with no separate File_system session (minimum
# privilege, AGENTS.md §1.2).
#
# Topology (kernel-agnostic — base-linux native or base-sel4 QEMU, same
# as run/sponge-terminal.run / run/sponge-textedit.run; the acceptance
# run uses KERNEL=sel4 BOARD=pc per the todo, base-linux is the fast
# iteration path):
#
#   init
#   + timer
#   + report_rom     (relays request/result/runtime/installed/files/
#                     files_request)
#   + nitpicker      (Gui/Capture/Event; "files" domain hosts the window)
#   + sponge_pkgd    (owns pkg_runtime's config via the "runtime" report;
#                     broadcasts the "installed" set)
#   + pkg_runtime    (binary init; config ROM <- report_rom "runtime";
#                     hosts sponge_files after launch)
#   + files_probe    (installs+launches files; pixel-verifies window;
#                     injects double-click; drives copy/delete via op
#                     channel; reads `files` report)
#
# report_rom policies (full labels include the child-name prefix):
#   sponge_pkgd's ROM "request"               <- files_probe's "request"
#   files_probe's ROM "result"                <- sponge_pkgd's "result"
#   files_probe's ROM "installed"             <- sponge_pkgd's "installed"
#   pkg_runtime's ROM "config"                <- sponge_pkgd's "runtime"
#   files_probe's ROM "files"                 <- sponge_files's "files"
#   sponge_files's ROM "files_request"        <- files_probe's "files_request"
#

build { core lib/ld init timer server/report_rom server/nitpicker \
        sponge_pkgd sponge_files test/files_probe \
        qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
        lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
        lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
        lib/zlib lib/libpng lib/blit }

create_boot_directory

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_pkgd -> request                          | report: files_probe -> request
    + policy | label: files_probe -> result                           | report: sponge_pkgd -> result
    + policy | label: files_probe -> installed                        | report: sponge_pkgd -> installed
    + policy | label: pkg_runtime -> config                            | report: sponge_pkgd -> runtime
    + policy | label: files_probe -> files                            | report: pkg_runtime -> files -> files
    + policy | label: pkg_runtime -> files -> files_request            | report: files_probe -> files_request

+ start nitpicker | ram: 8M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    #
    # The "files" domain hosts the sponge_files window at the screen
    # origin. Qt widget-local coords then line up with the probe's
    # pixel coords (window at (0,0) = screen at (0,0)), so the probe's
    # double-click target (DBL_X, DBL_Y) lands on the list's first row.
    # 1024x768 (the full seL4 panorama) lets the probe sample the
    # window footprint densely without the window's edge clipping.
    #
    + domain files | layer: 2 | content: client | label: no
                   | hover: always | focus: click
                   | xpos: 0 | ypos: 0 | width: 800 | height: 600
    + domain default | layer: 3 | content: client | label: no
                     | hover: always | focus: click | ypos: 0 | height: 0
    + default-policy | domain: files
    + background | color: #1e1e2e

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 1500 | ram: 256M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    #
    # Explicit routes for sponge_files's Report/ROM channels so they
    # reach the outer report_rom without depending on the default-route
    # chain through nested init. The "files" Report (sponge_files ->
    # report_rom) is published by sponge_files; the "files_request" ROM
    # (probe -> sponge_files) is written by files_probe. The full labels
    # (pkg_runtime -> files -> files_request, etc.) are matched by the
    # report_rom policies above. label_last matches the last label
    # element regardless of prefix, so the same route serves any depth.
    #
    + service ROM | label_last: files_request | + child report_rom
    + service Report | label_last: files | + child report_rom
    + service Gui | + child nitpicker
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start files_probe | caps: 200 | ram: 16M
  + route
    + service Capture | + child nitpicker
    + service Event | + child nitpicker
    + service Timer | + child timer
    + service ROM | label_last: result | + child report_rom
    + service ROM | label_last: installed | + child report_rom
    + service ROM | label_last: files | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }

#
# Stage the files package metadata + the derived index (same scheme as
# run/sponge-terminal.run / run/sponge-pkg-gui.run).
#
set staged_pkgs { files }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src "bin/pkg_$pkg.xml"
}

set index_fh [open "bin/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

#
# Build files_demo.tar from run/fixtures/files-demo/. The component's
# vfs mounts <tar name="files_demo.tar"/> at its root, exposing /demo/*
# paths inside the component (tar plugin is read-only by nature, so
# delete in /demo is refused with EROFS — the headline Alpha refusal).
#
# The fixture is committed under run/fixtures/files-demo/ so it is
# available to the run framework without a separate port. Staging path
# is under [run_dir] (git-ignored) so no committed artifact is touched.
#
set demo_src "${genode_dir}/../run/fixtures/files-demo"
if {![file isdirectory $demo_src]} {
	error "demo fixture directory not found: $demo_src"
}
set staging "[run_dir]/files-demo-staging"
file delete -force $staging
file mkdir "$staging/demo"
foreach f [glob -directory $demo_src *] {
	file copy -force -- $f "$staging/demo/"
}
exec tar -cf "bin/files_demo.tar" -C "$staging" demo
file delete -force $staging

#
# qt6_dejavusans.tar raw recipe is depot-only; mirror its content into
# bin/ from the qt6_base port sources (same as run/sponge-textedit.run /
# run/sponge-pkg-gui.run). The Qt QPA plugin expects the font at
# /qt/lib/fonts/DejaVuSans.ttf when the libc vfs mounts the tar.
#
set dejavu_dst "bin/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavu_dst -C "$staging" qt
	file delete -force $staging
}

#
# Default theme staged so sponge_files's fallback path (no live
# sponge_themed ROM) still produces a themed window (same staging as
# run/sponge-launcher.run). The component's <theme source="default"/>
# node is omitted; the loader falls through to default.theme.
#
set theme_src "${genode_dir}/repos/sponge/src/sponge-de/themes/default.theme"
set theme_dst "bin/default.theme"
if {[file exists $theme_src] && ![file exists $theme_dst]} {
	exec cp -fL $theme_src $theme_dst
}

#
# Full boot module list. The Qt6 shared libs + tars are cmake-built by
# qt6/base and land in bin/; they are NOT in [build_artifacts], so they
# are listed explicitly (base-sel4's boot_dir/sel4 plugin packs a single
# image.elf from bin/ at this point and needs every module named).
#
set boot_modules [build_artifacts]
foreach m { libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
            libqgenode.lib.so qt6_libqgenode.tar qt6_dejavusans.tar \
            default.theme \
            files_demo.tar \
            pkg_files.xml pkg_index.xml } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# QEMU: -nographic for headless, -m 2G for Qt6/Mesa softpipe +
# pkg_runtime's 256M allocation (generous on seL4; harmless overhead on
# linux). Bounded per the hung_or_long_commands class.
#
append qemu_args " -nographic -m 2G "

#
# Automated verification (fail-loud, docs/09-roadmap.md §11.1):
# files_probe logs PASS once it has installed+launched files via
# sponge_pkgd AND pixel-verified the rendered window AND injected a
# double-click navigated to /demo AND driven copy+delete via the
# request channel AND confirmed the read-only delete refusal surfaces
# in the log. On timeout (probe did not reach PASS) the run tool
# errors out — never a silent hang. The generous timeout covers Qt6
# first paint under softpipe Mesa on seL4 (~60-180s; faster on linux).
#
# Bounded per the hung_or_long_commands adversarial class. The
# misleading_success_output class is addressed by the structural report
# + pixel evidence (not just exit codes). The flaky_tests class is
# addressed by running the scenario twice (see evidence log).
#
run_genode_until {.*files-probe: PASS.*} 420
