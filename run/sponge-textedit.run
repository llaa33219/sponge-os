#
# \brief  Sponge OS text-editor package scenario (Phase 7, todo 14)
# \author Sponge OS contributors
# \date   2026
#
# Verifies pkg/textedit end to end in a single headless Genode instance:
# the textedit_probe drives sponge_pkgd to install and launch the
# `textedit` package (the depot-repackaged qt6_textedit), then proves
# (a) the `installed` broadcast lists it (vct list-equivalent), (b) the
# broadcast's `running` attribute transitions no -> yes on launch
# (lifecycle, docs/12 §9.2.1), (c) the Qt6 text-editor window actually
# renders into nitpicker's composited screen — verified by reading
# pixels through a Capture session (menu bar / toolbar / rich-text
# area; everywhere distinct from the #1e1e2e nitpicker background),
# and (d) pkgd's launch error paths return clear statuses
# (`not-installed', `already-running'), never a crash. The separate
# missing-binary failure channel is verified by run/sponge-textedit-fail.run.
#
# The package is the depot-repackaged cproc/pkg/qt6_textedit/2025-10-27
# (todo 11). Its binary is the upstream Qt6 rich-text example
# (QMainWindow + menuBar + QTextEdit loading example.html). The Sponge
# metadata at pkg/textedit/metadata.xml was generated by tool/pkg_import
# with: caps=1000 (Qt6/Mesa GUI floor, docs/09-roadmap.md §11.1),
# ram=64M, launcher category Editors, the inline <config> carrying the
# libc+vfs+Qt-font/plugin-tar boilerplate modeled on
# run/sponge-launcher.run:126-136, and every session routed to <parent/>.
#
# The prebuilt textedit binary is NOT a build target (no in-tree
# src/app/qt6_textedit target is wired into Sponge's repos/sponge/); it
# is staged from pkg/textedit/payload/ (the file tool/pkg_import
# extracted from cproc/bin/x86_64/qt6_textedit/2025-10-12). The Qt6
# shared libs and the font/plugin tars ARE built by qt6/base and the
# lib/* targets and pulled from bin/ via the same staging pattern as
# run/sponge-launcher.run:165-192 and run/sponge-pkg-gui.run.
#
# Topology (kernel-agnostic — base-linux native or base-sel4 QEMU, same
# as run/sponge-terminal.run and run/sponge-pkg-gui.run; the acceptance
# run uses KERNEL=sel4 BOARD=pc per the todo, base-linux is the fast
# iteration path):
#
#   init
#   + timer
#   + report_rom     (relays request/result/runtime/installed)
#   + nitpicker      (Gui/Capture/Event; "edit" domain hosts the window)
#   + sponge_pkgd    (owns pkg_runtime's config via the "runtime" report;
#                     broadcasts the "installed" set)
#   + pkg_runtime    (binary init; config ROM <- report_rom "runtime";
#                     hosts the textedit child after launch)
#   + textedit_probe (installs+launches textedit; pixel-verifies window;
#                     exercises pkgd error paths)
#
# report_rom policies (full labels include the child-name prefix):
#   sponge_pkgd's ROM "request"      <- textedit_probe's "request" report
#   textedit_probe's ROM "result"    <- sponge_pkgd's "result" report
#   textedit_probe's ROM "installed" <- sponge_pkgd's "installed" report
#   pkg_runtime's ROM "config"       <- sponge_pkgd's "runtime" report
#

build { core lib/ld init timer server/report_rom server/nitpicker \
        sponge_pkgd test/textedit_probe \
        qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
        lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
        lib/freetype lib/jpeg \
        lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
        lib/zlib lib/libpng lib/blit }

create_boot_directory

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_pkgd -> request        | report: textedit_probe -> request
    + policy | label: textedit_probe -> result      | report: sponge_pkgd -> result
    + policy | label: textedit_probe -> installed   | report: sponge_pkgd -> installed
    + policy | label: pkg_runtime -> config         | report: sponge_pkgd -> runtime

+ start nitpicker | ram: 8M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    #
    # The QGenodeScreen QPA reports the full nitpicker panorama
    # (1024x768) as QScreen::geometry(), and the upstream textedit
    # main.cpp centers itself against it: `mw.resize(512, 512);
    # mw.move(256, 128)`. Nitpicker adds the domain origin to the
    # Qt-requested position (verified via run/sponge-launcher.run's
    # pkg_gui_demo: Qt(0,0) -> demo-domain-origin(352,200)). So the
    # edit domain MUST sit at (0,0) for textedit's window to land at
    # screen coords (256,128)-(768,640) — inside the 1024x768 screen.
    # A small edit domain offset would push the window off-screen and
    # the rendered_frac check would still pass while the bg-point
    # check would fail (the window covers it). Full-screen edit domain
    # avoids both surprises and matches what a single-window focused
    # scenario actually wants.
    #
    + domain edit | layer: 2 | content: client | label: no
                   | hover: always | focus: click
                   | xpos: 0 | ypos: 0 | width: 1024 | height: 768
    + domain default | layer: 3 | content: client | label: no
                     | hover: always | focus: click | ypos: 0 | height: 0
    + default-policy | domain: edit
    + background | color: #1e1e2e

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 1500 | ram: 256M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service Gui | + child nitpicker
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start textedit_probe | caps: 200 | ram: 16M
  + route
    + service Capture | + child nitpicker
    + service Timer | + child timer
    + service ROM | label_last: result | + child report_rom
    + service ROM | label_last: installed | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }

#
# Stage the textedit package metadata + the derived index (same scheme
# as run/sponge-terminal.run / run/sponge-pkg-gui.run).
#
set staged_pkgs { textedit }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src "bin/pkg_$pkg.xml"
}

set index_fh [open "bin/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

#
# Stage the prebuilt `textedit` binary + its upstream `textedit.config`
# from pkg/textedit/payload/ (extracted from cproc/bin/x86_64/qt6_textedit/
# 2025-10-12 by tool/pkg_import). These are NOT build targets — Sponge
# has no in-tree src/app/qt6_textedit wired in (the depot host-side
# repackage is the whole point of todo 11/14; AGENTS.md §5.2 — do not
# re-implement Genode). The runtime config generator emits
# `<start name="textedit">` (binary defaults to name), so pkg_runtime
# looks up a ROM named "textedit" — which is the file staged here.
# Likewise the metadata <config> references <rom name="textedit.config"/>
# inside the binary's vfs, so textedit.config must be staged too.
#
set payload_dir "${genode_dir}/../pkg/textedit/payload"
foreach f { textedit textedit.config } {
	set src "$payload_dir/$f"
	set dst "bin/$f"
	if {![file exists $src]} {
		error "payload file not found: $src"
	}
	exec cp -fL $src $dst
}

#
# qt6_dejavusans.tar raw recipe is depot-only; mirror its content into
# bin/ from the qt6_base port sources (same as run/sponge-pkg-gui.run /
# run/sponge-alpha.run). The qt6_dejavusans.tar already in
# pkg/textedit/payload/ is the same content; we re-build from contrib
# here so this scenario is independent of pkg/textedit/payload's tar
# and matches every other headless Qt6 scenario in the suite.
#
set dejavu_dst "bin/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavu_dst -C "$staging" qt
	file delete -force $staging
}

#
# Full boot module list. The Qt6 shared libs + tars are cmake-built by
# qt6/base and land in bin/; they are NOT in [build_artifacts], so they
# are listed explicitly (base-sel4's boot_dir/sel4 plugin packs a single
# image.elf from bin/ at this point and needs every module named). The
# textedit runtime's <content> block enumerates 24 ROMs (the upstream
# qt6_textedit runtime); this list covers every one of them:
#   - common Qt6 libs: libQt{Core,Gui,Widgets,PrintSupport}, libqgenode,
#     egl/mesa/glapi/libdrm/libpng/freetype/jpeg/expat/zlib,
#     stdcxx/libc/libm, vfs/vfs_gpu/vfs_pipe, qt6_component
#   - Qt6 data tars:    qt6_libqgenode.tar (plugins), qt6_dejavusans.tar (font)
#   - mesa_gpu alias:   mesa_gpu-softpipe.lib.so (re-exported under the
#                       mesa_gpu.lib.so label by pkg_runtime's route)
#   - app payload:      textedit (binary), textedit.config (vfs ROM)
#   - staged metadata:  pkg_textedit.xml, pkg_index.xml
#
set boot_modules [build_artifacts]
foreach m { textedit textedit.config \
            libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
            libQt6PrintSupport.lib.so \
            libqgenode.lib.so qt6_libqgenode.tar qt6_dejavusans.tar \
            egl.lib.so mesa.lib.so glapi.lib.so mesa_gpu-softpipe.lib.so \
            libdrm.lib.so libpng.lib.so freetype.lib.so jpeg.lib.so \
            expat.lib.so zlib.lib.so \
            stdcxx.lib.so libc.lib.so libm.lib.so \
            qt6_component.lib.so \
            vfs.lib.so vfs_gpu.lib.so vfs_pipe.lib.so \
            pkg_textedit.xml pkg_index.xml } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# QEMU: -nographic for headless, -m 2G for Qt6/Mesa softpipe +
# pkg_runtime's 256M allocation (generous on seL4; harmless overhead on
# linux).
#
append qemu_args " -nographic -m 2G "

#
# Automated verification (fail-loud, docs/09-roadmap.md §11.1):
# textedit_probe logs PASS once it has installed+launched textedit via
# sponge_pkgd AND pixel-verified the rendered window AND exercised the
# pkgd error paths. On timeout (probe did not reach PASS — e.g. the
# missing-binary failure mode) the run tool errors out — never a silent
# hang. The generous timeout covers the qt6_textedit first paint under
# softpipe Mesa on seL4 (~60-180s; faster on linux). Bounded per the
# hung_or_long_commands adversarial class.
#
run_genode_until {.*textedit-probe: PASS.*} 420
