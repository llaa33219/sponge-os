#
# \brief  Sponge OS driver-package acceptance: install pc_nic, prove it runs.
# \author Sponge OS contributors
# \date   2026
#
# === WHAT THIS SCENARIO PROVES ==========================================
#
# The driver package path (docs/12-package-format.md §4.5,
# docs/17 §1). The topology is the PRODUCT shape — a Tier-0 with the
# hardware drivers, a system sandbox holding report_rom + sponge_pkgd +
# TWO sibling nested runtimes (pkg_runtime for applications,
# driver_runtime for drivers) — reduced to the components the claim
# actually needs. Specifically:
#
#   1. vct install pc_nic's backend accepts a <kind>driver</kind>
#      package and admits it against driver_runtime's OWN quota.
#   2. driver_runtime is a real protection domain: pkgd's driver config
#      reaches it over the report_rom relay, and no application config
#      path exists for it.
#   3. the driver really starts inside driver_runtime (its <child> node
#      appears in driver_runtime's OWN state report, generated by
#      driver_runtime's init from its own child table).
#   4. the NIC really binds the QEMU e1000 and really reaches the
#      network stack (nic_router acquires DHCP from QEMU's slirp server).
#
# Gates 1-3 are asserted by driver-probe; gate 4 is asserted from the
# driver and the router's own log lines, because only they know what
# "bound" and "leased" look like for this hardware.
#
# === WHAT IT DELIBERATELY DOES NOT PROVE ================================
#
#   - The disk-served (cached_fs_rom / chroot /system) binary path. This
#     scenario stages package binaries as BOOT MODULES, so pkgd runs with
#     an empty binary_prefix. The disk-served driver path differs only in
#     that one attribute and in rom_sys resolving bin/<binary>; the relay,
#     the split, the admission gate and the state report are identical,
#     and the disk-served wiring is exercised (as a regression) by
#     run/sponge-desktop-disk.run, which stages the same packages with
#     binary_prefix "bin/".
#   - Any driver other than pc_nic. usb_net / pc_wifi / intel_gpu /
#     pc_intel_fb build and are packaged, but none of them is
#     QEMU-emulable; see docs/15-hardware-compatibility.md.
#
# === HONESTY NOTE ON THE DHCP GATE ======================================
#
# The e1000 bind line ("Intel(R) PRO/1000 Network Driver") is printed by
# e1000e at module init. It can ONLY appear if the driver actually
# attached to the e1000 PCI device, so its absence is a hard failure
# rather than a silent pass. The DHCP line is QEMU slirp's fixed offer
# (server 10.0.2.2, lease 10.0.2.15) — a literal the guest cannot invent.
#
# Build:
#   make -C genode/build/x86_64 run/sponge-pkg-driver KERNEL=sel4 BOARD=pc
#
assert {[have_spec sel4]} \
	"sponge-pkg-driver requires KERNEL=sel4 (BOARD=pc). \
	 pc_nic is the x86 DDE-Linux NIC driver and QEMU's e1000 is the \
	 only NIC QEMU emulates for it."

#
# Build set. The driver targets are the same upstream targets Sculpt's
# sculpt_drivers-pc packages are built from; run/driver_runtime.inc keeps
# the package -> target mapping in one place for the product scenarios.
#
build { core lib/ld init timer server/report_rom \
        driver/acpi app/pci_decode driver/platform \
        server/nic_router \
        driver/nic/pc \
        sponge_pkgd test/driver_probe \
        lib/vfs }

create_boot_directory

#
# Package staging. pkg_index.xml is mandatory: sponge_pkgd refuses to
# open a metadata ROM for a package that is not in the index, because a
# missing boot module is a FATAL ROM-session denial under the base Env
# policy rather than a catchable error (docs/12 §5.3).
#
set repo_root [file normalize [file join [run_dir] "../../../../../.."]]
exec mkdir -p bin
exec cp -fL "$repo_root/pkg/pc_nic/metadata.xml" "bin/pkg_pc_nic.xml"
set idx [open "bin/pkg_index.xml" w]
puts $idx {<packages>}
puts $idx {  <pkg name="pc_nic"/>}
puts $idx {</packages>}
close $idx

install_config {
config

+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M

+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

#
# Tier-0 report_rom carries the hardware device reports up from acpi /
# pci_decode / platform.
#
+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: yes
    + policy | label: pci_decode -> system | report: acpi -> acpi
    + policy | label: platform -> devices  | report: pci_decode -> devices

+ start acpi | caps: 350 | ram: 6M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + any-service
      + parent

+ start pci_decode | caps: 350 | ram: 2M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: system | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent

#
# The platform driver holds the PCI/IRQ/IO_MEM/IO_PORT resources. The
# ETHERNET policy is a GRANT, published whether or not any driver is
# installed: it is what makes pc_nic able to find the e1000 once it is
# loaded, and it is the manual escape hatch — an operator can start the
# driver from a run script with no package manager involved at all
# (AGENTS.md §1.1).
#
+ start platform | caps: 500 | ram: 4M | managing_system: yes
  + provides
    + service Platform
    + service Dma
  + config
    + report | devices: yes
    # The label the platform driver sees is SCOPED by the whole sandbox
    # path, not just the requesting component: a driver inside
    # system/driver_runtime asks for "pc_nic" and init hands the platform
    # driver "system -> driver_runtime -> pc_nic". A policy written
    # against the bare name would silently match nothing and the driver
    # would be denied with "no matching policy" - the same wiring is
    # exercised from a run script with a bare pc_nic at the top level,
    # where the unscoped name IS the right prefix.
    + policy | label_prefix: system -> driver_runtime -> pc_nic | info: yes | + pci | class: ETHERNET
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: devices | + child report_rom
    + service Report | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent

#
# The Uplink<->Nic bridge. A SYSTEM SERVICE, not part of the driver
# package: the driver produces raw frames, the router gives the rest of
# the system a Nic session. Its policy matches on the Uplink SESSION
# label, which inside a nested init is scoped by the init's own name —
# hence the stable driver_runtime prefix rather than a per-driver name,
# so adding a second Uplink-providing driver needs no policy change.
#
+ start nic_router | caps: 300 | ram: 16M
  + provides
    + service Uplink
    + service Nic
  + config | verbose:                  no
         | verbose_domain_state:       yes
         | dhcp_discover_timeout_sec:  10
         | dhcp_request_timeout_sec:   6
    # Scoped label, like the platform policy above: the Uplink session
    # arrives as "system -> driver_runtime -> <driver> -> <netdev>".
    # Matching the sandbox path (rather than a per-driver name) is what
    # lets a second Uplink-providing driver be installed with no policy
    # change at all.
    + policy | label_prefix: system -> driver_runtime | domain: uplink
    + domain uplink
    +   | verbose_packets:  no
    +   | icmp_echo_server: yes
  + route
    + service Timer | + child timer
    + any-service   | + parent

#
# ---- the system sandbox -------------------------------------------------
#
# Everything above is hardware; everything below is policy. The nested
# config is inlined here (rather than relayed from pkgd) because it is
# the PRODUCT's static composition — pkgd only owns the two RUNTIME
# configs it publishes as reports.
#
# The route below is any-service -> parent / any-child, exactly like the
# disk product scenarios: parent reaches the core services (ROM/PD/RM/
# CPU/LOG/IRQ/IO_MEM/IO_PORT), any-child reaches this sandbox's
# SIBLINGS at the top level — timer, nic_router, platform. A route node
# REPLACES the default-route for this child, so dropping any-child here
# would silently cut the whole sandbox off every top-level service that is
# not a core service.
+ start system | caps: 40000 | ram: 512G
  + binary | name: init
  + route
    + any-service
      + parent
      + any-child
  + config
    # This sandbox is the hardware gateway: everything below it may ask
    # for a hardware service. The list is deliberately broad because the
    # set of drivers is open-ended (a new driver package declares its own
    # sessions and pkgd puts them into driver_runtime's parent-provides).
    #
    # The boundary that actually protects applications is NOT this list —
    # it is the parent-provides pkgd GENERATES for pkg_runtime, which
    # carries the application service set only. A package's own <route>
    # is emitted from its declared <sessions>, so no application package
    # can name Platform / Irq / Io_mem / Io_port and obtain one even
    # though this sandbox could route it (AGENTS.md §1.2).
    #
    + parent-provides
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Report
      + service Platform
      + service Dma
      + service Irq
      + service Io_mem
      + service Io_port
      + service Usb
      + service Capture
      + service Rtc
      + service File_system
      + service Uplink
      + service Nic
      + service Terminal

    + default | caps: 1000 | ram: 4M

    + default-route
      + any-service
        + parent
        + any-child

#
    # The relay that makes the whole driver flow work, all four policies
    # in one place (run/driver_runtime.inc emits the same two pkgd-facing
    # ones for the product scenarios):
    #
    #   sponge_pkgd -> request          driver_probe's install request
    #   driver_probe -> result          pkgd's answer
    #   driver_runtime -> config        pkgd's driver_runtime config
    #   runtime_state                    pkg_runtime's state report, so
    #                                    the app-side admission gate is
    #                                    armed too
    #   driver_runtime_state            driver_runtime's state report
    #
    + start report_rom | caps: 300 | ram: 8M
      + provides
        + service Report
        + service ROM
      + config | verbose: yes
        + policy | label: sponge_pkgd -> request | report: driver_probe -> request
        + policy | label: driver_probe -> result | report: sponge_pkgd -> result
        + policy | label: driver_probe -> installed | report: sponge_pkgd -> installed
        + policy | label: driver_runtime -> config | report: sponge_pkgd -> driver_runtime
        + policy | label: sponge_pkgd -> driver_runtime_state  | report: driver_runtime -> state
        + policy | label: driver_probe -> driver_runtime_state | report: driver_runtime -> state
        + policy | label: pkg_runtime -> config   | report: sponge_pkgd -> runtime
        + policy | label: sponge_pkgd -> runtime_state | report: pkg_runtime -> state
      + route
        + any-service
          + parent

    + start sponge_pkgd | caps: 200 | ram: 16M
      + binary | name: sponge_pkgd
      + config
        + admission
        + driver_admission
      + route
        + service ROM | label_last: ld.lib.so     | + parent
        + service ROM | label: request            | + child report_rom
        + service ROM | label: runtime_state      | + child report_rom
        + service ROM | label: driver_runtime_state | + child report_rom
        + service Report | + child report_rom
        + any-service
          + parent

#
    # driver_runtime: the driver sandbox. Its CONFIG is not here — it is
    # the report pkgd publishes as driver_runtime, relayed to the
    # config ROM below. The node therefore starts empty and is filled
    # in when the user (here: driver_probe) installs a driver package.
    #
    # The route list is short on purpose: driver_runtime is a pure
    # sandbox and opens no hardware session itself. Every driver resolves
    # its Platform/Irq/Io_mem/Io_port requests through its own + parent
    # route and lands on this sandbox's default-route.
    #
    # Explicit caps/ram, NOT a remainder clamp: pkg_runtime below is the
    # last node and carries ram: 512G precisely so that it receives
    # everything init still has. A node created after it would take its
    # RAM out of that clamp instead of out of a declared budget, and a
    # caps grant sized to absorb the whole remainder would starve the
    # next sibling added to this config.
    #
    + start driver_runtime | caps: 9000 | ram: 320M
      + binary | name: init
      + route
        + service ROM | label: config               | + child report_rom
        + service ROM | label: driver_runtime_state | + child report_rom
        + service Report | + child report_rom
        + any-service
          + parent

    + start driver_probe | caps: 200 | ram: 8M
      + binary | name: driver_probe
      + config | pkg: pc_nic | timeout_ms: 40000
      + route
        + service ROM | label_last: ld.lib.so       | + parent
        + service ROM | label: result               | + child report_rom
        + service ROM | label: installed            | + child report_rom
        + service ROM | label: driver_runtime_state | + child report_rom
        + service Report | + child report_rom
        + any-service
          + parent

#
    # pkg_runtime LAST, with the deliberate 512G RAM clamp (docs/14 §4.4).
    # On a fresh boot pkgd publishes an empty-but-valid config, so this
    # node stays empty — its presence here is what proves the two
    # sandboxes coexist: pkgd writes both configs on every request, and
    # an application install must not disturb driver_runtime (and vice
    # versa).
    #
    + start pkg_runtime | caps: 20000 | ram: 512G
      + binary | name: init
      + route
        + service ROM | label_last: ld.lib.so | + parent
        + service ROM | label: config         | + child report_rom
        + service Report | + child report_rom
        + any-service
          + parent
- }

#
# build_artifacts covers the binaries the build block produced. Shared
# libraries do NOT appear there — a dynamically linked child resolves its
# dependencies at runtime through ROM requests, so every .lib.so has to
# be an explicit boot module. sponge_pkgd links the Vfs library for its
# optional persistence store and therefore needs vfs.lib.so present even
# in a topology that never opens a File_system session.
#
set boot_modules [build_artifacts]
foreach m { vfs.lib.so pkg_index.xml pkg_pc_nic.xml } {
	if {[file exists "bin/$m"]} { lappend boot_modules $m }
}
build_boot_image $boot_modules

#
# QEMU: explicit platform pin (the same contract the disk product
# scenarios carry), headless, 2 GiB so both nested runtimes have room.
# The board default already supplies the e1000 + user/slirp netdev pair.
#
append qemu_args " -machine q35 -cpu Skylake-Client "
match_max 400000
append qemu_args " -nographic -m 2G "

#
# === Gates (ordered; run_genode_until consumes the stream sequentially,
#     so each gate can only match a marker that follows the previous one)
#
#   gate 1  pkgd is up and both sandboxes exist
#   gate 2  pkgd answered the install with status="ok"
#   gate 3  driver_runtime reports the driver as one of ITS children
#   gate 4  the e1000e driver actually bound the e1000 (hardware proof)
#   gate 5  nic_router leased an address from QEMU slirp (stack proof)
#
set rc 0
if {[catch {
	run_genode_until {.*sponge_pkgd: ready.*} 60
	run_genode_until {.*driver resource admission armed.*} 30
	run_genode_until {.*driver-probe: install answered status=ok.*} 120
	run_genode_until {.*driver-probe: driver_runtime lists child 'pc_nic'.*} 120
	run_genode_until {.*Intel\(R\) PRO/1000 Network Driver.*} 240
	run_genode_until {.*dhcp offer from 10\.0\.2\.2, offering 10\.0\.2\.15.*} 60
	run_genode_until {.*driver-probe: PASS.*} 30
} err]} {
	puts "sponge-pkg-driver: FAILED — $err"
	set rc 1
}

if {$rc != 0} {
	exit $rc
}

puts "sponge-pkg-driver: PASS (pc_nic installed as a package into driver_runtime, bound the e1000, leased 10.0.2.15)"

# vi: set ft=tcl :