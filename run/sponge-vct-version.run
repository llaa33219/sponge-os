#
# \brief  Sponge OS vct version scenario
# \author Sponge OS contributors
# \date   2026
#
# Verifies that `vct version` prints the Sponge OS and vct versions.
# Kernel-agnostic: runs on base-linux and base-sel4.
#

build { core lib/ld init vct }

create_boot_directory

install_config {
config
+ parent-provides
  + service LOG
  + service PD
  + service CPU
  + service ROM

+ default-route
  + any-service
    + parent
    + any-child
+ default | caps: 200 | ram: 8M

+ start vct
  + config
    + args
      + arg version
- }

build_boot_image [build_artifacts]

append qemu_args " -nographic -m 1G "

run_genode_until {.*vct 0\.0\.1-pre-alpha.*} 30
