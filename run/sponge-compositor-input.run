# SPDX-License-Identifier: Apache-2.0
#
# G2 input battery for the Sponge compositor. The selected Tier-0 is
# upstream nitpicker by default, or native with SPONGE_COMPOSITOR=native.
# The probe drives top-view clicks, alpha/input-mask fall-through, focus
# transitions, real Event injection, and pointer-report validation through
# the real ps2/event_filter chain. No WM/DE component is involved.

assert {[have_spec sel4]} \
	"sponge-compositor-input requires KERNEL=sel4 BOARD=pc; it drives the real ps2/event_filter input chain."

source [file join [file dirname [file normalize [info script]]] compositor.inc]

build { core lib/ld init timer server/report_rom server/nitpicker \
        driver/acpi app/pci_decode driver/platform \
        driver/framebuffer/vesa driver/ps2 \
        driver/usb_host/pc driver/usb_hid server/event_filter \
        sponge_compositor test/input_probe }

create_boot_directory

set tier0 [compositor::tier0_start_node]
append tier0 "    + report | pointer: yes | hover: yes\n"

set tier0_child nitpicker
if {[compositor::enabled]} {
	set tier0_child sponge_compositor
}

install_config "config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: compositor-input-probe -> pointer | report: $tier0_child -> pointer
    + policy | label: compositor-input-probe -> hover   | report: $tier0_child -> hover

$tier0

+ start drivers | caps: 1800 | ram: 96M | managing_system: yes
  + binary init
  + route
    + service ROM | label: config | + parent | label: drivers.config
    + service Timer | + child timer
    + service Capture | + child $tier0_child
    + service Event | + child $tier0_child
    + any-service | + parent
  + config
    + parent-provides
      + service IRQ
      + service IO_MEM
      + service IO_PORT
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Capture
      + service Event

    + default | caps: 60

    + start acpi | caps: 250 | ram: 4M
      + route
        + service IO_MEM | + parent
        + service LOG | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service ROM | + parent
        + service Report | + child report_rom

    + start report_rom | caps: 300 | ram: 8M
      + provides
      | + service ROM
      | + service Report
      + config
      | + policy | label: pci_decode -> system | report: acpi -> acpi
      | + policy | label: platform -> devices  | report: pci_decode -> devices
      | + policy | label: usb_hid -> report    | report: usb -> devices
      + route
        + service LOG | + parent
        + service PD | + parent
        + service CPU | + parent
        + service ROM | + parent

    + start pci_decode | caps: 100 | ram: 2M
      + route
        + service Report | + child report_rom
        + service ROM | label: system | + child report_rom
        + service IO_MEM | + parent
        + service LOG | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service ROM | + parent

    + start platform | caps: 200 | ram: 3M | managing_system: yes
      + provides
      | + service Dma
      | + service Platform
      + route
      | + service ROM | label: devices | + child report_rom
      | + service Report | + child report_rom
      | + service IRQ | + parent
      | + service IO_MEM | + parent
      | + service IO_PORT | + parent
      | + service ROM | + parent
      | + service PD | + parent
      | + service CPU | + parent
      | + service LOG | + parent
      | + service Timer | + parent
      + config
        + report | devices: yes
        + policy | label_prefix: ps2             | + device ps2
        + policy | label_prefix: fb  | info: yes | + pci | class: VGA
        + policy | label_prefix: usb | info: yes | + pci | class: USB

    + start fb | caps: 150 | ram: 20M
      + binary vesa_fb
      + route
        + service ROM | label: config | + parent | label: fb.config
        + service Report | + child report_rom
        + service Dma | + child platform
        + service Platform | + child platform
        + service IO_PORT | + parent
        + service IO_MEM | + parent
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent
        + service Capture | + parent

    + start ps2 | caps: 100 | ram: 1280K
      + config
      + route
        + service Dma | + child platform
        + service Platform | + child platform
        + service Event | + child event_filter | label: ps2
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

    + start usb | caps: 200 | ram: 16M
      + binary pc_usb_host
      + provides | + service Usb
      + config
      | + report | devices: yes
      | + policy | label_prefix: usb_hid | + device | class: 0x3
      + route
        + service Dma | + child platform
        + service Platform | + child platform
        + service Report | label: devices | + child report_rom
        + service ROM | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

    + start usb_hid | caps: 180 | ram: 10M
      + route
        + service ROM | label: report | + child report_rom
        + service ROM | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent
        + service Event | + child event_filter | label: usb
        + service Usb | + child usb

    + start event_filter | caps: 90 | ram: 1280K
      + provides | + service Event
      + route
        + service ROM | label: config | + parent | label: event_filter.config
        + service Event | + parent
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

+ start compositor-input-probe | caps: 300 | ram: 24M
  + config
  + route
    + service Gui | + child $tier0_child
    + service Event | + child $tier0_child
    + service Input | + child $tier0_child
    + service Report | + child report_rom
    + service ROM | label: pointer | + child report_rom
    + service ROM | label: hover | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent
      + any-child
-
"

# Stage the interactive driver configuration and chargen tables used by
# the proven qmp.inc PS/2 relative-click recipe.
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { drivers.config fb.config event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (interactive driver recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}
set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

set boot_modules [build_artifacts]
lappend boot_modules drivers.config fb.config event_filter.config en_us.chargen special.chargen
build_boot_image $boot_modules

append qemu_args " -nographic -m 2G -device nec-usb-xhci,id=xhci -device usb-tablet "
set qmp_source_path [file join [file dirname [file normalize [info script]]] qmp.inc]
catch { source $qmp_source_path }
set qmp_port [qmp_pick_port]
append qemu_args " -qmp tcp:127.0.0.1:${qmp_port},server=on,wait=off "

# Connect before component startup so the first probe marker cannot be
# consumed by the framebuffer boot gate. The Genode banner is common to
# both Tier-0 implementations and precedes the probe's first marker.
run_genode_until {.*Genode 26.08.*} 90
global qemu_spawn_id
set qmp_chan [qmp_connect $qmp_port]

# Rendezvous the first target with framebuffer readiness in either arrival
# order. Starting the nested drivers init returns before its children are
# ready, while the probe can emit its first marker during that startup.
set fb_ready 0
set tablet_ready 0
set first_x -1
set first_y -1
set timeout 90
while {!$fb_ready || !$tablet_ready || $first_x < 0} {
	expect {
		-i $qemu_spawn_id
		-re {\[init -> drivers -> fb\] using 1024x768} {
			set fb_ready 1
		}
		-re {Connected device: input0 .* POINTER} {
			set tablet_ready 1
		}
		-re {QMP-TARGET absmove (-?\d+) (-?\d+)\r*\n} {
			set first_x $expect_out(1,string)
			set first_y $expect_out(2,string)
		}
		timeout {
			puts stderr "\nsponge-compositor-input: FAIL - framebuffer/first-target rendezvous timed out"
			exit 1
		}
	}
}

puts "\nqmp: materializing pointer at guest ($first_x,$first_y)"
qmp_pointer_move $qmp_chan $first_x $first_y

# Each of the three host clicks is a bounded sequence of closed-loop moves
# followed by one terminal press. Event injection and pointer-report
# validation are local probe phases and have no QMP waits of their own.
for {set click 0} {$click < 3} {incr click} {
	set pressed 0
	for {set i 0} {$i < 32} {incr i} {
		if {[qmp_exec_target $qmp_chan 180] eq "press"} {
			set pressed 1
			break
		}
	}
	if {!$pressed} {
		error "sponge-compositor-input: click $click did not reach its press marker within 32 dispatches"
	}
}

run_genode_until {g2-input: PASS\r*\n} 180 $qemu_spawn_id
qmp_disconnect $qmp_chan
