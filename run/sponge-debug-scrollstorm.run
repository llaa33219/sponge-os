#
# \brief  SPONGE DEBUG scroll-storm resource measurement (headless, QEMU/seL4)
# \author Sponge OS contributors
# \date   2026
#
# QUESTION UNDER TEST
#
#   Field report (2026-10): in the SPONGE DEBUG window, rapidly dragging
#   the scrollbar until "text loads fast" FREEZES the whole system. The
#   freeze point moved when the package quota was raised, which points at
#   a resource leak; the user's own reading is "mere rendering shouldn't
#   kill it". Two competing explanations:
#
#     H-leak       one component's RAM/caps usage grows without bound
#                  under sustained repaints;
#     H-saturation no component grows; the shared render substrate
#                  saturates the CPU (docs/17-runtime-component-topology
#                  .md section 4 — the same pattern as the mouse
#                  follow-up recorded there).
#
#   This scenario decides between them by MEASUREMENT, not by argument:
#   repostorm_probe samples EVERY child's ram/caps out of the sandbox
#   state report (child_ram/child_caps armed below) once per second and
#   names the largest per-child growth. NOTE: the sandbox regenerates the
#   state report only when a child's PD stats change, so what the probe
#   observes is report REVISIONS, not wall-clock ticks — the baseline and
#   final TABLE lines are the load-bearing numbers. See
#   docs/evidence/sponge-debug-scrollstorm.md section 4. Growth in exactly one child =
#   leak, and the verdict line names it. Growth nowhere = the freeze is
#   CPU saturation of the shared substrate.
#
# TOPOLOGY (the real render chain, no package manager)
#
#   init (Tier 0)
#   + timer         (the ONLY Timer source: core provides no Timer)
#   + report_rom    (serves `system`'s own `state` Report session — see
#                    the note below on why the state report cannot live
#                    on the Tier-0 config)
#   + system        (nested init; the state report is armed HERE)
#     + report_rom  (the three report_rom relays SPONGE DEBUG subscribes
#                    to + the state relay)
#     + nitpicker   (Gui/Capture/Event; the compositor)
#     + drivers     (sub-init; acpi -> pci_decode -> platform ->
#                    vesa_fb (the real display) + ps2 + usb_hid +
#                    event_filter). The vendored
#                    recipes/raw/drivers_interactive-pc set, so nitpicker
#                    HAS a real framebuffer client and the compositing
#                    work is real — a scenario without one would
#                    under-measure nitpicker by construction.
#     (no wm / layouter / decorator — see the SCOPE DECISION note below)
#     + sponge_debug(the component under test; storm knobs in <config>)
#     + repostorm_probe (the instrument; Timer + the state ROM)
#
#   The product runs SPONGE DEBUG under pkg_runtime with its Gui routed
#   through wm. Both indirection layers are dropped here deliberately:
#   the field freeze is a RENDER-path symptom, and pkg_runtime/pkgd and
#   the WM triple contribute no rendering of the window under test.
#   Keeping them out makes the run cheap enough to iterate and removes
#   several large, unrelated, slowly-growing terms from the RAM table.
#   The WM triple's own resource behaviour is covered by
#   run/sponge-wm-tasks.run and run/sponge-de-sel4-interactive.run.
#
# THE STORM
#
#   sponge_debug's own config-gated knobs (repos/sponge/src/sponge_debug/
#   main.cc) drive a QTimer that jumps the text viewport between the top
#   and the bottom of the document at storm_hz — the same
#   relayout+repaint work a scrollbar fling produces. This is preferred
#   over host-side QMP mouse injection because the documented QEMU
#   pointer recipe cannot land on a 15-pixel-wide scrollbar reliably
#   (run/qmp.inc header: under -nographic the usb-tablet's absolute axis
#   is unscaled so every absolute event clamps to the screen center; the
#   relative recipe is +-1px but accumulates). Driving the repaint path
#   directly is deterministic, headless, and kernel-independent.
#
# FIELD-SHAPE KNOBS (opt-in; every default preserves the original arms)
#
#   SPONGE_FB_W / SPONGE_FB_H   framebuffer size. Unset = the stock
#                                drivers_interactive-pc fb.config
#                                (1024x768). SPONGE_FB_W=2560
#                                SPONGE_FB_H=1600 reaches the LG gram's
#                                panel resolution — the field topology.
#   SPONGE_HEARTBEAT=on|off      production containment heartbeat
#                                (rate_ms 2000, restart_after_skipped
#                                30 - see the comment at the knob) on
#                                EVERY child of both sandboxes.
#                                Default off: containment is what the
#                                product arms must not have perturbed,
#                                and arming it makes the state report
#                                print a per-child `skipped_heartbeats`
#                                counter, which is the STARVATION RANKING
#                                this scenario uses to localize a freeze
#                                (a child that stops answering for 2 s
#                                intervals is starved; the one that keeps
#                                answering and is not idle is the hog).
#   SPONGE_STORM_WIN            window geometry of the storming client.
#                                Default = the product 700x480. Every cost
#                                on the render path is proportional to the
#                                DAMAGED AREA, so a 2560x1600 window at a
#                                2560x1600 framebuffer is the only
#                                geometry that carries the field's
#                                per-frame magnitude.
#   SPONGE_STORM_BURST_HZ       override for storm_burst_hz.
#   SPONGE_MIN_HZ / SPONGE_MAX_GAP_MS
#                                the BOUNDS that turn this scenario into a
#                                pass/fail measurement instead of a log to
#                                read. Both default 0 = "do not assert",
#                                which is what every pre-existing arm
#                                wants. `SPONGE_MIN_HZ` asserts the storm's
#                                own `achieved_hz`; `SPONGE_MAX_GAP_MS`
#                                asserts its `max_gap_ms`, the largest
#                                interval between two delivered Qt event
#                                loop ticks - a saturated loop delivers
#                                them late and bunched up, so that number
#                                IS the liveness bound. A storm that does
#                                not reach its own `STORM done` line
#                                already fails before either bound is
#                                evaluated.
#   SPONGE_FB_CAPS / SPONGE_NITPICKER_CAPS
#                                capability quotas for the two components
#                                that MAP the panel buffer. Defaults are
#                                this scenario's original 1024x768-era
#                                values; the product media grants
#                                fb 24000 / nitpicker 20000.
#   SPONGE_FB_PERIOD_MS         the framebuffer driver's capture period
#                                (its config `period_ms`, default 20).
#                                Raises the rate cap of the LAST stage of
#                                the render path.
#   SPONGE_SMP                  QEMU vCPU count (default: QEMU's own 1).
#                                The LG gram is multi-core, so this is the
#                                field-faithful setting; see the gate note
#                                below.
#
#   The `freeze` arm (60 s of the burst gesture instead of 30) is the
#   field shape in one selector: use it with the knobs above.
#
# FREEZE GATE (the liveness measurement)
#
#   When a storm is armed, the storm's own `STORM done` line is a gate of
#   its own, BEFORE the probe's verdict. A storm that never reaches its
#   own end-of-storm line means the Qt event loop stopped draining, which
#   is the field symptom; the run tool then times out and reports a
#   failure. `STORM checkpoint` lines plus the verbose state report carry
#   the last known tick rate and the starvation ranking into the log.
#
# ARMS (select with SPONGE_ARM, default "scroll")
#
#   baseline  no storm at all (storm_ms=0). Establishes which components
#             grow on their own over the measurement window — Qt/Mesa
#             caches settling, etc.
#   scroll    the user's gesture: storm_ms=30000 storm_hz=30
#             storm_grow=0. Sustained scroll, constant document size.
#   grow      storm_grow=1: one appended log line per tick on top. The
#             "so text loads fast" half of the report — a growing
#             document under load.
#   burst     FORCED BACK-PRESSURE arm: storm_burst_hz=100 adds a second,
#             tiny-damage flush timer (an 8x8 update on the status
#             label) alongside the full-document flings. This arm exists
#             because frame coalescing (ledger row #23) can only engage
#             when the CLIENT outruns the compositor, and on this host it
#             never does on its own: a full-document relayout+repaint
#             costs ~100 ms (~10 Hz) while nitpicker drains a frame every
#             40 ms (~25 Hz). A tiny damage update is cheap enough to be
#             submitted at 100 Hz, so the client provably exceeds the
#             compositor and the coalescing path is genuinely exercised
#             and measured instead of merely compiled. Telemetry lines:
#             "BURST checkpoint ..." / "BURST done ...", plus the QPA
#             plugin's own self-gating "frame coalesced deferred=N ..."
#             lines, which are absent when coalescing never engaged.
#             Every pre-existing arm is unchanged.
#
# STORM TELEMETRY (what the before/after comparison is built on)
#
#   sponge_debug logs, every 5 s of storm and once at the end:
#
#     STORM checkpoint ticks=<n> elapsed_ms=<t> rate_hz=<r> max_gap_ms=<g>
#     STORM done      ticks=<n> elapsed_ms=<t> achieved_hz=<r> max_gap_ms=<g>
#
#   The burst arm adds the same shape from its own timer:
#
#     BURST checkpoint ticks=<n> elapsed_ms=<t> rate_hz=<r> max_gap_ms=<g>
#     BURST done      ticks=<n> elapsed_ms=<t> achieved_hz=<r> max_gap_ms=<g>
#
#   and the QPA plugin's frame-coalescing telemetry (self-gating: it
#   logs the first coalesced frame and every 32nd after it, and logs
#   NOTHING when coalescing never engaged):
#
#     QGenodePlatformWindow: frame coalesced deferred=N submitted=M ...
#
#   'rate_hz' is the cumulative average (it degrades if the per-frame
#   cost grows). 'max_gap_ms' is the largest interval between two
#   delivered QTimer ticks — a saturated Qt event loop delivers them
#   late and bunched up, so that is the headless liveness signal for
#   the repaint backlog this scenario exists to measure.
#   Docs: docs/evidence/sponge-debug-scrollstorm.md sections 1 and 8.
#
#   "grow" is EXPECTED to exceed any sane budget and therefore to report
#   a large delta_max; the run script raises threshold_kb for that arm so
#   the scenario still completes and the measured numbers stay in the
#   log. Read the TABLE/VERDICT lines, not just the exit code.
#
# GATE
#
#   repostorm-probe: VERDICT <PASS|FAIL> — the measurement itself. On
#   timeout the run tool errors out (no verdict at all = the system froze
#   or wedged, which is the field symptom).
#

assert {[have_spec sel4]} \
	"sponge-debug-scrollstorm requires KERNEL=sel4 (BOARD=pc): the scenario \
	 needs vesa_fb/ps2/usb_hid, i.e. real PC hardware access."

set arm "scroll"
if {[info exists ::env(SPONGE_ARM)]} { set arm $::env(SPONGE_ARM) }

# Framebuffer size. Empty = keep the stock drivers_interactive-pc
# fb.config (1024x768), which is what every arm in the evidence document
# was measured at.
set fb_w ""
set fb_h ""
if {[info exists ::env(SPONGE_FB_W)]} { set fb_w $::env(SPONGE_FB_W) }
if {[info exists ::env(SPONGE_FB_H)]} { set fb_h $::env(SPONGE_FB_H) }
if {($fb_w eq "") != ($fb_h eq "")} {
	error "SPONGE_FB_W and SPONGE_FB_H must be set together"
}
if {$fb_w eq ""} { set fb_desc "stock(1024x768)" } else { set fb_desc "${fb_w}x${fb_h}" }

# Framebuffer driver's capture/flush period in ms (its config attribute
# `period_ms`, default 20). This is the rate at which the driver pulls the
# composited buffer and blits the damaged rectangles into the panel, i.e.
# the rate of the LAST stage of the render path - the only knob that
# separates "the pipeline costs too much PER FRAME" from "the pipeline is
# asked for too many frames".
# Capability quotas for the two components that MAP the panel buffer.
# Defaults are this scenario's original 1024x768-era values, so every
# pre-existing arm is untouched. They are knobs because they are exactly
# what the field-resolution arms have to get right: at 2560x1600 the
# kernel prints "flush page table entries - mapping cache full" when they
# are too small (run/sponge-debug-firstpaint.run sizes these the same way,
# and the product media grants fb 24000 / nitpicker 20000).
#
# DERIVED, not hard-coded: asking for a panel resolution ALSO sizes the
# capability quotas of the two components that map the panel buffer.
#
# A 2560x1600x32 buffer is 16 MiB, and base-sel4's per-PD mapping cache is
# sized by the PD's cap quota. When the quota is smaller than the mapping
# needs, the cache overflows on access and the kernel falls back to
# "flush page table entries" - once per composited frame, hundreds of
# times a minute under a repaint storm. Measured on this very scenario:
# 521-567 kernel flushes and a storm that collapses 15 Hz -> 3 Hz with a
# 3672 ms event-loop stall at the original 150/200/1500, versus ZERO
# flushes and 17 Hz / 421 ms with the sizes below. Receipts and the full
# bisection: docs/evidence/sponge-debug-panelfreeze.md.
#
# So a user who asks for the field resolution gets a run that can actually
# answer the question (AGENTS.md 1.1: convenience) instead of one that
# re-measures a harness artefact. The knobs below stay as the explicit
# control door, and the ORIGINAL values are what the stock-resolution
# arms use, so every arm in the evidence document is untouched.
#
set fb_caps 150
set nitpicker_caps 200
set drivers_caps 1500
if {$fb_w ne ""} {
	# run/sponge-debug-firstpaint.run measured 6000 as sufficient for a
	# full-resolution vesa_fb / nitpicker; `drivers` must additionally
	# hold `fb`'s quota plus the rest of the driver set, or init denies
	# every PD session in that sandbox instead.
	set fb_caps 6000
	set nitpicker_caps 6000
	set drivers_caps 20000
}
if {[info exists ::env(SPONGE_FB_CAPS)]} { set fb_caps $::env(SPONGE_FB_CAPS) }
if {[info exists ::env(SPONGE_NITPICKER_CAPS)]} {
	set nitpicker_caps $::env(SPONGE_NITPICKER_CAPS)
}
if {[info exists ::env(SPONGE_DRIVERS_CAPS)]} {
	set drivers_caps $::env(SPONGE_DRIVERS_CAPS)
}

set fb_period_ms 0
if {[info exists ::env(SPONGE_FB_PERIOD_MS)]} {
	set fb_period_ms $::env(SPONGE_FB_PERIOD_MS)
}

# Production containment heartbeat on every child of both sandboxes.
# Default off so the original arms are bit-identical.
set heartbeat "off"
if {[info exists ::env(SPONGE_HEARTBEAT)]} { set heartbeat $::env(SPONGE_HEARTBEAT) }
if {$heartbeat ni {on off}} {
	error "SPONGE_HEARTBEAT must be 'on' or 'off' (got '$heartbeat')"
}
if {$heartbeat eq "on"} {
	# `rate_ms` belongs to the sandbox that OWNS the children (it needs
	# the Timer to generate them); `restart_after_skipped` belongs to the
	# policed child node. Same split run/sponge-debug-firstpaint.run uses.
	# rate_ms is the PRODUCTION 2 s period and is the thing that measures
	# starvation. restart_after_skipped is deliberately widened from the
	# production 3 to 30: QEMU gives the guest ONE vCPU, and a boot that
	# compiles and rasterizes a Qt first paint behind a full driver stack
	# already misses 2 s scheduling intervals, so the production budget
	# kills and respawns children during the settle period - which
	# destroys the instrument (the respawned repostorm_probe never emits
	# its verdict) without telling us anything the skip counter does not
	# already say. The skip COUNTER is identical either way; only the
	# containment kill is deferred.
	set hb_rate      "+ heartbeat | rate_ms: 2000"
	set hb           "+ heartbeat | restart_after_skipped: 30"
	set hb_off       "# SPONGE_HEARTBEAT=off - containment not armed for this arm"
	set hb_verbose   "verbose: yes"
} else {
	set hb_rate      "# SPONGE_HEARTBEAT=off - containment not armed for this arm"
	set hb           "# SPONGE_HEARTBEAT=off - containment not armed for this arm"
	set hb_off       "# SPONGE_HEARTBEAT=off - containment not armed for this arm"
	set hb_verbose   "verbose: no"
}

# Storming client window geometry (see the FIELD-SHAPE KNOBS header).
# Liveness bounds (0 = do not assert).
set min_hz 0
set max_gap_ms 0
if {[info exists ::env(SPONGE_MIN_HZ)]} { set min_hz $::env(SPONGE_MIN_HZ) }
if {[info exists ::env(SPONGE_MAX_GAP_MS)]} { set max_gap_ms $::env(SPONGE_MAX_GAP_MS) }

set win_w 700
set win_h 480
if {[info exists ::env(SPONGE_STORM_WIN)]} {
	set win_w [lindex [split $::env(SPONGE_STORM_WIN) "x"] 0]
	set win_h [lindex [split $::env(SPONGE_STORM_WIN) "x"] 1]
	if {![string is integer -strict $win_w] || ![string is integer -strict $win_h]} {
		error "SPONGE_STORM_WIN must be <w>x<h> in pixels"
	}
}

# Per-arm storm knobs (see the ARMS table above).
set storm_ms 30000
# The instrument settles 20 s and then measures 45 s. The storm must
# start AFTER the baseline, or most of its budget lands inside the
# settle period and is never sampled.
set storm_start_ms 24000
set storm_hz 30
set storm_lines 2000
set storm_grow 0
# storm_burst_hz adds a tiny-damage flush timer on top of the storm (see
# the BURST arm below). 0 = off, which is every pre-existing arm.
set storm_burst_hz 0
# threshold_kb: the per-child growth budget the probe asserts on. The
# "grow" arm is expected to exceed any sane budget, so its budget is set
# high enough for the scenario to complete and the numbers to survive in
# the log (the header above says that arm's verdict is informative, not
# normative).
set threshold_kb 2048
switch -- $arm {
	baseline { set storm_ms 0 }
	scroll   { set storm_ms 30000 ; set storm_grow 0 }
	grow     { set storm_ms 30000 ; set storm_grow 1 ; set threshold_kb 262144 }
	burst    { set storm_ms 30000 ; set storm_grow 0 ; set storm_burst_hz 100 }
# freeze: the FIELD shape in one arm - the field gesture (burst) for 60 s
# instead of 30, so a saturation that takes tens of seconds to develop has
# room inside one run. Combine with SPONGE_FB_W/H=2560x1600 and
# SPONGE_STORM_WIN=2560x1600 (see the FIELD-SHAPE KNOBS header) and
# SPONGE_HEARTBEAT=on for the starvation ranking.
freeze  { set storm_ms 60000 ; set storm_grow 0 ; set storm_burst_hz 100 }
	default  { error "SPONGE_ARM must be one of: baseline | scroll | grow | burst | freeze (got '$arm')" }
}
# Optional escape hatch on top of the arm's own value, so a sweep does
# not need a new arm per rate.
if {[info exists ::env(SPONGE_STORM_BURST_HZ)]} {
	set storm_burst_hz $::env(SPONGE_STORM_BURST_HZ)
}

#
# The instrument's measurement window must STRICTLY CONTAIN the storm's.
#
# The probe settles for settle_ms and then samples for duration_ms; the
# storm starts at storm_start_ms and runs storm_ms. With the stock numbers
# the probe finished at 80 s and the storm at 84 s, i.e. the storm outlived
# the measurement that is supposed to observe it. Beyond being wrong,
# the ordering was not stable: measured here, the probe's own exit
# coincided with the storm stalling (last storm tick at 57.2 s of a 60 s
# budget, no further serial output at all for the rest of the gate), so
# which of the two terminal markers landed LAST flipped between runs and
# no sequential gate pair could be order-independent. Deriving the
# window from the storm removes the race by construction.
#
if {$storm_ms > 0} {
	set probe_duration_ms [expr {$storm_start_ms + $storm_ms + 15000}]
} else {
	set probe_duration_ms 60000
}


build { core lib/ld init timer server/report_rom server/nitpicker \
         driver/acpi app/pci_decode driver/platform \
         driver/framebuffer/vesa driver/ps2 \
         driver/usb_host/pc driver/usb_hid \
         server/event_filter \
         server/wm app/window_layouter app/decorator \
         sponge_debug test/repostorm_probe \
         qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
         lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
         lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
         lib/zlib lib/libpng lib/blit }

create_boot_directory

install_config [subst {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

#
# TIER-0 report_rom. A sandbox can only produce a state report if a
# Report session can be OPENED for it, and it opens that session against
# its own parent (genode/repos/os/src/init/main.cc:62 builds a Reporter
# over a Report session labelled "state"). The Tier-0 init's parent is
# core, and core provides no Report service, so a report node on the Tier-0
# config is fatal ("parent denied Report-session"). The state report
# therefore lives on the nested `system` init and THIS report_rom is what
# lets `system` open its own `state` session. Exactly the split every
# other state-reporting scenario in this repo uses
# (run/sponge-vct-status.run:41, run/sponge-de-leak-audit.run:128).
#
#
# Tier-0 timer. core provides no Timer service, so the one Timer source
# in the system must be a Tier-0 child. Every sandbox below reaches it
# through the wildcard parent-service route (see the TIMER ROUTING note
# inside the `system` config).
#
+ start timer
  $hb
  + provides | + service Timer

+ start report_rom | caps: 100 | ram: 4M
  $hb
  + provides
    + service Report
    + service ROM
  + config | $hb_verbose
    + policy | label_suffix: state | report: system -> state

+ start system | caps: 30000 | ram: 512M
  + binary init
  + config
    $hb_rate
    + parent-provides
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Report
      + service IRQ
      + service IO_MEM
      + service IO_PORT
      + service Capture
      + service Event
    + default-route
      + any-service
        + parent
        + any-child
    + default | caps: 200 | ram: 4M

    # TIMER ROUTING -- deliberately no explicit Timer route rule below.
    # An explicit "service Timer" rule is a SPECIFIC rule in init's
    # Route_model (genode/repos/os/src/lib/sandbox/route_model.h:138)
    # and a specific rule whose target cannot be resolved is fatal:
    # Route_model::resolve rethrows Service_denied instead of falling
    # through to the wildcard rule (route_model.h:260-269). The only
    # Timer source is the Tier-0 "timer" child, which is NOT a child of
    # "system", so an explicit Timer route aimed at a child named timer
    # denies every request. The wildcard any-service/parent rule in
    # each sandbox resolves Timer from that sandbox's parent services
    # -- the Tier-0 timer for "system", and "system"'s parent-provides
    # Timer for everything below it -- and falls through harmlessly when
    # no target can serve. Measured while building this scenario: every
    # explicit Timer route variant produced "stop because parent denied
    # Timer-session".
    #
    #
    # The measurement instrument's data source. repostorm_probe reads
    # this as its "state" ROM (route below); report_rom inside `system`
    # fans it out so the probe sees the IDENTICAL report, not an estimate
    # (same idiom as run/sponge-pkg-admission.run:60-62).
    #
    + report | init_ram: yes | child_ram: yes | child_caps: yes | delay_ms: 1000

    + start report_rom | caps: 300 | ram: 8M
      $hb
      + provides
        + service Report
        + service ROM
      + config | $hb_verbose
        # The instrument.
        + policy | label_suffix: state | report: system -> state
        # SPONGE DEBUG's three subscriptions. This scenario has no package
        # manager, so 'installed' and 'launcher_result' are served from the
        # same real report wm produces: the app opens all three sessions at
        # construction or it stops on the first denied one, and the point of
        # the exercise is the app's RAM behaviour, not the payloads.
        + policy | label: sponge_debug -> installed       | report: wm -> window_list
        + policy | label: sponge_debug -> window_list     | report: wm -> window_list
        + policy | label: sponge_debug -> launcher_result | report: wm -> window_list

    + start nitpicker | caps: $nitpicker_caps | ram: 16M
      $hb
      + provides
        + service Gui
        + service Capture
        + service Event
      + route
        + service Report | + child report_rom
        + any-service
          + parent
          + any-child
      + config
        + capture
        + event
        + report | focus: yes | hover: yes | xray: yes
        + domain default | layer: 2 | content: client | label: no
                         | hover: always | focus: click
        + default-policy | domain: default
        + background | color: #1e1e2e

    #
    # The driver set, hosted by its own `drivers` sub-init exactly as
    # run/sponge-de-sel4-interactive.run does. Two facts forced this
    # shape, both measured in this scenario's own iteration:
    #
    #   1. init starts children CONCURRENTLY. Flattening the drivers
    #      into `system` puts event_filter and fb on the same start
    #      wave as nitpicker, and both lose the race for nitpicker's
    #      Event/Capture service ("parent denied Event-session" /
    #      "parent denied Capture-session"). One extra init generation
    #      is what the product topology already relies on.
    #   2. a sandbox only opens a Timer session when something in its
    #      config needs one. `drivers` parent-provides Timer for its
    #      children, so it needs one of its own -- the report node
    #      below is what makes it open one (and, as a side effect,
    #      gives the driver subtree its own per-child RAM table).
    #
    # The vendored recipes/raw/drivers_interactive-pc set is unchanged.
    #
    + start drivers | caps: $drivers_caps | ram: 96M | managing_system: yes
      + binary init
      + route
        + service ROM | label: config | + parent | label: drivers.config
        + service Capture | + child nitpicker
        + service Event | + child nitpicker
        + any-service
          + parent
      + config
        $hb_rate
        + report | init_ram: yes | child_ram: yes | child_caps: yes | delay_ms: 1000
        + parent-provides
          + service IRQ
          + service IO_MEM
          + service IO_PORT
          + service ROM
          + service PD
          + service RM
          + service CPU
          + service LOG
          + service Timer
          + service Capture
          + service Event

        + default | caps: 60

        + start report_rom | caps: 100 | ram: 2M
          $hb
          + provides
            + service ROM
            + service Report
          + config
            + policy | label: pci_decode -> system | report: acpi -> acpi
            + policy | label: platform -> devices  | report: pci_decode -> devices
            + policy | label: usb_hid -> report    | report: usb -> devices
          + route
            + service LOG | + parent
            + service PD | + parent
            + service CPU | + parent
            + service ROM | + parent
            + service Timer | + parent

        + start acpi | caps: 250 | ram: 4M
          $hb
          + route
            + service IO_MEM | + parent
            + service LOG | + parent
            + service PD | + parent
            + service RM | + parent
            + service CPU | + parent
            + service ROM | + parent
            + service Report | + child report_rom

        + start pci_decode | caps: 100 | ram: 2M
          $hb
          + route
            + service Report | + child report_rom
            + service ROM | label: system | + child report_rom
            + service IO_MEM | + parent
            + service LOG | + parent
            + service PD | + parent
            + service RM | + parent
            + service CPU | + parent
            + service ROM | + parent

        + start platform | caps: 200 | ram: 3M | managing_system: yes
          $hb
          + provides
            + service Dma
            + service Platform
          + route
            + service ROM | label: devices | + child report_rom
            + service Report | + child report_rom
            + service IRQ | + parent
            + service IO_MEM | + parent
            + service IO_PORT | + parent
            + service ROM | + parent
            + service PD | + parent
            + service RM | + parent
            + service CPU | + parent
            + service LOG | + parent
            + service Timer | + parent
          + config
            + report | devices: yes
            + policy | label_prefix: ps2             | + device ps2
            + policy | label_prefix: fb  | info: yes | + pci | class: VGA
            + policy | label_prefix: usb | info: yes | + pci | class: USB

        + start fb | caps: $fb_caps | ram: 20M
          $hb
          + binary vesa_fb
          + route
            + service ROM | label: config | + parent | label: fb.config
            + service Report | + child report_rom
            + service Dma | + child platform
            + service Platform | + child platform
            + service IO_PORT | + parent
            + service IO_MEM | + parent
            + service ROM | + parent
            + service PD | + parent
            + service CPU | + parent
            + service LOG | + parent
            + service Timer | + parent
            + service Capture | + parent

        + start ps2 | caps: 100 | ram: 1280K
          $hb
          + config
          + route
            + service Dma | + child platform
            + service Platform | + child platform
            + service Event | + child event_filter | label: ps2
            + service ROM | + parent
            + service PD | + parent
            + service CPU | + parent
            + service LOG | + parent
            + service Timer | + parent

        + start usb | caps: 200 | ram: 16M
          $hb
          + binary pc_usb_host
          + provides | + service Usb
          + config
            + report | devices: yes
            + policy | label_prefix: usb_hid | + device | class: 0x3
          + route
            + service Dma | + child platform
            + service Platform | + child platform
            + service Report | label: devices | + child report_rom
            + service ROM | + parent
            + service PD | + parent
            + service RM | + parent
            + service CPU | + parent
            + service LOG | + parent
            + service Timer | + parent

        + start usb_hid | caps: 180 | ram: 10M
          $hb
          + route
            + service ROM | label: report | + child report_rom
            + service ROM | + parent
            + service PD | + parent
            + service RM | + parent
            + service CPU | + parent
            + service LOG | + parent
            + service Timer | + parent
            + service Event | + child event_filter | label: usb
            + service Usb | + child usb

        + start event_filter | caps: 90 | ram: 1280K
          $hb
          + provides | + service Event
          + route
            + service ROM | label: config | + parent | label: event_filter.config
            + service Event | + parent
            + service ROM | + parent
            + service PD | + parent
            + service CPU | + parent
            + service LOG | + parent
            + service Timer | + parent

    #
    # SCOPE DECISION: no wm / layouter / decorator in this scenario.
    # SPONGE DEBUG's window still renders through exactly the same
    # measured path — Qt6 QPA genode -> nitpicker -> vesa_fb -> GOP —
    # and every component on THAT path is in the per-child RAM table.
    # The WM triple is a second shared-broker axis with its own
    # scenarios (run/sponge-wm-tasks.run, run/sponge-de-sel4-interactive.run);
    # carrying a private copy of it here would add three more
    # slowly-growing terms to the attribution table and make the storm
    # measurement harder to read, for no extra coverage of the field
    # symptom. Registered as a limitation in the evidence document.
    #
    # Gui therefore goes straight to nitpicker, the same route
    # run/sponge-de-sel4-interactive.run:755 gives pkg_runtime packages.
    #
    # caps: 1000 — base-sel4's capability accounting is roughly 3x
    # base-linux's; 300 caps wedges inside Mesa's EGL screen creation with
    # a silent hang (docs/09-roadmap.md section 11.1). ram: 64M is the
    # package's production figure (pkg/debug/metadata.xml).
    + start sponge_debug | caps: 1000 | ram: 64M
      $hb
      + config | storm_ms: $storm_ms | storm_start_ms: $storm_start_ms | storm_hz: $storm_hz | storm_lines: $storm_lines | storm_grow: $storm_grow | storm_burst_hz: $storm_burst_hz | storm_win_w: $win_w | storm_win_h: $win_h
        + vfs
          + dir dev
            + log
            + inline rtc | : 2018-01-01 00:01
          + dir pipe | + pipe
          + tar qt6_dejavusans.tar
          + tar qt6_libqgenode.tar
        + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
      + route
        + service Gui | + child nitpicker
        + service ROM | label_last: installed       | + child report_rom
        + service ROM | label_last: window_list     | + child report_rom
        + service ROM | label_last: launcher_result | + child report_rom
        + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
        + any-service
          + parent
          + any-child

    #
    # The instrument itself is deliberately NOT heartbeat-policed, and
    # this is a measured fact, not a preference: repostorm_probe runs its
    # whole measurement INSIDE Component::construct (probe.run()), so its
    # entrypoint thread never returns to the event loop and can never
    # dispatch the heartbeat handler. Armed, its counter climbs from 1 at
    # boot to 31 in ~60 s on a completely quiet system and init then kills
    # and respawns it - destroying the instrument without saying anything
    # the counter would have said anyway.
    #
    # Every other child here IS ep-driven, so a rising counter there means
    # real starvation. usb_hid's counter also climbs while idle (its ep is
    # bound up in the DDE-Linux USB host), which is why the ranking is
    # read as a DELTA between a quiet baseline arm and the storm arm.
    #
    + start repostorm_probe | caps: 200 | ram: 8M
      + config | settle_ms: 20000 | report_ms: 1000 | duration_ms: $probe_duration_ms | threshold_kb: $threshold_kb
  + route
    + service ROM | label_last: ld.lib.so | + parent
    # The instrument reads this sandbox's OWN state report. The ROM
    # request is routed here by `system` (a child's own <route> node
    # only serves that child's children, and the probe has none);
    # report_rom then requests the Report session "system -> state",
    # which init answers from its local services without any routing.
    + service ROM | label_last: state | + child report_rom
    + service Report | + child report_rom
    + service Capture | + child nitpicker
    + service Event | + child nitpicker
    + any-service
      + parent
      + any-child
- }]

#
# On base-sel4 the boot image is one packed image.elf: every non-build-
# artifact module must exist in bin/ BEFORE build_boot_image or it never
# reaches the guest (docs/11-environment.md section 10.4).
#
exec mkdir -p bin

set dejavu_dst "bin/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavu_dst -C $staging qt
	file delete -force $staging
}

set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { drivers.config fb.config event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

#
# The stock drivers_interactive-pc fb.config pins 1024x768. At the field
# resolution this scenario writes its own, in the same file format the
# recipe uses (`config | width: <w> | height: <h> | buffered: yes`), so
# nothing is hand-rolled and the stock file is untouched when the knobs
# are unset. 2560x1600 is the LG gram 17ZD90N's panel and what OVMF's
# GOP hands the field-identical driver.
#
if {$fb_w ne "" || $fb_period_ms > 0} {
	if {$fb_w eq ""} {
		set fw 1024
		set fh_ 768
	} else {
		set fw $fb_w
		set fh_ $fb_h
	}
	set period_attr ""
	if {$fb_period_ms > 0} { set period_attr " | period_ms: $fb_period_ms" }
	set fh [open "bin/fb.config" w]
	puts -nonewline $fh "config | width: $fw | height: $fh_ | buffered: yes$period_attr\n-\n"
	close $fh
	puts "sponge-debug-scrollstorm: framebuffer ${fw}x${fh_} period_ms=$fb_period_ms"
}

#
# event_filter.config is the recipe's own config, unmodified. The
# absolute-pointer scale and the PS/2 acceleration deviations that
# run/sponge-de-sel4-interactive.run writes exist only so a HOST-side QMP
# mouse can be aimed at a specific pixel. This scenario injects no host
# input — the storm is driven inside sponge_debug — so the stock config is
# correct here and nothing is hand-written.
#

set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} {
		error "$chargen_dir/$f missing (event_filter sources drifted?)"
	}
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

set boot_modules [build_artifacts]
foreach m { libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
            libqgenode.lib.so \
            qt6_libqgenode.tar qt6_dejavusans.tar \
            drivers.config fb.config event_filter.config \
            en_us.chargen special.chargen } {
	lappend boot_modules $m
}
build_boot_image $boot_modules

# SPONGE_SMP: QEMU defaults to ONE vCPU, which turns any CPU contention
# into total system starvation. The field machine is not single-core, so
# the SMP arms are the discriminating experiment between "too much work
# for the cores we have" (contention: more cores restore liveness) and
# "an entrypoint is BLOCKED" (no core count helps).
set smp ""
if {[info exists ::env(SPONGE_SMP)]} { set smp $::env(SPONGE_SMP) }
if {$smp eq ""} { set smp 1 }
append qemu_args " -smp $smp"

append qemu_args " -nographic -m 2G "

#
# GATES
#
#   Gate 1 boots the guest. It matches the FIRST thing the boot log
#   prints on purpose: every later gate reads from the same expect
#   buffer, and matching late would consume the storm telemetry this
#   scenario exists to observe.
#
#   Gate 2 (only when a storm is armed) is the LIVENESS gate: the storm's
#   own `STORM done` line. A storm that never reaches it means the Qt
#   event loop stopped draining — the field symptom — and the run tool
#   times out and reports a failure. This is what makes "bounded gaps"
#   (PASS) and "stall" (FAIL) distinguishable at the field resolution.
#
#   Gate 3 is the measurement itself. A missing verdict means the system
#   wedged, reported as a failure.
#
global qemu_spawn_id

set ss_log [run_dir]/scrollstorm.log

run_genode_until {.*Genode v.*} 180

# The verbose state report emits hundreds of bytes per child per second,
# more than expect's default 2000-byte match window, so a later gate
# would not find an earlier line. Same remedy as
# run/sponge-de-sel4-interactive.run and run/terminal_runtime.inc.
match_max -i $qemu_spawn_id 500000
log_file -a $ss_log

#
# ONE terminal gate, not two. The probe's verdict and the storm's closing
# line are both end-of-run markers, and WHICH one comes first is a race:
# the probe's own budget is settle_ms+duration_ms (20+60 s) while the
# storm's is storm_start_ms+storm_ms (24+60 s), so the verdict can and
# does land FIRST. Two sequential gates then lose whichever marker the
# first gate consumed - measured, not argued. So the VERDICT is the only
# expect gate and the storm's telemetry is asserted host-side below,
# straight out of the captured log, with its own bounded failure.
#
set liveness [expr {($storm_start_ms + $storm_ms)/1000 + 180}]
puts "sponge-debug-scrollstorm: arm=$arm fb=$fb_desc \
win=${win_w}x${win_h} heartbeat=$heartbeat burst_hz=$storm_burst_hz \
smp=$smp min_hz=$min_hz max_gap_ms=$max_gap_ms gate=${liveness}s"
#
# ONE expect gate: the probe's verdict. Because the probe's window now
# strictly contains the storm (see 'probe_duration_ms' above), the storm's
# closing line is ALWAYS already in the buffer by the time this matches,
# which is what makes a single gate sufficient - two gates consume
# everything up to their match, so a second gate could only ever find data
# the first one swallowed. The storm's own telemetry is asserted host-side
# from the captured log below, with its own bounded failure.
#
# A stall still fails here: the run tool times out rather than returning,
# and a stall of the storm alone (the rest of the guest still alive) is
# caught by that host-side assertion instead, which names it.
#
run_genode_until {.*repostorm-probe: VERDICT.*} $liveness $qemu_spawn_id

# The run tool stops logging and cuts the stream; let the closing
# numbers reach the file before it is read back.
sleep 2
log_file

set fh [open $ss_log r]
set ss_out [read $fh]
close $fh

set storm_line "n/a (no storm armed)"
foreach line [split $ss_out "\n"] {
	if {[string match "*sponge_debug: STORM done*" $line]} { set storm_line $line }
}
set burst_line "n/a"
foreach line [split $ss_out "\n"] {
	if {[string match "*sponge_debug: BURST done*" $line]} { set burst_line $line }
}

# Per-child starvation ranking: the largest skipped_heartbeats init ever
# reported for each child. With SPONGE_HEARTBEAT=off this table is empty
# by construction (no heartbeat is armed at all).
#
# The state report prints one `+ child <name> | ... | skipped_heartbeats: <n>`
# line per policed child per revision, so the maximum per name over the
# whole run is the starvation ranking. Read it as a DELTA against a quiet
# `SPONGE_ARM=baseline` run: a child whose counter climbs on a quiet
# system is not ep-driven and its counter carries no information.
array set skip_max {}
foreach line [split $ss_out "\n"] {
	if {[regexp {\+ child ([a-zA-Z_0-9]+) \| binary: [a-zA-Z_0-9]+ \| skipped_heartbeats: ([0-9]+)} \
	      $line -> nm cnt]} {
		if {![info exists skip_max($nm)] || $cnt > $skip_max($nm)} {
			set skip_max($nm) $cnt
		}
	}
}
set worst_skip 0
set worst_skip_name "-"
foreach nm [lsort [array names skip_max]] {
	if {$skip_max($nm) > $worst_skip} {
		set worst_skip $skip_max($nm)
		set worst_skip_name $nm
	}
}

puts ""
#
# The bounds. Parsed out of the storm's OWN closing telemetry line so the
# assertion is on the measured number, not on the run's exit code.
#
set storm_hz_achieved 0
set storm_gap_ms 0
if {$storm_ms > 0} {
	if {![regexp {STORM done ticks=[0-9]+ elapsed_ms=[0-9]+ achieved_hz=([0-9]+) max_gap_ms=([0-9]+)} \
	       $storm_line -> storm_hz_achieved storm_gap_ms]} {
		error "the storm never reached its own STORM done line - the Qt \
		       event loop stopped draining. This is the freeze. \
		       Last storm line: [lindex [split $ss_out \n] end] ; \
		       full log: $ss_log"
	}

	if {$min_hz > 0 && $storm_hz_achieved < $min_hz} {
		error "storm achieved only ${storm_hz_achieved} Hz (bound: >= \
		       $min_hz) - the Qt event loop could not keep up; see $ss_log"
	}
	if {$max_gap_ms > 0 && $storm_gap_ms > $max_gap_ms} {
		error "storm tick gap reached ${storm_gap_ms} ms (bound: <= \
		       ${max_gap_ms} ms) - the event loop stalled; see $ss_log"
	}
}

puts "  ================================================================"
puts "  scrollstorm: arm=$arm"
puts "    framebuffer       : $fb_desc"
puts "    storm window      : ${win_w}x${win_h}"
puts "    heartbeat         : $heartbeat"
puts "    guest vcpus       : $smp"
puts "    storm telemetry   : $storm_line"
puts "    burst telemetry   : $burst_line"
puts "    worst heartbeat   : $worst_skip skips (child: $worst_skip_name)"
foreach nm [lsort [array names skip_max]] {
	puts "      starved rank    : $nm = $skip_max($nm) skipped 2 s intervals"
}
puts "    serial log        : $ss_log"
puts "  ================================================================"