#
# \brief  Sponge configd persistence scenario (Phase 14 W6)
# \author Sponge OS contributors
# \date   2026
#
# Phase 14 W6 deliverable scenario (docs/plans/phase14-daily-desktop.md
# §W6): boots sponge_configd with <vfs>-activated persistence, drives a
# three-write sequence (panel.height=64, panel.visible_widgets=clock,
# panel.height=28), and asserts that the durable store.xml on the
# backing vfs carries the most-recent value plus the intermediate
# write (no clobber between writes). This is the persistence proof:
# a fresh boot of sponge_configd against the same store.xml would
# reload exactly these values via the same code path.
#
# Topology:
#   init
#   + timer
#   + report_rom       (relays config_request / config_result / config
#                       between sponge_configd and configd_persist_probe)
#   + ram_vfs          (writable RAM-backed File_system, both
#                       sponge_configd and configd_persist_probe mount
#                       this via their <vfs> nodes — the daemon writes
#                       /var/sponge_configd/store.xml; the probe reads
#                       /store.xml from the same backing store)
#   + sponge_configd   (<vfs> gate active, persists on every set)
#   + configd_persist_probe (drives the 3-write sequence, reads the
#                             store.xml back, asserts content)
#
# report_rom policies (labels mirror run/sponge-config-probe.run):
#   sponge_configd's ROM "config_request" <- configd_persist_probe's report
#   configd_persist_probe's ROM "config_result" <- sponge_configd's report
#   configd_persist_probe's ROM "config"        <- sponge_configd's broadcast
#
# ram_vfs policy (both clients label it the same way so each gets a
# fresh File_system session routed to the ram_vfs server):
#   sponge_configd -> <the configured label>            -> child ram_vfs
#   configd_persist_probe -> <the configured label>      -> child ram_vfs
#
# AGENTS.md §4.2: this scenario builds lib/ld + core init and passes
# [build_artifacts] to build_boot_image so init.xsd + ld.lib.so + the
# binaries are all staged. Acceptance on base-sel4 (KERNEL=sel4 BOARD=pc).
#

build { core lib/ld init timer server/report_rom server/vfs lib/vfs \
        sponge_configd test/configd_persist_probe }

create_boot_directory

install_config {
config
+ parent-provides
  + service LOG
  + service PD
  + service CPU
  + service ROM
  + service IO_MEM
  + service IRQ

+ default-route
  + any-service
    + parent
    + any-child
+ default | caps: 200 | ram: 8M

+ start timer
  + provides | + service Timer

+ start report_rom | ram: 4M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_configd -> config_request | report: configd_persist_probe -> config_request
    + policy | label: configd_persist_probe -> config_result | report: sponge_configd -> config_result
    + policy | label: configd_persist_probe -> broadcast | report: sponge_configd -> config

+ start ram_vfs | caps: 200 | ram: 8M
  + binary vfs
  + provides | + service File_system
  + config
    + vfs
      + ram | writeable: yes
    + policy | label_prefix: sponge_configd        | root: / | writeable: yes
    + policy | label_prefix: configd_persist_probe | root: / | writeable: no
  + route
    + service ROM | label_last: ld.lib.so  | + parent
    + service ROM | label_last: vfs.lib.so | + parent
    + any-service
      + parent
      + any-child

+ start sponge_configd | caps: 200 | ram: 16M
  + config
    + vfs
      + fs
  + route
    + service File_system | + child ram_vfs
    + service ROM | label_last: config_request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start configd_persist_probe | caps: 200 | ram: 16M
  + config
    + vfs
      + fs
  + route
    + service File_system | + child ram_vfs
    + service Timer       | + child timer
    + service ROM | label_last: config_result | + child report_rom
    + service ROM | label_last: broadcast     | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }

build_boot_image [build_artifacts]

#
# Harmless on base-linux (core runs natively); required for base-sel4 /
# QEMU to avoid opening a graphical QEMU window.
#
append qemu_args " -nographic -m 1G "

#
# Verification: the probe writes panel.height=64, panel.visible_widgets=clock,
# panel.height=28 in order through the config_request channel, asserts the
# broadcast carries the latest value after each set, and reads back
# store.xml from the same vfs to prove the durable copy carries both the
# most-recent value AND the intermediate value (no clobber). On success it
# logs "configd-persist-probe: PASS". A corrupt store.xml is exercised by
# the sister scenario run/sponge-configd-persist-corrupt.run.
#
run_genode_until {.*configd-persist-probe: PASS.*} 30
