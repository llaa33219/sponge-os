#
# \brief  Sponge OS per-runtime config-authority characterization
# \author Sponge OS contributors
# \date   2026-10-28
#
# Phase 16 runtime-overhaul P1.1 (docs/plans/phase16-runtime-overhaul.md).
#
# Claim under test: a package operation must publish only the config of the
# runtime it dirtied. Today pkgd republishes BOTH configs on every operation:
# an app operation also republishes driver_runtime, and a driver operation
# also republishes the application runtime.
#
# Detector: report_rom's verbose publication log (report_service.h: each
# submission logs `report '<module name>'` plus the content). No ROM-signal
# semantics are involved, so this works even when the content is unchanged.
#
# All gates observe ONE QEMU boot. The two-argument run_genode_until
# respawns QEMU per call, so stacked gates would each re-run the probe
# on a fresh IDENTICAL boot and could never order one operation's
# publications against the next (the observation the claim is made of).
# The first gate spawns the boot; every later gate chains on the same
# spawn ($qemu_spawn_id, the sponge-de-stability idiom). The optional
# defect gates are closed by an explicit landmark — the next operation's
# request line, or the control publication — rather than by a bare
# timeout window, so the FOLLOWING operation's legitimate publication of
# the other runtime can never be misread as the current operation's
# defect.
#
# Sequence and expected verdicts (single boot):
#   startup             runtime + driver_runtime are published once each.
#   install hello       runtime is published (positive control) and the
#                       hello <start> block is present and complete in
#                       it; a driver_runtime publication before the
#                       usb_net request is the app -> driver defect.
#   install usb_net     driver_runtime is published (positive control);
#                       a runtime publication ahead of it is the
#                       driver -> app defect. Because the driver
#                       operation never republishes the app config, the
#                       hello block published above is still the live
#                       app config byte for byte (the untouched block
#                       survives).
#
# With whole-regen emission the scenario reaches
# `config-authority-probe: RED` and exits 1. After dirty-scoped
# emission the two defect gates stop matching and the scenario reaches
# `config-authority-probe: PASS` and exits 0.
#
# Build:
#   make -C genode/build/x86_64 run/sponge-config-authority \
#       KERNEL=sel4 BOARD=pc
#

assert {[have_spec sel4]} \
	"sponge-config-authority requires KERNEL=sel4 (BOARD=pc)."

build { core lib/ld init timer server/report_rom lib/vfs sponge_pkgd \
        pkg_hello test/pkg_lifecycle_probe }

create_boot_directory

#
# Metadata staging: hello is an autostarted app; usb_net is a driver package
# that is not autostarted, so no hardware driver is required for this test.
#
set staged_pkgs { hello usb_net }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src "[run_dir]/genode/pkg_$pkg.xml"
}

set index_fh [open "[run_dir]/genode/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

install_config [subst {
config
+ parent-provides
  + service LOG
  + service PD
  + service CPU
  + service ROM
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default-route
  + any-service
    + parent
    + any-child
+ default | caps: 200 | ram: 8M

+ start timer
  + provides | + service Timer

+ start report_rom | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: yes
    + policy | label: sponge_pkgd -> request         | report: pkg_lifecycle_probe -> request
    + policy | label: pkg_lifecycle_probe -> result  | report: sponge_pkgd -> result
    + policy | label: pkg_lifecycle_probe -> installed | report: sponge_pkgd -> installed
    + policy | label: pkg_lifecycle_probe -> launcher_request | report: sponge_pkgd -> launcher_request
    + policy | label: pkg_lifecycle_probe -> launcher_result | report: sponge_pkgd -> launcher_result
    + policy | label: pkg_runtime -> config          | report: sponge_pkgd -> runtime
    + policy | label: driver_runtime -> config       | report: sponge_pkgd -> driver_runtime

+ start sponge_pkgd | caps: 400 | ram: 32M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 400 | ram: 32M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + any-service
      + parent
      + any-child

+ start driver_runtime | caps: 400 | ram: 32M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_lifecycle_probe | caps: 200 | ram: 16M
  + config | launcher: yes
    + step | op: install | pkg: hello
    + step | op: install | pkg: usb_net
  + route
    + service Timer | + child timer
    + service ROM | label_last: result | + child report_rom
    + service ROM | label_last: installed | + child report_rom
    + service ROM | label_last: launcher_result | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }]

build_boot_image [build_artifacts]

append qemu_args " -nographic -m 1G "

#
# Required gate: a publication must occur or the harness is broken.
# The first call spawns QEMU via the run tool; every later call chains
# on the same boot (a two-argument run_genode_until would respawn).
#
proc gate { pattern timeout_s } {
	global qemu_spawn_id
	if {$qemu_spawn_id eq ""} {
		if {[catch { run_genode_until $pattern $timeout_s } err]} {
			puts "config-authority-probe: FAIL harness ($err)"
			exit 1
		}
		match_max -i $qemu_spawn_id 200000
		return
	}
	match_max -i $qemu_spawn_id 200000
	set timeout $timeout_s
	expect {
		-i $qemu_spawn_id -re $pattern { }
		-i $qemu_spawn_id eof {
			puts "config-authority-probe: FAIL harness (QEMU died)"
			exit 1
		}
		timeout {
			puts "config-authority-probe: FAIL harness (no match for '$pattern' within ${timeout_s}s)"
			exit 1
		}
	}
}

#
# Optional defect gate: return 1 when the spurious publication (pattern)
# is observed before the window's closing landmark (close_pattern), 0
# when the landmark closes the window first. A silent timeout is a FAIL,
# not a clean verdict: both worlds must produce the landmark (the next
# operation's request line, or the control publication), so silence
# means the harness is broken. Written as a direct expect because
# run_genode_until's timeout path calls exit (uncatchable), which would
# kill the scenario instead of recording a clean 0.
#
proc maybe { pattern close_pattern timeout_s } {
	global qemu_spawn_id
	match_max -i $qemu_spawn_id 200000
	set timeout $timeout_s
	expect {
		-i $qemu_spawn_id -re $pattern       { return 1 }
		-i $qemu_spawn_id -re $close_pattern { return 0 }
		-i $qemu_spawn_id eof {
			puts "config-authority-probe: FAIL harness (QEMU died)"
			exit 1
		}
		timeout {
			puts "config-authority-probe: FAIL harness (neither defect nor closing landmark within ${timeout_s}s)"
			exit 1
		}
	}
}

# Startup publications: the detector must see both modules before any op.
# Expect patterns are unanchored substrings; leading/trailing greedy `.*`
# wildcards are unnecessary and unreliable with the verbose serial stream.
gate {report 'sponge_pkgd -> runtime'} 90
gate {report 'sponge_pkgd -> driver_runtime'} 90

# App operation: runtime is the positive control.
gate {report 'sponge_pkgd -> runtime'} 120

# The hello start block is present and complete in the app config the
# app operation published (byte-stability of the untouched block: it is
# published intact, and the driver -> app gate below proves the driver
# operation never republishes - and so never rewrites - it).
gate {<start name="hello"} 60
gate {</start>} 60

# App -> driver defect window, closed by the next operation's request:
# a driver_runtime publication before the usb_net request can only be
# the app operation republishing the driver config.
set app_to_driver [maybe {report 'sponge_pkgd -> driver_runtime'} \
                         {lifecycle-probe: \[2\] install usb_net} 60]

# Driver operation: a runtime publication ahead of the driver_runtime
# control is the driver -> app defect; driver_runtime closing the window
# is the positive control.
set driver_to_app [maybe {report 'sponge_pkgd -> runtime'} \
                         {report 'sponge_pkgd -> driver_runtime'} 120]

# When the defect fired, the positive control must still follow before
# the verdict (the closing landmark above already proved it otherwise).
if {$driver_to_app} {
	gate {report 'sponge_pkgd -> driver_runtime'} 60
}

if {$app_to_driver || $driver_to_app} {
	puts "config-authority-probe: RED (app->driver=$app_to_driver driver->app=$driver_to_app)"
	exit 1
}

puts "config-authority-probe: PASS"
exit 0
