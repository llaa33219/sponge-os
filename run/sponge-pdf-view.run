#
# \brief  Sponge OS pdf_view package scenario (Phase 13 W4, plan D13.3)
# \author Sponge OS contributors
# \date   2026
#
# Verifies pkg/pdf_view end to end in a single headless Genode instance:
# the pdf_view_probe drives sponge_pkgd to install and launch the
# `pdf_view` package (the source-built upstream app/pdf_view, mupdf 0.9
# based), then proves
# (a) the `installed` broadcast lists it (vct list-equivalent),
# (b) the broadcast's `running` attribute transitions no -> yes on
#     launch (lifecycle, docs/12 §9.2.1),
# (c) the mupdf-rendered PDF page actually appears in nitpicker's
#     composited screen — verified by reading pixels through a Capture
#     session. A rendered PDF page is mostly white (R/G/B > 200) with
#     black text on it; the nitpicker background (#1e1e2e) is dark
#     purple. The probe requires white_frac >= 10% AND non_bg_frac >=
#     50% — distinct from the background and clearly distinct from
#     an empty/uninitialized buffer (misleading_success_output class;
#     a bare exit-0 must not pass on a stale frame).
# (d) pkgd's launch error paths return clear statuses
#     (`not-installed', `already-running'), never a crash. The
#     missing-binary / missing-payload failure channels are verified
#     by a scratch scenario (run/sponge-pdf-view-fail.run), which
#     fails by bounded run_genode_until timeout.
#
# Package shape (source-built, no depot import):
#   - pkg/pdf_view/metadata.xml declares <name>pdf_view</name>,
#     <binary>pdf_view</binary> (matches upstream app/pdf_view binary
#     name so no <binary> element is emitted by the runtime-config
#     generator), <quota ram="1G" caps="256"/> (matches upstream
#     run/mupdf.run:81 — mupdf is memory-hungry on first paint,
#     docs/13 §6), <launcher category="Utilities"/>, and one inline
#     <config> child:
#       <libc stdout="/dev/log" stderr="/dev/log"/>
#       <vfs>
#         <dir name="dev"><log/></dir>
#         <rom name="sample.pdf"/>
#       </vfs>
#     The <rom name="sample.pdf"/> MUST match the boot module filename
#     (run/sponge-pdf-view.run stages pkg/pdf_view/payload/sample.pdf
#     as `bin/sample.pdf') — pdf_view's main.cc:239-254 calls
#     scandir("/", ...) on its VFS root, applies the *.pdf filter
#     (main.cc:62-69), and opens the first alphabetical match. A
#     missing or mis-named boot module fails fast with
#     "failed to find a PDF to open" (main.cc:251).
#
#   - pkg/pdf_view/payload/sample.pdf is a minimal valid one-page
#     PDF 1.4 document (632 bytes, "Hello Sponge PDF / Phase 13 W4
#     sample." in Helvetica). The mupdf 0.9 contrib directory at
#     genode/contrib/mupdf-<hash>/src/lib/mupdf/ carries no sample
#     PDF, so the payload is hand-generated (validated by pypdf,
#     `extract_text' returns the expected string).
#
# Build list — libs mirrored verbatim from genode/repos/libports/run/
# mupdf.run:1-4 (the upstream ground truth for the mupdf closure),
# plus the standard init/timer/report_rom/nitpicker/sponge_pkgd/probe
# set every headless package scenario uses.
#
# Topology (kernel-agnostic — base-linux native or base-sel4 QEMU,
# same as run/sponge-textedit.run and run/sponge-files.run; the
# acceptance run uses KERNEL=sel4 BOARD=pc):
#
#   init
#   + timer
#   + report_rom     (relays request/result/runtime/installed)
#   + nitpicker      (Gui/Capture/Event; "edit" domain hosts pdf_view)
#   + sponge_pkgd    (owns pkg_runtime's config via the "runtime"
#                     report; broadcasts the "installed" set)
#   + pkg_runtime    (binary init; config ROM <- report_rom "runtime";
#                     hosts the pdf_view child after launch)
#   + pdf_view_probe (installs+launches pdf_view; pixel-verifies the
#                     rendered page; exercises pkgd error paths)
#
# report_rom policies (full labels include the child-name prefix):
#   sponge_pkgd's ROM "request"      <- pdf_view_probe's "request" report
#   pdf_view_probe's ROM "result"    <- sponge_pkgd's "result" report
#   pdf_view_probe's ROM "installed" <- sponge_pkgd's "installed" report
#   pkg_runtime's ROM "config"       <- sponge_pkgd's "runtime" report
#

build { core lib/ld init timer server/report_rom server/nitpicker \
        sponge_pkgd test/pdf_view_probe \
        app/pdf_view \
        lib/libc lib/libm lib/vfs \
        lib/openjpeg lib/freetype lib/libpng lib/zlib \
        lib/jbig2dec lib/mupdf lib/jpeg }

create_boot_directory

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_pkgd -> request      | report: pdf_view_probe -> request
    + policy | label: pdf_view_probe -> result    | report: sponge_pkgd -> result
    + policy | label: pdf_view_probe -> installed | report: sponge_pkgd -> installed
    + policy | label: pkg_runtime -> config       | report: sponge_pkgd -> runtime

+ start nitpicker | ram: 8M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    #
    # pdf_view opens Gui::Top_level_view at domain origin (0,0) with
    # the default 512x512 size (main.cc:97-99 / _rebuffer). The
    # full-screen edit domain at (0,0) places the rendered page at
    # screen (0,0)-(512,512) — exactly the footprint the probe
    # samples (PV_X=0, PV_Y=0, PV_W=512, PV_H=512 in main.cc).
    #
    + domain edit | layer: 2 | content: client | label: no
                   | hover: always | focus: click
                   | xpos: 0 | ypos: 0 | width: 1024 | height: 768
    + domain default | layer: 3 | content: client | label: no
                      | hover: always | focus: click | ypos: 0 | height: 0
    + default-policy | domain: edit
    + background | color: #1e1e2e

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 1500 | ram: 1536M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + service Gui | + child nitpicker
    + service Input | + child nitpicker
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pdf_view_probe | caps: 200 | ram: 16M
  + route
    + service Capture | + child nitpicker
    + service Timer | + child timer
    + service ROM | label_last: result | + child report_rom
    + service ROM | label_last: installed | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }

#
# Stage the pdf_view package metadata + the derived index (same
# scheme as run/sponge-terminal.run / run/sponge-textedit.run /
# run/sponge-files.run).
#
set staged_pkgs { pdf_view }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src "bin/pkg_$pkg.xml"
}

set index_fh [open "bin/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

#
# Stage the bundled sample.pdf from pkg/pdf_view/payload/ as a boot
# module. The file's name MUST be `sample.pdf' — it is the ROM name
# the metadata <vfs> mounts (<rom name="sample.pdf"/>) AND the
# VFS-relative path pdf_view's scandir("/", ...) discovers and
# opens. Renaming the boot module silently breaks first paint (the
# probe would observe "failed to find a PDF to open" from
# main.cc:251 and the run fails loud by bounded run_genode_until
# timeout).
#
set sample_src "${genode_dir}/../pkg/pdf_view/payload/sample.pdf"
set sample_dst "bin/sample.pdf"
if {![file exists $sample_src]} {
	error "sample PDF not found: $sample_src"
}
exec cp -fL $sample_src $sample_dst

#
# Full boot module list. The mupdf closure (.lib.so files for libc,
# libm, vfs, mupdf, openjpeg, freetype, libpng, jbig2dec, jpeg,
# zlib) AND pdf_view itself come from [build_artifacts], but the
# base-sel4 boot image packs every module it needs at image-build
# time — same defensive pattern as run/sponge-textedit.run:247-260
# — so the mupdf libs + the sample PDF + the staged pkg metadata
# are listed explicitly.
#
set boot_modules [build_artifacts]
foreach m { sample.pdf \
            libc.lib.so libm.lib.so vfs.lib.so \
            openjpeg.lib.so freetype.lib.so libpng.lib.so zlib.lib.so \
            jbig2dec.lib.so mupdf.lib.so jpeg.lib.so \
            pkg_pdf_view.xml pkg_index.xml } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# QEMU: -nographic for headless, -m 3G to cover pkg_runtime's 1.5G
# allocation (pdf_view needs 1G inside) plus the rest of the boot
# stack with margin. Harmless overhead on base-linux; required for
# the seL4 acceptance run.
#
append qemu_args " -nographic -m 3G "

#
# Automated verification (fail-loud, docs/09-roadmap.md §11.1):
# pdf_view_probe logs PASS once it has installed+launched pdf_view
# via sponge_pkgd AND pixel-verified the rendered PDF page AND
# exercised the pkgd error paths. On timeout (probe did not reach
# PASS — e.g. mupdf failed to build, sample.pdf missing,
# pdf_view VFS could not find the PDF, or first paint stalled) the
# run tool errors out — never a silent hang. The generous timeout
# covers mupdf's first paint (font cache + initial render under
# softpipe Mesa on seL4 can take 60-180s; faster on linux).
# Bounded per the hung_or_long_commands adversarial class.
#
run_genode_until {.*pdf-view-probe: PASS.*} 420
