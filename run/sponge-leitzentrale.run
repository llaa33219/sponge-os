#
# \brief  Sponge OS Leitzentrale visibility scenario (Phase 6b)
# \author Sponge OS contributors
# \date   2026
#
# Builds on the Phase 6a headless boot: the Leitzentrale subsystem
# (sculpt_manager + its private GUI stack) is always booted inside
# lz_runtime. Phase 6b makes the window VISIBLE and verifies the
# `vct leitzentrale` command end-to-end:
#
#   vct leitzentrale  -->  sponge_configd (leitzentrale.enabled=true)
#                  -->  lz_bridge (rom_filter) regenerates leitzentrale_enabled
#                  -->  subsystem fader_config reads enabled=yes
#                  -->  gui_fader fades alpha 0 -> 210 (window appears)
#                  -->  lz_viz_probe (Capture pixel check) confirms it on screen
#
# Topology:
#
#   init
#   + timer
#   + report_rom        (configd channel + broadcast relay + nitpicker focus/hover)
#   + nitpicker         (outer compositor; default domain hosts the subsystem's
#                        proxied Gui views; lz_viz_probe defines the panorama)
#   + sponge_configd    (owns leitzentrale.enabled, default false)
#   + lz_bridge         (rom_filter: configd broadcast -> leitzentrale_enabled ROM)
#   + lz_runtime        (nested init from 6a; subsystem reads leitzentrale_enabled
#                        from lz_bridge now instead of the static module)
#     + lz_relay / leitzentrale / lz_probe   (6a, unchanged)
#   + vct               (runs "vct leitzentrale" — sets the configd key, exits)
#   + lz_viz_probe      (Capture pixel check — logs lz-viz-probe: PASS)
#
# Lifecycle: boot-present, visibility toggled. The subsystem is always
# running; vct only flips the flag, which persists via configd + lz_bridge.
# Disabled-by-default still boots cleanly (configd default=false ->
# lz_bridge emits enabled=no -> fader alpha 0); vct raising it is what
# makes the window appear here.
#

build { core lib/ld init timer \
        server/report_rom server/nitpicker server/rom_filter \
        server/wm app/themed_decorator app/backdrop \
        server/gui_fb server/gui_fader \
        server/fs_report server/fs_rom server/vfs \
        app/sculpt_manager app/menu_view \
        lib/vfs lib/vfs_ttf lib/vfs_import lib/libc lib/libm lib/libpng lib/zlib lib/posix \
        sponge_configd vct \
        test/lz_probe test/lz_viz_probe test/lz_viewer }

create_boot_directory

#
# Assemble the model fs seed (model.tar) from Sculpt ingredients.
# READ-ONLY access to genode/repos/gems/sculpt/ — no vendored-tree edits
# (AGENTS.md §5.2). The subsystem config itself (child/leitzentrale) is
# the Sponge-authored repos/sponge/src/leitzentrale/subsys.config.
#
set model_stage "[run_dir]/model-staging"
file mkdir "$model_stage/child"
file mkdir "$model_stage/depot"

set sculpt_dir "${genode_dir}/repos/gems/sculpt"

foreach cfg {deploy system manager fb runtime} {
    exec cp -L "$sculpt_dir/$cfg/default" "$model_stage/$cfg"
}

foreach cfg {wifi event_filter font gui clipboard log_view network \
             numlock_remap global_keys runtime_view usb ram_fs report model} {
    exec cp -L "$sculpt_dir/$cfg/default" "$model_stage/child/$cfg"
}

# Sponge-authored subsystem config replaces sculpt/leitzentrale/default.
exec cp -L "${genode_dir}/repos/sponge/src/leitzentrale/subsys.config" \
           "$model_stage/child/leitzentrale"

# Minimal depot/version seed (sculpt_manager reads model -> depot/version).
set dv [open "$model_stage/depot/version" w]
puts $dv {depot | version: 0}
close $dv

exec tar -cf "[run_dir]/genode/model.tar" -C "$model_stage" .
file delete -force "$model_stage"

#
# Stage assets the subsystem pulls from ROM modules.
#

# Fonts: Vera.ttf / VeraMono.ttf from the prepared ttf-bitstream-vera port.
set vera_dir [lindex [glob -nocomplain \
    "${genode_dir}/contrib/ttf-bitstream-vera-*/ttf/bitstream-vera"] 0]
if {$vera_dir eq ""} {
    error "ttf-bitstream-vera port not prepared; run: ./genode/tool/ports/prepare_port ttf-bitstream-vera"
}
exec cp -L "$vera_dir/Vera.ttf"     "[run_dir]/genode/Vera.ttf"
exec cp -L "$vera_dir/VeraMono.ttf" "[run_dir]/genode/VeraMono.ttf"

# Images referenced by the subsystem (decorator drop shadow, backdrop logo).
exec cp -L "$sculpt_dir/../run/sculpt/drop_shadow.png" \
           "[run_dir]/genode/drop_shadow.png"
exec cp -L "$sculpt_dir/../src/app/backdrop/genode_logo.png" \
           "[run_dir]/genode/genode_logo.png"

# Static runtime_config ROM: empty runtime (nothing deployed yet).
set rc [open "[run_dir]/genode/runtime_config" w]
puts $rc {config}
close $rc

# NOTE: leitzentrale_enabled is NO LONGER a static module. Phase 6b drives
# it from sponge_configd via the lz_bridge rom_filter (see topology), so
# `vct leitzentrale` can toggle it and the change persists. The subsystem
# routes its leitzentrale_enabled ROM to lz_bridge (top-level config below).

# VERSION ROM module read by sculpt_manager (Sculpt_version). Mirrors
# genode/repos/gems/run/sculpt.run line 488-493.
set ver [open "[run_dir]/genode/VERSION" w]
puts $ver "26.05"
close $ver

# build_info ROM read by sculpt_manager (Build_info). Sculpt stages this
# from its build metadata (sculpt.run line 516-525); we provide a static
# equivalent. board="pc" enables the reset feature; the other fields are
# informational (depot/arch are unused without a depot).
set bi [open "[run_dir]/genode/build_info" w]
puts $bi {build_info | genode_version: 26.05 | date: 2026-07-25 | depot_user: sponge | arch: x86_64 | board: pc
-}
close $bi

# lz_runtime's config (Sponge-authored, kept out of the top-level inline
# config to avoid deep HID nesting).
exec cp -L "${genode_dir}/repos/sponge/src/leitzentrale/lz_runtime.config" \
           "[run_dir]/genode/lz_runtime.config"

# leitzentrale subsystem config (also Sponge-authored; staged as a module
# and routed explicitly to avoid the leitzentrale child's "config" ROM
# falling through to the top-level config, which would recurse).
exec cp -L "${genode_dir}/repos/sponge/src/leitzentrale/subsys.config" \
           "[run_dir]/genode/leitzentrale.config"

# lz_bridge config (rom_filter that turns configd's broadcast into the
# leitzentrale_enabled ROM).
exec cp -L "${genode_dir}/repos/sponge/src/leitzentrale/lz_bridge.config" \
           "[run_dir]/genode/lz_bridge.config"

#
# Top-level init configuration.
#
install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_configd -> config_request | report: vct -> config_request
    + policy | label: vct -> config_result             | report: sponge_configd -> config_result
    + policy | label_suffix: lz_config            | report: sponge_configd -> config
    + policy | label_suffix: focus                      | report: nitpicker -> focus
    + policy | label_suffix: hover                      | report: nitpicker -> hover

+ start nitpicker | ram: 16M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer  | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    + report | focus: yes | hover: yes
    + domain default | layer: 1 | content: client | label: no
                     | hover: always | focus: click
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start sponge_configd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: config_request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start lz_bridge | ram: 4M
  + binary rom_filter
  + provides | + service ROM
  + route
    + service ROM | label: config | + parent | label: lz_bridge.config
    + service ROM | label_last: lz_config | + child report_rom
    + any-service
      + parent
      + any-child

+ start lz_runtime | caps: 8000 | ram: 1G | managing_system: yes
  + binary init
  + route
    + service ROM | label: config | + parent | label: lz_runtime.config
    + service Timer               | + child timer
    + service Gui                | + child nitpicker
    + service ROM | label_suffix: leitzentrale_enabled | + child lz_bridge
    + service ROM | label_suffix: focus | + child report_rom
    + service ROM | label_suffix: hover | + child report_rom
    + any-service                | + parent

+ start vct | caps: 200 | ram: 8M
  + config
    + args
      + arg leitzentrale
  + route
    + service Timer | + child timer
    + service ROM | label_last: config_result | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start lz_viz_probe | caps: 100 | ram: 16M
  + route
    + service Capture | + child nitpicker
    + service Timer   | + child timer
    + any-service
      + parent
      + any-child
- }

build_boot_image [build_artifacts]

append qemu_args " -nographic "

#
# Automated verification (Phase 6b):
#   1. lz_probe (inside lz_runtime) confirms sculpt_manager is alive (6a).
#   2. vct leitzentrale writes leitzentrale.enabled=true (audit log line).
#   3. lz_viz_probe confirms the window is actually on screen (Capture).
# The final gate is lz-viz-probe: PASS. On timeout (window never became
# visible, or vct failed to set the key) the run tool errors out — the
# correct FAIL path.
#
run_genode_until {.*lz-viz-probe: PASS.*} 180
