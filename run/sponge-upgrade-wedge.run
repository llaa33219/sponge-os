#
# \brief  A quota upgrade that is never answered must not park the
#         sandbox's entrypoint
# \author Sponge OS contributors
# \date   2026
#
# THE FIELD FAILURE THIS ATTACKS
#
#   2026-10-19, LG gram 17ZD90N: a fast scrollbar drag in the SPONGE
#   DEBUG window freezes the whole system. The mouse dies, the panel
#   health label reads "sponge_pkgd unresponsive(N)", and the freeze
#   NEVER heals - which rules out saturation and establishes that a
#   thread is blocked.
#
#   The blocked thread is a sandbox init's ENTRYPOINT, and the protocol
#   that blocks it is the quota upgrade:
#
#     victim --Parent::upgrade--> sandbox init --nested upgrade-->
#             top init --PENDING--> provider (never answers)
#
#   'Parent::Upgrade_result::PENDING' is not a promise - it means "the
#   request has been taken, the session's provider has not acted on it
#   yet". A provider that is stuck (the field's file-system server on a
#   stalled USB stick) never answers, and the sandbox init - whose
#   entrypoint serves every child's session plumbing AND the
#   containment alarm - waits for it forever. The whole container dies
#   silently, and the alarm that would have noticed is parked with it.
#
# WHAT IS MEASURED HERE
#
#   The provider is a component that never answers a quota upgrade (the
#   field's stuck file-system server, made deterministic). The victim
#   asks for an upgrade on a session to that provider. The witness
#   opens a session once per second and logs each round - a session
#   request goes through the sandbox's entrypoint, so the witness stops
#   talking exactly when the container is wedged.
#
#   RED   (unpatched base): the sandbox's entrypoint parks; the witness
#         stops; the gate never matches; the run times out -> exit 2.
#   GREEN (patched base): the container's entrypoint keeps serving, the
#         never-answered upgrade fails LOUDLY at the deadline, the
#         victim's request returns, the witness keeps its rounds, the
#         gate matches -> exit 0.
#
#   A container that releases the victim WITHOUT the loud failure is a
#   SPURIOUS SUCCESS and fails this run (exit 1).
#
# TOPOLOGY
#
#   init                                     THE TOP-LEVEL INIT
#   + timer                                  the only Timer source
#   + report_rom                             serves the 'system' state report
#   + upgrade_wedge            role: provider  the stuck server
#   + system                    init          THE CONTAINER UNDER TEST
#     + upgrade_wedge           role: witness  the liveness oracle
#     + upgrade_wedge           role: victim   the upgrade request
#
#   The victim reaches 'Test_service' through the default route, so its
#   session is parent-routed: the 'system' init forwards the upgrade to
#   the top init, which forwards it to the provider. That is the
#   product's shape - the vfs lives in the top-level sandbox, the
#   clients live in 'system' - and the nesting is not simulated, it is
#   the default route.
#

assert {[have_spec sel4]} \
	"sponge-upgrade-wedge requires KERNEL=sel4 (BOARD=pc)."

build { core lib/ld init timer test/upgrade_wedge }

create_boot_directory

install_config [subst {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer | caps: 100 | ram: 1M
  + provides | + service Timer

+ start upgrade_wedge | caps: 100 | ram: 4M
  + binary | name: upgrade_wedge
  + config | role: 0
  + provides | + service Test_service

+ start system | caps: 1000 | ram: 24M
  + binary init
  + config
    + parent-provides
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Test_service
      + service IRQ
      + service IO_MEM
      + service IO_PORT
    + default | caps: 200 | ram: 4M
    + default-route
      + any-service
        + parent
        + any-child
    + start witness | caps: 100 | ram: 4M
      + binary | name: upgrade_wedge
      + config | role: 2
    + start victim | caps: 200 | ram: 4M
      + binary | name: upgrade_wedge
      + config | role: 1
  + route
    + service PD           | + parent
    + service CPU          | + parent
    + service LOG          | + parent
    + service ROM          | + parent
    + service Timer        | + any-child
    + service Test_service | + any-child
- }]

build_boot_image [build_artifacts]

append qemu_args " -nographic -m 512M "

#
# GATES
#
#   Gate 1 boots the guest.
#   Gate 2 is the victim's line: the session to the provider was
#   established and the upgrade was requested. The line appears in both
#   states - in the wedged state the container wedges exactly here.
#
#   The VERDICT is then read out of the captured serial log. The
#   container is ALIVE if and only if ALL of the following are in the
#   log:
#
#     (a) the provider received the quota-upgrade request
#     (b) the container reported the failure LOUDLY - the provider never
#         answered within the deadline
#     (c) the victim's upgrade request returned
#     (d) the witness kept its rounds (round 3)
#
#   (b) is what makes the gate more than a liveness check: a container
#   that answers the client while the provider is still stuck has
#   released the client WITHOUT reporting the failure. That signature -
#   (c) present, (b) absent - is a SPURIOUS SUCCESS and fails the run.
#
#   The witness's last marker is printed as well: it localises a stall
#   for free (sleeping, probing, or already done).
#
global qemu_spawn_id

run_genode_until {.*Genode [0-9].*} 120

set uw_log [run_dir]/upgrade-wedge.log
match_max -i $qemu_spawn_id 500000
log_file -a $uw_log

run_genode_until {.*victim: session to Test_service established.*} 60 $qemu_spawn_id

#   The observation window must KEEP DRAINING the serial console. A plain
#   'sleep' stops the run tool from reading the console, and the guest then
#   stalls on its own console output (the seL4 kernel writes the console
#   polled) - the capture ends mid-line and every marker that follows the
#   first match is lost. 'expect' keeps the console flowing while the
#   container is observed.
#
#   The window ends with the witness's round 4, i.e. strictly AFTER the
#   never-answered upgrade ran into its deadline (5 s) and after round 3 -
#   the two markers the verdict is read from. A container that is wedged
#   never reaches round 4: the wait times out, the verdict is read from
#   the log that was captured up to that point, and the run fails.
set timeout 90
expect {
	-i $qemu_spawn_id -re {.*witness: round 4 ok.*} { }
	timeout { }
}
log_file

set fh [open $uw_log r]
set uw_out [read $fh]
close $fh

# the last witness marker - it localises a stall for free
set last_marker "none"
foreach line [split $uw_out "\n"] {
	if {[string match "*witness: round*" $line]} { set last_marker $line }
}

set has_provider [regexp -- {provider: quota-upgrade request received} $uw_out]
set has_loud     [regexp -- {\[init -> system\].*RAM upgrade of Test_service \(session [0-9]+\) failed - the provider did not answer} $uw_out]
set has_returned [regexp -- {victim: quota upgrade returned} $uw_out]
set has_round3   [regexp -- {witness: round 3 ok} $uw_out]

set verdict "WEDGED"
set ok 0

if {$has_provider && $has_loud && $has_returned && $has_round3} {
	set verdict "ALIVE"
	set ok 1
}

# the spurious-success signature: the client was released but the
# container never reported the failure
if {$has_returned && !$has_loud} {
	set verdict "SPURIOUS-SUCCESS"
	set ok 0
}

puts ""
puts "  ================================================================"
puts "  upgrade-wedge: container verdict = $verdict"
puts "    provider request   : [expr {$has_provider  ? {yes} : {no}}]"
puts "    loud failure       : [expr {$has_loud      ? {yes} : {no}}]"
puts "    upgrade returned   : [expr {$has_returned  ? {yes} : {no}}]"
puts "    witness round 3    : [expr {$has_round3    ? {yes} : {no}}]"
puts "    last witness marker: $last_marker"
puts "    serial log         : $uw_log"
puts "  ================================================================"

if {!$ok} {
	puts "upgrade-wedge: FAIL ($verdict)"
	exit 1
}

puts "upgrade-wedge: PASS (the container is alive and the never-answered quota upgrade failed loudly)"
