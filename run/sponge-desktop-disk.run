#
# \brief  Sponge OS Phase 8 P2 — desktop from disk
#         (bake-driven staging, Phase 15 W2, D15.3/D15.4/D15.8).
# \author Sponge OS contributors
# \date   2026
#
# Boots the FULL Alpha desktop from the GENODE partition's /system
# directory. Tier 0 (image.elf) contains ONLY the boot+storage chain
# plus display/input drivers and nitpicker. Everything else — wm,
# decorator, sponge_configd, sponge_themed, sponge_pkgd, sponge-de,
# Qt6/Mesa libs, themes — is served from /system via cached_fs_rom.
#
# Architecture (docs/14-boot-storage-architecture.md §4.4–§4.7):
#
#   GRUB → bender → seL4 (image.elf = Tier 0 only)
#     └─ init (Tier 0)
#         ├─ timer, report_rom
#         ├─ platform/acpi/pci_decode
#         ├─ ahci (Block)
#         ├─ part_block → Block/P3 (partition pinned BY NUMBER)
#         ├─ vfs (Vfs_block + <rump fs="ext2fs"/>) → File_system
#         ├─ rom_sys: cached_fs_rom(chroot /system)        → ROM
#         ├─ rom_lib: cached_fs_rom(chroot /system/lib)    → ROM (.lib.so only)
#         ├─ nitpicker  (the compositor server — a component, not a driver)
#         ├─ drivers (sub-init: ps2/usb_hid/event_filter)
#         └─ system (nested init from disk)
#             ├─ binary "init" from rom_sys at /system/bin/init
#             ├─ config from rom_sys at /system/init/system.config
#             ├─ ROM label_last="ld.lib.so" → parent (§4.6)
#             ├─ driver_runtime: the fb_vesa PACKAGE (vesa_fb) lives
#             │  here, started by sponge_pkgd from the baked first-boot
#             │  manifest — see "Display driver as a package" below
#             └─ hosts: report_rom, wm, window_layouter, decorator,
#                       sponge_configd, sponge_themed, sponge_pkgd,
#                       pkg_runtime_simple, pkg_runtime_terminal,
#                       pkg_runtime_browser, sponge-de, alpha_probe
#                  (ALL binaries+libs served from /system via rom_sys/rom_lib)
#
# === Display driver as a package (docs/17 §1) ===
#
# There is no `+ start fb` node in Tier 0 any more. The framebuffer
# driver is the `fb_vesa` package (pkg/fb_vesa/metadata.xml, BIOS /
# INT 10h path), and `driver_runtime::fb_package fb_vesa` above seeds it
# into the bake manifest so the FIRST boot of a freshly installed
# medium already has a display: pkgd's first-boot seeding installs it,
# its <autostart/> puts it into driver_runtime's generated config, and
# init starts it there. `vct remove fb_vesa` / `vct install fb_boot`
# is the runtime switch (docs/15 §8.2); the PCI VGA grant in the
# Tier-0 platform policy is a per-package label prefix declared by
# run/driver_runtime.inc.
#
# Honest consequence, accepted by the user: the display now depends on
# the storage chain being alive. A dead AHCI/NVMe chain means no
# image.elf siblings either, so this is not a new coupling — but the
# second-order case is: a chain that boots and then fails to serve
# /system/pkg_fb_vesa.xml leaves a running system with no display and no
# on-screen diagnostic. The FBCON diagnostic media is the answer for
# that (docs/13-installation.md, known limitations).
#
# === Tier-0 roster (docs/14 §4.5) ===
#
# In Tier 0: kernel/core/init/ld.lib.so, timer/report_rom,
# platform/acpi/pci_decode, ahci/part_block, vfs+vfs_rump+libc deps,
# cached_fs_rom (×2), nitpicker, ps2/usb_hid/event_filter, their config
# files, and the Tier-0 init config.
#
# Input drivers in Tier 0 — justification against §4.5:
#   The input drivers (ps2/usb_hid/event_filter) are NOT strictly
#   rescue-display, but:
#     (a) they are boot-critical — without them the desktop renders but
#         cannot accept input, which is useless for verification;
#     (b) they are small (~3 MiB total) — the §4.5 target is ≤80 MiB;
#     (c) serving them from disk would require routing Platform/Dma/IRQ
#         sessions through the nested init to the Tier-0 platform
#         driver, adding complexity for minimal Tier-0 savings.
#   The §4.5 rule's intent — keep LARGE payloads (Qt6/Mesa/sponge-de)
#   off the boot chain — is fully satisfied. Total Tier-0 is ~15 MiB.
#
# rescue-minimal nitpicker: skipped for P2 (noted as P5 work, §4.7).
# The current nitpicker in Tier 0 IS the full nitpicker; a dedicated
# rescue display with a console logger is future work. Note that with the
# fb driver gone from Tier 0 there is no longer even a Tier-0-resident
# display producer, so this line of work now also covers "a display when
# the packaged driver cannot start" rather than only "a display while
# the desktop is down".
#
# === ld.lib.so rule (docs/14 §4.6) ===
#
# ld.lib.so is a Tier-0 boot module ONLY. It is NOT in /system/lib/.
# Every dynamically linked child carries:
#   <service ROM label_last="ld.lib.so"> <parent/> </service>
# This cascades: child → system init → Tier-0 init → core ROM.
#
# === Verification ===
#
# alpha-probe (with skip_lz=yes) asserts three criteria:
#   (a) themed panel pixel rendered on nitpicker
#   (b) launcher report carries hello/Utilities
#       (with the bake-driven default profile enabled, the launcher
#        also carries terminal/textedit/files/calculator/pdf_view/falkon
#        — install-enabled on the staged media; alpha-probe only
#        asserts hello is present, so the additional installs do not
#        change the gate.)
#   (c) configd broadcast ROM is live
# Criterion (d) lz_viewer is deferred to P5.
# The run gates on "alpha-probe: PASS" with a bounded timeout.
#
# The image.elf size is printed and asserted ≤ 80 MiB (§4.5 target).
#
# === Bake profile (Phase 15 W2, D15.3/D15.4/D15.8/R15.3) ===
#
# Package staging is profile-driven via run/bake.inc (sourced below,
# after the plugin-load helpers). For .img media the mode is FULL bake:
# pkg_<name>.xml + the synthesized pkg_index.xml + every payload file
# under pkg/<name>/payload/ is copied to /system before image/disk
# auto-e2cps the run_dir.
#
# Env override:
#   SPONGE_BAKE_PROFILE  default: desktop
#                        valid:   minimal, desktop, none
#                        other:   loud error (lists valid profiles)
#
# Run matrix (W2a evidence):
#   SPONGE_BAKE_PROFILE=desktop (default) => alpha-probe: PASS
#   SPONGE_BAKE_PROFILE=minimal           => alpha-probe: PASS
#   SPONGE_BAKE_PROFILE=none               => alpha-probe: PASS (regression)
#   SPONGE_BAKE_PROFILE=invalid            => loud error, no .img
#
# === Failure channel ===
#
# SPONGE_DISK_FAIL=1 in the environment stages a corrupted
# /system/init/system.config (invalid XML). The nested init fails to
# parse it, logs an error, and the bounded run_genode_until timeout
# catches it — no silent hang. The run gates on the init parse-error
# marker for a bounded, identified failure.
#
# base-sel4 only.
#
# Build:
#   make -C genode/build/x86_64 run/sponge-desktop-disk \
#       KERNEL=sel4 BOARD=pc RUN_OPT="--include image/disk"
#

assert {[have_spec sel4]} \
	"sponge-desktop-disk requires KERNEL=sel4 (BOARD=pc)."

##
# Ensure essential run-framework plugins are loaded (same rationale as
# sponge-alpha.run: RUN_OPT override on the make command line discards
# build.conf's accumulated --include lines).
#
proc ensure_plugin_loaded { name } {
	if {![have_include $name]} {
		set path [genode_dir]/tool/run/$name
		puts "sourcing $path (missing from RUN_OPT, restored by run script)"
		source $path
		global include_list
		lappend include_list $name
	}
}

ensure_plugin_loaded boot_dir/sel4
ensure_plugin_loaded power_on/qemu
ensure_plugin_loaded log/qemu
ensure_plugin_loaded image/disk

#
# This scenario MUST boot the disk image, but the build.conf template's
# QEMU_RUN_OPT pulls in image/iso by default, and when both image modes
# are included the ISO wins the QEMU command line (the guest then finds
# no AHCI device: part_block's Block session is denied). Drop image/iso
# from the include list so the disk image is the only boot medium.
#
global include_list
set iso_idx [lsearch -exact $include_list "image/iso"]
if {$iso_idx >= 0} { set include_list [lreplace $include_list $iso_idx $iso_idx] }

#
# Top-level supervision (docs/17 §5, "Broker fault containment - top
# level"). run/supervisor.inc carries the shared wiring: it derives the
# supervisor's config templates from the desktop config staged below,
# hands the top-level report_rom the two relay policies, moves the
# `system` sandbox's config ROM from rom_sys to the relay, adds the
# console's nitpicker domain, and starts the supervisor + console before
# the sandbox. The templates are DERIVED, never authored twice, so this
# file stays the single source of truth for the desktop composition.
#
source [file join [file dirname [file normalize [info script]]] \
                    supervisor.inc]

# Driver packages (docs/12 §4.5). run/driver_runtime.inc is the single
# source of truth for the driver_runtime sandbox: the HID fragments it
# emits, the quota arithmetic, and the staging of the driver binaries and
# metadata onto /system. Sourced here so this scenario and its four
# uefi/nvme/usb variants cannot drift apart.
source [file join [file dirname [file normalize [info script]]] \
                    driver_runtime.inc]

# Per-runtime-class targets (Phase 16 P2.2/P2.4). run/runtime-simple.inc,
# run/runtime-terminal.inc and run/runtime-browser.inc own the class
# package maps, build targets, staging steps and the falkon/WebEngine
# exclusion list; run/runtime-quota.inc derives and drift-checks the
# three per-class grant pairs; run/runtime-grouped.inc owns the grouped
# config wiring (report_rom relays, pkgd markers/routes) and the
# structural assertions. Sourced alongside the shared includes so the
# build block, the staging steps and the quota literals below cannot
# drift apart. (runtime-terminal.inc sources run/terminal_runtime.inc
# for the shared VeraMono producer; stage_vera_metadata is NOT called
# here, so the product's package set is unchanged.)
source [file join [file dirname [file normalize [info script]]] \
                    runtime-simple.inc]
source [file join [file dirname [file normalize [info script]]] \
                    runtime-terminal.inc]
source [file join [file dirname [file normalize [info script]]] \
                    runtime-browser.inc]
source [file join [file dirname [file normalize [info script]]] \
                    runtime-quota.inc]
source [file join [file dirname [file normalize [info script]]] \
                    runtime-grouped.inc]
#
# Per-child heartbeat gate values (P3.4). Exposed so each
# child's sandbox containment gates can be tuned individually;
# the values below are the product defaults and render byte-
# identical to the previous inline literals.
#
supervisor::heartbeat_values {
	wm                    { 3 3 120000}
	layouter              { 3 3 120000}
	decorator             { 3 3 120000}
	sponge_configd        { 3 3 120000}
	sponge_themed         { 3 3 120000}
	sponge_pkgd           { 3 3 120000}
	sponge-de             { 3 3 120000}
	pkg_runtime_simple    { 3 3 120000}
	pkg_runtime_terminal  { 3 3 120000}
	pkg_runtime_browser   { 3 3 120000}
}

# Failure-channel selector: SPONGE_DISK_FAIL=1 corrupts system.config.
#
set fail_mode [expr {[info exists ::env(SPONGE_DISK_FAIL)] && $::env(SPONGE_DISK_FAIL) == "1"}]
if {$fail_mode} {
	puts "sponge-desktop-disk: FAILURE CHANNEL (corrupted system.config)"
}

#
# The SPONGE_DISK_FAIL failure channel runs WITHOUT the supervisor: its
# whole subject is "the nested init rejects a corrupted config", a
# diagnostic that predates the supervisor, and wiring it in would make two
# different failures indistinguishable in one log.
#
if {$fail_mode} { supervisor::enabled 0 }

set sup_mode [supervisor::test_mode]

# SPONGE_FB_SWITCH=on adds the runtime framebuffer-driver switch proof
# (test/fb_switch_probe) to the product topology. Off by default: the
# shipped media carries no probe.
set fb_switch 0
if {[info exists ::env(SPONGE_FB_SWITCH)] && $::env(SPONGE_FB_SWITCH) eq "on"} {
	set fb_switch 1
}

# SPONGE_GROUPED_UI=on adds the P2.4 D16R.11 grouped-runtime UI
# acceptance probe (test/grouped_ui_probe) to the product topology:
# real QMP mouse/keyboard through the Sponge DE launcher proves
# simple-class, terminal-class and browser-class (P2.6 falkon) first
# paint + typed-input delta on the grouped runtimes.
# Off by default: the shipped media carries no probe and no QMP
# socket.
set grouped_ui 0
if {[info exists ::env(SPONGE_GROUPED_UI)] && $::env(SPONGE_GROUPED_UI) eq "on"} {
	set grouped_ui 1
}

# SPONGE_APP_ISOLATION=on adds the P5.1 app-isolation acceptance arm
# (test/app_isolation_probe) to the product topology: real QMP input
# through the Sponge DE launcher kills one app via the decorator closer
# and wedges another via the ep_wedge package, while the DE and the
# sibling app are proven still functional (kill + wedge + relaunch
# legs). The arm also stages the focused `isolation` bake profile and
# injects the ep_wedge fixture package (see the bake block below).
# Off by default: the shipped media carries no probe, no fixture
# package and no QMP socket.
set app_isolation 0
if {[info exists ::env(SPONGE_APP_ISOLATION)] && $::env(SPONGE_APP_ISOLATION) eq "on"} {
	set app_isolation 1
}

# report_rom is single-writer per label: SPONGE_FB_SWITCH,
# SPONGE_GROUPED_UI and SPONGE_APP_ISOLATION all claim pkgd's
# `probe_request`/`probe_result` channel (and all add `+ probe_request`
# to pkgd's config); the QMP-TARGET dispatch stream is single-consumer
# too. Exactly one arm may run per boot - fail loud instead of
# corrupting the relay.
set claimed_arms {}
foreach {flag name} [list $fb_switch fb_switch $grouped_ui grouped_ui \
                          $app_isolation app_isolation] {
	if {$flag} { lappend claimed_arms $name }
}
if {[llength $claimed_arms] > 1} {
	error "sponge-desktop-disk: [join $claimed_arms { and }] each claim \
pkgd's probe_request channel (report_rom single-writer per label) - run \
one arm at a time"
}
# The supervisor fault arm stages its own ep_wedge fault child and gates
# the same `ep_wedge: wedge fired` marker; it cannot coexist with the
# app-isolation wedge leg.
if {$app_isolation && $sup_mode ne "off"} {
	error "sponge-desktop-disk: SPONGE_APP_ISOLATION and \
SPONGE_SUPERVISOR_TEST both stage ep_wedge fault children - run one at \
a time"
}
if {$sup_mode ne "off"} {
	puts "sponge-desktop-disk: supervisor fault-injection ARM '$sup_mode'"
}

#
# Build — Tier-0 chain + desktop components. The desktop components are
# built normally; they are copied to /system/bin on disk (not into
# image.elf). The build list matches sponge-alpha.run minus the lz
# subsystem (P5 work).
#
set build_components {
	core lib/ld init timer
	server/report_rom server/nitpicker
	driver/platform driver/acpi app/pci_decode
	driver/framebuffer/vesa driver/framebuffer/boot driver/ps2
	driver/usb_host/pc driver/usb_hid server/event_filter
	server/part_block server/vfs server/cached_fs_rom
	lib/vfs lib/vfs_rump lib/rump lib/rump_fs
	server/wm app/window_layouter app/decorator app/pointer
	sponge_configd sponge_themed sponge_pkgd sponge-de
	cfg_probe sponge_supervisor sponge_console
	test/alpha_probe
	qt6/base lib/libc lib/libm lib/stdcxx lib/mesa
	lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat
	lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter
	lib/zlib lib/libpng lib/blit lib/vfs_ttf lib/vfs_import lib/posix
	lib/ncurses lib/pcre
	lib/openjpeg lib/freetype lib/jbig2dec lib/mupdf lib/jpeg
	driver/ahci
	server/nic_router driver/nic/pc driver/usb_net driver/wifi \
	driver/gpu/intel driver/framebuffer/intel/pc/spec/x86_64
	driver/nic server/nic_uplink driver/rtc/spec/x86 server/system_rtc
}
# The last four build targets above are the P2.6 falkon-startup
# network/RTC stack (see the Tier-0 nodes): dde_ipxe e1000 driver +
# the Uplink<->Nic bridge + the gems system_clock pair. `driver/nic`
# resolves to TARGET=ipxe_nic. No comments may live INSIDE the build
# brace above — the braced words become make goals verbatim.
#
# Per-runtime-class build targets (Phase 16 P2.2): the simple-class
# package targets and the terminal toolset closure are composed from
# the class includes (run/runtime-simple.inc, run/runtime-terminal.inc)
# instead of being spelled out above. The Tier-0 and lib-tail entries
# above stay literal — server/vfs, server/cached_fs_rom and several
# libs serve the storage chain and Qt regardless of class — so a
# shared target can appear twice in the goal list (the literal already
# repeats lib/vfs today); `make` treats duplicate goals as one.
# Browser stays exclusion-only (run/runtime-browser.inc) — falkon is
# not built here (P2.6 stages its payload).
#
lappend build_components {*}[runtime_simple::build_targets]
lappend build_components {*}[runtime_terminal::build_targets]

build $build_components

#
# Fault-injection gate (docs/17 §5, top-level supervision). OFF by
# default: shipped media carries the supervisor and the console, never a
# fault child. With SPONGE_SUPERVISOR_TEST the scenario also stages a
# wedging child inside the supervised sandbox and a Capture-side pixel
# oracle, and gates the whole detect -> kill -> console -> recover chain
# in the PRODUCT topology (the lean proof is
# run/sponge-supervisor-takeover.run).
#
if {$sup_mode ne "off"} {
	build { test/ep_wedge test/takeover_probe }
}

#
# The framebuffer-switch probe (SPONGE_FB_SWITCH) is built HERE, next to
# the supervisor test arm and not in the wiring block further down: the
# `desktop binaries -> /system/bin/` staging loop runs before the
# system.config is generated, so a binary built later never reaches the
# disk image and init reports "binary is not an ELF".
#
if {$fb_switch} {
	build { test/fb_switch_probe }
	# The probe exits cleanly when it is done; a clean exit must not be
	# read by the supervisor as a fault (it would tear the desktop down
	# after a PASS).
	supervisor::ignore_exited fb_switch_probe
}

#
# The grouped-UI probe (SPONGE_GROUPED_UI) is built HERE for the same
# reason as the switch probe: the /system/bin staging loop runs below,
# so a binary built later never reaches the disk image.
#
if {$grouped_ui} {
	build { test/grouped_ui_probe }
	supervisor::ignore_exited grouped_ui_probe
}

#
# The app-isolation probe (SPONGE_APP_ISOLATION) plus its ep_wedge
# fixture binary are built HERE for the same reason as the probes
# above: the /system/bin staging loop runs below, so a binary built
# later never reaches the disk image.
#
if {$app_isolation} {
	build { test/app_isolation_probe test/ep_wedge }
	supervisor::ignore_exited app_isolation_probe
}

create_boot_directory

#
# On base-sel4 every boot module must land in bin/ BEFORE
# build_boot_image.
#
exec mkdir -p bin

# ========================================================================
# Stage /system/ directory (auto-e2cp'd into GENODE P3 by image/disk)
# ========================================================================
#
# /system/bin/    desktop binaries (served via <binary name="bin/...">)
# /system/lib/    .lib.so files (served via rom_lib chroot)
# /system/init/   the nested init config (system.config)
# /system/        flat: themes, tars, pkg metadata (served by bare name)
#
# Directory layout note (docs/14 §4 vs cached_fs_rom label resolution):
#   cached_fs_rom resolves ROM labels via label.last_element(), which
#   becomes the file path relative to the vfs chroot. Binaries use
#   <binary name="bin/..."/> so the path includes the bin/ prefix.
#   Libraries are requested by bare name by the dynamic linker (e.g.
#   "libQt6Core.lib.so") and cannot carry a prefix — so rom_lib uses a
#   SEPARATE cached_fs_rom chrooted to /system/lib to resolve them.
#   Files served by bare name (themes, tars, pkg metadata) live flat
#   under /system/.
#
set sys_dir "[run_dir]/system"
exec mkdir -p "$sys_dir/bin"
exec mkdir -p "$sys_dir/lib"
exec mkdir -p "$sys_dir/init"

#
# Empty config for children without inline <config> (e.g. hello). The
# sandbox opens a "config" ROM for every child; without an inline config,
# the request cascades to rom_sys. A bare <config/> at /system/config
# satisfies the request so the child isn't stopped by a ROM denial.
#
set empty_cfg [open "$sys_dir/config" w]
puts -nonewline $empty_cfg {<config/>}
close $empty_cfg

# --- desktop binaries → /system/bin/ ---
#
# Bake-enabled source-built packages (terminal/textedit/files/
# calculator/pdf_view) and the desktop chrome both land here. The
# iteration is profile-driven via bake::stage's manifest — every
# binary the [packages] section names (AND whose <binary> differs
# from the same name as <name>) is staged here. For consistency,
# the list below mirrors what's in pkg/bake/desktop.profile.
#
# The per-runtime-class package binaries are NOT listed here (Phase
# 16 P2.2): the simple class is staged by runtime_simple::stage_binaries
# below. `terminal` stays listed here on purpose (see the helper note).
#
foreach b { init report_rom wm window_layouter decorator \
            sponge_configd sponge_themed sponge_pkgd sponge-de \
            alpha_probe terminal cfg_probe fb_switch_probe \
            grouped_ui_probe app_isolation_probe ep_wedge } {
	#
	# Some packages (terminal) use a different binary name from
	# their package name (pkg/terminal has <binary>init</binary> —
	# already covered by `init` above). Skip-don't-error: a
	# package whose payload has already covered the binary does
	# NOT need this copy loop.
	#
	if {[file exists "bin/$b"]} {
		exec cp -fL "bin/$b" "$sys_dir/bin/$b"
	}
}

# Per-runtime-class package binaries (Phase 16 P2.2). Same staged
# files as the old inline list, now fail-loud on both ends:
#   runtime_simple — hello, files(sponge_files),
#                    calculator(calculatorform), pdf_view, debug;
#                    textedit is payload-supplied and is NOT copied
#                    into /system/bin/ (its binary is staged by
#                    bake::stage under pkg/textedit/payload/, which
#                    is where the old silent `if exists` skip left
#                    it too — no /system/bin/textedit before or
#                    after this migration).
# The terminal sub-init trio (terminal, vfs, cached_fs_rom) must be
# disk-served in /system/bin: the terminal package's nested init
# resolves /bin/vfs and /bin/cached_fs_rom at start — the same
# staging the proven sponge-desktop-disk-uefi-usb scenario does.
runtime_terminal::stage_binaries $sys_dir

# The switch probe is staged by the loop above (it is a no-op entry when
# the arm is off), so a missing or truncated binary must fail HERE with a
# path, not three minutes later as init's opaque "binary is not an ELF".
if {$fb_switch} {
	set fbsw "$sys_dir/bin/fb_switch_probe"
	if {![file exists $fbsw]} {
		error "fb-switch: $fbsw was not staged — the build of\
 test/fb_switch_probe must run BEFORE this copy loop"
	}
	if {[file size $fbsw] < 4096} {
		error "fb-switch: $fbsw is only [file size $fbsw] bytes —\
 truncated staging"
	}
	puts "fb-switch: staged $fbsw ([file size $fbsw] bytes)"
}

if {$grouped_ui} {
	set gui_p "$sys_dir/bin/grouped_ui_probe"
	if {![file exists $gui_p]} {
		error "grouped-ui: $gui_p was not staged — the build of\
 test/grouped_ui_probe must run BEFORE this copy loop"
	}
	if {[file size $gui_p] < 4096} {
		error "grouped-ui: $gui_p is only [file size $gui_p] bytes —\
 truncated staging"
	}
	puts "grouped-ui: staged $gui_p ([file size $gui_p] bytes)"
}

# --- terminal payload → /system/ (flat, ROM-served) ---
#
# The sub-init's vfs child mounts the noux tars as ROM sessions
# (<tar name="..."/>); the terminal server loads VeraMono.ttf via the
# vfs_ttf rom plugin (rom_sys resolves it at /system/VeraMono.ttf,
# docs/evidence/phase16-runtime-rom-failures.md §2). On the product
# media these resolve through rom_sys at the /system root (same layout
# as the qt6 tars).
#
# Phase 16 P2.2: the vct-bin.tar producer (kept in the build dir), the
# shared VeraMono.ttf producer (terminal_runtime::copy_vera_font) and
# the fail-loud noux-tar staging live in run/runtime-terminal.inc.
# The staged payload is exactly the 12 flat files of
# run/sponge-desktop-disk-uefi-usb.run (10 noux toolset tars +
# vct-bin.tar + VeraMono.ttf) — closing this media's terminal payload
# gap. The helper's copies are fail-loud where the old silent
# `if {[file exists]}` skip let a clean tree drop the payload (the §2
# H-a1 anti-pattern). vct_tty is NOT added: the in-terminal vct bridge
# stays uefi-usb-specific (no new start node or route here).
runtime_terminal::stage_payload $sys_dir

# --- shared libraries → /system/lib/ ---
# Copy ALL .lib.so files EXCEPT ld-*.lib.so (Tier-0 only, §4.6) and
# the Falkon/WebEngine-specific libs (P4 payload, not desktop). The
# desktop's transitive deps are covered by staging the full set minus
# these exclusions.
#
# The Falkon/WebEngine payload closure is runtime_browser::payload_libs
# (run/runtime-browser.inc — the exact former inline list);
# exclude_lib is the same membership test. This loop stays
# exclusion-only: falkon's payload is staged by bake::stage (img mode)
# into pkg/falkon/payload and served via rom_pkg, never here. The
# Tier-0 exceptions
# below (ld*, rump*, vfs_rump) stay inline — they are storage-chain
# properties of the media, not browser properties.
#
foreach lib [glob -nocomplain bin/*.lib.so] {
	set libname [file tail $lib]
	# Skip ld-*.lib.so (Tier-0 boot module, §4.6 — never on disk)
	if {[string match "ld-*.lib.so" $libname]} { continue }
	# Skip ld.lib.so itself (the generic name — Tier-0 only)
	if {$libname eq "ld.lib.so"} { continue }
	# Skip Falkon/WebEngine-specific libs (P4 payload)
	if {[runtime_browser::exclude_lib $libname]} { continue }
	# Skip rump storage-chain libs (Tier-0 deps)
	if {$libname eq "rump.lib.so" || $libname eq "rump_fs.lib.so"} { continue }
	# Skip vfs_rump (Tier-0 storage chain dep)
	if {$libname eq "vfs_rump.lib.so"} { continue }

	exec cp -fL $lib "$sys_dir/lib/$libname"
}

# mupdf closure: pdf_view's document-rendering library and its shared
# closure (P5.1 R13: without them pdf_view stops with "parent denied
# ROM-session: label=mupdf.lib.so", then label=freetype.lib.so, ...).
# Built by the `lib/openjpeg lib/freetype lib/jbig2dec lib/mupdf
# lib/jpeg` build targets (the lean run's sponge-pdf-view.run builds
# the same set) and staged by the bin/*.lib.so glob. Do NOT stage the
# `*.abi.so` stubs next to the app — those are the small ABI-stability
# interfaces (compare var/libcache/zlib/: zlib.abi.so 17KB stub vs
# zlib.lib.so 319KB real), and staging the mupdf stub crashed
# pdf_view with a WRITE violation (R14 evidence). Assert the real
# artifacts reached the staged set.
foreach mupdf_dep { mupdf.lib.so freetype.lib.so jpeg.lib.so \
                    jbig2dec.lib.so openjpeg.lib.so } {
	if {![file exists "$sys_dir/lib/$mupdf_dep"]} {
		error "mupdf closure lib missing from the staged lib set: \
$mupdf_dep (are the lib/openjpeg lib/freetype lib/jbig2dec \
lib/mupdf lib/jpeg build targets in the build list?)"
	}
}

# sample.pdf: the pdf_view package's document ROM (metadata VFS
# <rom name="sample.pdf"/>). The run scenario owns the staged bytes
# (the metadata: "the boot module of that same name MUST be staged by
# the run scenario"); this arm stages a TWO-PAGE document generated
# here instead of copying pkg/pdf_view/payload/sample.pdf:
#
#   - pdfapp.c clamps pageno to pagecount and re-renders only on a
#     real page change, so page-down is a dead input on a one-page
#     document (R21: pgdn_changed=0);
#   - the port blit (app/pdf_view main.cc Pdf_view::show) applies no
#     panx/pany, so scroll alone never changes a pixel (R22).
#
# The P5.1 page-down/scroll input delta therefore needs a real page
# flip. Page 1 keeps the payload's wording; page 2 paints a filled
# block so the flip is a large unmistakable delta. Pure ASCII (no NUL
# bytes) and a computed xref: the staged-metadata text-mode rom trim
# (binary="no") then yields exactly the file bytes inside the padded
# ROM dataspace and mupdf's startxref scan lands on the real table.
set sp1 "BT\n/F1 24 Tf\n72 720 Td\n(Hello Sponge PDF) Tj\n0 -32 Td\n(Phase 13 W4 sample.) Tj\nET\n"
set sp2 "0 0 0 rg\n36 600 540 120 re f\nBT\n/F1 24 Tf\n72 720 Td\n(Sample page two.) Tj\nET\n"
set obj4 "<< /Length [string length $sp1] >>\nstream\n${sp1}endstream"
set obj6 "<< /Length [string length $sp2] >>\nstream\n${sp2}endstream"
set pdf_objs [list \
	{<< /Type /Catalog /Pages 2 0 R >>} \
	{<< /Type /Pages /Kids [3 0 R 5 0 R] /Count 2 >>} \
	{<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 7 0 R >> >> >>} \
	$obj4 \
	{<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 6 0 R /Resources << /Font << /F1 7 0 R >> >> >>} \
	$obj6 \
	{<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>}]
set pdf "%PDF-1.4\n"
set pdf_offs {}
set pdf_num 1
foreach pdf_b $pdf_objs {
	lappend pdf_offs [string length $pdf]
	append pdf "$pdf_num 0 obj\n$pdf_b\nendobj\n"
	incr pdf_num
}
set pdf_xref [string length $pdf]
append pdf "xref\n0 8\n0000000000 65535 f \n"
foreach pdf_o $pdf_offs {
	append pdf [format "%010d 00000 n \n" $pdf_o]
}
append pdf "trailer << /Size 8 /Root 1 0 R >>\nstartxref\n$pdf_xref\n%%EOF\n"
set pdf_fh [open "$sys_dir/sample.pdf" w]
fconfigure $pdf_fh -translation binary
puts -nonewline $pdf_fh $pdf
close $pdf_fh

# --- themes (flat — served by bare name) ---
foreach theme { default light } {
	set theme_src "${genode_dir}/repos/sponge/src/sponge-de/themes/${theme}.theme"
	if {[file exists $theme_src]} {
		exec cp -fL $theme_src "$sys_dir/${theme}.theme"
	}
}

# --- Qt6 tars (flat — served by bare name) ---
# qt6_dejavusans.tar: staged from qt6_base port sources
set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
if {[llength $dejavu_src] > 0} {
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf "$sys_dir/qt6_dejavusans.tar" -C "$staging" qt
	file delete -force "$staging"
}

# qt6_libqgenode.tar: cmake-built, already in bin/
if {[file exists "bin/qt6_libqgenode.tar"]} {
	exec cp -fL "bin/qt6_libqgenode.tar" "$sys_dir/qt6_libqgenode.tar"
}

# files_demo.tar: the files package's read-only /demo fixture
# (pkg/files/metadata.xml VFS mounts <tar name="files_demo.tar"/>).
# Staged by the same recipe as run/sponge-files.run lines 216-235 —
# without it the files child dies at startup with
# "parent denied ROM-session: label=files_demo.tar" (P5.1 R6
# evidence, docs/evidence/phase16-p51-grouped-app-matrix.md).
set demo_src "${genode_dir}/../run/fixtures/files-demo"
if {![file isdirectory $demo_src]} {
	error "demo fixture directory not found: $demo_src"
}
set staging "[run_dir]/files-demo-staging"
file delete -force $staging
file mkdir "$staging/demo"
foreach f [glob -directory $demo_src *] {
	file copy -force -- $f "$staging/demo/"
}
exec tar -cf "$sys_dir/files_demo.tar" -C "$staging" demo
file delete -force $staging

# files_request: the files package's automation channel ROM (a
# report_rom relay in run/sponge-files.run line 117, written by its
# probe). On product media no writer exists, but the ROM itself must
# RESOLVE or the child stops with "parent denied ROM-session:
# label=files_request" (P5.1 R7 evidence). An empty file behind the
# rom_sys catch-all serves an empty ROM, which the app tolerates
# (files_window.cc _poll_request returns on empty/invalid XML). The
# driven channel remains proven in run/sponge-files.run.
exec touch "$sys_dir/files_request"

# ----------------------------------------------------------------
# Bake-driven pkg metadata + index + payloads (Phase 15 W2, D15.8)
# ----------------------------------------------------------------
#
# Source run/bake.inc (the canonical Phase 15 W2 shared include) and
# invoke bake::stage for FULL img-mode staging: pkg_<name>.xml +
# the synthesized pkg_index.xml + every pkg/<name>/payload/* file
# under $sys_dir. R15.3 verifier fires synchronously after staging;
# any missing artifact errors loudly and exits before image assembly
# (no silent or misleading-success run).
#
# On success, /system also gains the bake defaults tree at
# $sys_dir/bake/{bake_manifest.json, config.defaults, theme.defaults};
# the W3 first-boot sentinel (sponge_configd + .bake-seed) will read
# them on the desk media path. iso media lands the same files under
# bin/bake/ via the corresponding sponge-alpha.run call.
#
source [file join [file dirname [file normalize [info script]]] \
                    bake.inc]

#
# The DISPLAY driver is a package, not a Tier-0 node (docs/17 §1). This
# media boots through the BIOS INT 10h path, so the seeded first-boot
# root is fb_vesa; the UEFI variants of this scenario seed fb_boot
# instead. driver_packages::stage asserts that the choice reached the
# staged bake manifest.
#
driver_runtime::fb_package fb_vesa

#
# SPONGE_APP_ISOLATION: the FOCUSED media set. The isolation profile
# stages hello + textedit + calculator (the launcher popup domain fits
# at most 8 entries and the desktop set already fills it exactly - a
# ninth entry would clip textedit out of the clickable domain, and
# textedit must stay launcher-reachable for the kill + relaunch legs).
# The ep_wedge wedge fixture is injected ON TOP of the profile via
# bake::add_package so it reaches the bake manifest (the first-boot
# seed - there is no other way into the installed set) and gets a real
# launcher entry. The env override is set HERE so the whole arm
# contract stays one env var (SPONGE_APP_ISOLATION=on).
#
if {$app_isolation} {
	set ::env(SPONGE_BAKE_PROFILE) isolation
	bake::add_package ep_wedge
}

bake::stage $sys_dir img

#
# pdf_view's document ROM needs `binary="no"` on the served media
# (P5.1 evidence, docs/evidence/phase16-p51-grouped-app-matrix.md):
# the disk-serving path reports the ext2 block-rounded size (632 ->
# 4096) and the vfs rom plugin keeps the whole padded dataspace in
# its default binary mode, so mupdf seeks to size-1024 inside the
# zero padding and reports "cannot find startxref" (the lean
# sponge-pdf-view.run serves the same file as an exact-size core ROM
# module and is unaffected). The plugin's text mode trims the content
# at the first NUL — the document is NUL-free and the block padding
# is zeros, so the trim yields exactly the 632-byte file. Same
# staged-metadata transform pattern as the P2.4 clipboard removal
# (staged pkg_textedit.xml); the repo metadata stays untouched and
# this media-only fix is recorded as the residual gap.
#
# The transform applies to whatever pdf_view metadata the active bake
# profile stages; a focused profile (SPONGE_APP_ISOLATION's
# `isolation`) carries no pdf_view and skips it — skip-don't-error,
# same discipline as the /system/bin copy loop above.
if {[file exists "$sys_dir/pkg_pdf_view.xml"]} {
	set pv_fh [open "$sys_dir/pkg_pdf_view.xml" r]
	set pv_xml [read $pv_fh]
	close $pv_fh
	if {[string first {<rom name="sample.pdf"/>} $pv_xml] < 0} {
		error "pkg_pdf_view.xml: sample.pdf rom element missing or drifted"
	}
	set pv_xml [string map [list \
		{<rom name="sample.pdf"/>} \
		{<rom name="sample.pdf" binary="no"/>}] $pv_xml]
	set pv_fh [open "$sys_dir/pkg_pdf_view.xml" w]
	puts -nonewline $pv_fh $pv_xml
	close $pv_fh
}

# After bake::stage: it re-stages pkg payload from the repo, so
# runtime_simple's payload staging/transforms must run after it.
runtime_simple::stage_binaries $sys_dir

# No vct_tty on this media: strip the terminal package's optional vct
# bridge so the nested vfs does not die on the unavailable session.
# Profile-scoped: only when the terminal package is staged.
if {[file exists "$sys_dir/pkg_terminal.xml"]} {
	runtime_terminal::strip_vct_bridge $sys_dir
}

#
# Driver packages (docs/12 §4.5). Opt-in: none of these is listed in a
# bake profile, so none of them becomes a first-boot root — `vct install
# pc_nic` is what brings a driver up. Called after bake::stage, which
# owns pkg_index.xml.
#
driver_runtime::stage $sys_dir

#
# Phase 16 W3 — flat-copy the bake defaults from /system/bake/ to
# /system/ so the cached_fs_rom chroot (rom_sys, root=/system) can
# resolve `bake_manifest` -> /system/bake_manifest.json (the path
# rom_sys uses is `label.last_element()`, which strips the bake/
# prefix). The bake/ subdirectory stays on disk (Phase 15 W2 contract)
# for tool/dist inspection; this scenario reads from the flat shadow.
#
foreach f { bake_manifest.json config.defaults theme.defaults } {
	if {[file exists "$sys_dir/bake/$f"]} {
		exec cp -fL "$sys_dir/bake/$f" "$sys_dir/$f"
	}
}

#
# NOTE: the source-built binaries (init, sponge-de, sponge_configd,
# sponge_themed, sponge_pkgd, hello, etc.) are copied in the
# `desktop binaries -> /system/bin/` block above. The R15.3 verifier
# checks those binaries exist in bin/ after the scenario's `build {}`
# block but does NOT copy them itself — that remains the scenario's
# responsibility (this scenario already does so above).
#

# ========================================================================
# Write /system/init/system.config — the nested system init config
# ========================================================================
#
# This is the desktop composition, formerly inline in sponge-alpha.run's
# top-level init config. It is now DATA on disk (docs/14 §4.4: "init
# config is data, not image"). Changing the desktop composition no
# longer rebuilds image.elf.
#
# The config references Tier-0 services (nitpicker/timer/report_rom)
# via <parent/>, which cascades through the system init to the Tier-0
# init. Binaries use <binary name="bin/..."/> for disk resolution.
# Every child carries the §4.6 ld.lib.so route.
#

if {$fail_mode} {
	#
	# FAILURE CHANNEL: write a deliberately corrupted system.config.
	# The nested init will fail to parse it and log an XML error.
	#
	set sysconfig_fh [open "$sys_dir/init/system.config" w]
	puts $sysconfig_fh {<config THIS IS DELIBERATELY BROKEN XML><unclosed}
	close $sysconfig_fh
} else {
	#
	# Fail-loud drift check (Phase 16 P2.4): the three grant pairs
	# written into the config below must match what
	# run/runtime-quota.inc derives from the class rows. A class
	# quota row that moved aborts the run here — the literals are
	# kept, never substituted (docs/14 §4.4).
	#
	runtime_quota::verify 6000 1488M 2000 247M 220000 512G

	#
	# Write system.config in HID format to a temp file, then convert
	# to XML using the `hid` tool. The nested init reads the config
	# from disk via cached_fs_rom; writing it as proper XML eliminates
	# any ambiguity in how inline <config> attributes (e.g.
	# binary_prefix) are parsed by child components.
	#
	set sysconfig_hid "[run_dir]/system.config.hid"
	set sysconfig_fh [open "$sysconfig_hid" w]
puts $sysconfig_fh {
config
# This sandbox is the hardware gateway: driver_runtime below may ask for
# a hardware service. The list is deliberately broad because the set of
# installable drivers is open-ended.
#
# The boundary that protects applications is NOT this list — it is the
# parent-provides pkgd GENERATES for each package runtime (the three
# P2.4 class configs), which carries the
# application service set only. A package's route is emitted from its
# declared <sessions>, so no application package can name Platform / Irq
# / Io_mem / Io_port and obtain one even though this sandbox would route
# it (AGENTS.md §1.2).
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service Timer
  # Report is here because a driver package declares it: the framebuffer
  # drivers publish a `connectors` inventory (pc_intel_fb and pc_wifi do
  # the same). Without it in THIS list the request from driver_runtime
  # would be denied at this hop even though the Tier-0 node routes Report
  # to report_rom below.
  + service Report
  + service Gui
  + service Capture
  + service Event
  + service Platform
  + service Dma
  # The three hardware services below are spelled the way the CLIENTS
  # request them, which is NOT the CamelCase a human would write:
  # Genode's session service_name() is "IRQ" / "IO_MEM" / "IO_PORT"
  # (io_mem_session.h:37 and friends), and the parent-provides match is
  # case-sensitive. The old Irq/Io_mem/Io_port spelling was never
  # requested by anyone and silently denied every one of them at this
  # hop — invisible while every hardware component was a Tier-0 child,
  # and the reason a packaged fb_vesa died with
  # 'parent denied IO_MEM-session'.
  + service IRQ
  + service IO_MEM
  + service IO_PORT
  + service Usb
  + service Rtc
  + service File_system
  + service Uplink
  + service Nic
  + service Terminal

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ report | init_ram: yes | child_ram: yes | child_caps: yes | delay_ms: 1000

# Fault containment (docs/17 §5): a child whose entrypoint wedges is
# abandoned and respawned by the sandbox after 3 skipped heartbeats
# (8 s at rate 2000 ms: the child is killed on the FOURTH unanswered
# heartbeat). The input chain (top-level) is untouched.
#
# Every contained child additionally carries `startup_grace_ms`: a child
# that has not answered a SINGLE heartbeat is not wedged, it is inside
# its first construct - and in the classic Genode the construct runs on
# the very thread that has to answer the heartbeat. A child that loads
# its shared libraries (Qt6, Mesa) over a slow storage chain therefore
# looks exactly like a wedge to the parent. The grace gives such a
# child a bounded window to come up; when it expires, the normal wedge
# rules apply unchanged. Measurements and the field receipt:
# docs/evidence/startup-grace.md.
+ heartbeat | rate_ms: 2000

+ start report_rom | caps: 300 | ram: 8M
  + binary | name: bin/report_rom
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: layouter -> window_list       | report: wm -> window_list
    + policy | label: decorator -> pointer           | report: wm -> pointer
    + policy | label: decorator -> window_layout     | report: layouter -> window_layout
    + policy | label: wm -> focus                    | report: layouter -> focus
    + policy | label: wm -> resize_request           | report: layouter -> resize_request
    + policy | label: layouter -> hover              | report: decorator -> hover
    + policy | label: layouter -> decorator_margins  | report: decorator -> decorator_margins
    + policy | label: layouter -> rules              | report: sponge-de -> rules
    + policy | label: layouter -> focus_request      | report: sponge-de -> focus_request
    + policy | label: sponge_configd -> config_request | report: alpha_probe -> config_request
    + policy | label: alpha_probe -> config_result     | report: sponge_configd -> config_result
    + policy | label: sponge_themed -> config          | report: sponge_configd -> config
    + policy | label: alpha_probe -> configd_config    | report: sponge_configd -> config
    + policy | label: alpha_probe -> config            | report: sponge_configd -> config
    + policy | label: sponge-de -> theme               | report: sponge_themed -> theme
    + policy | label: alpha_probe -> theme             | report: sponge_themed -> theme
    + policy | label: sponge_pkgd -> request     | report: alpha_probe -> request
    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result
    #
    # P2.4 grouped runtimes (run/runtime-grouped.inc): the three
    # per-class config relays + three per-class state relays + the
    # simple-class debug feeds + the sponge-de/cfg_probe consumers
    # (their ROM names — runtime_state / runtime_mirror / config — are
    # stable; only the `report:` sources point at the simple class).
    #
    @GROUPED_RELAY_POLICIES@
    + policy | label: sponge-de -> cfg_probe_state | report: cfg_probe -> cfg_probe
    + policy | label: sponge-de -> installed      | report: sponge_pkgd -> installed
    + policy | label: sponge_pkgd -> launcher_request | report: sponge-de -> launcher_request
    + policy | label: sponge-de -> launcher_result   | report: sponge_pkgd -> launcher_result
    + policy | label: sponge-de -> window_list   | report: wm -> window_list
    + policy | label: sponge-de -> window_layout | report: layouter -> window_layout
    + policy | label: alpha_probe -> sponge_de_launcher | report: sponge-de -> launcher
    @DRIVER_RELAY_POLICIES@

+ start wm | caps: 2000 | ram: 16M
  + binary | name: bin/wm
  @HB:wm@
  + provides
    + service Gui
    + service Report
    + service ROM
  + config
    + policy | label_prefix: decorator | role: decorator
    + policy | label_prefix: layouter  | role: layouter
    + default-policy
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: focus          | + child report_rom
    + service ROM | label: resize_request | + child report_rom
    + service Report | label_last: shape  | + child report_rom
    + service Report | + child report_rom
    + service Gui | + parent
    + any-service
      + parent
      + any-child

+ start layouter | caps: 1000 | ram: 8M
  + binary | name: bin/window_layouter
  @HB:layouter@
  + config | rules: rom
    + report | rules: yes
    + rules
      + screen screen
      #
      # Launched GUI packages need a floating placement so they don't
      # maximize over the desktop. See run/sponge-alpha.run for the
      # full rationale (Phase 10 W3 pkg_runtime Gui-route fix). The
      # matching Gui route through the wm is added to the class
      # runtimes below; this rule covers the layouter side. label_prefix is
      # supported on <assign> per the window_layouter README. Textedit's
      # minimum decorated frame is 512x493; give it an on-screen rule
      # before the generic small-window fallback or its 300px origin
      # pushes the bottom beyond the 768px display.
      + assign | label_prefix: pkg_runtime_simple -> textedit | target: screen
               | xpos: 50 | ypos: 80 | width: 512 | height: 493 | maximized: no
      #
      # Falkon (P2.6): window_list/window_layout runtime evidence
      # (docs/evidence/phase16-p26-browser-acceptance.md) shows its
      # QtWebEngine main window keeps a 787x569 client — a smaller
      # resize request is clamped up to that size — so the generic
      # fallback left its frame center right of/below the pkg_runtime
      # assign region and its bottom past the 768px display. Size the
      # rule to the observed client so the assign request equals it,
      # and place it so the client center (393,284) lands inside the
      # region (report rect (5,108) -> center (398,392)) while the
      # decorated frame (stock decorator margins 20/4/4/4) stays fully
      # on screen.
      + assign | label_prefix: pkg_runtime_browser -> falkon | target: screen
               | xpos: 5 | ypos: 80 | width: 787 | height: 569 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen
               | xpos: 50 | ypos: 300 | width: 320 | height: 240 | maximized: no
    + press   | key: BTN_LEFT  | action: drag
      + release | key: BTN_LEFT | action: drop
  + route
    + service ROM | label_last: ld.lib.so     | + parent
    + service ROM | label: window_list       | + child report_rom
    + service ROM | label: focus_request     | + child report_rom
    + service ROM | label: hover             | + child report_rom
    + service ROM | label: focus             | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service ROM | label: rules             | + child report_rom
    + service Report | label: rules           | + child report_rom | label: layout_rules
    + service Report | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start decorator | caps: 350 | ram: 32M
  + binary | name: bin/decorator
  @HB:decorator@
  + config
    + controls
      + maximizer
      + title
      #
      # The closer (P5.1): the stock motif decorator ships a closer
      # control (decorator/window.h TYPE_CLOSER) that was never
      # enabled in the product config. Windows are now closable from
      # the title bar - the app-isolation kill leg's closer click and
      # the user-facing close door (AGENTS.md 1.1 control). The
      # closer is the LAST control = the rightmost title-bar control
      # (decorator/window.cc draws right-side controls right-to-left
      # from the end of the list), hit-tested at content
      # (x+w-16, y-16)..(x+w, y).
      + closer
    + default-policy
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: window_layout | + child report_rom
    + service ROM | label: pointer       | + child report_rom
    + service Report | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start sponge_configd | caps: 200 | ram: 16M
  + binary | name: bin/sponge_configd
  @HB:sponge_configd@
  + config
    + bake
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: config_request | + child report_rom
    #
    # Phase 16 W3 — bake ROM routes. The bake defaults tree is staged
    # at /system/bake/{bake_manifest.json, config.defaults} by
    # bake::stage above (img mode, full bake) AND flat-copied into
    # /system/ so the cached_fs_rom chroot (rom_sys, root=/system)
    # can resolve the labels — rom_sys uses `label.last_element()`
    # which strips the bake/ prefix. The flat copy lands the files
    # at /system/{bake_manifest.json, config.defaults, theme.defaults}.
    # Without these routes the broadcast never carries bake.applied=yes
    # and the alpha-probe extended set times out at the first missing
    # baked key (D15.9 / D16.4).
    #
    + service ROM | label: bake_manifest        | + parent | label: bake_manifest.json
    + service ROM | label: bake_config_defaults | + parent | label: config.defaults
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_themed | caps: 200 | ram: 8M
  + binary | name: bin/sponge_themed
  @HB:sponge_themed@
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: config       | + child report_rom
    + service ROM | label_last: default.theme | + parent
    + service ROM | label_last: light.theme   | + parent
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_pkgd | caps: 200 | ram: 16M
  + binary | name: bin/sponge_pkgd
  @HB:sponge_pkgd@
  + config | binary_prefix: bin/
    + launcher_request
    #
    # P2.4 grouped runtimes (run/runtime-grouped.inc): grouped
    # emission + the three EXPLICIT per-class admission gates.
    #
    @GROUPED_ADMISSION_NODES@
    + driver_admission
    + bake
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: request | + child report_rom
    + service ROM | label_last: launcher_request | + child report_rom
    @GROUPED_PKGD_STATE_ROUTES@
    + service ROM | label: driver_runtime_state | + child report_rom
    + service ROM | label: bake_manifest | + parent | label: bake_manifest.json
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child


+ start sponge-de | caps: 4000 | ram: 160M
  + binary | name: bin/sponge-de
  @HB:sponge-de@
  + config
    + theme | source: themed
    + launcher | source: pkgd
    + demo | enabled: no
    + tasklist | source: wm
    + tasklist_static_rules
      + assign | label_prefix: pkg_runtime_simple -> textedit | target: screen | xpos: 50 | ypos: 80 | width: 512 | height: 493 | maximized: no
      + assign | label_prefix: pkg_runtime_browser -> falkon | target: screen | xpos: 5 | ypos: 80 | width: 787 | height: 569 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen | xpos: 50 | ypos: 300 | width: 320 | height: 240 | maximized: no
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Gui | label_last: Sponge Panel   | + parent
    + service Gui | label_last: Sponge Launcher | + parent
    + service Gui | + child wm
    + service Report | label: shape | + child report_rom
    + service Report | label: input | + child report_rom
    + service Report | label: applied_theme | + child report_rom
    + service Report | label: launcher | + child report_rom
    + service Report | label: launcher_request | + child report_rom
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service Report | label: focus_request | + child report_rom
    + service Report | label: rules        | + child report_rom
    + service ROM | label: launcher_result | + child report_rom
    + service ROM | label_last: runtime_state | + child report_rom
    + service ROM | label_last: runtime_mirror | + child report_rom
    + service ROM | label_last: system_state   | + parent
    + service ROM | label_last: cfg_probe_state | + child report_rom
    + service ROM | label: installed | + child report_rom
    + service ROM | label: theme | + child report_rom
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child

+ start alpha_probe | caps: 200 | ram: 16M
  + binary | name: bin/alpha_probe
  + config | skip_lz: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Capture | + parent
    + service Timer | + parent
    + service ROM | label_last: result | + child report_rom
    + service ROM | label_last: config_result | + child report_rom
    + service ROM | label_last: configd_config | + child report_rom
    + service ROM | label_last: config | + child report_rom
    + service ROM | label_last: sponge_de_launcher | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
+ start cfg_probe | caps: 200 | ram: 4M
  + binary | name: bin/cfg_probe
  + route
    + service ROM | label: config | + child report_rom
    + service Report | + child report_rom
    + service Timer | + parent
    + any-service
      + parent
      + any-child

#
# P2.4 grouped runtime sizing: the three grant pairs below are
# derived and drift-checked in run/runtime-quota.inc — the class rows,
# the editor closure, the documented headroom/round-up and the
# admission-margin arithmetic all live there (docs/17 §6/§6.1). The
# literals are kept on purpose (docs/14 §4.4 "init config is data,
# not image") and are checked against the derivation twice: the
# runtime_quota::verify call above this section, and
# runtime_grouped::assert_wiring on the staged HID (which also
# re-asserts the node set and the ordering below).
#
#   pkg_runtime_simple    caps 6000,   ram 1488M  (explicit)
#   pkg_runtime_terminal  caps 2000,   ram 247M   (explicit)
#   pkg_runtime_browser   caps 220000, ram 512G   (remainder clamp)
#
# HARD ORDERING INVARIANT: pkg_runtime_browser MUST remain the LAST
# `+ start` node of THIS config. `ram: 512G` only means "everything
# left" if nothing is created afterwards — a node appended below takes
# its RAM out of this pool silently. The driver start-node expansion
# (the placeholder line below), the SPONGE_FB_SWITCH probe node and
# the supervisor's SPONGE_SUPERVISOR_TEST fault child
# (run/supervisor.inc) all land above this node. Caps stay EXPLICIT
# (never a clamp): caps exhaustion on seL4 HANGS
# (docs/09-roadmap.md §11.1), and a remainder-sized cap grant would
# starve any future sibling (docs/17 §5).
#
# Route split per class: the debug feeds (installed / window_list /
# launcher_result) go with the SIMPLE runtime, where the debug
# package lives; this media carries no vct_tty, so the terminal class
# has no Terminal route here (the uefi-usb flagship keeps it). Each
# runtime's `label: config` serves its own generated config from
# report_rom (the grouped relay fragment) and `label_last: state`
# publishes its sandbox state report, which its pkgd admission gate
# reads.
#
@DRIVER_START_NODE@
+ start pkg_runtime_simple | caps: 6000 | ram: 1488M
  + binary | name: bin/init
  @HB:pkg_runtime_simple@
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service ROM | label: config | + child report_rom
    + service ROM | label_last: installed      | + child report_rom
    + service ROM | label_last: window_list    | + child report_rom
    + service ROM | label_last: launcher_result | + child report_rom
    #
    # Route the class runtimes' Gui sessions through the wm so
    # launched GUI packages get decorated, movable frames. Phase 10
    # W3 fix — see run/sponge-alpha.run for full rationale. Inert when
    # no GUI package is running (hello is a non-GUI binary).
    + service Gui | + child wm
    + service Report | label_last: shape | + child wm
    + service Report | label_last: state | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime_terminal | caps: 2000 | ram: 247M
  + binary | name: bin/init
  @HB:pkg_runtime_terminal@
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: config | + child report_rom
    + service Gui | + child wm
    + service Report | label_last: shape | + child wm
    + service Report | label_last: state | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime_browser | caps: 220000 | ram: 512G
  + binary | name: bin/init
  @HB:pkg_runtime_browser@
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service ROM | label: config | + child report_rom
    + service Gui | + child wm
    + service Report | label_last: shape | + child wm
    + service Report | label_last: state | + child report_rom
    + any-service
      + parent
      + any-child
-}
	close $sysconfig_fh


#
# ===========================================================================
# SPONGE_FB_SWITCH=on — the runtime framebuffer-driver switch arm
# ===========================================================================
#
# The claim under test is that the display driver is an ordinary,
# replaceable package (docs/17 §1), so a display-driver change is a
# package operation with no privileged Tier-0 fixture to edit. The probe
# (test/fb_switch_probe) asserts four things in the PRODUCT topology:
# the seeded fb package is a driver_runtime child; the composited
# screen shows a rendered desktop; and after `remove` + `install` the
# other driver takes over and the screen comes back and SETTLES on a
# rendered desktop again. The exclusivity refusal is proven separately,
# in run/sponge-pkg-driver.run.
#
# Off by default, like every other product-media test arm: the shipped
# media carries no probe and no extra relay policy. The arm uses the
# same FBCON env-gate pattern as SPONGE_SUPERVISOR_TEST and
# SPONGE_LAUNCHTEST.
#
if {[info exists ::env(SPONGE_FB_SWITCH)] && $::env(SPONGE_FB_SWITCH) eq "on"} {
	puts "fb-switch: SPONGE_FB_SWITCH=on — fb_switch_probe wired into system.config"

	set fs_fh [open $sysconfig_hid r]
	set fs_cfg [read $fs_fh]
	close $fs_fh

	# pkgd's dedicated probe channel (report_rom is single-writer per
	# label, and `request`/`launcher_request` are already spent).
	set fs_cfg [string map [list \
		"    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result" \
		"    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result\n    + policy | label: sponge_pkgd -> probe_request | report: fb_switch_probe -> probe_request\n    + policy | label: fb_switch_probe -> probe_result | report: sponge_pkgd -> probe_result\n    + policy | label: fb_switch_probe -> driver_runtime_state | report: driver_runtime -> state"] \
		$fs_cfg]

	set fs_cfg [string map [list "    + launcher_request\n" \
		"    + launcher_request\n    + probe_request\n"] $fs_cfg]

	set fs_cfg [string map [list "    + service ROM | label_last: launcher_request | + child report_rom" \
		"    + service ROM | label_last: launcher_request | + child report_rom\n    + service ROM | label_last: probe_request | + child report_rom"] \
		$fs_cfg]

	set fs_cfg [string map [list "+ start sponge-de | caps: 4000 | ram: 160M" {+ start fb_switch_probe | caps: 400 | ram: 24M
  + binary | name: bin/fb_switch_probe
  + config | active: fb_vesa | alternate: fb_boot | timeout_ms: 120000
    | settle_ms: 4000 | screen_w: 1024 | screen_h: 768
  + route
    + service ROM | label_last: ld.lib.so | + parent
    # driver_runtime's own state report, on a relay label of the
    # probe's own (report_rom is single-writer per ROM label, and the
    # driver relay policy already spends pkgd's label slot).
    # (A comment here must never name a driver_runtime.inc placeholder:
    # the expander substitutes every occurrence in the file, comments
    # included, and a substituted policy line inside a <route> block
    # corrupts the node - which is exactly the "binary is not an ELF"
    # this cost once.)
    # The `label:` here is matched against the CHILD-SCOPED query label
    # (route_model: skip_label_prefix strips "<child> -> "), so the
    # unscoped spelling is the correct one here; report_rom publishes
    # the ROM under the scoped name, exactly as driver_probe does in
    # run/sponge-pkg-driver.run.
    + service ROM | label: driver_runtime_state | + child report_rom
    + service ROM | label: probe_result | + child report_rom
    + service Report | label: probe_request | + child report_rom
    + service Timer | + parent
    + service Capture | + parent
    + any-service
      + parent

+ start sponge-de | caps: 4000 | ram: 160M}] $fs_cfg]

	set fs_fh [open $sysconfig_hid w]
	puts -nonewline $fs_fh $fs_cfg
	close $fs_fh
}

#
# ===========================================================================
# SPONGE_GROUPED_UI=on — the P2.4 D16R.11 grouped-runtime UI acceptance arm
# ===========================================================================
#
# The claim under test: REAL launcher input reaches all three grouped
# runtime classes and produces the D16R.11 acceptance shape per class
# (first paint + a real typed-input event with a measurable rendered
# delta). The probe (test/grouped_ui_probe) drives nothing itself: it
# emits the run/qmp.inc QMP-TARGET marker choreography (panel toggle +
# launcher menu entry clicks over the usb-tablet path, send-key typing)
# and verifies via Capture pixels + the wm window_list / layouter
# window_layout / focus reports that the resulting windows belong to
# pkg_runtime_simple / pkg_runtime_terminal / pkg_runtime_browser. The
# window label prefix is the class binding — the evidence cannot come
# from a different runtime. The browser/falkon leg (P2.6) asserts first
# paint + basic typed input only; page load / DHCP / HTTP stay follow-up
# (criterion 15).
#
# Off by default, like every other product-media test arm: the shipped
# media carries no probe and no extra relay policy. The arm uses the
# same FBCON env-gate pattern as SPONGE_SUPERVISOR_TEST and
# SPONGE_LAUNCHTEST.
#
if {$grouped_ui} {
	puts "grouped-ui: SPONGE_GROUPED_UI=on — grouped_ui_probe wired into system.config"

	set gu_fh [open $sysconfig_hid r]
	set gu_cfg [read $gu_fh]
	close $gu_fh

	# The probe's observation ROMs on report_rom relays: the launcher
	# feed, the wm window list, the layouter's placement/focus reports,
	# the three class state reports (the grouped-topology binding), the
	# pkgd launcher_result channel (the documented already-running
	# receipt for the hello/debug autostart entry clicks) and the files
	# app's `files` report (the structural navigation receipt).
	set gu_cfg [string map [list \
		"    + policy | label: alpha_probe -> sponge_de_launcher | report: sponge-de -> launcher" \
		"    + policy | label: alpha_probe -> sponge_de_launcher | report: sponge-de -> launcher\n    + policy | label: grouped_ui_probe -> launcher      | report: sponge-de -> launcher\n    + policy | label: grouped_ui_probe -> window_list   | report: wm -> window_list\n    + policy | label: grouped_ui_probe -> window_layout | report: layouter -> window_layout\n    + policy | label: grouped_ui_probe -> focus         | report: layouter -> focus\n    + policy | label: grouped_ui_probe -> st_simple     | report: pkg_runtime_simple -> state\n    + policy | label: grouped_ui_probe -> st_terminal   | report: pkg_runtime_terminal -> state\n    + policy | label: grouped_ui_probe -> st_browser    | report: pkg_runtime_browser -> state\n    + policy | label: grouped_ui_probe -> launcher_result | report: sponge_pkgd -> launcher_result\n    + policy | label: grouped_ui_probe -> files         | report: pkg_runtime_simple -> files -> files"] \
		$gu_cfg]

	# The probe's ONE sanctioned pkgd call (P5.1 falkon teardown
	# `remove`, see _remove_falkon): pkgd's probe_request/probe_result
	# channel, the same relay pair the fb_switch arm wires for
	# fb_switch_probe (report_rom is single-writer per label — the
	# two arms are mutually exclusive, guarded above).
	set gu_cfg [string map [list \
		"    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result" \
		"    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result\n    + policy | label: sponge_pkgd -> probe_request | report: grouped_ui_probe -> probe_request\n    + policy | label: grouped_ui_probe -> probe_result | report: sponge_pkgd -> probe_result"] \
		$gu_cfg]

	set gu_cfg [string map [list "    + launcher_request\n" \
		"    + launcher_request\n    + probe_request\n"] $gu_cfg]

	set gu_cfg [string map [list \
		"    + service ROM | label_last: launcher_request | + child report_rom" \
		"    + service ROM | label_last: launcher_request | + child report_rom\n    + service ROM | label_last: probe_request | + child report_rom"] \
		$gu_cfg]

	#
	# The files app's `files` Report ascends through the nested
	# pkg_runtime_simple init; without an explicit route it reaches the
	# Tier-0 report_rom and is refused there (run/sponge-files.run
	# lines 163-173 carry the same explicit route in the lean
	# topology). Route it to the system-level report_rom instead, only
	# inside this arm — the shipped media is untouched.
	#
	set gu_cfg [string map [list \
		"    + service ROM | label_last: launcher_result | + child report_rom" \
		"    + service ROM | label_last: launcher_result | + child report_rom\n    + service Report | label_last: files | + child report_rom"] \
		$gu_cfg]

	#
	# Debug window placement (P5.1 Mark leg, R2 evidence): the debug
	# app self-resizes to 700x480 at the generic assign origin
	# (50,328), which pushes its Mark button row below the 768px QEMU
	# display. A debug-specific assign rule moves the window up to
	# ypos 60 (screen y 88) so the whole 700x480 frame is on-screen
	# and the Mark button is clickable. GROUPED-ARM ONLY: the shipped
	# media keeps the generic placement (on real hardware panels the
	# 700x480 frame is well within the display). Added at both rule
	# sites (the layouter's <rules> and sponge-de's
	# tasklist_static_rules) like the textedit/falkon precedents.
	#
	set gu_cfg [string map [list \
		"      + assign | label_prefix: pkg_runtime_browser -> falkon | target: screen
               | xpos: 5 | ypos: 80 | width: 787 | height: 569 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen" \
		"      + assign | label_prefix: pkg_runtime_browser -> falkon | target: screen
               | xpos: 5 | ypos: 80 | width: 787 | height: 569 | maximized: no
      + assign | label_prefix: pkg_runtime_simple -> debug | target: screen
               | xpos: 50 | ypos: 60 | width: 700 | height: 480 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen"] \
		$gu_cfg]
	set gu_cfg [string map [list \
		"      + assign | label_prefix: pkg_runtime_browser -> falkon | target: screen | xpos: 5 | ypos: 80 | width: 787 | height: 569 | maximized: no" \
		"      + assign | label_prefix: pkg_runtime_browser -> falkon | target: screen | xpos: 5 | ypos: 80 | width: 787 | height: 569 | maximized: no
      + assign | label_prefix: pkg_runtime_simple -> debug | target: screen | xpos: 50 | ypos: 60 | width: 700 | height: 480 | maximized: no"] \
		$gu_cfg]

	set gu_cfg [string map [list "+ start alpha_probe | caps: 200 | ram: 16M" {+ start grouped_ui_probe | caps: 200 | ram: 32M
  + binary | name: bin/grouped_ui_probe
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Capture | + parent
    + service Timer | + parent
    + service ROM | label: launcher      | + child report_rom
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service ROM | label: focus         | + child report_rom
    + service ROM | label: st_simple     | + child report_rom
    + service ROM | label: st_terminal   | + child report_rom
    + service ROM | label: st_browser    | + child report_rom
    + service ROM | label: launcher_result | + child report_rom
    + service ROM | label: files         | + child report_rom
    + service ROM | label: probe_result | + child report_rom
    + service Report | label: probe_request | + child report_rom
    + any-service
      + parent
      + any-child

+ start alpha_probe | caps: 200 | ram: 16M}] $gu_cfg]

	set gu_fh [open $sysconfig_hid w]
	puts -nonewline $gu_fh $gu_cfg
	close $gu_fh
}

#
# ===========================================================================
# SPONGE_APP_ISOLATION=on — the P5.1 app-isolation acceptance arm
# ===========================================================================
#
# The claim under test: one application's failure cannot take the
# desktop or a sibling app down, and the desktop recovers. The probe
# (test/app_isolation_probe) emits the run/qmp.inc QMP-TARGET marker
# choreography and verifies via Capture pixels + the wm window_list /
# layouter window_layout reports + the class state report + sponge-de's
# `input` report. The kill leg closes the textedit window with the
# decorator CLOSER (the product decorator gains `+ closer` above); the
# wedge leg launches the run-script-staged ep_wedge package whose
# entrypoint parks `wedge_after_ms` in. The pkgd probe_request channel
# carries the sanctioned remove+install RESET before the relaunch
# (wm_tasks_probe step-8 shape) — never a launch substitute: every
# launch is a real launcher entry click.
#
# Off by default, like every other product-media test arm.
#
if {$app_isolation} {
	puts "app-isolation: SPONGE_APP_ISOLATION=on — app_isolation_probe wired into system.config"

	set ai_fh [open $sysconfig_hid r]
	set ai_cfg [read $ai_fh]
	close $ai_fh

	# The probe's observation ROMs on report_rom relays: the launcher
	# feed, the wm window list, the layouter's placement/focus reports,
	# the simple class state report, the pkgd launcher_result channel
	# and sponge-de's `input` report (the C2 DE-input witness).
	set ai_cfg [string map [list \
		"    + policy | label: alpha_probe -> sponge_de_launcher | report: sponge-de -> launcher" \
		"    + policy | label: alpha_probe -> sponge_de_launcher | report: sponge-de -> launcher\n    + policy | label: app_isolation_probe -> launcher      | report: sponge-de -> launcher\n    + policy | label: app_isolation_probe -> window_list   | report: wm -> window_list\n    + policy | label: app_isolation_probe -> window_layout | report: layouter -> window_layout\n    + policy | label: app_isolation_probe -> focus         | report: layouter -> focus\n    + policy | label: app_isolation_probe -> st_simple     | report: pkg_runtime_simple -> state\n    + policy | label: app_isolation_probe -> launcher_result | report: sponge_pkgd -> launcher_result\n    + policy | label: app_isolation_probe -> sponge_de_input | report: sponge-de -> input"] \
		$ai_cfg]

	# pkgd's probe_request/probe_result channel: the sanctioned
	# remove+install RESET before the relaunch (never a launch
	# substitute). report_rom is single-writer per label — the arms
	# are mutually exclusive, guarded above.
	set ai_cfg [string map [list \
		"    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result" \
		"    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result\n    + policy | label: sponge_pkgd -> probe_request | report: app_isolation_probe -> probe_request\n    + policy | label: app_isolation_probe -> probe_result | report: sponge_pkgd -> probe_result"] \
		$ai_cfg]

	set ai_cfg [string map [list "    + launcher_request\n" \
		"    + launcher_request\n    + probe_request\n"] $ai_cfg]

	set ai_cfg [string map [list \
		"    + service ROM | label_last: launcher_request | + child report_rom" \
		"    + service ROM | label_last: launcher_request | + child report_rom\n    + service ROM | label_last: probe_request | + child report_rom"] \
		$ai_cfg]

	# alpha_probe runs the minimal hello-only smoke contract (D16.7)
	# on this focused media: the isolation profile stages 3 of the 7
	# launcher pairs and `bake.profile` is `isolation`, so the full W3
	# pair/baked-key table cannot hold. The panel-pixel criterion (a)
	# is unchanged. The per-app acceptance receipts for the FULL set
	# come from the grouped-UI arm (docs/evidence/
	# phase16-runtime-acceptance.md).
	set ai_cfg [string map [list "  + config | skip_lz: yes" \
		"  + config | skip_lz: yes | minimal: yes"] $ai_cfg]

	# The C2 DE-input press witness (sponge-de -> input) is served by
	# Main::eventFilter, which is installed by the DEMO window's
	# constructor and absent on shipped media. Enable the demo in
	# this arm and route its Gui session straight to nitpicker (the
	# proven de-pkgd-failure topology shape); the tier-0 rewrite below
	# pins it in a corner domain clear of every measurement region.
	set ai_cfg [string map [list "    + demo | enabled: no" \
		"    + demo | enabled: yes"] $ai_cfg]

	set ai_cfg [string map [list \
		"    + service Gui | label_last: Sponge Launcher | + parent\n    + service Gui | + child wm" \
		"    + service Gui | label_last: Sponge Launcher | + parent\n    + service Gui | label_last: Sponge DE Demo | + parent\n    + service Gui | + child wm"] $ai_cfg]

	set ai_cfg [string map [list "+ start alpha_probe | caps: 200 | ram: 16M" {+ start app_isolation_probe | caps: 200 | ram: 32M
  + binary | name: bin/app_isolation_probe
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Capture | + parent
    + service Timer | + parent
    + service ROM | label: launcher      | + child report_rom
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service ROM | label: focus         | + child report_rom
    + service ROM | label: st_simple     | + child report_rom
    + service ROM | label: launcher_result | + child report_rom
    + service ROM | label: sponge_de_input | + child report_rom
    + service ROM | label: probe_result | + child report_rom
    + service Report | label: probe_request | + child report_rom
    + any-service
      + parent
      + any-child

+ start alpha_probe | caps: 200 | ram: 16M}] $ai_cfg]

	set ai_fh [open $sysconfig_hid w]
	puts -nonewline $ai_fh $ai_cfg
	close $ai_fh
}

	#
	# Expand the grouped-runtime placeholders (run/runtime-grouped.inc)
	# and then the driver_runtime placeholders (run/driver_runtime.inc).
	# They are @-delimited rather than written as Tcl [command] calls
	# because this block is emitted inside a braced Tcl literal, where no
	# substitution happens at all — an unexpanded bracket would reach the
	# HID parser as a policy node and fail schema validation. The
	# grouped expand runs FIRST so the driver expand's leftover-token
	# check sees the whole picture; the required lists fail loudly if
	# any placeholder survived.
	#
	set grp_fh [open $sysconfig_hid r]
	set grp_hid [runtime_grouped::expand [read $grp_fh] \
	                       [list @GROUPED_RELAY_POLICIES@ \
	                             @GROUPED_ADMISSION_NODES@ \
	                             @GROUPED_PKGD_STATE_ROUTES@]]
	close $grp_fh
	set grp_fh [open $sysconfig_hid w]
	puts -nonewline $grp_fh $grp_hid
	close $grp_fh

	set drv_fh [open $sysconfig_hid r]
	set drv_hid [driver_runtime::expand [read $drv_fh] \
	                       [list @DRIVER_RELAY_POLICIES@ @DRIVER_START_NODE@ @SYSTEM_CAPS@]]
	close $drv_fh
	set drv_fh [open $sysconfig_hid w]
	puts -nonewline $drv_fh $drv_hid
	close $drv_fh

	#
	# Convert HID → XML so the nested init receives unambiguous XML.
	#
	#
	# Top-level supervision: stamp a restart version onto every top-level
	# <start> and derive the supervisor's two templates from THIS file
	# (which stays the single source of truth for the desktop
	# composition).
	#
	supervisor::prepare $sys_dir $sysconfig_hid

	#
	# P2.4 structural assertions (run/runtime-grouped.inc): the three
	# runtime nodes with their derived grant literals, the class
	# config/state policies, the quota ordering (driver first,
	# pkg_runtime_browser last), and the absence of every legacy
	# single-runtime line. Fail-loud before QEMU starts.
	#
	set asr_fh [open $sysconfig_hid r]
	runtime_grouped::assert_wiring [read $asr_fh]
	close $asr_fh

	set xml_content [exec [genode_dir]/tool/hid format --output-xml "$sysconfig_hid"]
	set sysconfig_final [open "$sys_dir/init/system.config" w]
	puts -nonewline $sysconfig_final $xml_content
	close $sysconfig_final
	file delete "$sysconfig_hid"
}

# ========================================================================
# Tier-0 init configuration
# ========================================================================

set tier0_config [subst [supervisor::tier0 {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: pci_decode -> system | report: acpi -> acpi
    + policy | label: platform -> devices  | report: pci_decode -> devices
    + policy | label: usb_hid -> report    | report: usb -> devices
    + policy | label_suffix: focus | report: nitpicker -> focus
    + policy | label_suffix: system_state | report: system -> state
    + policy | label_suffix: hover | report: nitpicker -> hover
    + policy | label: pointer -> xray | report: pointer-xray-none

+ start acpi | caps: 350 | ram: 4M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service IO_MEM | + parent
    + service LOG | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service ROM | + parent

+ start pci_decode | caps: 350 | ram: 2M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service ROM | label: system | + child report_rom
    + service IO_MEM | + parent
    + service LOG | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service ROM | + parent

+ start platform | caps: 200 | ram: 3M | managing_system: yes
  + provides
    + service Platform
    + service Dma
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: devices | + child report_rom
    + service Report | + child report_rom
    + service Timer | + child timer
    + service IRQ | + parent
    + service IO_MEM | + parent
    + service IO_PORT | + parent
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent
  + config
    + report | devices: yes
    + policy | label_prefix: ahci | + pci | class: AHCI
    + policy | label_prefix: ps2  | + device ps2
    + policy | label_prefix: fb   | info: yes | + pci | class: VGA
    + policy | label_prefix: usb  | info: yes | + pci | class: USB
    + policy | label_prefix: nic  | info: yes | + pci | class: ETHERNET
    @DRIVER_PLATFORM_POLICIES@

# The Uplink<->Nic bridge. A SYSTEM SERVICE, not part of any driver
# package: the driver produces raw frames, the router gives the rest of
# the system a Nic session. Its policy matches the sandbox path rather
# than a per-driver name, so installing a second Uplink-providing driver
# needs no change here.
+ start nic_router | caps: 300 | ram: 16M
  + provides
    + service Uplink
    + service Nic
  + config | verbose: no
    |        | verbose_domain_state: yes
    |        | dhcp_discover_timeout_sec: 10
    |        | dhcp_request_timeout_sec:  6
    + policy | label_prefix: system -> driver_runtime | domain: uplink
    + domain uplink
    +   | verbose_packets:  no
    +   | icmp_echo_server: yes
  + route
    + service Timer | + child timer
    + any-service   | + parent | + any-child

#
# P2.6 falkon-startup network/RTC stack (the run/sponge-falkon-disk.run
# proven pair, shared with run/sponge-net-probe.run): ipxe_nic is an
# Uplink CLIENT (dde_ipxe e1000) bridged by nic_uplink to a Nic
# session; falkon's lwip vfs plugin DHCPs over it at startup (the
# plugin's config blocks until the interface is configured — no Nic,
# no falkon window). pc_rtc + system_rtc are the gems system_clock
# pair: falkon's vfs <rtc/> opens an Rtc session at mount ("denied
# Rtc-session" stops falkon at construction, docs/evidence
# phase16-runtime-rom-failures.md lineage). The system node routes
# Nic/Rtc/Uplink to these children EXPLICITLY: nic_router also
# provides Nic+Uplink, so an any-child query would be ambiguous
# (sandbox/child.cc "ambiguous routes to service").
#
+ start nic_uplink | caps: 200 | ram: 8M
  + provides
    + service Uplink
    + service Nic
  + config | verbose: yes
  + route
    + service Timer | + child timer
    + any-service | + parent

+ start nic | caps: 250 | ram: 10M
  + binary ipxe_nic
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Dma | + child platform
    + service Platform | + child platform
    + service ROM | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer
    + service Uplink | + child nic_uplink

+ start pc_rtc | caps: 100 | ram: 2M
  + provides | + service Rtc
  + route
    + service Timer | + child timer
    + any-service | + parent

+ start system_rtc | caps: 100 | ram: 2M
  + provides | + service Rtc
  + route
    + service Rtc | + child pc_rtc
    + service Timer | + child timer
    + any-service | + parent

+ start ahci | caps: 5000 | ram: 128M
  + provides | + service Block
  + config
    + report | ports: yes
    + policy | label_prefix: part_block | device: 0 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Platform | + child platform
    + service Dma | + child platform
    + service Timer | + child timer
    + service Report | + child report_rom
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent

+ start part_block | caps: 200 | ram: 8M
  + provides | + service Block
  + config
    + report | partitions: no
    + policy | label_prefix: vfs | partition: 3 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Block | + child ahci
    + any-service
      + parent
      + any-child

+ start vfs | caps: 16000 | ram: 128M
  + provides | + service File_system
  + config
    + vfs
      + rump | fs: ext2fs | ram: 48M | writeable: yes
    + policy | label_prefix: rom_sys | root: /system     | writeable: no
    + policy | label_prefix: rom_lib | root: /system/lib | writeable: no
    [runtime_browser::vfs_policy]
  + route
    + service ROM | label_last: ld.lib.so     | + parent
    + service ROM | label_last: vfs.lib.so    | + parent
    + service ROM | label_last: vfs_rump.lib.so | + parent
    + service ROM | label_last: rump.lib.so   | + parent
    + service ROM | label_last: rump_fs.lib.so | + parent
    + service Block | + child part_block
    + any-service
      + parent
      + any-child

+ start rom_sys | caps: 500 | ram: 256M
  + binary cached_fs_rom
  + provides | + service ROM
  + route
    + service File_system | + child vfs
    + service ROM | label_last: ld.lib.so | + parent
    + any-service
      + parent
      + any-child

+ start rom_lib | caps: 500 | ram: 256M
  + binary cached_fs_rom
  + provides | + service ROM
  + route
    + service File_system | + child vfs
    + service ROM | label_last: ld.lib.so | + parent
    + any-service
      + parent
      + any-child

# P2.6 browser payload serving: falkon's ~509 MiB closure (binary +
# WebEngine libs + Qt tars, staged at /system/pkg/falkon/payload by
# bake::stage) served as ROM — the shared fragment of
# run/runtime-browser.inc, byte-identical on every product media.
[runtime_browser::rom_pkg_node vfs]

+ start nitpicker | ram: 16M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    + report | focus: yes | hover: yes
    # Pointer cursor domain: front-most (layer 0), positioned at the
    # pointer by nitpicker itself (origin: pointer). The upstream
    # 'pointer' component renders the cursor glyph into it — without
    # this domain + component there is no visible mouse cursor.
    + domain pointer | layer: 0 | content: client | label: no | origin: pointer
    + domain panel | layer: 1 | content: client | label: no
                   | hover: always | focus: click | ypos: 0 | height: 28
    + domain launcher | layer: 2 | content: client | label: no
                      | hover: always | focus: click
                      | xpos: 0 | ypos: 28 | width: 341 | height: 532
    + domain default | layer: 3 | content: client | label: no
                     | hover: always | focus: click | ypos: 28 | height: -28
    + policy | label_prefix: pointer                  | domain: pointer
    + policy | label_prefix: system -> sponge-de -> Sponge Panel   | domain: panel
    + policy | label_prefix: system -> sponge-de -> Sponge Launcher | domain: launcher
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start pointer | caps: 100 | ram: 4M
  + provides
    + service Report
  + config | shapes: no
  + route
    + service Gui | + child nitpicker
    + service ROM | label: hover | + child report_rom
    # The xray ROM is optional (shape-debug feature); without this
    # empty-ROM route the session denial would freeze the component
    # (base-lib DENIED -> sleep_forever, cf. the W3 theme fallback).
    + service ROM | label: xray  | + child report_rom
    + any-service
      + parent
      + any-child

+ start ps2 | caps: 100 | ram: 1280K
  + config
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Dma | + child platform
    + service Platform | + child platform
    + service Event | + child event_filter | label: ps2
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer

+ start usb | caps: 200 | ram: 16M
  + binary pc_usb_host
  + provides | + service Usb
  + config
    + report | devices: yes
    + policy | label_prefix: usb_hid | + device | class: 0x3
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Dma | + child platform
    + service Platform | + child platform
    + service Report | label: devices | + child report_rom
    + service ROM | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer

+ start usb_hid | caps: 180 | ram: 10M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: report | + child report_rom
    + service ROM | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer
    + service Event | + child event_filter | label: usb
    + service Usb | + child usb

+ start event_filter | caps: 90 | ram: 1280K
  + provides | + service Event
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: config | + parent | label: event_filter.config
    + service Event | + child nitpicker
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer

# caps carry ~10% headroom per docs/17 §5 (adding a child must not be
# a cliff-edge operation on a grant sized exactly to fit).
# Children caps-sum of THIS sandbox: 236650 caps
#   report_rom 300 + wm 2000 + layouter 1000 + decorator 350 +
#   sponge_configd 200 + sponge_themed 200 + sponge_pkgd 200 +
#   sponge-de 4000 + alpha_probe 200 + cfg_probe 200 +
#   pkg_runtime_simple 6000 + pkg_runtime_terminal 2000 +
#   pkg_runtime_browser 220000
# Grant 263000 caps => +11.1% caps headroom.
#
# RAM: `512G` IS THE SAME DELIBERATELY-HUGE QUANTUM as
# pkg_runtime_browser's, one level up — same clamp mechanism,
# genode/repos/os/src/lib/sandbox/
# child.cc:481-486. `system` is the LAST `+ start` node in THIS
# top-level config, so it absorbs every MiB the Tier-0 children did not
# claim; inside it, pkg_runtime_browser (also last) absorbs whatever
# the fixed system services and the two explicit class runtimes did
# not. That is what makes the whole stack
# physical-RAM-size agnostic. The declared 3420M it replaces (+10.3%
# over the 3100M fixed-child sum) was a hand-derived constant that only
# happened to fit -m 6G/8G and had to be recomputed whenever -m or a
# package profile changed.
# Caps for `system` stay explicit at 263000 for the reason the class
# runtimes' do — the caps clamp hangs on seL4; see the caps rationale
# at the runtime node block below.
#
+ start system | caps: @SYSTEM_CAPS@ | ram: 512G
  + binary | name: bin/init
  + route
    + service ROM | label: config | + child rom_sys | label: init/system.config
    + service ROM | label_last: ld.lib.so | + parent
    #
    # falkon's payload ROMs (P2.4: the BROWSER class owns them, so the
    # rules are pkg_runtime_browser-scoped — run/runtime-grouped.inc;
    # P2.6: served from disk via rom_pkg below). BEFORE the generic
    # .lib.so rule: the WebEngine closure exists only in the payload.
    #
    [runtime_grouped::falkon_rom_rules]
    + service ROM | label_suffix: .lib.so | + child rom_lib
    + service ROM | label_last: focus | + child report_rom
    + service ROM | label_last: hover | + child report_rom
    + service ROM | label_last: system_state | + child report_rom
    #
    # platform_info BEFORE the rom_sys catch-all: a CORE rom module
    # (base-sel4 exports it from the multiboot2 boot info,
    # core/platform.cc:629), matched by label_LAST because the query
    # label is child-scoped at whichever node the request arrives at.
    # Every `<service>` node is "specific" in
    # repos/os/src/lib/sandbox/route_model.h, so the rom_sys denial
    # below would otherwise stop the search silently. The BIOS media
    # needs it too once the display driver is a package: the fb-switch
    # proof installs fb_boot here, and fb_boot reads this ROM. Whether
    # the SeaBIOS/GRUB2 media actually carries a framebuffer tag is a
    # separate, measured question (docs/15 §8).
    + service ROM | label_last: platform_info | + parent
    #
    # P2.6: falkon's startup sessions, pinned explicitly. Nic goes to
    # the ipxe_nic/nic_uplink falkon stack and Rtc to the system_clock
    # pair (both above); Uplink stays pinned to nic_router so a future
    # driver package (vct install pc_nic) keeps the product bridge and
    # the two Nic/Uplink providers can never make an any-child query
    # ambiguous (sandbox/child.cc "ambiguous routes to service").
    #
    + service Nic   | + child nic_uplink
    + service Rtc   | + child system_rtc
    + service Uplink | + child nic_router
    + service ROM | + child rom_sys
    + service Gui | + child nitpicker
    + service Capture | + child nitpicker
    + service Event | + child nitpicker
    + service Timer | + child timer
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }]]
set tier0_config [driver_runtime::expand $tier0_config \
                       [list @DRIVER_PLATFORM_POLICIES@]]
runtime_grouped::assert_tier0 $tier0_config
runtime_browser::assert_tier0 $tier0_config vfs

#
# SPONGE_APP_ISOLATION: pin the demo window (the C2 press observer's
# host) in a corner domain clear of every measurement region —
# x 600..1000 vs the textedit frame (46..566), the popup (0..341),
# the closer points (554..558) and every click column. The de-pkgd-
# failure topology's domain + direct-Gui shape, arm-gated only.
#
if {$app_isolation} {
	set ai_t0 [string map [list \
		"    + domain default | layer: 3 | content: client | label: no\n                     | hover: always | focus: click | ypos: 28 | height: -28" \
		"    + domain demo | layer: 2 | content: client | label: no\n                  | hover: always | focus: click\n                  | xpos: 600 | ypos: 30 | width: 400 | height: 300\n    + domain default | layer: 3 | content: client | label: no\n                     | hover: always | focus: click | ypos: 28 | height: -28"] \
		$tier0_config]
	set ai_t0 [string map [list \
		"    + policy | label_prefix: system -> sponge-de -> Sponge Launcher | domain: launcher" \
		"    + policy | label_prefix: system -> sponge-de -> Sponge Launcher | domain: launcher\n    + policy | label_prefix: system -> sponge-de -> Sponge DE Demo | domain: demo"] \
		$ai_t0]
	set tier0_config $ai_t0
}

install_config $tier0_config

#
# Stage the driver sub-init config modules (Tier-0 boot modules).
#
# fb.config is gone from this list: the framebuffer mode is declared in
# pkg/fb_vesa/metadata.xml and reaches the driver as the inline <config>
# of its generated <start> node, so there is no Tier-0 ROM to relay.
#
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

#
# SPONGE_GROUPED_UI / SPONGE_APP_ISOLATION: REWRITE the staged
# event_filter.config with the
# W4 usb-tablet <transform> scale (the exact recipe proven by
# run/sponge-terminal-qmp.run and run/sponge-wm-qmp.run). QEMU 11's
# usb-tablet reports absolute positions in device units (0..32767 per
# axis) and nitpicker treats Absolute_motion values as raw pixels, so
# unscaled tablet events clamp to the screen corner. The scale maps
# device units to the 1024x768 framebuffer (1024/32767, 768/32767) —
# with it, `QMP-TARGET tablet <x> <y>` lands on the target pixel
# (W4: ±0-1px). The rewrite happens ONLY inside these arms: the default
# path stages the untouched recipe above. Everything else (chargen
# includes, ps2 accelerate wrapper, mod/repeat blocks) is identical to
# the proven scenario configs.
#
if {$grouped_ui || $app_isolation} {
	set ef [open "bin/event_filter.config" w]
	puts $ef {<config>
  <output>
    <chargen>
      <merge>
        <accelerate max="50" sensitivity_percent="1000" curve="127">
          <button-scroll>
            <input name="ps2"/>
            <vertical button="BTN_MIDDLE" speed_percent="-10"/>
            <horizontal button="BTN_MIDDLE" speed_percent="-10"/>
          </button-scroll>
        </accelerate>
        <transform>
          <scale x="0.0312517" y="0.0234382"/>
          <input name="usb"/>
        </transform>
      </merge>
      <mod1><key name="KEY_LEFTSHIFT"/><key name="KEY_RIGHTSHIFT"/></mod1>
      <mod2><key name="KEY_LEFTCTRL"/><key name="KEY_RIGHTCTRL"/></mod2>
      <mod3><key name="KEY_RIGHTALT"/>AltGr</mod3>
      <repeat delay_ms="230" rate_ms="90"/>
      <include rom="en_us.chargen"/>
      <include rom="special.chargen"/>
    </chargen>
  </output>
  <policy label="ps2" input="ps2"/>
  <policy label="usb" input="usb"/>
</config>}
	close $ef
	if {$grouped_ui} {
		puts "grouped-ui: event_filter.config rewritten with usb tablet scale"
	} else {
		puts "app-isolation: event_filter.config rewritten with usb tablet scale"
	}
}

#
# Keyboard layouts consumed by event_filter.
#
set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

#
# Tier-0 boot module list — storage chain + drivers + nitpicker ONLY.
# ld.lib.so is auto-injected by boot_dir/sel4 (docs/11 §10.4).
# The vfs+rump chain libs are transitive deps not in build_artifacts.
# Desktop components (wm/sponge-de/Qt6/Mesa/etc.) are on DISK, NOT here.
#
set boot_modules { }
# vesa_fb is NOT here any more: it is the fb_vesa PACKAGE's binary and
# is served from /system/bin like every other packaged component
# (driver_packages::stage copies it). The display comes up when pkgd
# seeds the manifest and starts it inside driver_runtime.
foreach m { core-sel4.a ld-sel4.lib.so init timer report_rom nitpicker platform acpi pci_decode \
            ahci part_block vfs cached_fs_rom nic_router \
            ipxe_nic nic_uplink pc_rtc system_rtc \
            ps2 pc_usb_host usb_hid event_filter pointer } {
	lappend boot_modules $m
}
foreach m { vfs.lib.so vfs_rump.lib.so rump.lib.so rump_fs.lib.so \
            en_us.chargen special.chargen \
            event_filter.config } {
	lappend boot_modules $m
}

#
# Top-level supervision (sponge_supervisor + sponge_console + their two
# config modules). Both are small base-lib binaries; the Tier-0 budget
# check below is asserted against image.elf, not against a hope.
#
foreach m [supervisor::boot_modules] { lappend boot_modules $m }

# The kernel's early framebuffer console mirrors debug output over the
# composited desktop. Keep it off on product media; SPONGE_FBCON=on is the
# diagnostic escape hatch and leaves the serial log unchanged. run_boot_dir
# generates grub.cfg and then calls run_image, so the override must happen
# inside image assembly rather than after build_boot_image returns.
set fbcon_token "off"
if {[info exists ::env(SPONGE_FBCON)]} {
	if {$::env(SPONGE_FBCON) ni {on off}} {
		error "SPONGE_FBCON must be 'on' or 'off'"
	}
	set fbcon_token $::env(SPONGE_FBCON)
}
rename run_image run_image_without_fbcon_override
proc run_image {} {
	global fbcon_token
	set grub_cfg "[run_dir]/boot/grub/grub.cfg"
	set grub_fh [open $grub_cfg r]
	set grub_body [read $grub_fh]
	close $grub_fh
	set sel4_cmdline "module2 /boot/sel4 sel4 disable_iommu"
	if {[string first $sel4_cmdline $grub_body] < 0} {
		error "BIOS GRUB sel4 command line not found for fbcon configuration"
	}
	set grub_fh [open $grub_cfg w]
	puts -nonewline $grub_fh [string map \
		[list $sel4_cmdline "$sel4_cmdline fbcon=$fbcon_token"] $grub_body]
	close $grub_fh
	puts "sponge-desktop-disk: kernel fb console $fbcon_token (SPONGE_FBCON=on enables diagnostic output)"
	run_image_without_fbcon_override
}

build_boot_image $boot_modules

#
# Assert Tier-0 budget: image.elf must be ≤ 80 MiB (docs/14 §4.5).
#
set image_elf "[run_dir]/boot/image.elf"
if {[file exists $image_elf]} {
	set size_bytes [file size $image_elf]
	set size_mib [expr {$size_bytes / 1048576}]
	puts "sponge-desktop-disk: image.elf = ${size_mib} MiB ($size_bytes bytes)"
	if {$size_mib > 80} {
		puts "sponge-desktop-disk: ERROR — Tier-0 budget exceeded (>80 MiB, §4.5)"
	}
} else {
	puts "sponge-desktop-disk: image.elf not found at expected path"
}

#
# Assert ld.lib.so is NOT in /system/lib/ (§4.6 rule).
#
set ld_check "$sys_dir/lib/ld.lib.so"
if {[file exists $ld_check]} {
	puts "sponge-desktop-disk: ERROR — ld.lib.so found in /system/lib/ (§4.6 violation)"
}

#
# QEMU: -m 6G now only sets the CEILING on guest RAM. It no longer has to
# match any declared grant, because `system` and `pkg_runtime_browser`
# are remainder clamps (child.cc:481-486) and track whatever init actually
# has. 6G is kept unchanged deliberately: every receipt in
# docs/evidence/ was earned at 6G, and changing the value would
# invalidate that evidence for no functional gain. A SMALLER -m also
# works — pkg_runtime_browser just receives a proportionally smaller remainder,
# and `sponge_pkgd`'s admission control refuses a package that no longer
# fits instead of letting init clamp it into a hang.
# Historical arithmetic, kept for provenance: -m 6G => "5686 MiB RAM and
# 523288 caps assigned to init", i.e. core reserves ~458M of guest RAM
# for kernel/rootserver; the previous fixed grants asked for Tier-0
# children 874M + system 3420M = 4294M, leaving ~1392M of slack. At the
# old -m 4G the pool was 3667 MiB — ~627M SHORT of 4294M, which is why
# 4G could not work before the clamp. Measured post-change, see
# docs/evidence/remainder-clamp-ram.md.
# nec-usb-xhci + usb-tablet for absolute pointer.
#
# Phase 12 W1 (docs/plans/phase12-hardware.md W1): pin the platform
# explicitly. PC board default already supplies -machine q35
# -cpu Skylake-Client; this makes the contract local and guards
# against a silent board-default regression. Existing storage/device
# arguments and the 900 s alpha-probe gate are preserved.
#
append qemu_args " -machine q35 -cpu Skylake-Client "
append qemu_args " -nographic -m 6G "
append qemu_args " -device nec-usb-xhci,id=xhci -device usb-tablet "
# P2.6: the falkon-startup NIC (bound by ipxe_nic inside the guest).
append qemu_args " -device e1000 "

#
# SPONGE_GROUPED_UI / SPONGE_APP_ISOLATION: open the QMP control socket
# and source the shared run/qmp.inc helper (the Phase-10 QMP-TARGET
# dispatch contract). The socket is added ONLY inside these arms - the
# shipped media boots with no QMP socket. The port append must happen
# BEFORE the first run_genode_until below (power_on consumes qemu_args
# at spawn).
#
if {$grouped_ui || $app_isolation} {
	source [file join [file dirname [file normalize [info script]]] qmp.inc]
	set qmp_port [qmp_pick_port]
	append qemu_args " -qmp tcp:127.0.0.1:${qmp_port},server=on,wait=off "
}

#
# Verification gate.
#
# SUCCESS: alpha-probe logs PASS after confirming themed panel pixel,
# launcher feed (hello), and configd broadcast — all from disk-served
# binaries. Bounded timeout (fail-loud on expiry).
#
# FAILURE CHANNEL: bounded by timeout; the nested init's XML parse
# error identifies the stage (corrupted system.config).
#
if {$fail_mode} {
	run_genode_until {.*init -> system.*Error.*config.*|.*system.*invalid.*|.*Error reading config.*} 120
	puts "sponge-desktop-disk: FAILURE CHANNEL — system init rejected corrupted config (bounded, identified)"
} else {

	#
	# Gate ORDER follows emission order, and the run tool consumes the
	# serial stream sequentially: a gate can only match a marker that
	# comes AFTER the previous gate matched. alpha_probe and
	# fb_switch_probe run concurrently, so which of the two finishes
	# first is a race — with the fb arm enabled, the switch proof is
	# gated FIRST (its PASS is its own last marker, and it exits 1 with
	# the failing phase named if anything inside it fails), then
	# alpha-probe as the second receipt.
	#
	#
	# alpha_probe and fb_switch_probe are independent and concurrent, so
	# which of the two finishes first is a race — gating them in a fixed
	# order is a coin flip. ONE gate with an alternation waits for
	# whichever lands first, and the two receipts are then asserted
	# against the accumulated output, which is order-independent.
	#
	# SPONGE_SUPERVISOR_TEST=contain gates the fault child's WEDGE first
	# (ep_wedge fires it `wedge_after_ms` into each incarnation, well
	# before alpha-probe finishes its assertion sequence): the gate order
	# is then itself the receipt that the DE functional PASS below is
	# POST-wedge — the desktop proves itself while a runtime child is
	# already wedged and being contained underneath it. The two-argument
	# run_genode_until form POWERS ON the guest, so this pre-gate is the
	# boot call and the alpha gates below must pass its spawn id.
	#
	set gate_spawn -1
	if {$sup_mode eq "contain"} {
		run_genode_until {.*ep_wedge: wedge fired - entrypoint parked.*} 300
		set gate_spawn $qemu_spawn_id
	}
	#
	# SPONGE_GROUPED_UI: the hello autostart receipt (P5.1 app matrix).
	# `hello from package: running` is the hello package's own
	# self-report (pkg_hello, the <autostart/> claim) and lands during
	# pkgd's boot-time install — stably BEFORE alpha-probe's PASS
	# (alpha's criterion (b) itself waits for the hello feed entry), so
	# gating it here cannot consume the alpha marker. The debug
	# package's FIRSTPAINT self-report is NOT gated here on purpose:
	# its Qt startup races alpha-probe's PASS in both directions (R1:
	# FIRSTPAINT landed AFTER alpha's PASS and a fixed-order gate
	# swallowed the alpha marker — docs/evidence/phase16-p51-grouped-
	# app-matrix.md), so it is asserted from the ACCUMULATED output at
	# the debug leg instead, where no gate can lose it.
	#
	if {$grouped_ui && !$fail_mode} {
		run_genode_until {.*hello from package: running.*} 420 $gate_spawn
		set gate_spawn $qemu_spawn_id
	}
	if {$fb_switch} {
		run_genode_until {.*(alpha-probe: PASS|fb-switch-probe: PASS).*} 1200 $gate_spawn
		#
		# Follow-up gates MUST pass $qemu_spawn_id: a call without it is
		# a fresh BOOT (run_genode_until does run_power_cycle +
		# run_load), and a second boot while the first QEMU still holds
		# the image is a write-lock failure, not a test result.
		#
		if {[string first "alpha-probe: PASS" $output] < 0} {
			run_genode_until {.*alpha-probe: PASS.*} 900 $qemu_spawn_id
		}
		if {[string first "fb-switch-probe: PASS" $output] < 0} {
			run_genode_until {.*fb-switch-probe: PASS.*} 900 $qemu_spawn_id
		}
		set _missing ""
		foreach m {"alpha-probe: PASS" "fb-switch-probe: PASS"} {
			if {[string first $m $output] < 0} { append _missing " $m" }
		}
		if {$_missing ne ""} {
			puts "\nsponge-desktop-disk: FB SWITCH FAIL - missing receipt(s):\
 $_missing\n"
			exit 1
		}
	} else {
		run_genode_until {.*alpha-probe: PASS.*} 900 $gate_spawn
	}

	#
	# === SPONGE_GROUPED_UI — P2.4 D16R.11 grouped-runtime UI acceptance ===
	#
	# Explicit QMP-TARGET instructions (the probe emits one marker at a
	# time; each qmp_exec_target call below dispatches exactly one real
	# input event through run/qmp.inc):
	#
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle (open popup)
	#   QMP-TARGET tablet <x> <y>   hello launcher menu entry (autostart)
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle
	#   QMP-TARGET tablet <x> <y>   debug launcher menu entry (autostart)
	#   QMP-TARGET tablet <x> <y>   debug Mark button click (6 candidates)
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle
	#   QMP-TARGET tablet <x> <y>   simple-class launcher menu entry
	#   QMP-TARGET tablet <x> <y>   focus click on the simple-class input widget
	#   QMP-TARGET type <string>    typed input, simple class
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle (second open)
	#   QMP-TARGET tablet <x> <y>   terminal-class launcher menu entry
	#   QMP-TARGET tablet <x> <y>   focus click in the terminal window
	#   QMP-TARGET type echo grouped-ok  typed input, terminal class
	#   QMP-TARGET key ret          submit, then execution delta
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle
	#   QMP-TARGET tablet <x> <y>   browser-class launcher menu entry
	#   QMP-TARGET tablet <x> <y>   focus click (browser URL bar)
	#   QMP-TARGET type sponge      typed input, browser class
	#   (no QMP: browser settle — child-set stability gate)
	#   (no QMP: falkon removed — pkgd remove teardown on the
	#    probe_request channel; the falkon window + class child are
	#    gone before any later spawn)
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle
	#   QMP-TARGET tablet <x> <y>   files launcher menu entry
	#   QMP-TARGET tablet <x> <y>   files list-row click (3 double-click candidates = 6 clicks)
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle
	#   QMP-TARGET tablet <x> <y>   pdf_view launcher menu entry
	#   QMP-TARGET tablet <x> <y>   focus click (pdf page)
	#   QMP-TARGET key pgdn         page-down input (two-page sample: page flip)
	#   QMP-TARGET key down         scroll input (port blit applies no pan)
	#   (no QMP: debug removed — pkgd remove teardown before the
	#    calculator spawn; calculator's entry sits ABOVE debug's in
	#    the Utilities section, so the remaining entry click does
	#    not shift)
	#   QMP-TARGET tablet <x> <y>   panel launcher toggle
	#   QMP-TARGET tablet <x> <y>   calculator launcher menu entry
	#   QMP-TARGET tablet <x> <y>   focus click (inputSpinBox1)
	#   QMP-TARGET type 17          digit input
	#   QMP-TARGET key up           spin input
	#   QMP-TARGET tablet <x> <y>   focus click (textedit, above the sibling stack)
	#   QMP-TARGET type sponge      last typed delta (concurrent windows)
	#
	# Every gate is an explicit alternation with the probe's FAIL
	# marker (bounded, fail-loud — never a silent hang), and the single
	# `grouped-ui-probe: PASS` is gated LAST, only after all classes
	# passed first paint + typed input and the terminal produced output.
	# Gate patterns carry no trailing
	# `.*`: a QMP-TARGET line co-buffered after a gate line must remain
	# for the next qmp_exec_target instead of being eaten by the gate.
	#
	if {$grouped_ui} {
		global qemu_spawn_id
		match_max -i $qemu_spawn_id 200000

		# Verbatim probe FAIL line for the receipt (first match only,
		# bounded); empty when the captured output carries none.
		proc grouped_ui_fail_reason {output} {
			foreach line [split $output "\n"] {
				set t [string trim $line]
				set i [string first "grouped-ui-probe: FAIL" $t]
				if {$i >= 0} {
					return [string range $t $i end]
				}
			}
			return ""
		}

		run_genode_until {(grouped-ui-probe: ready|grouped-ui-probe: FAIL)} 300 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "probe failed before the QMP phase"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		set qmp_chan [qmp_connect $qmp_port]

		#
		# === P5.1 app matrix — hello (GUI-free autostart) ===
		#
		# The feed receipt (probe logged hello/Utilities in the ready
		# window), then a REAL launcher entry click whose documented
		# result is `already-running` (hello autostarts at install and
		# carries no window — paint/input are N/A by design).
		#
		if {[string first "grouped-ui-probe: hello/Utilities" $output] < 0} {
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — launcher feed \
missing hello/Utilities\n"
			exit 1
		}

		# QMP-TARGET tablet: panel toggle + hello menu entry
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: hello launcher entry click|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "hello launcher entry click"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}
		if {[string first "sponge_pkgd: launch result hello -> already-running" $output] < 0} {
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — hello launch \
result never answered already-running (channel=launcher)\n"
			exit 1
		}

		#
		# === P5.1 app matrix — debug (autostart monitor) ===
		#
		# Real launcher entry click (also documented already-running),
		# the probe's Capture receipt on the boot-first-painted window,
		# and a Mark-click rendered delta cross-checked against the
		# app's own "sponge_debug: MARK" log.
		#
		# QMP-TARGET tablet: panel toggle + debug menu entry
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: debug launcher entry click|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "debug launcher entry click"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}
		if {[string first "sponge_pkgd: launch result debug -> already-running" $output] < 0} {
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — debug launch \
result never answered already-running (channel=launcher)\n"
			exit 1
		}
		#
		# The debug package's FIRSTPAINT self-report
		# (sponge_debug FirstPaintProbe, autostarted at boot). Asserted
		# from the ACCUMULATED output: it races alpha-probe's PASS in
		# either direction, so it can sit in any earlier gate window.
		#
		if {[string first "sponge_debug: FIRSTPAINT ms=" $output] < 0} {
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — debug FIRSTPAINT \
self-report (sponge_debug: FIRSTPAINT ms=) not recorded\n"
			exit 1
		}

		# QMP-TARGET tablet x6 (Mark-button candidate column — the
		# probe stops targeting Mark after the first rendered delta
		# and lands the rest on its status label), then the app's own
		# MARK log
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: debug-class mark-click delta|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "debug-class mark-click delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}
		if {[string first "sponge_debug: MARK" $output] < 0} {
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — Mark click never \
reached the debug Mark button (no sponge_debug: MARK log)\n"
			exit 1
		}

		# QMP-TARGET tablet: panel toggle + simple-class menu entry
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: simple-class first paint|grouped-ui-probe: FAIL)} 420 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "simple-class first paint"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET tablet (input focus) + QMP-TARGET type
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: simple-class typed delta|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "simple-class typed delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET tablet: panel toggle + terminal-class menu entry
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: terminal-class first paint|grouped-ui-probe: FAIL)} 420 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "terminal-class first paint"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET tablet (focus) + QMP-TARGET type
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: terminal-class typed delta|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "terminal-class typed delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET key ret, then rendered command-output evidence
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: terminal-class execution delta|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "terminal-class execution delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		#
		# === P5.1 browser leg (P2.6 shape, UNCHANGED) — position 5,
		# after terminal and before files: R5's proven green slot
		# (first paint + typed input with three Qt apps resident).
		# R24 proved launching LAST dies in rom_pkg's closure load
		# over six resident Qt/mupdf apps; R25/R26 proved launching
		# THIRD misroutes the calibrated URL-bar click/type even on
		# a quiet band (click_changed=11265/10018 vs R5's 990). The
		# settle gate below keeps later child spawns out of the
		# closure window (R5's collision class: files' child
		# creation hit 226 seL4 "Source slot invalid or empty"
		# errors while falkon's closure was still resolving).
		#
		# QMP-TARGET tablet: panel toggle + browser-class menu entry
		# (falkon). The first-paint gate carries the longer browser
		# budget: falkon's WebEngine closure resolves from disk before
		# its window can appear. No page-load gate.
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: browser-class first paint|grouped-ui-probe: FAIL)} 600 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "browser-class first paint"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET tablet (URL-bar focus) + QMP-TARGET type
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: browser-class typed delta|grouped-ui-probe: FAIL)} 180 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "browser-class typed delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# Browser settle (no input dispatch): the probe waits for
		# pkg_runtime_browser's child set to stabilize before any
		# later child spawn.
		run_genode_until {(grouped-ui-probe: browser settle|grouped-ui-probe: FAIL)} 60 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "browser settle"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		#
		# === P5.1 falkon teardown (pkgd remove, probe_request
		# channel — NO QMP dispatch) ===
		#
		# The probe destroys falkon via pkgd's `remove` (the one
		# sanctioned pkgd call, teardown only) and waits for the
		# falkon window to leave window_list AND pkg_runtime_browser's
		# state report to lose its live child. R29 proved the
		# counterfactual: with falkon resident, the files spawn died
		# in core's CNode construction (228x "Cnode construction
		# failed" + seL4 "Source slot invalid or empty"). Everything
		# after this gate spawns into the freed budget.
		#
		run_genode_until {(grouped-ui-probe: falkon removed|grouped-ui-probe: FAIL)} 300 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "falkon removed"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		#
		# === P5.1 app matrix — files ===
		#
		# First paint + a REAL QMP double-click (two back-to-back
		# QMP-TARGET tablet dispatches inside Qt's double-click
		# interval) on the first list row, navigating into /demo. The
		# navigation receipt is the app's own "sponge_files: navigate
		# -> /demo" log + the probe's structural files-report check.
		# NOTE: falkon is already torn down above, so this spawn (and
		# the pdf_view/calculator spawns) run in the freed budget —
		# the R5/R29 collision class (a child created while falkon's
		# WebEngine closure was resident dies in core's CNode
		# construction) cannot recur here.
		#
		# QMP-TARGET tablet: panel toggle + files menu entry
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: files-class first paint|grouped-ui-probe: FAIL)} 420 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "files-class first paint"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET tablet x6 — three double-click candidates on the
		# list rows (post-win clicks land on the path label). Each pair
		# is dispatched TIGHTLY: the generic one-marker-one-dispatch
		# path leaves mouse_set/abs/after overhead between the presses
		# and that races Qt's 400ms doubleClickInterval (R8/R11 missed
		# the double-click, R9 hit it — 1/3). The tight form keeps the
		# marker contract (one QMP-TARGET tablet = one click gesture)
		# but realizes the second press immediately after the first
		# release — the cursor is already on target, so only the button
		# events are needed. The span print is the timing receipt.
		proc grouped_ui_double_click {chan what} {
			global qemu_spawn_id
			set x 0
			set y 0
			expect {
				-i $qemu_spawn_id
				-re {QMP-TARGET tablet (-?\d+) (-?\d+)\r*\n} {
					set x $expect_out(1,string)
					set y $expect_out(2,string)
				}
				timeout 120 {
					puts stderr "\ngrouped-ui: FAIL - no $what click marker"
					exit 1
				}
			}
			expect {
				-i $qemu_spawn_id
				-re {QMP-TARGET tablet (-?\d+) (-?\d+)\r*\n} { }
				timeout 120 {
					puts stderr "\ngrouped-ui: FAIL - no $what click marker (2nd)"
					exit 1
				}
			}
			set t0 [clock milliseconds]
			qmp_tablet_click $chan $x $y
			qmp_hmp $chan "mouse_button 1"
			qmp_hmp $chan "mouse_button 0"
			puts "\ngrouped-ui: $what double-click at ($x,$y) span: \
[expr {[clock milliseconds] - $t0}]ms"
		}
		grouped_ui_double_click $qmp_chan "files pair 1"
		grouped_ui_double_click $qmp_chan "files pair 2"
		grouped_ui_double_click $qmp_chan "files pair 3"
		run_genode_until {(grouped-ui-probe: files-class navigation delta|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "files-class navigation delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}
		#
		# The navigation receipt is the probe's structural check (the
		# files report path=/demo + the rendered delta, both in the
		# marker above). The app's "sponge_files: navigate -> /demo"
		# serial line corroborates in the raw log but CANNOT be gated
		# here: it fires between the double-click dispatches and the
		# marker-dispatch expects consume it out of the gate window
		# (R9: the line is present in the log yet invisible to
		# `string first` at this point).
		#

		#
		# === P5.1 app matrix — pdf_view ===
		#
		# First paint + page-down/scroll input, delivered as the app's
		# OWN physical-key bindings (app/pdf_view main.cc maps
		# KEY_PAGEDOWN -> pdfapp '.' page flip and KEY_DOWN -> pdfapp
		# 'j' scroll via ev.key_press). The staged sample.pdf is
		# TWO pages (this file's staging block) because page-down is
		# a no-op on a one-page document (pdfapp.c clamps pageno to
		# pagecount); scroll alone renders nothing on this port
		# (Pdf_view::show applies no pan), so both inputs are
		# dispatched and measured, the delta is asserted over the
		# pair, and each input's contribution is logged separately.
		#
		# QMP-TARGET tablet: panel toggle + pdf_view menu entry
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: pdf-view-class first paint|grouped-ui-probe: FAIL)} 420 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "pdf-view-class first paint"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET tablet (focus) + QMP-TARGET key pgdn + key down
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: pdf-view-class page-down/scroll input delta|grouped-ui-probe: FAIL)} 180 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "pdf-view-class page-down/scroll input delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		#
		# === P5.1 debug teardown (pkgd remove, probe_request
		# channel — NO QMP dispatch) ===
		#
		# debug's receipt (first paint + Mark click) is banked; the
		# probe now destroys it via pkgd `remove` and waits for its
		# window + st_simple child to go away. R30 proved the
		# counterfactual: with debug's Qt closure resident, the
		# calculator's first mapping died in core's CNode
		# construction ("Cnode construction failed" + "mapping
		# failure for thread 'ep' in pd ... -> calculator").
		# Layout safety: calculator's launcher entry sits ABOVE
		# debug's in the Utilities section, so its click y is
		# invariant to the removal; the files/pdf_view entry clicks
		# are already banked.
		#
		run_genode_until {(grouped-ui-probe: debug removed|grouped-ui-probe: FAIL)} 300 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "debug removed"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		#
		# === P5.1 app matrix — calculator ===
		#
		# First paint + unconditional QMP digits/spin on inputSpinBox1
		# with the result-band delta (the calculator is its own leg,
		# never a fallback).
		#
		# QMP-TARGET tablet: panel toggle + calculator menu entry
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: calculator-class first paint|grouped-ui-probe: FAIL)} 420 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "calculator-class first paint"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET tablet (spinbox focus) + QMP-TARGET type 17
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: calculator-class digits result delta|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "calculator-class digits result delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		# QMP-TARGET key up (spin), then the spin result delta
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: calculator-class spin result delta|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "calculator-class spin result delta"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}

		#
		# === P5.1 final assertion — concurrent windows ===
		#
		# >=5 NON-FALKON app windows from >=2 runtime classes mapped
		# simultaneously, with the last typed delta delivered while
		# the sibling windows remain mapped. The probe counts the
		# class-prefixed window set minus the browser class (falkon
		# and debug are both torn down above — keeping them mapped
		# would re-poison the spawn budget and each keeps its own
		# receipt), types into the textedit window ABOVE the sibling
		# stack (every stacked sibling sits at y=328 and reaches past
		# textedit's center column; the clear band above the stack
		# is the only textedit-only region), and re-checks the
		# sibling set. The surviving
		# set is exactly five windows (textedit, terminal, files,
		# pdf_view, calculator) from the simple + terminal classes.
		#
		# QMP-TARGET tablet (textedit focus) + QMP-TARGET type sponge
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		run_genode_until {(grouped-ui-probe: concurrent windows n=|grouped-ui-probe: FAIL)} 120 $qemu_spawn_id
		if {[string first "grouped-ui-probe: FAIL" $output] >= 0} {
			set reason [grouped_ui_fail_reason $output]
			if {$reason eq ""} {
				set reason "concurrent windows"
			}
			puts "\nsponge-desktop-disk: GROUPED UI FAIL — $reason\n"
			exit 1
		}
		foreach m {"grouped-ui-probe: concurrent typed delta" \
		           "grouped-ui-probe: concurrent siblings held"} {
			if {[string first $m $output] < 0} {
				puts "\nsponge-desktop-disk: GROUPED UI FAIL — missing \
receipt: $m\n"
				exit 1
			}
		}

		run_genode_until {grouped-ui-probe: PASS} 120 $qemu_spawn_id
		puts "sponge-desktop-disk: GROUPED UI PASS — real launcher input reached\
 every built-in desktop package (hello entry+already-running, debug entry+capture+\
 Mark click, textedit/terminal/falkon first paint + typed input, falkon+debug\
 pkgd-remove teardowns, files double-click navigation, pdf_view page-down/scroll,\
 calculator digits/spin result) and the five-window concurrent set (textedit,\
 terminal, files, pdf_view, calculator) held while the last typed delta landed"
		qmp_disconnect $qmp_chan
	}

	#
	# === SPONGE_APP_ISOLATION — P5.1 app-isolation acceptance ===
	#
	# QMP-TARGET instruction batches (fixed dispatch count per gate):
	#
	#   t0 (0) state baseline                 -> wedge state t0
	#   K1+K2+W1 x6 open slots + 3-row salvo   -> wedge launched + wedge fired + kill apps first paint
	#   (0) closer geometry derivation       -> kill closer geometry
	#   K3 x2 closer candidate A + B         -> kill victim-gone
	#   K4 x2 toggle x2 (DE-input witness)   -> kill de-input ok
	#   K5 x2 calculator spin click + type   -> kill sibling typed delta
	#   (0) pkgd remove+install reset        -> kill reset ok
	#   K6 x6 open slots + solo salvo (band rows) -> kill relaunch first paint
	#   K7 x2 textedit focus click + type    -> kill relaunch typed delta
	#   (0) ep_wedge wedge marker (early gate) -> wedge fired
	#   W2a x2 toggle x2 (DE-input witness)  -> wedge de-input ok
	#   W2b x3 raise click + spin click + type -> wedge survivors
	#   (0) class state t1                   -> wedge state ok
	#   (0) probe verdict                    -> app-isolation-probe: PASS
	#
	# Every gate is an alternation with the probe's FAIL marker
	# (bounded, fail-loud) and the single `app-isolation-probe: PASS`
	# is gated LAST, only after both legs. Gate patterns carry no
	# trailing `.*` (a QMP-TARGET line co-buffered after a gate line
	# must remain for the next qmp_exec_target). The no-churn receipt
	# (zero `sponge_supervisor: version-change` lines) is asserted from
	# the accumulated output, because no log-line gate can express an
	# absence.
	#
	if {$app_isolation} {
		global qemu_spawn_id
		match_max -i $qemu_spawn_id 200000

		proc app_iso_fail_reason {output} {
			foreach line [split $output "\n"] {
				set t [string trim $line]
				set i [string first "app-isolation-probe: FAIL" $t]
				if {$i >= 0} {
					return [string range $t $i end]
				}
			}
			return ""
		}

		proc app_iso_gate {pat what} {
			global qemu_spawn_id output
			run_genode_until $pat 300 $qemu_spawn_id
			if {[string first "app-isolation-probe: FAIL" $output] >= 0} {
				set reason [app_iso_fail_reason $output]
				if {$reason eq ""} {
					set reason $what
				}
				puts "\nsponge-desktop-disk: APP ISOLATION FAIL — $reason\n"
				exit 1
			}
		}

		run_genode_until {(app-isolation-probe: ready|app-isolation-probe: FAIL)} 300 $qemu_spawn_id
		if {[string first "app-isolation-probe: FAIL" $output] >= 0} {
			set reason [app_iso_fail_reason $output]
			if {$reason eq ""} {
				set reason "probe failed before the QMP phase"
			}
			puts "\nsponge-desktop-disk: APP ISOLATION FAIL — $reason\n"
			exit 1
		}

		set qmp_chan [qmp_connect $qmp_port]

		# class state t0 (no QMP) — the launch session below carries
		# ALL three launches, so the state baseline precedes it
		app_iso_gate {(app-isolation-probe: wedge state t0|app-isolation-probe: FAIL)} "wedge state t0"

		# K1+K2+W1 (one first-show popup session): 3 open slots (see-
		# then toggle / heading pads) + the 4-click entry SALVO (pad +
		# textedit row + calculator row + ep_wedge row) — the fixed
		# dispatch count of the probe's _open_popup + _salvo_clicks
		# contract. All later popup sessions cannot deliver entry
		# clicks (stale-view receipts ai-cal2..10), so every launch in
		# the run rides this session.
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: wedge launched|app-isolation-probe: FAIL)} "wedge launched"

		# The wedge marker (ep_wedge's entrypoint parks wedge_after_ms
		# into the incarnation) — gated HERE so the gate order is the
		# receipt that every survival assertion below is POST-wedge.
		run_genode_until {.*ep_wedge: wedge fired - entrypoint parked.*} 120 $qemu_spawn_id

		app_iso_gate {(app-isolation-probe: kill apps first paint|app-isolation-probe: FAIL)} "kill apps first paint"

		# closer geometry derivation (no QMP)
		app_iso_gate {(app-isolation-probe: kill closer geometry|app-isolation-probe: FAIL)} "kill closer geometry"

		# K3: closer candidate A + candidate B / re-hit winner
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: kill victim-gone|app-isolation-probe: FAIL)} "kill victim-gone"

		# K4: DE-input witness (launcher toggle open + close)
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: kill de-input ok|app-isolation-probe: FAIL)} "kill de-input ok"

		# K5: spin/type pairs (spin, type, spin, type) — the type is
		# a per-type flake and the second spin re-establishes the
		# focus layers — 4 slots
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: kill sibling typed delta|app-isolation-probe: FAIL)} "kill sibling typed delta"

		# pkgd remove+install reset (no QMP)
		app_iso_gate {(app-isolation-probe: kill reset ok|app-isolation-probe: FAIL)} "kill reset ok"



		# K6: relaunch — 3 open slots + the 4-click solo SALVO (pad +
		# textedit cand_a + cand_b + pad; the calculator is minimized
		# so the popup clicks deliver)
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: kill relaunch first paint|app-isolation-probe: FAIL)} "kill relaunch first paint"

		# K7: relaunch typed input — focus click + type
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: kill relaunch typed delta|app-isolation-probe: FAIL)} "kill relaunch typed delta"



		# W2a: DE-input witness (launcher toggle open + close)
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: wedge de-input ok|app-isolation-probe: FAIL)} "wedge de-input ok"

		# W2b: sibling delta on the relaunched textedit (the K7
		# clear-band shape — PS/2 focus click + typed digits) — 2 slots
		qmp_exec_target $qmp_chan 120
		qmp_exec_target $qmp_chan 120
		app_iso_gate {(app-isolation-probe: wedge survivors|app-isolation-probe: FAIL)} "wedge survivors"

		# class state t1 + launch receipt (no QMP)
		app_iso_gate {(app-isolation-probe: wedge state ok|app-isolation-probe: FAIL)} "wedge state ok"

		run_genode_until {app-isolation-probe: PASS} 120 $qemu_spawn_id

		# Receipt completeness + no sibling construction-version churn
		# (the supervisor's version-change lines are a rebuild receipt;
		# the wedge child lives INSIDE pkg_runtime_simple and must not
		# bump any top-level construction version).
		set _missing ""
		foreach m {"app-isolation-probe: kill victim-gone" \
		           "app-isolation-probe: kill de-input ok" \
		           "app-isolation-probe: kill sibling typed delta" \
		           "app-isolation-probe: kill relaunch typed delta" \
		           "ep_wedge: wedge fired - entrypoint parked" \
		           "sponge_pkgd: launch result ep_wedge -> ok" \
		           "app-isolation-probe: wedge de-input ok" \
		           "app-isolation-probe: wedge survivors" \
		           "app-isolation-probe: wedge state ok"} {
			if {[string first $m $output] < 0} { append _missing " $m" }
		}
		if {$_missing ne ""} {
			puts "\nsponge-desktop-disk: APP ISOLATION FAIL - missing \
receipt(s):$_missing\n"
			exit 1
		}
		set _churn {}
		foreach line [split $output "\n"] {
			if {[string first "sponge_supervisor: version-change " $line] >= 0} {
				lappend _churn [string trim $line]
			}
		}
		if {[llength $_churn] > 0} {
			puts "\nsponge-desktop-disk: APP ISOLATION FAIL - \
construction-version churn (no sibling churn allowed):\n[join $_churn \n]\n"
			exit 1
		}
		puts "sponge-desktop-disk: APP ISOLATION PASS — closer-kill of \
textedit left the DE input-live (QMP launcher toggle -> sponge-de press \
change) and the sibling calculator typed-input-live (real QMP digits -> \
result-band delta), the victim left window_list, the real launcher \
relaunch answered ok + first paint + typed delta; the ep_wedge package \
wedged its entrypoint from a real launcher entry and the DE + siblings \
(textedit, calculator) stayed functional with windows retained, class \
state live and no construction-version churn"
		qmp_disconnect $qmp_chan
	}

	#
	# === Top-level supervision, product topology =========================
	#
	# Nothing below runs on the shipped media: the supervisor, its config
	# relay and the fault console are always present there and always idle
	# until a fault happens. What follows is the env-gated proof that the
	# chain works in THIS topology - the lean proof is
	# run/sponge-supervisor-takeover.run.
	#
	#   SPONGE_SUPERVISOR_TEST=takeover  the fault child has NO local
	#     containment, so the supervisor is the single restart authority:
	#     detect -> kill -> console (pixels) -> release -> display back
	#
	#   SPONGE_SUPERVISOR_TEST=control   the fault child carries the
	#     product's OWN containment (restart_after_skipped=3), so the
	#     sandbox respawns it forever and the supervisor must do nothing.
	#     The desktop reaches alpha-probe: PASS while the wedged child is
	#     restarted underneath it, which is the receipt that the two
	#     containment layers do not fight - and that a clean probe exit is
	#     not read as a fault.
	#
	#
	# The run tool keeps only the last `match_max` bytes of the stream
	# (2000 by default), and the product boot floods the serial console -
	# so the supervisor's own lines are dropped before a late gate can see
	# them. Raised for the whole proof window, the same fix
	# run/qmp.inc documents for the launch phase.
	#
	match_max -i $qemu_spawn_id 400000

	if {$sup_mode eq "takeover"} {

		run_genode_until {.*sponge_supervisor: FAULT max_skipped=.*} 300 $qemu_spawn_id

		#
		# The kill receipt: the supervisor rewrote the config with a fresh
		# <start> version, so the subtree really was abandoned and
		# respawned. A second incarnation line can only appear if it was.
		#
		run_genode_until {.*sponge_supervisor: published <system> kill=2.*} 120 $qemu_spawn_id
		run_genode_until {.*ep_wedge: incarnation alive . wedging in.*} 120 $qemu_spawn_id

		# the console takes the display, and the claim is a PIXEL claim
		run_genode_until {.*sponge_supervisor: phase=3 .*unrecoverable.*} 180 $qemu_spawn_id
		run_genode_until {.*sponge_console: ARMED role=console.*} 120 $qemu_spawn_id
		run_genode_until {.*takeover_probe: console-up state=console.*} 120 $qemu_spawn_id

		#
		# Bounded release, then the display goes back to the desktop. The
		# gate order follows the EMISSION order, not the causal one: the
		# supervisor logs "CONSOLE RELEASED" before the console has
		# processed the disarming report, so the console's own DISARMED
		# line comes after it. The run tool consumes the stream
		# sequentially, so a gate can only match a marker that follows the
		# previous gate's match (the same lesson as defect #12 in
		# docs/evidence/top-level-supervision.md).
		#
		run_genode_until {.*sponge_supervisor: CONSOLE RELEASED.*} 180 $qemu_spawn_id
		run_genode_until {.*sponge_console: DISARMED.*} 120 $qemu_spawn_id
		run_genode_until {.*sponge_supervisor: phase=1 .desktop restored.*} 180 $qemu_spawn_id
		run_genode_until {.*takeover_probe: pixel state=desktop.*} 180 $qemu_spawn_id

		puts "\nsponge-desktop-disk: SUPERVISOR TAKEOVER PASS - fault detected in\
  the product subtree, subtree killed, console owned the display by\
  pixels, display handed back\n"

	} elseif {$sup_mode eq "control"} {

		#
		# The supervisor must SEE the fault - the wedged child really is
		# being restarted by the sandbox every few seconds - and must then
		# leave everything alone. The second half is the one a log-line
		# gate cannot express, so it is asserted against the run tool's
		# accumulated output.
		#
		run_genode_until {.*sponge_supervisor: FAULT max_skipped=.*} 300 $qemu_spawn_id

		#
		# The periodic liveness line: the supervisor is still polling and
		# still considers the subtree healthy, which is what must keep
		# happening for the whole window.
		#
		run_genode_until {.*sponge_supervisor: nominal .*subtree healthy.*} 300 $qemu_spawn_id

		if {[string first "sponge_supervisor: published <system> kill=2" $output] >= 0 ||
		    [string first "sponge_supervisor: published <system_console>" $output] >= 0} {
			puts "\nsponge-desktop-disk: SUPERVISOR CONTROL FAIL - the supervisor\
  destroyed a desktop the supervised sandbox was already containing\n"
			exit 1
		}
		if {[string first "sponge_console: ARMED" $output] >= 0} {
			puts "\nsponge-desktop-disk: SUPERVISOR CONTROL FAIL - the console was\
  armed on a contained fault\n"
			exit 1
		}

		puts "\nsponge-desktop-disk: SUPERVISOR CONTROL PASS - the sandbox's own\
  containment held, the supervisor killed nothing and armed no console\n"
	} elseif {$sup_mode eq "contain"} {

		#
		# === Containment by name (SPONGE_SUPERVISOR_TEST=contain) ====
		#
		# The fault child (pkg_runtime_fault, ep_wedge, bare heartbeat)
		# wedges EVERY incarnation: a persistent fault that only a
		# restart can fix. The claim under test is that the supervisor
		# contains it BY NAME — only that child's <start> version is
		# bumped — so the sibling runtimes and the DE are never rebuilt.
		# Two full containment cycles are gated: the persistent fault
		# must recur and be re-contained, not merely absorbed once.
		#
		# The gates below follow the emission order of the green run and
		# are NON-FATAL on purpose: under the current global-CONTAIN
		# behaviour the red run's rebuild churns the whole subtree (and
		# on seL4 several recreation attaches fail outright), so a
		# missing revival must be REPORTED by the witness walk below
		# rather than killing the run at a gate timeout before the
		# behavioural findings can be printed. run_genode_until cannot
		# express that (its timeout exits the process), hence the small
		# bounded-expect helper.
		#
		proc contain_gate { re secs what } {
			global output fail qemu_spawn_id
			set timeout $secs
			set rc 1
			expect {
				-i $qemu_spawn_id -re $re { }
				-i $qemu_spawn_id eof {
					lappend fail "$what: the guest died"
					set rc 0
				}
				timeout {
					lappend fail "$what: no match within ${secs}s"
					set rc 0
				}
			}
			# every consumed byte reaches $output on all paths: the
			# witness walk below must see evidence that arrived inside
			# a later gate's window
			if {[info exists expect_out(buffer)]} {
				append output $expect_out(buffer)
			}
			if {$rc} { puts "sponge-desktop-disk: contain gate ok - $what" }
			return $rc
		}

		set fail {}

		contain_gate {.*sponge_supervisor: FAULT max_skipped=.*child=pkg_runtime_fault.*} 300 \
			"the fault is attributed to pkg_runtime_fault"
		contain_gate {.*sponge_supervisor: published <system> kill=2 .*} 120 \
			"the first containment publish"
		contain_gate {.*ep_wedge: incarnation alive .*wedging in.*} 120 \
			"the victim revived by name (2nd incarnation)"
		contain_gate {.*sponge_supervisor: contained - child=pkg_runtime_fault.*} 120 \
			"the victim contained by name"
		contain_gate {.*sponge_supervisor: published <system> kill=3 .*} 120 \
			"the second containment publish"
		contain_gate {.*ep_wedge: incarnation alive .*wedging in.*} 120 \
			"the victim revived again (3rd incarnation)"
		contain_gate {.*sponge_supervisor: contained - child=pkg_runtime_fault.*} 120 \
			"the victim contained again"
		set after_fault 0
		set panels 0
		set alpha_starts 0
		set revivals 0

		foreach line [split $output \n] {

			if {!$after_fault &&
			    [string first "sponge_supervisor: FAULT max_skipped=" $line] >= 0} {
				set after_fault 1
			}

			if {$after_fault &&
			    [string first "sponge_supervisor: published " $line] >= 0 &&
			    [string first "target=pkg_runtime_fault bumped=1" $line] < 0} {
				lappend fail "a post-fault publish was NOT a targeted\
 one-node containment: [string trim $line]"
			}

			#
			# The version-change witness: the state report's per-child
			# `version` is a CONSTRUCTION version, so any change is a
			# rebuild. Only the contained child may ever change.
			#
			if {[string first "sponge_supervisor: version-change " $line] >= 0 &&
			    [string first "sponge_supervisor: version-change pkg_runtime_fault " $line] < 0} {
				lappend fail "a construction version changed OUTSIDE the\
 contained child: [string trim $line]"
			}

			if {[string first "sponge-de: panel shown" $line] >= 0} {
				incr panels
			}
			if {[string first "alpha-probe: starting" $line] >= 0} {
				incr alpha_starts
			}
			if {[string first "ep_wedge: incarnation alive" $line] >= 0} {
				incr revivals
			}
			if {[string first "sponge_console: ARMED" $line] >= 0} {
				lappend fail "the fault console was armed on a contained fault"
			}
			if {[string first "published <system_console>" $line] >= 0} {
				lappend fail "a console-takeover config was published"
			}
		}

		if {$panels != 1} {
			lappend fail "sponge-de: panel shown appeared $panels times\
 (expected 1 - a global kill recreates the DE)"
		}
		if {$alpha_starts != 1} {
			lappend fail "alpha-probe started $alpha_starts times (expected 1\
 - a global kill recreates the boot probe)"
		}
		if {$revivals < 3} {
			lappend fail "only $revivals victim incarnations seen (expected 3:\
 the initial one plus two named restarts)"
		}
		if {[string first "alpha-probe: PASS" $output] < 0} {
			lappend fail "the post-wedge DE functional PASS is missing"
		}

		if {[llength $fail]} {
			puts "\nsponge-desktop-disk: SUPERVISOR CONTAIN FAIL:"
			foreach f $fail { puts "  - $f" }
			puts ""
			exit 1
		}

		puts "\nsponge-desktop-disk: SUPERVISOR CONTAIN PASS - the persistent\
 fault in pkg_runtime_fault was contained BY NAME across two cycles: one\
 node bumped per publish (target=pkg_runtime_fault bumped=1), sibling and\
 DE construction versions stable, panel shown once, post-wedge DE\
 functional PASS, no console takeover\n"
	} elseif {$fb_switch} {

		#
		# === Runtime framebuffer-driver switch (SPONGE_FB_SWITCH) =====
		#
		# The display came up through a driver PACKAGE (the seeded fb
		# package inside driver_runtime), which alpha-probe's pixel gate
		# has just proven. Now the same claim for the CHANGE: stop the
		# active driver package, start the other one, and require the
		# composited screen to come back and settle on a rendered
		# desktop. The probe also asserts the exclusivity refusal on the
		# way through, so the switch cannot silently race two drivers
		# for the one PCI VGA resource.
		#
		# The probe's own PASS is the gate: it is emitted only after the
		# driver child was seen, the pre-switch frame was rendered, the
		# incumbent was removed, the other driver entered driver_runtime
		# and the screen settled on a rendered desktop again. Every one
		# of those is a named internal phase that makes the probe exit 1
		# with the phase spelled out, so the single marker is complete
		# rather than convenient. (Gating the intermediate markers
		# individually is not possible: they race alpha_probe's PASS on
		# the same serial stream.)
		#
		if {[string first "fb-switch-probe: FAIL" $output] >= 0} {
			puts "\nsponge-desktop-disk: FB SWITCH FAIL - see the\
 fb-switch-probe: FAIL phase= line above\n"
			exit 1
		}

		puts "\nsponge-desktop-disk: FB SWITCH PASS - the display driver is a\
  package: the running one was removed, the other installed, and the\
  composited screen came back and settled on a rendered desktop\n"

	}
}
