#
# \brief  Sponge OS manual install scenario (Phase 4c)
# \author Sponge OS contributors
# \date   2026
#
# Verifies `vct install hello --manual`: the same install as the
# automatic path, but rendered step-by-step. vct first explains (to
# surface the real plan), prints each step, then executes the real
# install through sponge_pkgd, which regenerates pkg_runtime's config
# and starts hello.
#
# There is no terminal input channel in Genode yet, so the per-step
# [Y/n] prompts from docs/06-vct.md §5.3 are not honored — each step is
# printed and the install proceeds (noted in vct's output).
#
# Topology is run/sponge-pkg-install.run with vct args changed to
# `install hello --manual`. Verification matches hello's marker from
# inside pkg_runtime (the step-by-step output prints above it).
#

build { core lib/ld init timer server/report_rom sponge_pkgd pkg_hello vct }

create_boot_directory

install_config {
config
+ parent-provides
  + service LOG
  + service PD
  + service CPU
  + service ROM

+ default-route
  + any-service
    + parent
    + any-child
+ default | caps: 200 | ram: 8M

+ start timer
  + provides | + service Timer

+ start report_rom | ram: 4M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_pkgd -> request | report: vct -> request
    + policy | label: vct -> result          | report: sponge_pkgd -> result
    + policy | label: pkg_runtime -> config  | report: sponge_pkgd -> runtime

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 400 | ram: 32M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + any-service
      + parent
      + any-child

+ start vct | caps: 200 | ram: 8M
  + config
    + args
      + arg install
      + arg hello
      + arg --manual
  + route
    + service Timer | + child timer
    + service ROM | label_last: result | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }

set staged_pkgs { hello ncurses nano }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	set dst "[run_dir]/genode/pkg_$pkg.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src $dst
}

set index_fh [open "[run_dir]/genode/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

build_boot_image [build_artifacts]

append qemu_args " -nographic -m 1G "

#
# Verification: hello's marker proves the manual install actually
# started the component under pkg_runtime. The step-by-step output
# (steps 1-3 + header) prints above this line; step 4 / "Done." is
# verified via a direct boot-dir run.
#
run_genode_until {.*hello from package: running.*} 30
