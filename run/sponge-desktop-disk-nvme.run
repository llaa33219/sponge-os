#
# \brief  Sponge OS Phase 12 W2 — desktop from disk via NVMe (q35)
# \author Sponge OS contributors
# \date   2026
#
# NVMe variant of run/sponge-desktop-disk.run (Phase 8 P2 / docs/14 §4.4).
# Topology is identical; the ONLY changes are:
#   (a) the storage driver (`ahci` → `nvme`) with the plan-mandated
#       `caps: 5000 | ram: 64M` (Risk 26 mitigation — no ad hoc cap
#       bump; multi-namespace NVMe is a documented gap);
#   (b) the QEMU attachment — the boot .img (auto-attached by
#       image/disk on q35's implicit ICH9) is just the bootloader;
#       the GENODE ext2 partition carrying /system lives on a
#       SEPARATE GPT disk attached via `-device nvme` on a
#       `pcie-root-port`. The QEMU root-port + raw-drive + NVMe
#       sequence is copied verbatim from run/sponge-boot.run's
#       `SPONGE_BOOT_NVME` block (Risk 10 mitigation);
#   (c) a new Tier-0 `partition_check` probe that scans part_block's
#       partitions reporter for `number="3"` and logs the byte
#       assertion `Number: 3` BEFORE the alpha-probe: PASS gate
#       (Risk 3 mitigation — partition-number pin survives the
#       NVMe namespace).
#
# Architecture (docs/14-boot-storage-architecture.md §4.4–§4.7):
#
#   GRUB → bender → seL4 (image.elf = Tier 0 only)
#     └─ init (Tier 0)
#         ├─ timer, report_rom
#         ├─ platform/acpi/pci_decode
#         ├─ nvme (Block, one namespace on a pcie-root-port)
#         ├─ part_block → Block/P3 (partition pinned BY NUMBER;
#         │              partitions report enabled; verified by
#         │              partition_check before alpha-probe)
#         ├─ vfs (Vfs_block + <rump fs="ext2fs"/>) → File_system
#         ├─ rom_sys: cached_fs_rom(chroot /system)        → ROM
#         ├─ rom_lib: cached_fs_rom(chroot /system/lib)    → ROM (.lib.so only)
#         ├─ nitpicker
#         ├─ drivers (sub-init: vesa_fb/ps2/usb_hid/event_filter)
#         ├─ partition_check: byte-asserts `Number: 3` and exits
#         └─ system (nested init from NVMe's /system)
#             ├─ binary "init" from rom_sys at /system/bin/init
#             ├─ config from rom_sys at /system/init/system.config
#             ├─ ROM label_last="ld.lib.so" → parent (§4.6)
#             └─ hosts: report_rom, wm, window_layouter, decorator,
#                       sponge_configd, sponge_themed, sponge_pkgd,
#                       pkg_runtime, sponge-de, alpha_probe
#                  (ALL binaries+libs served from /system via rom_sys/rom_lib)
#
# === Two-disk attachment (the W2 NVMe wiring) ===
#
#   QEMU sees TWO raw disks on q35:
#     - the .img from image/disk (auto-attached to q35's implicit
#       ICH9 AHCI; Genode does NOT start AHCI in this scenario, so
#       this disk is only the bootloader media — GRUB reads image.elf
#       off it, then it is left unread by Genode); and
#     - bin/nvme_disk.img (GPT P3=ext2 containing /system/), attached
#       via `-device pcie-root-port -drive -device nvme` — Genode's
#       nvme driver reads this one.
#
# The desktop staging (binaries, libs, themes, tars, pkg metadata,
# nested init config) is performed in [run_dir]/system/ exactly like
# sponge-desktop-disk.run — image/disk auto-e2cp's it into the .img
# P3 (waste, but harmless since AHCI is not started). The same tree
# is ALSO staged into bin/nvme_disk.img's P3 via e2cp, which is what
# Genode actually reads via the NVMe chain.
#
# === Tier-0 roster (docs/14 §4.5) ===
#
# Same as sponge-desktop-disk.run; only the storage driver name and
# size change. Total Tier-0 is ~15 MiB.
#
# === Verification (TWO gates, in order) ===
#
#   Gate 1 (Tier-0, near-60s target):
#     partition-check: PASS (Number: 3)
#     — part_block's `partitions` reporter lists a partition with
#       `number="3"` on the NVMe namespace, byte-identical to the
#       AHCI pin. The probe is a tiny Genode component (repos/sponge/
#       src/test/partition_check/).
#
#   Gate 2 (full desktop, 600s+ reality, bounded at 900s):
#     alpha-probe: PASS
#     — themed panel pixel rendered on nitpicker, launcher feed
#       carries hello, configd broadcast ROM is live, all served
#       from disk via the NVMe chain. Same three criteria as
#       sponge-desktop-disk.run.
#
# The `run_genode_until` regex requires BOTH lines in order. The
# 900s budget is the full-desktop reality; the Tier-0 gate alone is
# near 60s in normal conditions (plan §W2 step 3 honesty note).
#
# === Failure channel ===
#
# SPONGE_DISK_FAIL=1 in the environment stages a corrupted
# /system/init/system.config (invalid XML). The nested init fails to
# parse it, logs an error, and the bounded run_genode_until timeout
# catches it — no silent hang. The run gates on the init parse-error
# marker for a bounded, identified failure.
#
# base-sel4 only.
#
# Build:
#   make -C genode/build/x86_64 run/sponge-desktop-disk-nvme \
#       KERNEL=sel4 BOARD=pc RUN_OPT="--include image/disk"
#

assert {[have_spec sel4]} \
	"sponge-desktop-disk-nvme requires KERNEL=sel4 (BOARD=pc)."

##
# Ensure essential run-framework plugins are loaded (same rationale as
# sponge-alpha.run: RUN_OPT override on the make command line discards
# build.conf's accumulated --include lines).
#
proc ensure_plugin_loaded { name } {
	if {![have_include $name]} {
		set path [genode_dir]/tool/run/$name
		puts "sourcing $path (missing from RUN_OPT, restored by run script)"
		source $path
		global include_list
		lappend include_list $name
	}
}

ensure_plugin_loaded boot_dir/sel4
ensure_plugin_loaded power_on/qemu
ensure_plugin_loaded log/qemu
ensure_plugin_loaded image/disk

#
# This scenario MUST boot the disk image, but the build.conf template's
# QEMU_RUN_OPT pulls in image/iso by default, and when both image modes
# are included the ISO wins the QEMU command line (the guest then finds
# no NVMe device: part_block's Block session is denied). Drop image/iso
# from the include list so the disk image is the only boot medium.
# (Phase 12 W2 NVMe: ahci in the original comment becomes nvme here,
# but the gating logic is identical — the boot .img is the medium.)
#
global include_list
set iso_idx [lsearch -exact $include_list "image/iso"]
if {$iso_idx >= 0} { set include_list [lreplace $include_list $iso_idx $iso_idx] }

#
# Top-level supervision (docs/17 §5, "Broker fault containment - top
# level"). run/supervisor.inc carries the shared wiring: it derives the
# supervisor's config templates from the desktop config staged below,
# hands the top-level report_rom the two relay policies, moves the
# `system` sandbox's config ROM from rom_sys to the relay, adds the
# console's nitpicker domain, and starts the supervisor + console before
# the sandbox. The templates are DERIVED, never authored twice, so this
# file stays the single source of truth for the desktop composition.
#
source [file join [file dirname [file normalize [info script]]] \
                    supervisor.inc]

# Driver packages (docs/12-package-format.md section 4.5).
# run/driver_runtime.inc is the single source of truth for the
# driver_runtime sandbox: the HID fragments it emits, the quota
# arithmetic, and the staging of the driver binaries and metadata onto
# /system. Sourced here so this scenario and its sibling variants cannot
# drift apart.
source [file join [file dirname [file normalize [info script]]] \
                    driver_runtime.inc]

# This media's `system` caps grant before driver_runtime joins it.
driver_runtime::base_caps 263000

# Failure-channel selector: SPONGE_DISK_FAIL=1 corrupts system.config.
#
set fail_mode [expr {[info exists ::env(SPONGE_DISK_FAIL)] && $::env(SPONGE_DISK_FAIL) == "1"}]
if {$fail_mode} {
	puts "sponge-desktop-disk-nvme: FAILURE CHANNEL (corrupted system.config)"
}

#
# The SPONGE_DISK_FAIL failure channel runs WITHOUT the supervisor: its
# whole subject is "the nested init rejects a corrupted config", a
# diagnostic that predates the supervisor, and wiring it in would make two
# different failures indistinguishable in one log.
#
if {$fail_mode} { supervisor::enabled 0 }

#
# Build — Tier-0 chain + desktop components. The desktop components are
# built normally; they are copied to /system/bin on disk (not into
# image.elf). The build list matches sponge-alpha.run minus the lz
# subsystem (P5 work).
#
set build_components {
	core lib/ld init timer
	server/report_rom server/nitpicker
	driver/platform driver/acpi app/pci_decode
	driver/framebuffer/vesa driver/framebuffer/boot driver/ps2
	driver/usb_host/pc driver/usb_hid server/event_filter
	server/part_block server/vfs server/cached_fs_rom
	lib/vfs lib/vfs_rump lib/rump lib/rump_fs
	server/wm app/window_layouter app/decorator app/pointer
	sponge_configd sponge_themed sponge_pkgd pkg_hello sponge-de
	cfg_probe sponge_supervisor sponge_console
	test/alpha_probe
	test/partition_check
	qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
	lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
	lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
	lib/zlib lib/libpng lib/blit lib/vfs_ttf lib/vfs_import lib/posix \
	driver/nvme
	server/nic_router driver/nic/pc driver/usb_net driver/wifi \
	driver/gpu/intel driver/framebuffer/intel/pc/spec/x86_64
}


build $build_components

create_boot_directory

#
# On base-sel4 every boot module must land in bin/ BEFORE
# build_boot_image.
#
exec mkdir -p bin

# ========================================================================
# Stage /system/ directory (auto-e2cp'd into GENODE P3 by image/disk)
# ========================================================================
#
# /system/bin/    desktop binaries (served via <binary name="bin/...">)
# /system/lib/    .lib.so files (served via rom_lib chroot)
# /system/init/   the nested init config (system.config)
# /system/        flat: themes, tars, pkg metadata (served by bare name)
#
# Directory layout note (docs/14 §4 vs cached_fs_rom label resolution):
#   cached_fs_rom resolves ROM labels via label.last_element(), which
#   becomes the file path relative to the vfs chroot. Binaries use
#   <binary name="bin/..."/> so the path includes the bin/ prefix.
#   Libraries are requested by bare name by the dynamic linker (e.g.
#   "libQt6Core.lib.so") and cannot carry a prefix — so rom_lib uses a
#   SEPARATE cached_fs_rom chrooted to /system/lib to resolve them.
#   Files served by bare name (themes, tars, pkg metadata) live flat
#   under /system/.
#
set sys_dir "[run_dir]/system"
exec mkdir -p "$sys_dir/bin"
exec mkdir -p "$sys_dir/lib"
exec mkdir -p "$sys_dir/init"

#
# Empty config for children without inline <config> (e.g. hello). The
# sandbox opens a "config" ROM for every child; without an inline config,
# the request cascades to rom_sys. A bare <config/> at /system/config
# satisfies the request so the child isn't stopped by a ROM denial.
#
set empty_cfg [open "$sys_dir/config" w]
puts -nonewline $empty_cfg {<config/>}
close $empty_cfg

# --- desktop binaries → /system/bin/ ---
foreach b { init report_rom wm window_layouter decorator \
            sponge_configd sponge_themed sponge_pkgd sponge-de \
            alpha_probe hello cfg_probe } {
	exec cp -fL "bin/$b" "$sys_dir/bin/$b"
}

# --- shared libraries → /system/lib/ ---
# Copy ALL .lib.so files EXCEPT ld-*.lib.so (Tier-0 only, §4.6) and
# the Falkon/WebEngine-specific libs (P4 payload, not desktop). The
# desktop's transitive deps are covered by staging the full set minus
# these exclusions.
set falkon_libs {
	libFalkonPrivate.lib.so
	libQt6WebEngineCore.lib.so
	libQt6WebEngineQuick.lib.so
	libQt6WebEngineWidgets.lib.so
	libQt6WebChannel.lib.so
	libQt6WebChannelQuick.lib.so
	libQt6PrintSupport.lib.so
	libQt6Qml.lib.so
	libQt6QmlMeta.lib.so
	libQt6QmlModels.lib.so
	libQt6QmlWorkerScript.lib.so
	libQt6Quick.lib.so
	libQt6QuickWidgets.lib.so
	libqtquick2plugin.lib.so
	libqtwebenginequickplugin.lib.so
	libworkerscriptplugin.lib.so
	nss3.lib.so
	nssckbi.lib.so
	freebl3.lib.so
	softokn3.lib.so
	libssl.lib.so
	libcrypto.lib.so
	libssh.lib.so
	curl.lib.so
	vfs_lwip.lib.so
	vfs_qtwebengine_shm.lib.so
	vfs_jitterentropy.lib.so
	vfs_xoroshiro.lib.so
	vfs_oss.lib.so
	ncurses.lib.so
}

foreach lib [glob -nocomplain bin/*.lib.so] {
	set libname [file tail $lib]
	# Skip ld-*.lib.so (Tier-0 boot module, §4.6 — never on disk)
	if {[string match "ld-*.lib.so" $libname]} { continue }
	# Skip ld.lib.so itself (the generic name — Tier-0 only)
	if {$libname eq "ld.lib.so"} { continue }
	# Skip Falkon/WebEngine-specific libs (P4 payload)
	if {[lsearch -exact $falkon_libs $libname] >= 0} { continue }
	# Skip rump storage-chain libs (Tier-0 deps)
	if {$libname eq "rump.lib.so" || $libname eq "rump_fs.lib.so"} { continue }
	# Skip vfs_rump (Tier-0 storage chain dep)
	if {$libname eq "vfs_rump.lib.so"} { continue }

	exec cp -fL $lib "$sys_dir/lib/$libname"
}

# --- themes (flat — served by bare name) ---
foreach theme { default light } {
	set theme_src "${genode_dir}/repos/sponge/src/sponge-de/themes/${theme}.theme"
	if {[file exists $theme_src]} {
		exec cp -fL $theme_src "$sys_dir/${theme}.theme"
	}
}

# --- Qt6 tars (flat — served by bare name) ---
# qt6_dejavusans.tar: staged from qt6_base port sources
set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
if {[llength $dejavu_src] > 0} {
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf "$sys_dir/qt6_dejavusans.tar" -C "$staging" qt
	file delete -force "$staging"
}

# qt6_libqgenode.tar: cmake-built, already in bin/
if {[file exists "bin/qt6_libqgenode.tar"]} {
	exec cp -fL "bin/qt6_libqgenode.tar" "$sys_dir/qt6_libqgenode.tar"
}

# --- package metadata (flat — pkgd opens ROM "pkg_<name>.xml") ---
foreach pkg { hello } {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	if {[file exists $src]} {
		exec cp -fL $src "$sys_dir/pkg_$pkg.xml"
	}
}

set index_fh [open "$sys_dir/pkg_index.xml" w]
puts $index_fh "<packages>"
puts $index_fh "  <pkg name=\"hello\"/>"
puts $index_fh "</packages>"
close $index_fh

# --- driver packages (docs/12 §4.5, §4.6) ---
#
# This variant deliberately stages NO bake profile: its package set is
# the single `hello` probe marker, and making it a full desktop media is
# a different, larger change — its staging carries neither the Qt6 tars
# nor the desktop lib set (measured: sponge-de comes up with "Could not
# find the Qt platform plugin"). That remains the documented
# limitation in docs/13-installation.md.
#
# What the display DOES need is a first-boot root for the fb package,
# and there is no manifest here to name one — so driver_packages::stage
# synthesizes a minimal one: a display, and nothing else, is what this
# variant needs seeded. That also ends the pre-existing `+ bake` ROM
# denial documented for this scenario (pkgd asked rom_sys for
# `bake_manifest.json`, which did not exist, and was DENIED it at every
# boot); the synthesized file is exactly what it asked for, so pkgd now
# comes up, seeds fb_vesa and the desktop reaches its panel.
#
# NOTE: this variant deliberately stages NO bake profile. Its package set
# is the single `hello` probe marker, and turning it into a full desktop
# media is a different change (it would also need the Qt6 tars and the
# desktop lib set, which its staging does not carry — measured: sponge-de
# comes up with "Could not find the Qt platform plugin"). That stays a
# documented limitation, docs/13-installation.md.
#
# What the display DOES need is a first-boot root for the fb package, and
# there is no manifest to name one — so driver_packages::stage synthesizes
# a minimal one (a display, and nothing else, is what this variant needs
# seeded). That also ends the pre-existing `+ bake` ROM denial: pkgd asks
# rom_sys for `bake_manifest.json`, and the synthesized file is exactly
# what it asked for.
#
driver_runtime::fb_package fb_vesa
driver_runtime::stage $sys_dir

# ========================================================================
# Write /system/init/system.config — the nested system init config
# ========================================================================
#
# This is the desktop composition, formerly inline in sponge-alpha.run's
# top-level init config. It is now DATA on disk (docs/14 §4.4: "init
# config is data, not image"). Changing the desktop composition no
# longer rebuilds image.elf.
#
# The config references Tier-0 services (nitpicker/timer/report_rom)
# via <parent/>, which cascades through the system init to the Tier-0
# init. Binaries use <binary name="bin/..."/> for disk resolution.
# Every child carries the §4.6 ld.lib.so route.
#

if {$fail_mode} {
	#
	# FAILURE CHANNEL: write a deliberately corrupted system.config.
	# The nested init will fail to parse it and log an XML error.
	#
	set sysconfig_fh [open "$sys_dir/init/system.config" w]
	puts $sysconfig_fh {<config THIS IS DELIBERATELY BROKEN XML><unclosed}
	close $sysconfig_fh
} else {
	#
	# Write system.config in HID format to a temp file, then convert
	# to XML using the `hid` tool. The nested init reads the config
	# from disk via cached_fs_rom; writing it as proper XML eliminates
	# any ambiguity in how inline <config> attributes (e.g.
	# binary_prefix) are parsed by child components.
	#
	set sysconfig_hid "[run_dir]/system.config.hid"
	set sysconfig_fh [open "$sysconfig_hid" w]
puts $sysconfig_fh {
config
# This sandbox is the hardware gateway: driver_runtime below may ask for
# a hardware service. The list is deliberately broad because the set of
# installable drivers is open-ended.
#
# The boundary that protects applications is NOT this list - it is the
# parent-provides pkgd GENERATES for pkg_runtime, which carries the
# application service set only. A package route is emitted from its
# declared <sessions>, so no application package can name Platform / Irq
# / Io_mem / Io_port and obtain one even though this sandbox would route
# it (AGENTS.md 1.2).
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service Timer
  # Report is here because a driver package declares it: the framebuffer
  # driver publishes a `connectors` inventory. Without it in THIS list
  # the request from driver_runtime would be denied at this hop even
  # though the Tier-0 node routes Report to report_rom.
  + service Report
  + service Gui
  + service Capture
  + service Event
  + service Platform
  + service Dma
  # The three hardware services below are spelled the way the CLIENTS
  # request them, which is NOT the CamelCase a human would write:
  # Genode's session service_name() is "IRQ" / "IO_MEM" / "IO_PORT"
  # (io_mem_session.h:37 and friends), and the parent-provides match is
  # case-sensitive. The old Irq/Io_mem/Io_port spelling was never
  # requested by anyone and silently denied every one of them at this
  # hop — invisible while every hardware component was a Tier-0 child,
  # and the reason a packaged fb_vesa died with
  # 'parent denied IO_MEM-session'.
  + service IRQ
  + service IO_MEM
  + service IO_PORT
  + service Usb
  + service Rtc
  + service File_system
  + service Uplink
  + service Nic
  + service Terminal

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ report | init_ram: yes | child_ram: yes | child_caps: yes | delay_ms: 1000

# Fault containment (docs/17 §5): a child whose entrypoint wedges is
# abandoned and respawned by the sandbox after 3 skipped heartbeats
# (~6 s at rate 2000 ms). The input chain (top-level) is untouched.
+ heartbeat | rate_ms: 2000

+ start report_rom | caps: 300 | ram: 8M
  + binary | name: bin/report_rom
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: layouter -> window_list       | report: wm -> window_list
    + policy | label: decorator -> pointer           | report: wm -> pointer
    + policy | label: decorator -> window_layout     | report: layouter -> window_layout
    + policy | label: wm -> focus                    | report: layouter -> focus
    + policy | label: wm -> resize_request           | report: layouter -> resize_request
    + policy | label: layouter -> hover              | report: decorator -> hover
    + policy | label: layouter -> decorator_margins  | report: decorator -> decorator_margins
    + policy | label: layouter -> rules              | report: sponge-de -> rules
    + policy | label: layouter -> focus_request      | report: sponge-de -> focus_request
    + policy | label: sponge_configd -> config_request | report: alpha_probe -> config_request
    + policy | label: alpha_probe -> config_result     | report: sponge_configd -> config_result
    + policy | label: sponge_themed -> config          | report: sponge_configd -> config
    + policy | label: alpha_probe -> configd_config    | report: sponge_configd -> config
    + policy | label: alpha_probe -> config            | report: sponge_configd -> config
    + policy | label: sponge-de -> theme               | report: sponge_themed -> theme
    + policy | label: alpha_probe -> theme             | report: sponge_themed -> theme
    + policy | label: sponge_pkgd -> request     | report: alpha_probe -> request
    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result
    + policy | label: pkg_runtime -> config       | report: sponge_pkgd -> runtime
    + policy | label: sponge_pkgd -> runtime_state | report: pkg_runtime -> state
    + policy | label: cfg_probe -> config          | report: sponge_pkgd -> runtime
    + policy | label: sponge-de -> cfg_probe_state | report: cfg_probe -> cfg_probe
    + policy | label: sponge-de -> installed      | report: sponge_pkgd -> installed
    + policy | label: sponge_pkgd -> launcher_request | report: sponge-de -> launcher_request
    + policy | label: sponge-de -> launcher_result   | report: sponge_pkgd -> launcher_result
    + policy | label: sponge-de -> window_list   | report: wm -> window_list
    + policy | label: sponge-de -> window_layout | report: layouter -> window_layout
    + policy | label: alpha_probe -> sponge_de_launcher | report: sponge-de -> launcher
    @DRIVER_RELAY_POLICIES@

+ start wm | caps: 2000 | ram: 16M
  + binary | name: bin/wm
  + heartbeat | restart_after_skipped: 3
  + provides
    + service Gui
    + service Report
    + service ROM
  + config
    + policy | label_prefix: decorator | role: decorator
    + policy | label_prefix: layouter  | role: layouter
    + default-policy
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: focus          | + child report_rom
    + service ROM | label: resize_request | + child report_rom
    + service Report | label_last: shape  | + child report_rom
    + service Report | + child report_rom
    + service Gui | + parent
    + any-service
      + parent
      + any-child

+ start layouter | caps: 1000 | ram: 8M
  + binary | name: bin/window_layouter
  + heartbeat | restart_after_skipped: 3
  + config | rules: rom
    + report | rules: yes
    + rules
      + screen screen
      #
      # Launched GUI packages need a floating placement so they don't
      # maximize over the desktop. See run/sponge-alpha.run for the
      # full rationale (Phase 10 W3 pkg_runtime Gui-route fix). The
      # matching Gui route through the wm is added to pkg_runtime
      # below; this rule covers the layouter side. label_prefix is
      # supported on <assign> per the window_layouter README.
      + assign | label_prefix: pkg_runtime | target: screen
               | xpos: 50 | ypos: 300 | width: 320 | height: 240 | maximized: no
    + press   | key: BTN_LEFT  | action: drag
      + release | key: BTN_LEFT | action: drop
  + route
    + service ROM | label_last: ld.lib.so     | + parent
    + service ROM | label: window_list       | + child report_rom
    + service ROM | label: focus_request     | + child report_rom
    + service ROM | label: hover             | + child report_rom
    + service ROM | label: focus             | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service ROM | label: rules             | + child report_rom
    + service Report | label: rules           | + child report_rom | label: layout_rules
    + service Report | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start decorator | caps: 350 | ram: 32M
  + binary | name: bin/decorator
  + heartbeat | restart_after_skipped: 3
  + config
    + controls
      + maximizer
      + title
    + default-policy
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: window_layout | + child report_rom
    + service ROM | label: pointer       | + child report_rom
    + service Report | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start sponge_configd | caps: 200 | ram: 16M
  + binary | name: bin/sponge_configd
  + heartbeat | restart_after_skipped: 3
  + config
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: config_request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

#
# Phase 16 W3 D16.7 honest disclosure: the bake ROM routes that were
# added in the W3 wiring are INTENTIONALLY OMITTED here. This scenario
# is the Phase 8 P2 storage variant — the build list stages only
# `pkg_hello` + `sponge-de`, not the full desktop profile (no
# terminal/textedit/files/calculator/pdf_view binaries). The Phase 16
# W3 extended alpha_probe (plan W3 #3) requires the 7-package
# launcher feed AND bake.applied=yes + 8 baked keys; wiring the bake
# gate without expanding the build list would force alpha_probe to
# fail at the install-terminal step. Expanding the build list to the
# full desktop stack is Phase 17 scope (the P2 storage-variant
# scenario remains a smoke test of the desktop boot + storage chain,
# not a first-boot acceptance scenario). The dedicated first-boot
# scenario `run/sponge-desktop-defaults-firstboot.run` carries the
# full 8-baked-keys + 7-launcher-set assertion against the full
# desktop stack; this scenario continues to assert hello + configd
# broadcast only (its pre-W3 contract).
#

+ start sponge_themed | caps: 200 | ram: 8M
  + binary | name: bin/sponge_themed
  + heartbeat | restart_after_skipped: 3
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: config       | + child report_rom
    + service ROM | label_last: default.theme | + parent
    + service ROM | label_last: light.theme   | + parent
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_pkgd | caps: 200 | ram: 16M
  + binary | name: bin/sponge_pkgd
  + heartbeat | restart_after_skipped: 3
  + config | binary_prefix: bin/
    + launcher_request
    + admission
    + driver_admission
    + bake
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: request | + child report_rom
    + service ROM | label_last: launcher_request | + child report_rom
    + service ROM | label: runtime_state | + child report_rom
    + service ROM | label: driver_runtime_state | + child report_rom
    + service ROM | label: bake_manifest | + parent | label: bake_manifest.json
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child


+ start sponge-de | caps: 4000 | ram: 160M
  + binary | name: bin/sponge-de
  + heartbeat | restart_after_skipped: 3
  + config
    + theme | source: themed
    + launcher | source: pkgd
    + demo | enabled: no
    + tasklist | source: wm
    + tasklist_static_rules
      + assign | label_prefix: pkg_runtime | target: screen | xpos: 50 | ypos: 300 | width: 320 | height: 240 | maximized: no
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Gui | label_last: Sponge Panel   | + parent
    + service Gui | label_last: Sponge Launcher | + parent
    + service Gui | + child wm
    + service Report | label: shape | + child report_rom
    + service Report | label: input | + child report_rom
    + service Report | label: applied_theme | + child report_rom
    + service Report | label: launcher | + child report_rom
    + service Report | label: launcher_request | + child report_rom
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service Report | label: focus_request | + child report_rom
    + service Report | label: rules        | + child report_rom
    + service ROM | label: launcher_result | + child report_rom
    + service ROM | label: installed | + child report_rom
    + service ROM | label_last: system_state   | + parent
    + service ROM | label_last: cfg_probe_state | + child report_rom
    + service ROM | label: theme | + child report_rom
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child

+ start alpha_probe | caps: 200 | ram: 16M
  + binary | name: bin/alpha_probe
  + config | skip_lz: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Capture | + parent
    + service Timer | + parent
    + service ROM | label_last: result | + child report_rom
    + service ROM | label_last: config_result | + child report_rom
    + service ROM | label_last: configd_config | + child report_rom
    + service ROM | label_last: config | + child report_rom
    + service ROM | label_last: sponge_de_launcher | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
+ start cfg_probe | caps: 200 | ram: 4M
  + binary | name: bin/cfg_probe
  + route
    + service ROM | label: config | + child report_rom
    + service Report | + child report_rom
    + service Timer | + parent
    + any-service
      + parent
      + any-child

#
# Quota arithmetic (2026-10-xx, pkg_runtime sizing fix): pkg_runtime
# hosts the WHOLE enabled package set simultaneously, so its grant must
# cover the SUM of every package's declared quota, not one package.
# The `desktop` bake profile enables 8 packages:
#   hello 256/8M · terminal 1100/224M · textedit 1000/64M ·
#   files 1000/64M · calculator 1000/64M · pdf_view 256/1G ·
#   falkon 200000/1G · debug 1000/64M
#   => 205612 caps / 2536M   (206512 caps incl. the nano+ncurses pair)
# The previous 8000 caps made falkon (200000 caps) structurally
# un-launchable — 25x short. Caps grant: 230000, i.e. +11.9% over the
# enabled sum above.
# Media-independent: all five desktop-disk scenarios carry this same
# caps value (docs/14 §4.4 "init config is data, not image").
#
# ============ RAM: THE DELIBERATELY-HUGE 512G QUANTUM =====================
# `ram: 512G` below is INTENTIONAL. It is NOT a claim that this system
# needs 512 GiB. It is the MECHANISM by which pkg_runtime receives ALL
# RAM still unallocated at the moment it is created:
#
#   Genode's init SILENTLY CLAMPS a child's RAM quantum to whatever its
#   parent still has available at creation time. See
#   genode/repos/os/src/lib/sandbox/child.cc:481-486: `avail_ram =
#   effective_quota(quota_limit.ram)` is the parent budget minus
#   everything the parent already granted and consumed; when the
#   declared quantum exceeds it, init logs "configured RAM exceeds
#   available RAM, proceed with <avail>" and transfers `avail` instead.
#   (The caps path is the identical clamp at child.cc:490-495.) Here
#   the clamp IS the desired semantics: "take everything left".
#
# REQUIREMENT — pkg_runtime MUST be the LAST `+ start` node in THIS
# system config. The grant is only "everything left" if nothing is
# created afterwards; a child appended below takes its RAM out of
# pkg_runtime's pool rather than out of a declared budget, silently.
# The ordering was introduced by 248afa12d6 ("start pkg_runtime LAST",
# for the real-hardware config-delivery timing); this is the SAME
# invariant seen from the quota side. Do not append a start node under
# this one without moving pkg_runtime back to the end of the file.
#
# WHAT IT BUYS: physical-RAM-size agnosticism. One unchanged file boots
# QEMU -m 4G, -m 6G, and a 16 GiB laptop; the grant follows the machine
# instead of a hand-derived constant. The fixed 2816M it replaces had
# to be re-derived for every -m value and every package-profile change
# (git history: 8000/1536M -> 210000/2048M -> 230000/2816M), and any
# under-estimate was silently clamped to a grant too small for the
# enabled set — invisible in the config, visible only as packages that
# refuse to launch.
#
# WHY caps: 230000 STAYS EXPLICIT — the caps clamp is deliberately NOT
# used as a mechanism here:
#   1. caps exhaustion on seL4 HANGS. A child that cannot obtain a
#      capability waits forever instead of failing (docs/09-roadmap.md
#      §11.1) — a silent hang is the worst failure mode a resource can
#      have.
#   2. A cap grant that absorbs the whole remainder would starve any
#      FUTURE sibling added to this config: the remainder is zero-sum,
#      so the next addition becomes exactly the cliff edge docs/17 §5
#      forbids. RAM carries no such failure mode, which is why only
#      RAM uses the clamp.
#
@DRIVER_START_NODE@
+ start pkg_runtime | caps: 230000 | ram: 512G
  + binary | name: bin/init
  + heartbeat | restart_after_skipped: 3
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service ROM | label: config | + child report_rom
    #
    # pkg_runtime's own sandbox state report, relayed by report_rom.
    # sponge-de reads it through the "sponge-de -> runtime_state"
    # policy; sponge_pkgd reads the SAME report through
    # "sponge_pkgd -> runtime_state" for its resource admission control.
    # This scenario is the one product variant that had no state relay
    # at all before admission control landed.
    + service Report | label_last: state | + child report_rom
    #
    # Route pkg_runtime's Gui sessions through the wm so launched GUI
    # packages get decorated, movable frames. Phase 10 W3 fix — see
    # run/sponge-alpha.run for full rationale. Inert when no GUI
    # package is running (hello is a non-GUI binary).
    + service Gui | + child wm
    + service Report | label_last: shape | + child wm
    + any-service
      + parent
      + any-child
-}
	close $sysconfig_fh

	#
	# Expand the driver_runtime placeholders (run/driver_runtime.inc).
	# They are @-delimited rather than Tcl [command] calls because this
	# block is emitted inside a braced Tcl literal, where no substitution
	# happens at all - an unexpanded bracket would reach the HID parser
	# as a policy node and fail schema validation.
	#
	set drv_fh [open $sysconfig_hid r]
	set drv_hid [driver_runtime::expand [read $drv_fh] \
	                       [list @DRIVER_RELAY_POLICIES@ @DRIVER_START_NODE@ @SYSTEM_CAPS@]]
	close $drv_fh
	set drv_fh [open $sysconfig_hid w]
	puts -nonewline $drv_fh $drv_hid
	close $drv_fh

	#
	# Convert HID → XML so the nested init receives unambiguous XML.
	#
	#
	# Top-level supervision: stamp a restart version onto every top-level
	# <start> and derive the supervisor's two templates from THIS file
	# (which stays the single source of truth for the desktop
	# composition).
	#
	supervisor::prepare $sys_dir $sysconfig_hid

	set xml_content [exec [genode_dir]/tool/hid format --output-xml "$sysconfig_hid"]
	set sysconfig_final [open "$sys_dir/init/system.config" w]
	puts -nonewline $sysconfig_final $xml_content
	close $sysconfig_final
	file delete "$sysconfig_hid"
}

# ========================================================================
# Tier-0 init configuration
# ========================================================================

set tier0_config [supervisor::tier0 {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: pci_decode -> system | report: acpi -> acpi
    + policy | label: platform -> devices  | report: pci_decode -> devices
    + policy | label: usb_hid -> report    | report: usb -> devices
    + policy | label_suffix: focus | report: nitpicker -> focus
    + policy | label_suffix: system_state | report: system -> state
    + policy | label_suffix: hover | report: nitpicker -> hover
    + policy | label: pointer -> xray | report: pointer-xray-none
    #
    # Phase 12 W2 (plan §W2 step 3 / Risk 3): capture part_block's
    # `partitions` reporter so partition_check can byte-assert
    # `Number: 3` on the NVMe namespace. The reporter is enabled
    # on part_block above (`report partitions: yes`); the policy
    # below routes that Report into report_rom as a ROM. The
    # `label:` is the requesting child's name + ROM label (Tcl
    # policy syntax: `<requesting-child> -> <rom-label>`) and the
    # `report:` is the source child + report label
    # (`<source-child> -> <report-label>`). partition_check reads
    # the resulting ROM "partitions" and exits.
    #
    + policy | label: partition_check -> partitions | report: part_block -> partitions

+ start acpi | caps: 350 | ram: 4M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service IO_MEM | + parent
    + service LOG | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service ROM | + parent

+ start pci_decode | caps: 350 | ram: 2M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service ROM | label: system | + child report_rom
    + service IO_MEM | + parent
    + service LOG | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service ROM | + parent

+ start platform | caps: 200 | ram: 3M | managing_system: yes
  + provides
    + service Platform
    + service Dma
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: devices | + child report_rom
    + service Report | + child report_rom
    + service Timer | + child timer
    + service IRQ | + parent
    + service IO_MEM | + parent
    + service IO_PORT | + parent
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent
  + config
    + report | devices: yes
    + policy | label_prefix: nvme | + pci | class: NVME
    + policy | label_prefix: ps2  | + device ps2
    + policy | label_prefix: fb   | info: yes | + pci | class: VGA
    + policy | label_prefix: usb  | info: yes | + pci | class: USB
    @DRIVER_PLATFORM_POLICIES@

#
# Storage driver: nvme. Sized per plan §W2 / Risk 26 mitigation
# (`caps: 5000 | ram: 64M` — no quota-failure retry or ad hoc cap
# bump permitted). One namespace verified (Risk 3 mitigation);
# multi-namespace is a documented gap (D12.2, docs/15 row).
#
# The Uplink<->Nic bridge. A SYSTEM SERVICE, not part of any driver
# package: the driver produces raw frames, the router gives the rest of
# the system a Nic session. Its policy matches the sandbox path rather
# than a per-driver name, so installing a second Uplink-providing driver
# needs no change here.
+ start nic_router | caps: 300 | ram: 16M
  + provides
    + service Uplink
    + service Nic
  + config | verbose: yes
    |        | verbose_domain_state: yes
    |        | dhcp_discover_timeout_sec: 10
    |        | dhcp_request_timeout_sec:  6
    + policy | label_prefix: system -> driver_runtime | domain: uplink
    + domain uplink
    +   | verbose_packets:  no
    +   | icmp_echo_server: yes
  + route
    + service Timer | + child timer
    + any-service   | + parent | + any-child

+ start nvme | caps: 5000 | ram: 64M
  + provides | + service Block
  + config
    + report | ports: yes
    + policy | label_prefix: part_block | device: 0 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Platform | + child platform
    + service Dma | + child platform
    + service Timer | + child timer
    + service Report | + child report_rom
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent

#
# part_block: pin partition 3 BY NUMBER (docs/14 §4.4) on the NVMe
# namespace. The partitions reporter is enabled (was `no` in the
# AHCI scenario) so partition_check can byte-assert `Number: 3` per
# plan §W2 step 3 / Risk 3.
#
+ start part_block | caps: 200 | ram: 8M
  + provides | + service Block
  + config
    + report | partitions: yes
    + policy | label_prefix: vfs | partition: 3 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Block | + child nvme
    #
    # Phase 12 W2: route part_block's `Report` session to report_rom
    # so the partitions report becomes ROM "partitions" (Risk 3 +
    # Risk 10 mitigation). Without this explicit route the Report
    # session cascades to any-service → parent, and report_rom never
    # receives the report (genode emits "ambiguous routes to
    # service Report" + "no valid policy for ROM request
    # 'partition_check -> partitions'" and part_block stops).
    #
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

#
# partition_check: phase-12 W2 / Risk-3 / Risk-10 byte assertion.
# Reads the part_block `partitions` reporter (relayed as a ROM by
# report_rom — see the policy added above) and asserts a row with
# `number="3"` exists on the NVMe namespace. Logs
# `partition-check: PASS (Number: 3)` then exits. The
# run_genode_until regex below gates both this line AND the
# subsequent `alpha-probe: PASS`.
#
+ start partition_check | caps: 100 | ram: 4M
  + route
    + service ROM | label: partitions | + child report_rom
    + service ROM | label_last: ld.lib.so | + parent
    + any-service
      + parent
      + any-child

+ start vfs | caps: 16000 | ram: 128M
  + provides | + service File_system
  + config
    + vfs
      + rump | fs: ext2fs | ram: 48M | writeable: yes
    + policy | label_prefix: rom_sys | root: /system     | writeable: no
    + policy | label_prefix: rom_lib | root: /system/lib | writeable: no
  + route
    + service ROM | label_last: ld.lib.so     | + parent
    + service ROM | label_last: vfs.lib.so    | + parent
    + service ROM | label_last: vfs_rump.lib.so | + parent
    + service ROM | label_last: rump.lib.so   | + parent
    + service ROM | label_last: rump_fs.lib.so | + parent
    + service Block | + child part_block
    + any-service
      + parent
      + any-child

+ start rom_sys | caps: 500 | ram: 256M
  + binary cached_fs_rom
  + provides | + service ROM
  + route
    + service File_system | + child vfs
    + service ROM | label_last: ld.lib.so | + parent
    + any-service
      + parent
      + any-child

+ start rom_lib | caps: 500 | ram: 256M
  + binary cached_fs_rom
  + provides | + service ROM
  + route
    + service File_system | + child vfs
    + service ROM | label_last: ld.lib.so | + parent
    + any-service
      + parent
      + any-child

+ start nitpicker | ram: 16M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    + report | focus: yes | hover: yes
    # Pointer cursor domain: front-most (layer 0), positioned at the
    # pointer by nitpicker itself (origin: pointer). The upstream
    # 'pointer' component renders the cursor glyph into it — without
    # this domain + component there is no visible mouse cursor.
    + domain pointer | layer: 0 | content: client | label: no | origin: pointer
    + domain panel | layer: 1 | content: client | label: no
                   | hover: always | focus: click | ypos: 0 | height: 28
    + domain launcher | layer: 4 | content: client | label: no
                      | hover: always | focus: click
                      | xpos: 0 | ypos: 28 | width: 341 | height: 480
    + domain default | layer: 3 | content: client | label: no
                     | hover: always | focus: click | ypos: 28 | height: -28
    + policy | label_prefix: pointer                  | domain: pointer
    + policy | label_prefix: system -> sponge-de -> Sponge Panel   | domain: panel
    + policy | label_prefix: system -> sponge-de -> Sponge Launcher | domain: launcher
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start pointer | caps: 100 | ram: 4M
  + provides
    + service Report
  + config | shapes: no
  + route
    + service Gui | + child nitpicker
    + service ROM | label: hover | + child report_rom
    # The xray ROM is optional (shape-debug feature); without this
    # empty-ROM route the session denial would freeze the component
    # (base-lib DENIED -> sleep_forever, cf. the W3 theme fallback).
    + service ROM | label: xray  | + child report_rom
    + any-service
      + parent
      + any-child

# The display driver is the fb_vesa PACKAGE now (docs/17 §1): no static
# `+ start fb` node. pkgd starts it inside driver_runtime from the
# first-boot manifest, with the route its <sessions> declare
# (pkg/fb_vesa/metadata.xml) rather than the hand-written list above.

+ start ps2 | caps: 100 | ram: 1280K
  + config
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Dma | + child platform
    + service Platform | + child platform
    + service Event | + child event_filter | label: ps2
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer

+ start usb | caps: 200 | ram: 16M
  + binary pc_usb_host
  + provides | + service Usb
  + config
    + report | devices: yes
    + policy | label_prefix: usb_hid | + device | class: 0x3
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Dma | + child platform
    + service Platform | + child platform
    + service Report | label: devices | + child report_rom
    + service ROM | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer

+ start usb_hid | caps: 180 | ram: 10M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: report | + child report_rom
    + service ROM | + parent
    + service PD | + parent
    + service RM | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer
    + service Event | + child event_filter | label: usb
    + service Usb | + child usb

+ start event_filter | caps: 90 | ram: 1280K
  + provides | + service Event
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: config | + parent | label: event_filter.config
    + service Event | + child nitpicker
    + service ROM | + parent
    + service PD | + parent
    + service CPU | + parent
    + service LOG | + parent
    + service Timer | + child timer

# caps carry ~10% headroom per docs/17 §5 (adding a child must not be
# a cliff-edge operation on a grant sized exactly to fit).
# Children caps-sum of THIS sandbox: 238650 caps
#   report_rom 300 + wm 2000 + layouter 1000 + decorator 350 +
#   sponge_configd 200 + sponge_themed 200 + sponge_pkgd 200 +
#   sponge-de 4000 + alpha_probe 200 + cfg_probe 200 + pkg_runtime 230000
# Grant 263000 caps => +10.2% caps headroom.
#
# RAM: `512G` IS THE SAME DELIBERATELY-HUGE QUANTUM as pkg_runtime's,
# one level up — same clamp mechanism, genode/repos/os/src/lib/sandbox/
# child.cc:481-486. `system` is the LAST `+ start` node in THIS
# top-level config, so it absorbs every MiB the Tier-0 children did not
# claim; inside it, pkg_runtime (also last) absorbs whatever the fixed
# system services did not. That is what makes the whole stack
# physical-RAM-size agnostic. The declared 3420M it replaces (+10.3%
# over the 3100M fixed-child sum) was a hand-derived constant that only
# happened to fit -m 6G/8G and had to be recomputed whenever -m or a
# package profile changed.
# Caps for `system` stay explicit at 263000 for the reason pkg_runtime's
# do — the caps clamp hangs on seL4; see the caps rationale at the
# pkg_runtime node below.
#
+ start system | caps: @SYSTEM_CAPS@ | ram: 512G
  + binary | name: bin/init
  + route
    + service ROM | label: config | + child rom_sys | label: init/system.config
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_suffix: .lib.so | + child rom_lib
    + service ROM | label_last: focus | + child report_rom
    + service ROM | label_last: hover | + child report_rom
    + service ROM | label_last: system_state | + child report_rom
    #
    # platform_info BEFORE the rom_sys catch-all: a CORE rom module
    # (base-sel4 exports it from the multiboot2 boot info,
    # core/platform.cc:629), matched by label_LAST because the query
    # label is child-scoped at whichever node the request arrives at.
    # Every `<service>` node is "specific" in
    # repos/os/src/lib/sandbox/route_model.h, so the rom_sys denial
    # below would otherwise stop the search silently. The BIOS media
    # needs it too once the display driver is a package: the fb-switch
    # proof installs fb_boot here, and fb_boot reads this ROM. Whether
    # the SeaBIOS/GRUB2 media actually carries a framebuffer tag is a
    # separate, measured question (docs/15 §8).
    + service ROM | label_last: platform_info | + parent
    + service ROM | + child rom_sys
    + service Gui | + child nitpicker
    + service Capture | + child nitpicker
    + service Event | + child nitpicker
    + service Timer | + child timer
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }]
set tier0_config [driver_runtime::expand $tier0_config \
                       [list @DRIVER_PLATFORM_POLICIES@]]
install_config $tier0_config

#
# Stage the driver sub-init config modules (Tier-0 boot modules).
#
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
# fb.config is gone: the framebuffer mode is declared in
# pkg/fb_vesa/metadata.xml, so there is no Tier-0 ROM to relay.
foreach f { event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

#
# Keyboard layouts consumed by event_filter.
#
set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

#
# Tier-0 boot module list — storage chain + drivers + nitpicker ONLY.
# ld.lib.so is auto-injected by boot_dir/sel4 (docs/11 §10.4).
# The vfs+rump chain libs are transitive deps not in build_artifacts.
# Desktop components (wm/sponge-de/Qt6/Mesa/etc.) are on DISK, NOT here.
#
set boot_modules { }
foreach m { core-sel4.a ld-sel4.lib.so init timer report_rom nitpicker platform acpi pci_decode \
            nvme part_block partition_check vfs cached_fs_rom nic_router \
            ps2 pc_usb_host usb_hid event_filter pointer } {
	lappend boot_modules $m
}
foreach m { vfs.lib.so vfs_rump.lib.so rump.lib.so rump_fs.lib.so \
            en_us.chargen special.chargen \
            event_filter.config } {
	lappend boot_modules $m
}

#
# Top-level supervision (sponge_supervisor + sponge_console + their two
# config modules). Both are small base-lib binaries; the Tier-0 budget
# check below is asserted against image.elf, not against a hope.
#
foreach m [supervisor::boot_modules] { lappend boot_modules $m }

build_boot_image $boot_modules

#
# Assert Tier-0 budget: image.elf must be ≤ 80 MiB (docs/14 §4.5).
#
set image_elf "[run_dir]/boot/image.elf"
if {[file exists $image_elf]} {
	set size_bytes [file size $image_elf]
	set size_mib [expr {$size_bytes / 1048576}]
	puts "sponge-desktop-disk-nvme: image.elf = ${size_mib} MiB ($size_bytes bytes)"
	if {$size_mib > 80} {
		puts "sponge-desktop-disk-nvme: ERROR — Tier-0 budget exceeded (>80 MiB, §4.5)"
	}
} else {
	puts "sponge-desktop-disk-nvme: image.elf not found at expected path"
}

#
# Assert ld.lib.so is NOT in /system/lib/ (§4.6 rule).
#
set ld_check "$sys_dir/lib/ld.lib.so"
if {[file exists $ld_check]} {
	puts "sponge-desktop-disk-nvme: ERROR — ld.lib.so found in /system/lib/ (§4.6 violation)"
}

#
# QEMU: -m 6G now only sets the CEILING on guest RAM. It no longer has to
# match any declared grant, because `system` and `pkg_runtime` are
# remainder clamps (child.cc:481-486) and track whatever init actually
# has. 6G is kept unchanged deliberately: every receipt in
# docs/evidence/ was earned at 6G, and changing the value would
# invalidate that evidence for no functional gain. A SMALLER -m also
# works — pkg_runtime just receives a proportionally smaller remainder,
# and `sponge_pkgd`'s admission control refuses a package that no longer
# fits instead of letting init clamp it into a hang.
# Historical arithmetic, kept for provenance: Tier-0 children here total
# 814M (nvme 64M instead of ahci 128M) and the previous fixed grants
# asked for that + system 3420M = 4234M from init's pool. On the
# BIOS/direct-kernel path core reserves ~458M of guest RAM (measured on
# the sibling sponge-desktop-disk: "-m 6G => 5686 MiB RAM assigned to
# init"), so 6G left ~1452M of slack above every declared grant, while at
# the old -m 4G the pool was 3667 MiB — ~567M SHORT of 4234M.
# Measured post-change, see docs/evidence/remainder-clamp-ram.md.
# nec-usb-xhci + usb-tablet for absolute pointer.
#
# Phase 12 W1 (docs/plans/phase12-hardware.md W1): pin the platform
# explicitly. PC board default already supplies -machine q35
# -cpu Skylake-Client; this makes the contract local and guards
# against a silent board-default regression. Existing storage/device
# arguments and the 900 s alpha-probe gate are preserved.
#
append qemu_args " -machine q35 -cpu Skylake-Client "
append qemu_args " -nographic -m 6G "
append qemu_args " -device nec-usb-xhci,id=xhci -device usb-tablet "
#
# Phase 12 W2 (docs/plans/phase12-hardware.md §"W2: Storage variants
# and product-media selector", Risk 10 mitigation): the QEMU
# root-port + raw drive + `-device nvme` sequence is copied VERBATIM
# from run/sponge-boot.run's `SPONGE_BOOT_NVME` block (lines 372–376).
# The boot .img is auto-attached by image/disk to q35's implicit
# ICH9 (AHCI) — Genode does NOT start AHCI in this scenario, so that
# disk is only the bootloader media. bin/nvme_disk.img is the
# storage-chain target (one namespace, GPT P3 ext2, /system/ tree).
#
append qemu_args " -device pcie-root-port,id=root_port1 "
append qemu_args " -drive id=disk0,file=bin/nvme_disk.img,format=raw,if=none "
append qemu_args " -device nvme,drive=disk0,serial=fnord,id=nvme0,bus=root_port1 "

#
# Build bin/nvme_disk.img: a GPT disk with P3 = GENODE ext2 carrying
# the full /system/ tree (the desktop binaries, libs, themes, tars,
# pkg metadata, nested init config). Mirrors the SPONGE_BOOT_NVME
# sequence in run/sponge-boot.run lines 297-333: build a standalone
# ext2 image first, then assemble a GPT disk with that ext2 embedded
# at partition 3. The image/disk plugin ALSO copies [run_dir]/system/
# into the .img's P3 (AHCI auto-attach, but ahci driver is NOT
# started, so that copy is dead weight — harmless, identical to the
# sponge-boot NVMe variant precedent).
#
set sgdisk [installed_command sgdisk]
set mkfs   [installed_command mkfs.ext2]
set e2cp   [installed_command e2cp]
set e2mkdir [installed_command e2mkdir]

#
# Size the NVMe ext2 from the ACTUAL staged content (du -smL of
# [run_dir]/system) + 16 MiB + 25% slack — the earlier hardcoded
# 128 MiB broke the desktop profile mid-e2cp (falkon's payload
# alone exceeds it; same failure class as the UEFI-NVMe variant
# fixed in the same change).
#
set sys_size_mb [expr [regsub {\s.*} [exec du -smL [run_dir]/system] {}]]
set nvme_mb   [expr $sys_size_mb + 16 + ($sys_size_mb / 4)]
exec dd if=/dev/zero of=bin/nvme_partition.ext2 bs=1M count=$nvme_mb 2>/dev/null
exec $mkfs -F -q -L GENODE bin/nvme_partition.ext2 2>/dev/null
#
# Mirror [run_dir]/system/ into bin/nvme_partition.ext2's /system via
# e2cp + e2mkdir. e2cp does NOT auto-create parent directories, so
# we must:
#   1. explicitly e2mkdir the root /system + every subdirectory
#      (bin, lib, init, ...) BEFORE any e2cp into them; and
#   2. sort the find output so directories precede their contents
#      (find's default inode order is not depth-first and can return
#      a file before its parent dir, breaking e2cp).
#
# The `rel` slice uses `string range $entry [string length $sys_dir]+1 end`
# (start index is `sys_dir_len + 1` to skip the '/' that separates
# the prefix from the relative path) — the original implementation
# used `string replace $entry 0 $sysdir_len ""` which is OFF-BY-ONE
# because `string replace`'s last index is inclusive, eating the
# leading '/' and producing "bin" instead of "/bin". The off-by-one
# caused rom_lib to fail with `session root '/system/lib' not found`
# and rom_sys to fail with `/bin/init not found` (the leading slash
# collapsed to e.g. /systembin/init).
#
exec $e2mkdir bin/nvme_partition.ext2:/system
set sysdir_len [string length $sys_dir]
foreach entry [lsort [exec find "$sys_dir" -mindepth 1]] {
	#
	# `string range $entry $sysdir_len end` keeps the '/' that
	# separates the sys_dir prefix from the relative sub-path.
	# (Adding 1 to skip the slash would lose the slash, producing
	# `/systembin/init` instead of `/system/bin/init` — see the
	# session-root-not-found failure mode this fixes.)
	#
	set rel [string range $entry $sysdir_len end]
	if {[file isdirectory $entry]} {
		exec $e2mkdir bin/nvme_partition.ext2:/system$rel
	} else {
		exec $e2cp $entry bin/nvme_partition.ext2:/system$rel
	}
}

exec dd if=/dev/zero of=bin/nvme_disk.img bs=1M count=256 2>/dev/null
exec $sgdisk --clear --new=3:0:0 --change-name=3:GENODE bin/nvme_disk.img 2>/dev/null
set p3_info [exec $sgdisk -i 3 bin/nvme_disk.img]
set first_sector [regexp -inline {First sector: ([0-9]+)} $p3_info]
set first_sector [lindex $first_sector 1]
exec dd if=bin/nvme_partition.ext2 of=bin/nvme_disk.img bs=512 \
	seek=$first_sector conv=notrunc 2>/dev/null
exec rm -f bin/nvme_partition.ext2

#
# Verification gate (TWO bounds, plan §W2 step 3).
#
# Tier-0 gate: partition-check: PASS (Number: 3) — verifies the
# part_block reporter lists partition 3 BY NUMBER on the NVMe
# namespace (Risk 3 + Risk 10 mitigation). Bounded by the 900 s
# timeout; in normal conditions this fires well under 60 s.
#
# Full-desktop gate: alpha-probe: PASS — themed panel pixel +
# launcher feed + configd broadcast, all from the NVMe-served
# /system/ tree. The 600 s+ reality (Phase 9 C4 flake: 2 fails
# then PASS) is bounded at 900 s per plan §W2 step 6.
#
# The run_genode_until regex requires both lines in order. If
# partition-check never logs PASS, alpha-probe never runs (because
# the chain would have already broken), and the 900 s timeout
# fires as a bounded failure.
#
# FAILURE CHANNEL: bounded by timeout; the nested init's XML parse
# error identifies the stage (corrupted system.config).
#
if {$fail_mode} {
	run_genode_until {.*init -> system.*Error.*config.*|.*system.*invalid.*|.*Error reading config.*} 120
	puts "sponge-desktop-disk-nvme: FAILURE CHANNEL — system init rejected corrupted config (bounded, identified)"
} else {
	run_genode_until {.*partition-check: PASS.*Number: 3.*alpha-probe: PASS.*} 900
}
