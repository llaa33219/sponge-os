
# \brief  Native Sponge WM Master-Stack / mode / reflow acceptance
#        scenario (Criterion 16, M4/M5 gates — D16W.5 + §7.1 tiling row)
# \author Sponge OS contributors
# \date   2026
#
# Drives the D16W.5 tiling acceptance against the NATIVE trio
# (sponge_wm + sponge_layouter + sponge_decorator): Master-Stack
# placement, every reflow trigger of docs/plans/wm-state-table.md's
# "Native WM Extension" rows, wm.layout.mode switching via the
# `vct config` backend write (D16W.11), mode-switch geometry
# retention, and the >=20-cycle rules-drift soak (§7.2) with EXACT
# arrangement assertions after every reflow.
#
# Derived from run/sponge-wm-tasks.run (the proven tasklist topology)
# plus sponge_configd (the mode-key owner). The upstream anchors
# run/sponge-wm{,-qmp,-tasks}.run stay untouched and green (D16W.7).
#
# === ACCEPTANCE STATUS ===
#
# The two-client sequence passes on base-sel4/QEMU (pre-fixture
# revision), including the default 20-cycle soak and the real chrome
# close. Step 12 requires the remaining client to be visible and
# exactly in the left-half master slot; a parked sole client is not
# accepted as a reflow proof.
#
# The non-resizeable fixture (native_wm_fixture_client, static assign
# 850,560,160x160) is a later addition: its window_list
# resizeable="no" classification and exact floating geometry are
# asserted by an INDEPENDENT probe helper at step 1 and inside every
# arrangement check (fixture exclusion from Master-Stack is
# continuously proven without touching the two-client classification,
# the eligible count, or the step-12 min_clients logic). These
# fixture gates are new and gate this scenario; the serial acceptance
# run is the authority for their PASS status.
#
# Mode write path (D16W.11): the probe drives the sponge_configd
# config_request/config_result channel — the SAME backend `vct config`
# uses (AGENTS.md §3.3 rule 5). The user-facing spelling of the writes
# the probe performs is:
#
#   vct config set wm.layout.mode tiling
#   vct config set wm.layout.mode floating
#
# (the admin/manual escape hatch until the wm_settings provider owns
# the wm.* key domain at Criterion 18).
#
# Topology (base-sel4, headless, one QEMU boot): the
# run/sponge-wm-native-qmp.run topology (drivers sub-init +
# sponge_pkgd + pkg_runtime + sponge-de tasklist) PLUS sponge_configd
# (mode-key registry + broadcast), test/native_wm_tiling_probe, and
# the non-resizeable test/native_wm_fixture_client fixture. Three
# windows exist: sponge-de's demo window (420,60,560,220),
# pkg_gui_demo (50,320,320,240), and the fixture (850,560,160x160) —
# disjoint floating placements. The fixture never opens the Gui info
# ROM, so window_list reports resizeable="no" and D16W.5 keeps it
# floating at exactly that static-assign geometry in every mode (it
# is never eligible and never joins the Master-Stack arrangement);
# the tiling arrangement itself is computed by the probe from the
# work area (screen minus the 28 px panel) and the decorator margins.
#
# Master-Stack run-side contract (D16W.5 reading asserted exactly;
# see native_wm_tiling_probe/main.cc header): outer-rect placement,
# master = left half, stack = equal right-half bands top to bottom,
# no gaps (gaps are a non-goal); a lone eligible window stays the
# left-half master; eligibility = resizeable && non-minimized &&
# non-maximized; window_list order = creation order.
#
# Marker choreography (shared run/qmp.inc dispatch — no local Tcl QMP
# procs; probe-derived coordinates):
#
#   gate [step 1]  two clients live + eligibility (>= 2 resizeable)
#                  + fixture exclusion (resizeable=no + exact floating
#                  geometry 850,560,160x160; probe-side, no marker)
#   gate [step 2]  mode floating -> tiling + arrangement (probe-driven
#                  configd write)
#   dispatch/gate [steps 3-8]  minimize/restore (tasklist clicks),
#                  master-minimize/restore, chrome fullscreen
#                  maximize/restore
#   gate [steps 9-10]  mode retention + re-entry (probe-driven)
#   soak loop: 2 dispatches per cycle x soak_cycles (tasklist
#                  minimize+restore inside the cycle), then gate
#                  [step 11] soak clean and drain through QMP-TARGET sync
#   dispatch/gate [step 12]  materialize the pointer, walk combined-axis
#                  rel-1 steps to the closer, press, and require the
#                  remaining client at the exact master slot
#   gate PASS
#
# Soak length: >= 20 cycles (§7.2). SPONGE_TILING_SOAK overrides the
# cycle count (control door, AGENTS.md §1.1) — the run dispatch loop
# and the probe's count are stamped from the same value, so the
# marker serialization can never desync.
#
# Hard constraints (same as run/sponge-wm-native-tasks.run):
# base-sel4 only; event_filter.config copied VERBATIM from the vendored
# drivers_interactive-pc recipe (accelerate LUT kept for the shared
# qmp.inc PS/2 helpers).

assert {[have_spec sel4]} \
	"sponge-wm-native-tiling requires KERNEL=sel4 (BOARD=pc) in build.conf. \
	 This scenario drives real PC hardware (vesa_fb/ps2/usb_hid) which \
	 base-linux cannot provide."

#
# G3 WM-shaped Tier-0 selection seam (run/compositor.inc). tier0_kind
# defaults to 'upstream' (this reference run keeps nitpicker); 'native'
# selects sponge_compositor and rewrites every nitpicker child/report
# label in the generated config.
#
source [file join [file dirname [file normalize [info script]]] compositor.inc]

if {![info exists tier0_kind]} {
	set tier0_kind upstream
}
set tier0_build [compositor::wm_tier0_build $tier0_kind]
set tier0_child [compositor::wm_tier0_child $tier0_kind]
set tier0 [compositor::wm_start_node $tier0_kind "focus: yes | hover: yes | pointer: yes | xray: yes"]

build [string map [list server/nitpicker $tier0_build] { core lib/ld init timer server/report_rom server/nitpicker \
         driver/acpi app/pci_decode driver/platform \
         driver/framebuffer/vesa driver/ps2 \
         driver/usb_host/pc driver/usb_hid server/event_filter \
         sponge_wm sponge_layouter sponge_decorator \
         sponge_configd sponge_pkgd test/pkg_gui_demo \
         test/native_wm_fixture_client \
         test/native_wm_tiling_probe \
         sponge-de \
         qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
         lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
         lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
         lib/zlib lib/libpng lib/blit }]

create_boot_directory

#
# Soak length: >= 20 cycles (docs/plans/phase16-sponge-wm.md §7.2).
# SPONGE_TILING_SOAK is the control door for shorter debug runs; the
# SAME value drives the probe config and the dispatch loop below.
#
set soak_cycles 20
if {[info exists env(SPONGE_TILING_SOAK)] \
 && [string is integer -strict $env(SPONGE_TILING_SOAK)] \
 && $env(SPONGE_TILING_SOAK) >= 1} {
	set soak_cycles $env(SPONGE_TILING_SOAK)
}

install_config [string map [list @TIER0@ $tier0 nitpicker $tier0_child @SOAK@ $soak_cycles] {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    #
    # Protocol v1 (frozen) — TasklistController-facing labels preserved.
    #
    + policy | label: sponge-de -> window_list         | report: sponge_wm -> window_list
    + policy | label: sponge-de -> window_layout       | report: sponge_layouter -> window_layout
    + policy | label: sponge_layouter -> window_list   | report: sponge_wm -> window_list
    + policy | label: sponge_layouter -> focus_request | report: sponge-de -> focus_request
    + policy | label: sponge_layouter -> rules         | report: sponge-de -> rules
    + policy | label: native_wm_tiling_probe -> window_list   | report: sponge_wm -> window_list
    + policy | label: native_wm_tiling_probe -> window_layout | report: sponge_layouter -> window_layout
    + policy | label: native_wm_tiling_probe -> focus_request | report: sponge-de -> focus_request
    + policy | label: native_wm_tiling_probe -> rules         | report: sponge-de -> rules
    + policy | label: native_wm_tiling_probe -> decorator_margins | report: sponge_decorator -> decorator_margins
    + policy | label: native_wm_tiling_probe -> pointer | report: nitpicker -> pointer
    #
    # Non-resizeable fixture command channel. No command is sent in
    # this scenario: the fixture_cmd ROM serves empty content until a
    # probe-side fixture_cmd report arrives (the probe would publish
    # via Genode::Expanding_reporter only if a command were needed).
    #
    + policy | label: native_wm_fixture_client -> fixture_cmd | report: native_wm_tiling_probe -> fixture_cmd
    #
    # Internal contract v1.1 (binding; see run/sponge-wm-native.run header).
    #
    + policy | label: sponge_layouter -> focus_state      | report: sponge_wm -> focus_state
    + policy | label: sponge_layouter -> decorator_margins | report: sponge_decorator -> decorator_margins
    + policy | label: sponge_wm -> focus                  | report: sponge_layouter -> focus
    + policy | label: sponge_wm -> window_request         | report: sponge_layouter -> window_request
    + policy | label: sponge_wm -> decorator_margins      | report: sponge_decorator -> decorator_margins
    + policy | label: sponge_decorator -> window_chrome   | report: sponge_wm -> window_chrome
    #
    # sponge_configd relay (the wm.layout.mode backend, D16W.11).
    #
    + policy | label: sponge_configd -> config_request      | report: native_wm_tiling_probe -> config_request
    + policy | label: native_wm_tiling_probe -> config_result | report: sponge_configd -> config_result
    + policy | label: native_wm_tiling_probe -> configd      | report: sponge_configd -> config
    + policy | label: sponge_layouter -> configd            | report: sponge_configd -> config
    #
    # sponge_pkgd relay.
    #
    + policy | label: sponge_pkgd -> request          | report: native_wm_tiling_probe -> request
    + policy | label: native_wm_tiling_probe -> result | report: sponge_pkgd -> result
    + policy | label: pkg_runtime -> config           | report: sponge_pkgd -> runtime

@TIER0@

+ start drivers | caps: 1800 | ram: 96M | managing_system: yes
  + binary init
  + route
    + service ROM | label: config | + parent | label: drivers.config
    + service Timer | + child timer
    + service Capture | + child nitpicker
    + service Event | + child nitpicker
    + any-service                 | + parent
  + config
    + parent-provides
      + service IRQ
      + service IO_MEM
      + service IO_PORT
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Capture
      + service Event

    + default | caps: 60

    + start acpi | caps: 250 | ram: 4M
      + route
        + service IO_MEM | + parent
        + service LOG | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service ROM | + parent
        + service Report | + child report_rom

    + start report_rom | caps: 300 | ram: 8M
      + provides
      | + service ROM
      | + service Report
      + config
      | + policy | label: pci_decode -> system | report: acpi -> acpi
      | + policy | label: platform -> devices  | report: pci_decode -> devices
      | + policy | label: usb_hid -> report    | report: usb -> devices
      + route
        + service LOG | + parent
        + service PD | + parent
        + service CPU | + parent
        + service ROM | + parent

    + start pci_decode | caps: 100 | ram: 2M
      + route
        + service Report | + child report_rom
        + service ROM | label: system | + child report_rom
        + service IO_MEM | + parent
        + service LOG | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service ROM | + parent

    + start platform | caps: 200 | ram: 3M | managing_system: yes
      + provides
      | + service Dma
      | + service Platform
      + route
      | + service ROM | label: devices | + child report_rom
      | + service Report | + child report_rom
      | + service IRQ | + parent
      | + service IO_MEM | + parent
      | + service IO_PORT | + parent
      | + service ROM | + parent
      | + service PD | + parent
      | + service CPU | + parent
      | + service LOG | + parent
      | + service Timer | + parent
      + config
        + report | devices: yes
        + policy | label_prefix: ps2             | + device ps2
        + policy | label_prefix: fb  | info: yes | + pci | class: VGA
        + policy | label_prefix: usb | info: yes | + pci | class: USB

    + start fb | caps: 150 | ram: 20M
      + binary vesa_fb
      + route
        + service ROM | label: config | + parent | label: fb.config
        + service Report | + child report_rom
        + service Dma | + child platform
        + service Platform | + child platform
        + service IO_PORT | + parent
        + service IO_MEM | + parent
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent
        + service Capture | + parent

    + start ps2 | caps: 100 | ram: 1280K
      + config
      + route
        + service Dma | + child platform
        + service Platform | + child platform
        + service Event | + child event_filter | label: ps2
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

    + start usb | caps: 200 | ram: 16M
      + binary pc_usb_host
      + provides | + service Usb
      + config
      | + report | devices: yes
      | + policy | label_prefix: usb_hid | + device | class: 0x3
      + route
        + service Dma | + child platform
        + service Platform | + child platform
        + service Report | label: devices | + child report_rom
        + service ROM | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

    + start usb_hid | caps: 180 | ram: 10M
      + route
        + service ROM | label: report | + child report_rom
        + service ROM | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent
        + service Event | + child event_filter | label: usb
        + service Usb | + child usb

    + start event_filter | caps: 90 | ram: 1280K
      + provides | + service Event
      + route
        + service ROM | label: config | + parent | label: event_filter.config
        + service Event | + parent
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

+ start sponge_wm | caps: 250 | ram: 8M
  + provides
    + service Gui
  + config
    + policy | label_prefix: sponge_decorator | role: decorator
    + policy | label_prefix: sponge_layouter  | role: layouter
    + default-policy
  + route
    + service ROM | label: focus            | + child report_rom
    + service ROM | label: window_request   | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service Report | + child report_rom
    + service Gui | + child nitpicker
    + any-service
      + parent
      + any-child

+ start sponge_layouter | caps: 150 | ram: 4M
  + config | rules: rom
    + work_area | x: 0 | y: 28 | width: 1024 | height: 740
    + rules
      + screen screen
      + assign | label: sponge-de -> Sponge DE Demo | target: screen
               | xpos: 420 | ypos: 60 | width: 560 | height: 220 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen
               | xpos: 50 | ypos: 320 | width: 320 | height: 240 | maximized: no
      + assign | label_prefix: native_wm_fixture_client | target: screen
               | xpos: 850 | ypos: 560 | width: 160 | height: 160 | maximized: no
    + press   | key: BTN_LEFT  | action: drag
      + release | key: BTN_LEFT | action: drop
  + route
    + service ROM | label: window_list       | + child report_rom
    + service ROM | label: focus_request     | + child report_rom
    + service ROM | label: rules             | + child report_rom
    + service ROM | label: focus_state       | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service ROM | label: configd           | + child report_rom
    + service Report | + child report_rom
    + any-service
      + child sponge_wm
      + parent
      + any-child

+ start sponge_decorator | caps: 350 | ram: 32M
  + config
    + theme | source: default
  + route
    + service ROM | label: theme         | + parent
    + service ROM | label: default.theme | + parent
    + service ROM | label: window_chrome | + child report_rom
    + service Report | + child report_rom
    + any-service
      + child sponge_wm
      + parent
      + any-child

+ start sponge_configd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: config_request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 1500 | ram: 256M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service Gui | + child sponge_wm
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge-de | caps: 1000 | ram: 128M
  + config
    + tasklist | source: wm
    + tasklist_static_rules
      + assign | label: sponge-de -> Sponge DE Demo | target: screen
               | xpos: 420 | ypos: 60 | width: 560 | height: 220 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen
               | xpos: 50 | ypos: 320 | width: 320 | height: 240 | maximized: no
    + theme | source: default
    + config | source: default
    + version: 2
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service Gui | label_last: Sponge Panel | + child nitpicker
    + service Gui | + child sponge_wm
    + service Report | + child report_rom
    + service ROM | label: theme   | + parent
    + service ROM | label: configd | + parent
    + service ROM | label: default.theme | + parent
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service Report | label: focus_request | + child report_rom
    + service Report | label: rules        | + child report_rom
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child

+ start native_wm_fixture_client | caps: 200 | ram: 16M
  + route
    + service Gui | + child sponge_wm
    + service ROM | label: fixture_cmd | + child report_rom
    + any-service
      + parent
      + any-child

+ start native_wm_tiling_probe | caps: 150 | ram: 32M
  + config | panel_height: 28 | soak_cycles: @SOAK@
  + route
    + service Timer | + child timer
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service ROM | label: rules         | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service ROM | label: configd       | + child report_rom
    + service ROM | label: config_result | + child report_rom
    + service ROM | label: pointer       | + child report_rom
    + service ROM | label_last: result   | + child report_rom
    + service Report | label: fixture_cmd | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }]

#
# Stage every non-build-artifact boot module into bin/ BEFORE
# build_boot_image (base-sel4 packs a single image.elf at that point).
#
exec mkdir -p bin

set dejavu_dst "bin/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavu_dst -C $staging qt
	file delete -force $staging
}

#
# Driver sub-init config modules copied VERBATIM (accelerate LUT kept
# for the shared qmp.inc PS/2 helpers — see the header).
#
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { drivers.config fb.config event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

exec cp -f "${genode_dir}/../repos/sponge-de/src/sponge-de/themes/default.theme" \
           "bin/default.theme"

set staged_pkgs { pkg_gui_demo }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src "bin/pkg_$pkg.xml"
}

set index_fh [open "bin/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

set boot_modules [build_artifacts]
foreach m { libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
            libqgenode.lib.so qt6_libqgenode.tar qt6_dejavusans.tar \
            en_us.chargen special.chargen \
            drivers.config fb.config event_filter.config \
            default.theme \
            pkg_pkg_gui_demo.xml pkg_index.xml } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# Source the shared QMP helper — no local QMP procs in this scenario.
#
set qmp_source_path [file join [file dirname [file normalize [info script]]] qmp.inc]
catch { source $qmp_source_path }

if {[info procs qmp_disconnect] eq ""} {
	proc qmp_disconnect { chan } { catch { close $chan } }
}

append qemu_args " -nographic -m 2G "
append qemu_args " -device nec-usb-xhci,id=xhci -device usb-tablet "

set qmp_port [qmp_pick_port]
append qemu_args " -qmp tcp:127.0.0.1:${qmp_port},server=on,wait=off "

#
# Choreography (see the header). Gate patterns match unique probe
# POST-step phrases so pre-action log lines can never satisfy them.
#
run_genode_until {.*\[init -> drivers -> fb\] using 1024x768.*} 90
global qemu_spawn_id

set qmp_chan [qmp_connect $qmp_port]

# Steps 1-2 complete inside the probe before its first marker. Do not
# gate on them separately: the probe's own failure is authoritative.
#
# steps 3-8: QMP-TARGET markers are the post-step gates. Competing
# run_genode_until calls can consume a marker before qmp_exec_target sees it.
for {set step 3} {$step <= 8} {incr step} {
	qmp_exec_target $qmp_chan 120
}

# steps 9-10: mode retention + re-entry (probe-driven configd writes)
run_genode_until {native-wm-tiling-probe: \[step 9\] floating mode} 300 $qemu_spawn_id
run_genode_until {native-wm-tiling-probe: \[step 10\] tiling arrangement} 300 $qemu_spawn_id

# step 11: rules-drift soak — two tasklist clicks per cycle, dispatched
# in lockstep with the probe's markers (same cycle count, both stamped
# from $soak_cycles).
for {set c 0} {$c < $soak_cycles} {incr c} {
	qmp_exec_target $qmp_chan 120
	qmp_exec_target $qmp_chan 120
}
run_genode_until {native-wm-tiling-probe: \[step 11\] soak clean} 600 $qemu_spawn_id

# Do not let queued tasklist clicks race step-12 pointer materialization.
# The probe emits sync only after its final arrangement assertion, so
# reaching it here proves every earlier real input action was dispatched.
set step11_synced 0
for {set i 0} {$i <= [expr {2 * $soak_cycles}]} {incr i} {
	if {[qmp_exec_target $qmp_chan 120] eq "sync"} {
		set step11_synced 1
		break
	}
}
if {!$step11_synced} {
	error "step 11: sync marker was not dispatched after the soak"
}

# step 12: one pointer-materialization marker, at most 30 closed-loop
# moves, then one press. qmp_exec_target identifies the terminal press;
# all other callers retain its historical empty return value.
set step12_pressed 0
for {set i 0} {$i < 32} {incr i} {
	if {[qmp_exec_target $qmp_chan 120] eq "press"} {
		set step12_pressed 1
		break
	}
}
if {!$step12_pressed} {
	error "step 12: chrome closer press was not dispatched within 32 markers"
}

run_genode_until {native-wm-tiling-probe: PASS} 120 $qemu_spawn_id

qmp_disconnect $qmp_chan
