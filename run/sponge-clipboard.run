#
# \brief  Sponge OS cross-component clipboard scenario (Phase 14 W5)
# \author Sponge OS contributors
# \date   2026
#
# Phase 14 W5 acceptance boot for decision D14.2 (the cross-component
# clipboard proof per U2: writer and reader are different components;
# data flows through the upstream Genode clipboard server, not Qt
# intra-process state).
#
# Topology (base-sel4 + QMP, headless):
#
#   init
#   + timer
#   + report_rom     (relays focus ROM from nitpicker -> wm_report_rom
#                     style for the clipboard server's focus gating;
#                     carries sponge_pkgd request/result/installed/
#                     runtime channels for textedit launch)
#   + wm_report_rom  (the focus ROM relay from nitpicker -> clipboard)
#   + nitpicker      (Gui/Capture/Event; demo domain hosts sponge-de's
#                     window; edit domain hosts textedit; the panel
#                     domain is disabled here — the scenario is focused
#                     on the cross-component proof)
#   + drivers        (sub-init copied from run/sponge-de-sel4-
#                     interactive.run: vesa_fb/ps2/usb_hid/
#                     pc_usb_host/event_filter + xhci + usb-tablet.
#                     QMP listener enabled for the host-driven
#                     choreography below.)
#   + sponge_configd | sponge_themed | sponge_pkgd
#                     (the live theme + theme + package backends so
#                     sponge-de and textedit boot identically to the
#                     Alpha scenario — proves the W5 wiring integrates
#                     with the established backend pattern, docs/04 §5)
#   + clipboard      (the upstream os/src/server/clipboard binary,
#                     staged as-is from the vendored tree per AGENTS.md
#                     §5.2 — no source change, no Sponge fork.
#                     Default flow: <flow from="default" to="default"/>
#                     + match_labels="no" (permissive single-domain).)
#   + sponge-de      (Qt6 DE; the W5 path adds clipboard="yes" in the
#                     runtime config so QGenodeClipboard opens Report
#                     + ROM sessions to the upstream server; the demo
#                     window now carries a small QLineEdit for the
#                     "focus + type + Ctrl-C" sender.)
#   + pkg_runtime    (nested init hosting launched packages; carries
#                     the per-label Report/ROM routes for textedit's
#                     clipboard session pair.)
#   + textedit       (Qt6 qt6_textedit, the cross-component reader;
#                     clipboard="yes" via metadata.xml — Phase 14 W5
#                     metadata change, carried in this run to prove the
#                     metadata change does NOT break the existing
#                     sponge-textedit.run regression.)
#   + clipboard_probe (Phase 14 W5 NEW: a plain Genode component,
#                     opens its OWN labeled Report/ROM session pair
#                     against the clipboard server; structural witness
#                     on the bus; polls its "clipboard" ROM for the
#                     sentinel byte-for-byte; Capture-polls the
#                     textedit document region for the paste delta.
#                     Logs "clipboard-probe: PASS".)
#
# AGENTS.md §4.2 / docs/08-development.md §4.1: builds lib/ld + core
# init <components> and passes [build_artifacts] to build_boot_image
# so init.xsd + ld.lib.so + the binaries are all staged. base-sel4
# only.
#

assert {[have_spec sel4]} \
	"sponge-clipboard requires KERNEL=sel4 (BOARD=pc) in build.conf. \
	 The scenario drives real PC hardware (vesa_fb/ps2/usb_hid) and \
	 Qt6/Mesa-on-seL4 desktop rendering, which base-linux cannot provide."

build { core lib/ld init timer server/report_rom server/nitpicker \
        driver/acpi app/pci_decode driver/platform \
        driver/framebuffer/vesa driver/ps2 \
        driver/usb_host/pc driver/usb_hid server/event_filter \
        server/clipboard \
        sponge_configd sponge_themed sponge_pkgd \
        sponge-de \
        test/clipboard_probe test/pkg_gui_demo \
        qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
        lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
        lib/freetype lib/jpeg \
        lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
        lib/zlib lib/libpng lib/blit lib/file }

create_boot_directory

#
# Stage every non-build-artifact boot module into bin/ BEFORE
# build_boot_image (base-sel4: the boot image is a single packed
# image.elf; modules added after build_boot_image never reach the
# guest — docs/11 §10.4).
#
exec mkdir -p bin

#
# Vendor driver configs (copied from run/sponge-de-sel4-interactive.run).
#
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { drivers.config fb.config event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

#
# Keyboard layouts consumed by event_filter.
#
set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

#
# Theme files staged so sponge_themed can resolve the default theme.
#
foreach theme { default light } {
	set theme_src "${genode_dir}/repos/sponge/src/sponge-de/themes/${theme}.theme"
	set theme_dst "bin/${theme}.theme"
	if {[file exists $theme_src] && ![file exists $theme_dst]} {
		exec cp -fL $theme_src $theme_dst
	}
}

#
# Empty qt_config ROM module for the clipboard_probe. The probe reads
# this at startup; an absent qt_write_sentinel attribute means the
# probe runs in its default mode (writes its own sentinel, then
# verifies it appears in the ROM). The companion qtwrite scenario
# stages the same module with a qt_write_sentinel attribute to
# switch the probe into Qt-write witness mode.
#
set qtc_fh [open "bin/qt_config" w]
puts $qtc_fh "<config/>"
close $qtc_fh

#
# Stage the textedit package metadata + the derived index so sponge_pkgd
# can resolve `textedit`. The metadata carries <sessions> with the
# Report session default-route="parent" — the run config below provides
# the per-label routes for Report label="clipboard" and ROM
# label="clipboard" so the metadata's wildcard <Report default-route>
# allows the clipboard session to be opened by textedit.
#
set staged_pkgs { textedit }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	set dst "bin/pkg_$pkg.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -fL $src $dst
}

set index_fh [open "bin/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

#
# Stage the prebuilt textedit binary + its config.
#
set payload_dir "${genode_dir}/../pkg/textedit/payload"
foreach f { textedit textedit.config } {
	set src "$payload_dir/$f"
	set dst "bin/$f"
	if {![file exists $src]} { error "payload file not found: $src" }
	exec cp -fL $src $dst
}

#
# DejaVuSans font, mirrored from the qt6_base port sources (the
# qt6_dejavusans.tar raw recipe is depot-only, so for a source build
# we pack it here).
#
set dejavu_dst "bin/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavu_dst -C $staging qt
	file delete -force $staging
}

#
# Source the QMP helper (Tcl 8.x, no external deps) BEFORE using any
# qmp_* proc — qmp.inc defines qmp_pick_port, qmp_connect, etc.
#
source [file join [file dirname [file normalize [info script]]] qmp.inc]

#
# Enable QMP on a free TCP port (run/qmp.inc picks one).
#
set qemu_args ""
set qmp_port [qmp_pick_port]
append qemu_args " -qmp tcp:127.0.0.1:${qmp_port},server=on,wait=off "

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_pkgd -> request           | report: clipboard_probe -> request
    + policy | label: clipboard_probe -> result         | report: sponge_pkgd -> result
    + policy | label: clipboard_probe -> installed      | report: sponge_pkgd -> installed
    + policy | label: pkg_runtime -> config             | report: sponge_pkgd -> runtime
    + policy | label: sponge-de -> theme                | report: sponge_themed -> theme
    + policy | label: sponge_themed -> config           | report: sponge_configd -> config
    + policy | label: sponge_configd -> config_request  | report: clipboard_probe -> config_request
    + policy | label: clipboard -> focus                | report: clipboard_probe -> focus
    + policy | label: pkg_runtime -> textedit -> shape  | report: textedit -> shape
    + policy | label: clipboard_probe -> focus          | report: nitpicker -> focus
    + policy | label: clipboard_probe -> clicked        | report: nitpicker -> clicked
    + policy | label: clipboard_probe -> hover          | report: nitpicker -> hover
    + policy | label: clipboard_probe -> pointer        | report: nitpicker -> pointer
    + policy | label: sponge-de -> input                | report: sponge-de -> input
    + policy | label: sponge-de -> sponge_de_clipboard_src | report: sponge-de -> input
    # Routes for the clipboard_probe to read the input ROM directly:
    + policy | label: clipboard_probe -> sponge_de_input  | report: sponge-de -> input

+ start nitpicker | ram: 16M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer  | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    #
    # Focus/clicked reporting: the probe observes WHICH session (if
    # any) nitpicker focused after each QMP click — the decisive
    # signal for the keyboard chain (unfocused session => keys
    # dropped). The wm_report_rom policy block downstream relays the
    # focus ROM from nitpicker into the clipboard server so the
    # match_labels="yes" sub-scenario can gate writes by domain
    # focus.
    #
    + report | focus: yes | clicked: yes | hover: yes | pointer: yes | keystate: yes
    #
    # Three domains:
    #   - "panel"  : reserved for sponge-de's panel widget (the W7
    #                tasklist module does not exist yet, so the panel
    #                is allowed but unrendered in this scenario).
    #   - "demo"   : hosts sponge-de's Sponge DE Demo window
    #                (192,172)-(832,652, 640x480). The QMP click on
    #                the QLineEdit lands here.
    #   - "edit"   : hosts textedit's window. The QGenodeScreen QPA
    #                reports the full 1024x768 panorama and the
    #                upstream textedit main.cpp centers a 512x512
    #                window at (256,128), so the edit domain MUST
    #                sit at (0,0) for the window to land at screen
    #                coords (256,128)-(768,640) — inside the demo
    #                domain's footprint AND inside the QMP click
    #                radius for the paste step.
    #
    + domain panel | layer: 1 | content: client | label: no
                   | hover: always | focus: click | ypos: 0 | height: 28
    + domain demo | layer: 2 | content: client | label: no
                  | hover: always | focus: click
                  | xpos: 192 | ypos: 172 | width: 640 | height: 480
    + domain edit | layer: 3 | content: client | label: no
                   | hover: always | focus: click
                   | xpos: 0 | ypos: 0 | width: 1024 | height: 768
    + domain default | layer: 4 | content: client | label: no
                     | hover: always | focus: click | ypos: 28 | height: -28
    + policy | label_prefix: sponge-de -> Sponge Panel     | domain: panel
    + policy | label_prefix: sponge-de -> Sponge DE Demo   | domain: demo
    + policy | label_prefix: pkg_runtime -> textedit       | domain: edit
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start drivers | caps: 1500 | ram: 96M | managing_system: yes
  + binary init
  + route
    + service ROM | label: config | + parent | label: drivers.config
    + service Timer               | + child timer
    + service Capture             | + child nitpicker
    + service Event               | + child nitpicker
    + any-service                 | + parent
  + config
    + parent-provides
      + service IRQ
      + service IO_MEM
      + service IO_PORT
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Capture
      + service Event
    + default | caps: 60
    + default-route
      + any-service
        + parent
        + any-child
    + start vesa_fb | caps: 100 | ram: 8M
      + provides | + service Framebuffer
    + start ps2 | caps: 100 | ram: 4M
      + provides | + service Input
    + start pc_usb_host | caps: 100 | ram: 8M
      + provides | + service Usb
    + start usb_hid | caps: 200 | ram: 8M
      + provides
        + service Input
        + service Report
      + config | hid: yes
    + start event_filter | caps: 100 | ram: 4M
      + provides | + service Event
      + config
        + output
          + chargen
            + merge
              + input ps2
              + input usb
          + mod2
            + key KEY_LEFTCTRL
            + key KEY_RIGHTCTRL
          + repeat | delay_ms: 230 | rate_ms: 90
          + include | rom: en_us.chargen
          + include | rom: special.chargen
        + policy | label: ps2 | input: ps2
        + policy | label: usb | input: usb
    + start platform | caps: 100 | ram: 4M
      + provides | + service Platform
    + start acpi | caps: 100 | ram: 4M
      + provides | + service Power
    + start pci_decode | caps: 100 | ram: 4M
      + provides | + service PCI

#
# sponge_configd / sponge_themed / sponge_pkgd: same wire style as the
# proven Alpha scenario (run/sponge-alpha.run).
#
+ start sponge_configd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: config_request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_themed | caps: 200 | ram: 8M
  + route
    + service ROM | label_last: config         | + child report_rom
    + service ROM | label_last: default.theme | + parent
    + service ROM | label_last: light.theme   | + parent
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

#
# sponge-de on seL4: caps 1000, ram 128M (proven sizing — docs/09
# §11.1). The <config clipboard="yes"/> enables the vendored
# QGenodeClipboard backend (qgenodeclipboard.cpp) which opens a
# labeled Report + ROM session pair against the clipboard child.
# Without this attribute QGenodeClipboard is a no-op (verified by
# the upstream test in genode/repos/libports/run/qt6_textedit.run).
#
+ start sponge-de | caps: 1000 | ram: 128M
  + config | clipboard: yes
    + theme | source: themed
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service Gui | + child nitpicker
    + service Report | label: input | + child report_rom
    + service Report | label: applied_theme | + child report_rom
    + service Report | label: shape | + child report_rom
    + service Report | label: launcher | + child report_rom
    + service ROM | label: theme | + child report_rom
    + service ROM | label: installed | + child report_rom
    + service ROM | label: default.theme | + parent
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service Report | label_last: clipboard | + child clipboard
    + service ROM    | label_last: clipboard | + child clipboard
    + any-service
      + parent
      + any-child

#
# Upstream clipboard server (genode/repos/os/src/server/clipboard).
# Default flow config = permissive single-domain: <flow
# from="default" to="default"/> + match_labels="no". The focus ROM
# is routed from nitpicker via report_rom (the report_rom's focus
# policy is sourced from nitpicker -> focus; see the policies above).
# The companion focus-gated sub-scenario
# run/sponge-clipboard-focus.run switches match_labels="yes" and
# proves the write rejection path.
#
+ start clipboard | caps: 100 | ram: 4M
  + provides
    + service ROM
    + service Report
  + config | verbose: no | match_labels: no
    #
    # Domain policy: every clipboard session is in the "default"
    # domain (writer AND reader). The QMP click at (500, 700)
    # focuses the default nitpicker domain, which matches every
    # client's domain — cross-component write/paste succeeds.
    # Sponge-de's Qt side is NOT exercised in this scenario (the
    # cross-component proof uses the probe as the writer; the
    # structural claim is that the writer (probe) and the reader
    # (textedit) are separately-launched components and the data
    # flows through the upstream server, NOT Qt intra-process
    # state — per D14.2).
    #
    + default-policy | domain: default
    + flow | from: default | to: default
  + route
    + service ROM    | label: focus | + child report_rom
    + any-service
      + parent
      + any-child

+ start clipboard_probe | caps: 100 | ram: 16M
  + route
    + service Capture | + child nitpicker
    + service Timer   | + child timer
    + service Report | label_last: request       | + child report_rom
    + service Report | label_last: config_request | + child report_rom
    + service Report | label_last: focus         | + child report_rom
    + service Report | label_last: clipboard     | + child clipboard
    + service ROM    | label_last: clipboard     | + child clipboard
    + service ROM    | label: qt_config         | + parent
    + service ROM    | label_last: result        | + child report_rom
    + service ROM    | label_last: installed     | + child report_rom
    + service ROM    | label_last: focus         | + child report_rom
    + service ROM    | label_last: clicked       | + child report_rom
    + any-service
      + parent

#
# textedit (Phase 14 W5 metadata carries clipboard="yes" so the
# QGenodeClipboard backend opens its own session pair against the
# clipboard child).
#
+ start textedit | caps: 1000 | ram: 128M
  + config | clipboard: yes
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
  + route
    + service Gui | + child nitpicker
    + service Report | label: shape | + child report_rom
    + service Report | label_last: clipboard | + child clipboard
    + service ROM    | label_last: clipboard | + child clipboard
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child
- }

#
# Full boot module list. The Qt6 shared libs + tars are cmake-built
# by qt6/base and land in bin/; they are NOT in [build_artifacts], so
# listed explicitly (base-sel4 needs them inside image.elf).
#
set boot_modules [build_artifacts]
foreach m { libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
            libQt6PrintSupport.lib.so \
            libqgenode.lib.so qt6_libqgenode.tar qt6_dejavusans.tar \
            en_us.chargen special.chargen \
            drivers.config fb.config event_filter.config \
            default.theme light.theme \
            pkg_textedit.xml pkg_index.xml \
            textedit textedit.config \
            qt_config \
            egl.lib.so mesa.lib.so glapi.lib.so mesa_gpu-softpipe.lib.so \
            libdrm.lib.so libpng.lib.so freetype.lib.so jpeg.lib.so \
            expat.lib.so zlib.lib.so \
            stdcxx.lib.so libc.lib.so libm.lib.so \
            qt6_component.lib.so \
            vfs.lib.so vfs_gpu.lib.so vfs_pipe.lib.so \
            pkg_gui_demo } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# QEMU: -nographic for headless, -m 2G for Qt6/Mesa softpipe +
# pkg_runtime's 256M allocation + the clipboard server. xhci +
# usb-tablet for the absolute pointer fallback; the proven PS/2 REL
# recipe (run/qmp.inc) is the primary input path.
#
append qemu_args " -machine q35 -cpu Skylake-Client "
append qemu_args " -nographic -m 2G "
append qemu_args " -device nec-usb-xhci,id=xhci -device usb-tablet "

#
# QMP choreography (the cross-component proof):
#
# 1. Wait for both sponge-de's and textedit's windows to appear on
#    nitpicker (sponge-de emits "panel and window shown" on first
#    paint; textedit's pkg_runtime emits the upstream Qt6 marker
#    "qGenodeScreen: screen 0 ... window shown" — both observable
#    in the boot log).
# 2. Connect QMP; PS/2 click on sponge-de's QLineEdit at the demo
#    window center (the QLineEdit lives inside the demo domain; the
#    click focuses it).
# 3. Type "Sponge Phase 14 clipboard sentinel" via QMP send-key
#    (qmp.inc's qmp_type, char-by-char).
# 4. Send Ctrl-A + Ctrl-C: select all + copy. The Ctrl-C triggers
#    QGenodeClipboard::setMimeData -> the Report session write
#    reaches the clipboard server -> the bus broadcasts to all
#    readers (including the probe's own ROM session).
# 5. Bounded wait for the bus to propagate (the probe's ROM update
#    handler picks up the new content).
# 6. PS/2 click on textedit's window (the edit domain — full screen,
#    textedit's 512x512 window at (256,128)-(768,640); click at the
#    center).
# 7. Send Ctrl-V. QGenodeClipboard::mimeData reads the bus; Qt's
#    paste action inserts the sentinel into the QTextEdit document.
# 8. The clipboard_probe observes both:
#    (a) the "clipboard" ROM contains the sentinel byte-for-byte
#        (structural proof the bus propagated the write); AND
#    (b) the textedit document region changed beyond the
#        cursor-blink baseline (typed-text delta > 2*baseline +
#        floor 30, the misleading_success_output guard).
#
# The probe logs exactly "clipboard-probe: PASS" on success; the run
# gates on that marker.
#

#
# Stage the choreography. The run_genode_until gates use the proven
# sponge-de "panel and window shown" marker for the first paint and
# the clipboard_probe "PASS" marker for the final acceptance gate.
# The intermediate QMP steps have bounded timeouts; the qmp_move /
# qmp_ps2_click procs are failure-loud (exit 1) on protocol error.
#
run_genode_until {.*panel and window shown.*} 120

set qmp_chan [qmp_connect $qmp_port]
puts "\nqmp: connected on port $qmp_port"

#
# Wait for textedit to boot and render. The clipboard_probe's own
# Capture-poll emits a "textedit-rendered" marker when the textedit
# document region first shows the cursor blink baseline; the run
# script gates on that. Until the marker is observed the probe is
# not yet Capture-ready (the capture buffer is allocated on the
# first run() iteration, after which the probe emits the marker).
#
puts "\nqmp: waiting for clipboard_probe textedit-rendered marker"
set timeout [expr {180}]
match_max -i $qemu_spawn_id 500000
expect {
	-i $qemu_spawn_id
	"clipboard-probe: textedit rendered" { }
	timeout { puts stderr "qmp: timeout waiting for textedit render"; exit 1 }
}

#
# Phase 0 — focus textedit (the QMP click sets nitpicker's focus
# to the edit domain; textedit's session label matches the
# default-policy so its domain is "default"; keyboard events now
# flow to textedit AND the clipboard server's write_permitted
# check accepts the probe's writer with matching "default"
# domain).
#
puts "\nqmp: focus textedit (writer domain match + paste target)"
qmp_ps2_click $qmp_chan 512 384
after 1500

#
# Phase 1+2 already executed by the clipboard_probe (Phase 14 W5
# architecture decision: the probe writes the sentinel through
# the upstream bus and observes its own ROM byte-for-byte; the
# data crosses an address-space boundary via the upstream
# server, NOT Qt intra-process state). Wait for the probe's
# byte-match log before dispatching the paste step.
#
puts "\nqmp: waiting for clipboard_probe sentinel-in-ROM marker"
match_max -i $qemu_spawn_id 500000
expect {
	-i $qemu_spawn_id
	"clipboard-probe: sentinel present in clipboard ROM" { }
	timeout { puts stderr "qmp: timeout waiting for sentinel in ROM"; exit 1 }
}

#
# Step 2: Ctrl-V — paste. The QGenodeClipboard's mimeData() reads
# the bus ROM, parses the sentinel, and Qt's paste action inserts
# it into the QTextEdit document.
#
puts "\nqmp: send Ctrl-V (paste -> textedit document)"
qmp_cmd $qmp_chan {{"execute":"send-key","arguments":{"keys":[{"type":"qcode","data":"ctrl"},{"type":"qcode","data":"v"}]}}}
after 1500

#
# Final gate: the probe emits exactly "clipboard-probe: PASS" once
# (a) the clipboard ROM carries the sentinel AND (b) the textedit
# document region shows the typed text. The clipboard_probe also
# logs the structural observation as it runs:
#   "clipboard-probe: sentinel present in clipboard ROM (<n> bytes)"
#   "clipboard-probe: typed text rendered via upstream clipboard bus ..."
#
run_genode_until {.*clipboard-probe: PASS.*} 180 $qemu_spawn_id

qmp_disconnect $qmp_chan
puts "\nqmp: clipboard cross-component proof PASSED"
