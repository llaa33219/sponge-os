
# \brief  Native Sponge WM QMP acceptance battery scenario
#        (Criterion 16, M5 gate — docs/plans/phase16-sponge-wm.md §7.1)
# \author Sponge OS contributors
# \date   2026
#
# Drives the §7.1 QMP acceptance battery against the NATIVE trio
# (sponge_wm + sponge_layouter + sponge_decorator):
#
#   move            title-bar drag lands at the expected geometry
#   8-zone resize   all four edges + all four corners, FULL sequence in
#                   one run (the W9 honesty rule: docs/evidence/
#                   phase16-w9-resize.md — upstream's full sequence is
#                   flaky and was recorded as an honest partial; the
#                   native path must prove the full sequence in one run
#                   or record an honest partial of its own. Partial is
#                   never relabeled green.)
#   focus           title and content clicks on each window flip `focused`
#                   in window_layout AND the window_chrome per-window focus
#                   truth (focused=yes follows exactly the clicked wid, the
#                   other client focused=no); content-click selections remain
#                   stable for 12 consecutive layout/chrome observations; the
#                   decorator's focus styling is corroborated from
#                   'chrome view <wid> focus no' lines after the gate
#   close           native chrome closer destroys the window
#   minimize/restore+focus  chrome minimizer parks, tasklist restore
#                   lands focused (U3 focus-after-restore)
#   maximize/restore chrome fullscreen fills the work area (D16W.10),
#                   toggle restores the previous geometry exactly
#
# Derived from run/sponge-wm-qmp.run (the proven upstream QMP drag
# topology) plus the 8-zone choreography shape of
# run/sponge-de-release-resize.run. Upstream anchor files remain as the
# fallback; this scenario is the native acceptance gate.
#
# Acceptance status (2026-11-12): the complete battery passes repeatedly.
# Geometry waits require five identical in-tolerance snapshots before the
# next marker, preventing queued drag motion from producing stale targets.
#
# Marker discipline (run/qmp.inc shared dispatch — this scenario
# defines NO local Tcl QMP procs, unlike run/sponge-wm-qmp.run):
# the probe emits markers in strict serialization. Title/chrome actions
# use one marker; each content click uses absmove, at most 30 closed-loop
# moves, and a terminal press dispatched by a bounded run-side loop.
# Drag deltas stay <= 49 px per axis so the shared drag arm walks
# exact rel-1 steps against the recipe's accelerate LUT. No probe-side
# marker re-emission: a miss is an honest FAIL, never a silent retry.
#
# Topology (base-sel4, headless, one QEMU boot): the
# run/sponge-wm-native-tasks.run topology (drivers sub-init +
# sponge_pkgd + pkg_runtime + sponge-de with the panel tasklist —
# the tasklist supplies the step-13 restore path and the frozen
# maximize-inference rules republication), with
# test/native_wm_qmp_probe in place of the tasks probe.
#
# Window placement (layouter initial rules):
#   - sponge-de -> Sponge DE Demo: (420, 60, 560, 220) — high-right,
#     title band clear of the 28 px panel, disjoint from pkg_gui_demo.
#   - label_prefix: pkg_runtime: (50, 320, 320, 240) — the battery
#     subject; the +40,+40 move keeps both axes under the shared drag
#     arm's exact-step limit and stays disjoint from the demo window.
#
# Hard constraints (same as run/sponge-wm-native-tasks.run):
# base-sel4 only; event_filter.config copied VERBATIM from the vendored
# drivers_interactive-pc recipe (accelerate LUT kept for the shared
# qmp.inc PS/2 helpers).

assert {[have_spec sel4]} \
	"sponge-wm-native-qmp requires KERNEL=sel4 (BOARD=pc) in build.conf. \
	 This scenario drives real PC hardware (vesa_fb/ps2/usb_hid) which \
	 base-linux cannot provide."

build { core lib/ld init timer server/report_rom server/nitpicker \
         driver/acpi app/pci_decode driver/platform \
         driver/framebuffer/vesa driver/ps2 \
         driver/usb_host/pc driver/usb_hid server/event_filter \
         sponge_wm sponge_layouter sponge_decorator \
         sponge_pkgd test/pkg_gui_demo test/native_wm_qmp_probe \
         sponge-de \
         qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
         lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
         lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
         lib/zlib lib/libpng lib/blit }

create_boot_directory

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    #
    # Protocol v1 (frozen) — TasklistController-facing labels preserved.
    #
    + policy | label: sponge-de -> window_list         | report: sponge_wm -> window_list
    + policy | label: sponge-de -> window_layout       | report: sponge_layouter -> window_layout
    + policy | label: sponge_layouter -> window_list   | report: sponge_wm -> window_list
    + policy | label: sponge_layouter -> focus_request | report: sponge-de -> focus_request
    + policy | label: sponge_layouter -> rules         | report: sponge-de -> rules
    + policy | label: native_wm_qmp_probe -> window_list   | report: sponge_wm -> window_list
    + policy | label: native_wm_qmp_probe -> window_layout | report: sponge_layouter -> window_layout
    + policy | label: native_wm_qmp_probe -> rules         | report: sponge-de -> rules
    + policy | label: native_wm_qmp_probe -> decorator_margins | report: sponge_decorator -> decorator_margins
    + policy | label: native_wm_qmp_probe -> window_chrome | report: sponge_wm -> window_chrome
    + policy | label: native_wm_qmp_probe -> pointer | report: nitpicker -> pointer
    + policy | label: native_wm_qmp_probe -> hover | report: nitpicker -> hover
    #
    # Internal contract v1.1 (binding; see run/sponge-wm-native.run header).
    #
    + policy | label: sponge_layouter -> focus_state      | report: sponge_wm -> focus_state
    + policy | label: sponge_layouter -> decorator_margins | report: sponge_decorator -> decorator_margins
    + policy | label: sponge_wm -> focus                  | report: sponge_layouter -> focus
    + policy | label: sponge_wm -> window_request         | report: sponge_layouter -> window_request
    + policy | label: sponge_wm -> decorator_margins      | report: sponge_decorator -> decorator_margins
    + policy | label: sponge_decorator -> window_chrome   | report: sponge_wm -> window_chrome
    #
    # sponge_pkgd relay.
    #
    + policy | label: sponge_pkgd -> request          | report: native_wm_qmp_probe -> request
    + policy | label: native_wm_qmp_probe -> result   | report: sponge_pkgd -> result
    + policy | label: pkg_runtime -> config           | report: sponge_pkgd -> runtime

+ start nitpicker | ram: 16M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    + report | focus: yes | hover: yes | pointer: yes | xray: yes
    + domain panel | layer: 1 | content: client | label: no
                   | hover: always | focus: click | ypos: 0 | height: 28
    + domain default | layer: 2 | content: client | label: no
                     | hover: always | focus: click
    + policy | label_prefix: sponge-de -> Sponge Panel | domain: panel
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start drivers | caps: 1800 | ram: 96M | managing_system: yes
  + binary init
  + route
    + service ROM | label: config | + parent | label: drivers.config
    + service Timer | + child timer
    + service Capture | + child nitpicker
    + service Event | + child nitpicker
    + any-service                 | + parent
  + config
    + parent-provides
      + service IRQ
      + service IO_MEM
      + service IO_PORT
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Capture
      + service Event

    + default | caps: 60

    + start acpi | caps: 250 | ram: 4M
      + route
        + service IO_MEM | + parent
        + service LOG | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service ROM | + parent
        + service Report | + child report_rom

    + start report_rom | caps: 300 | ram: 8M
      + provides
      | + service ROM
      | + service Report
      + config
      | + policy | label: pci_decode -> system | report: acpi -> acpi
      | + policy | label: platform -> devices  | report: pci_decode -> devices
      | + policy | label: usb_hid -> report    | report: usb -> devices
      + route
        + service LOG | + parent
        + service PD | + parent
        + service CPU | + parent
        + service ROM | + parent

    + start pci_decode | caps: 100 | ram: 2M
      + route
        + service Report | + child report_rom
        + service ROM | label: system | + child report_rom
        + service IO_MEM | + parent
        + service LOG | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service ROM | + parent

    + start platform | caps: 200 | ram: 3M | managing_system: yes
      + provides
      | + service Dma
      | + service Platform
      + route
      | + service ROM | label: devices | + child report_rom
      | + service Report | + child report_rom
      | + service IRQ | + parent
      | + service IO_MEM | + parent
      | + service IO_PORT | + parent
      | + service ROM | + parent
      | + service PD | + parent
      | + service CPU | + parent
      | + service LOG | + parent
      | + service Timer | + parent
      + config
        + report | devices: yes
        + policy | label_prefix: ps2             | + device ps2
        + policy | label_prefix: fb  | info: yes | + pci | class: VGA
        + policy | label_prefix: usb | info: yes | + pci | class: USB

    + start fb | caps: 150 | ram: 20M
      + binary vesa_fb
      + route
        + service ROM | label: config | + parent | label: fb.config
        + service Report | + child report_rom
        + service Dma | + child platform
        + service Platform | + child platform
        + service IO_PORT | + parent
        + service IO_MEM | + parent
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent
        + service Capture | + parent

    + start ps2 | caps: 100 | ram: 1280K
      + config
      + route
        + service Dma | + child platform
        + service Platform | + child platform
        + service Event | + child event_filter | label: ps2
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

    + start usb | caps: 200 | ram: 16M
      + binary pc_usb_host
      + provides | + service Usb
      + config
      | + report | devices: yes
      | + policy | label_prefix: usb_hid | + device | class: 0x3
      + route
        + service Dma | + child platform
        + service Platform | + child platform
        + service Report | label: devices | + child report_rom
        + service ROM | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

    + start usb_hid | caps: 180 | ram: 10M
      + route
        + service ROM | label: report | + child report_rom
        + service ROM | + parent
        + service PD | + parent
        + service RM | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent
        + service Event | + child event_filter | label: usb
        + service Usb | + child usb

    + start event_filter | caps: 90 | ram: 1280K
      + provides | + service Event
      + route
        + service ROM | label: config | + parent | label: event_filter.config
        + service Event | + parent
        + service ROM | + parent
        + service PD | + parent
        + service CPU | + parent
        + service LOG | + parent
        + service Timer | + parent

+ start sponge_wm | caps: 250 | ram: 8M
  + provides
    + service Gui
  + config
    + policy | label_prefix: sponge_decorator | role: decorator
    + policy | label_prefix: sponge_layouter  | role: layouter
    + default-policy
  + route
    + service ROM | label: focus            | + child report_rom
    + service ROM | label: window_request   | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service Report | + child report_rom
    + service Gui | + child nitpicker
    + any-service
      + parent
      + any-child

+ start sponge_layouter | caps: 150 | ram: 4M
  + config | rules: rom
    + work_area | x: 0 | y: 28 | width: 1024 | height: 740
    + rules
      + screen screen
      + assign | label: sponge-de -> Sponge DE Demo | target: screen
               | xpos: 420 | ypos: 60 | width: 560 | height: 220 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen
               | xpos: 50 | ypos: 320 | width: 320 | height: 240 | maximized: no
    + press   | key: BTN_LEFT  | action: drag
      + release | key: BTN_LEFT | action: drop
  + route
    + service ROM | label: window_list       | + child report_rom
    + service ROM | label: focus_request     | + child report_rom
    + service ROM | label: rules             | + child report_rom
    + service ROM | label: focus_state       | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service Report | + child report_rom
    + any-service
      + child sponge_wm
      + parent
      + any-child

+ start sponge_decorator | caps: 350 | ram: 32M
  + config
    + theme | source: default
  + route
    + service ROM | label: theme         | + parent
    + service ROM | label: default.theme | + parent
    + service ROM | label: window_chrome | + child report_rom
    + service Report | + child report_rom
    + any-service
      + child sponge_wm
      + parent
      + any-child

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 1500 | ram: 256M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service Gui | + child sponge_wm
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge-de | caps: 1000 | ram: 128M
  + config
    + tasklist | source: wm
    + tasklist_static_rules
      + assign | label: sponge-de -> Sponge DE Demo | target: screen
               | xpos: 420 | ypos: 60 | width: 560 | height: 220 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen
               | xpos: 50 | ypos: 320 | width: 320 | height: 240 | maximized: no
    + theme | source: default
    + config | source: default
    + version: 2
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service Gui | label_last: Sponge Panel | + child nitpicker
    + service Gui | + child sponge_wm
    + service Report | + child report_rom
    + service ROM | label: theme   | + parent
    + service ROM | label: configd | + parent
    + service ROM | label: default.theme | + parent
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service Report | label: focus_request | + child report_rom
    + service Report | label: rules        | + child report_rom
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child

+ start native_wm_qmp_probe | caps: 150 | ram: 32M
  + config | panel_height: 28
  + route
    + service Capture | + child nitpicker
    + service Timer | + child timer
    + service ROM | label: window_list   | + child report_rom
    + service ROM | label: window_layout | + child report_rom
    + service ROM | label: rules         | + child report_rom
    + service ROM | label: decorator_margins | + child report_rom
    + service ROM | label: window_chrome | + child report_rom
    + service ROM | label: pointer       | + child report_rom
    + service ROM | label: hover         | + child report_rom
    + service ROM | label_last: result   | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
- }

#
# Stage every non-build-artifact boot module into bin/ BEFORE
# build_boot_image (base-sel4 packs a single image.elf at that point).
#
exec mkdir -p bin

set dejavu_dst "bin/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavu_dst -C $staging qt
	file delete -force $staging
}

#
# Driver sub-init config modules copied VERBATIM (accelerate LUT kept
# for the shared qmp.inc PS/2 helpers — see the header).
#
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { drivers.config fb.config event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

exec cp -f "${genode_dir}/repos/sponge/src/sponge-de/themes/default.theme" \
           "bin/default.theme"

set staged_pkgs { pkg_gui_demo }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src "bin/pkg_$pkg.xml"
}

set index_fh [open "bin/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

set boot_modules [build_artifacts]
foreach m { libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
            libqgenode.lib.so qt6_libqgenode.tar qt6_dejavusans.tar \
            en_us.chargen special.chargen \
            drivers.config fb.config event_filter.config \
            default.theme \
            pkg_pkg_gui_demo.xml pkg_index.xml } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# Source the shared QMP helper — no local QMP procs in this scenario.
#
set qmp_source_path [file join [file dirname [file normalize [info script]]] qmp.inc]
catch { source $qmp_source_path }

if {[info procs qmp_disconnect] eq ""} {
	proc qmp_disconnect { chan } { catch { close $chan } }
}

append qemu_args " -nographic -m 2G "
append qemu_args " -device nec-usb-xhci,id=xhci -device usb-tablet "

set qmp_port [qmp_pick_port]
append qemu_args " -qmp tcp:127.0.0.1:${qmp_port},server=on,wait=off "

#
# Choreography: 16 serialized dispatches (see the header). Every gate
# matches a unique probe POST-step phrase so pre-action log lines can
# never satisfy it.
#
run_genode_until {.*\[init -> drivers -> fb\] using 1024x768.*} 90
global qemu_spawn_id

# Record the complete serial stream independently of expect consumption;
# the decorator evidence scan below must never eat a QMP-TARGET marker.
set serial_log "[run_dir]/native-qmp-serial.log"
file delete -force $serial_log
log_file -a $serial_log

# The framebuffer gate is early enough that QMP is listening, and far
# enough before the probe's first marker that it cannot consume it.
set qmp_chan [qmp_connect $qmp_port]

#
# The probe's QMP-TARGET markers are the post-step gates themselves.
# Waiting for the next marker (rather than a separate run_genode_until
# gate) keeps another expect from consuming the marker first.
#

# step 2: move (title-bar drag)
set serial_acc ""
qmp_exec_target $qmp_chan 120

# steps 3-10: 8-zone resize (full sequence in one run)
for {set z 1} {$z <= 8} {incr z} {
	qmp_exec_target $qmp_chan 120
	}

# step 11: two title clicks, then two pointer-verified content clicks.
# Each content click emits absmove, at most 30 closed-loop moves, and press.
qmp_exec_target $qmp_chan 120
qmp_exec_target $qmp_chan 120
for {set click 0} {$click < 2} {incr click} {
	set content_pressed 0
	for {set i 0} {$i < 32} {incr i} {
		if {[qmp_exec_target $qmp_chan 120] eq "press"} {
			set content_pressed 1
			break
		}
	}
	if {!$content_pressed} {
		error "step 11: content press was not dispatched within 32 markers"
	}
}

# step 12: chrome minimizer
qmp_exec_target $qmp_chan 120

# step 13: tasklist restore + focus (U3)
qmp_exec_target $qmp_chan 120

# step 14: chrome fullscreen (work-area maximize)
qmp_exec_target $qmp_chan 120

# step 15: fullscreen toggle (restore previous geometry)
qmp_exec_target $qmp_chan 120

# step 16: chrome closer
qmp_exec_target $qmp_chan 120

run_genode_until {native-wm-qmp-probe: PASS} 120 $qemu_spawn_id
log_file
set serial_acc [read [open $serial_log r]]

#
# Decorator focus-styling evidence (non-consuming): log_file recorded
# the serial stream independently of expect consumption; this is a plain
# scan over that captured text, so no QMP marker can be eaten.
# For every wid the probe asserted focused=no (via
# window_chrome), the committed decorator focus log contract must show
# its unfocused repaint 'sponge_decorator: chrome view <wid> focus no'.
# At least one of those wids must show the line TRAILING its
# 'focus yes' — a genuine focused->unfocused flip repaint, so a lone
# Chrome_view construction-time initial-state line cannot carry the
# 'real clicks update the styling' claim by itself.
#
set focus_no_wids {}
foreach {full yw nw} [regexp -all -inline \
	{chrome focus: wid (\d+) focused=yes, wid (\d+) focused=no} $serial_acc] {
	lappend focus_no_wids $nw
}
set focus_no_wids [lsort -unique $focus_no_wids]
if {[llength $focus_no_wids] == 0} {
	puts stderr "\nsponge-wm-native-qmp: FAIL - probe reported no\
 window_chrome focus assertion (chrome focus: ... focused=no)"
	exit 1
}
set flip_evidence 0
foreach w $focus_no_wids {
	set needle_no  [format {chrome view %d focus no}  $w]
	set needle_yes [format {chrome view %d focus yes} $w]
	if {[string first $needle_no $serial_acc] < 0} {
		puts stderr "\nsponge-wm-native-qmp: FAIL - decorator never logged\
  '$needle_no' for the window the probe asserted focused=no"
		exit 1
	}
	set p_yes [string first $needle_yes $serial_acc]
	set p_no  [string last  $needle_no  $serial_acc]
	if {$p_yes >= 0 && $p_no > $p_yes} { incr flip_evidence }
}
if {$flip_evidence == 0} {
	puts stderr "\nsponge-wm-native-qmp: FAIL - decorator logged\
  'chrome view <wid> focus no' only as construction-time initial state,\
  never as a focused->unfocused flip repaint"
	exit 1
}
puts "\nsponge-wm-native-qmp: decorator focus styling verified -\
 chrome view <[join $focus_no_wids ,]> focus no ($flip_evidence unfocused flip(s))"

qmp_disconnect $qmp_chan
