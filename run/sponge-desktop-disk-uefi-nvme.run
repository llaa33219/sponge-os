#
# \brief  Sponge OS Phase 15 W4 — UEFI desktop product media (NVMe envelope)
#         (D15.13 / D15.16, QEMU-unverified, structural-gate only).
# \author Sponge OS contributors
# \date   2026
#
# The NVMe variant of run/sponge-desktop-disk-uefi.run — the
# target-machine envelope (the 17ZD90N-VX7BK boots from NVMe per
# D15.1). The structural layout mirrors the BIOS NVMe scenario
# (run/sponge-desktop-disk-nvme.run) with the UEFI mechanics from
# the SATA envelope (run/sponge-desktop-disk-uefi.run):
#
#   - The handcrafted UEFI .img is the BOOTLOADER MEDIA only:
#       P1=ESP (FAT32 EF00) with /EFI/BOOT/BOOTX64.EFI + grub.cfg
#       P3=GENODE ext2 with /boot/{bender,sel4,image.elf} ONLY
#       (no /system — the desktop lives on the NVMe disk)
#     The .img is auto-attached to q35's implicit ICH9 (default for
#     image/disk); OVMF reads P1=ESP via its own firmware driver
#     stack; the Genode-side ahci driver is NOT started so the
#     auto-attach is "dead weight" from Genode's view (mirrors the
#     BIOS NVMe pattern's q35 ICH9 auto-attach).
#
#   - A SEPARATE NVMe disk (bin/nvme_disk.img) is the actual
#     storage-chain target. P3 = GENODE ext2 carrying the desktop
#     /system tree (binaries + libs + themes + tars + bake defaults
#     + nested init config). P4 = SPONGE-DATA via tool/mkdata.
#     Attached via -device pcie-root-port + -device nvme (the
#     proven SPONGE_BOOT_NVME pattern, copied verbatim from
#     run/sponge-boot.run and run/sponge-desktop-disk-nvme.run).
#     The Genode-side nvme driver reads this disk.
#
#   - The desktop composition (system init, wm, sponge-de, etc.)
#     is identical to the SATA envelope — only the storage driver
#     (ahci → nvme) and the partition-number pin (still 3) change
#     in Tier-0.
#
# === Partition layout ===
#
#   .img (bootloader):
#     P1  ESP    FAT32  typecode=EF00  label=ESP          64 MiB
#     P2  ABSENT (W4 P2-absent contract — see SATA envelope)
#     P3  GENODE  ext2   typecode=8300  label=GENODE       16 MiB
#                  /boot/{bender,sel4,image.elf}  ONLY
#   .img has NO P4 (no SPONGE-DATA on the bootloader; the
#   desktop's writable P4 is on the NVMe disk only).
#
#   NVMe disk (desktop):
#     P3  GENODE  ext2   typecode=8300  label=GENODE       256+ MiB
#                  /system/bin, /system/lib, /system/init,
#                  /system/{themes,tars,pkg_*.xml,bake/}
#     P4  SPONGE-DATA  ext2  added by tool/mkdata (docs/14 §4.3)
#
# === Architecture (docs/14 §4.4 + D15.13) ===
#
#   OVMF pflash → GRUB2 EFI on .img P1 ESP → grub.cfg multiboot2 →
#   bender + sel4 + image.elf from .img P3 → seL4 → base-sel4 core
#     └─ init (Tier 0)
#         ├─ timer, report_rom
#         ├─ platform/acpi/pci_decode
#         ├─ nvme (Block) → SPONGE_BOOT_NVME PCIe root-port
#         ├─ part_block → Block/P3 (NVMe, partition pinned BY NUMBER)
#         ├─ vfs (Vfs_block + <rump fs="ext2fs"/>) → File_system
#         ├─ rom_sys: cached_fs_rom(chroot /system)        → ROM
#         ├─ rom_lib: cached_fs_rom(chroot /system/lib)    → ROM
#         ├─ nitpicker
#         ├─ drivers (sub-init: boot_fb/ps2/usb_hid/event_filter)
#         └─ system (nested init from NVMe's /system)
#             ├─ binary "init" from rom_sys at /system/bin/init
#             ├─ config from rom_sys at /system/init/system.config
#             ├─ ROM label_last="ld.lib.so" → parent (§4.6)
#             └─ hosts: report_rom, wm, window_layouter, decorator,
#                       sponge_configd, sponge_themed, sponge_pkgd,
#                       pkg_runtime, sponge-de, alpha_probe
#
# === QEMU wiring ===
#
#   -machine q35 -cpu Skylake-Client
#   -nographic -m 4G -snapshot
#   -device nec-usb-xhci,id=xhci -device usb-tablet
#   -drive if=pflash,format=raw,readonly=on,file=$ovmf_code
#   -drive if=pflash,format=raw,file=$ovmf_vars
#   -fw_cfg name=opt/org.tianocore/UninstallMemAttrProtocol,string=yes
#   -drive format=raw,file=[run_dir].img                    (image/disk auto-attach, the bootloader)
#   -device pcie-root-port,id=root_port1
#   -drive id=disk0,file=bin/nvme_disk.img,format=raw,if=none
#   -device nvme,drive=disk0,serial=fnord,id=nvme0,bus=root_port1
#
# OVMF resolution: identical to the SATA envelope.
#
# === Tier-0 driver swap (vs SATA) ===
#
#   ahci → nvme   (with the Phase 12 W2 sizing: caps 5000 | ram 64M)
#
# nvme is a Phase-12-proven driver on this exact QEMU
# configuration; the q35 + Skylake-Client + pcie-root-port +
# -device nvme sequence is the same one that run/sponge-boot.run's
# SPONGE_BOOT_NVME block and run/sponge-desktop-disk-nvme.run
# both use successfully.
#
# === QEMU boot gate honesty (D15.16) ===
#
# Identical to the SATA envelope: the W1 OVMF core-init hang is
# the EXPECTED outcome under QEMU. The scenario runs the same
# 3 structural gates (sgdisk -p on the NVMe disk / mdir on the
# ESP of the .img / e2ls on the NVMe disk's P3) and the same
# 180 s QEMU boot attempt with the W1 hang signature check.
# QGenodeScreen 1×1 race evaluation on the boot_fb NVMe path:
# blocked-by-W1-hang (same as the SATA envelope).
#
# base-sel4 only.
#
# Build:
#   make -j1 -C genode/build/x86_64 run/sponge-desktop-disk-uefi-nvme \
#       KERNEL=sel4 BOARD=pc
#

assert {[have_spec sel4]} \
	"sponge-desktop-disk-uefi-nvme requires KERNEL=sel4 (BOARD=pc)."

##
# === Plugin loading (mirror of the SATA envelope) ===
#
proc ensure_plugin_loaded { name } {
	if {![have_include $name]} {
		set path [genode_dir]/tool/run/$name
		puts "sourcing $path (missing from RUN_OPT, restored by run script)"
		source $path
		global include_list
		lappend include_list $name
	}
}

ensure_plugin_loaded boot_dir/sel4
ensure_plugin_loaded image/disk
ensure_plugin_loaded power_on/qemu
ensure_plugin_loaded log/qemu

#
# Remove image/iso from include_list (cascade through to image/disk)
#
foreach entry $include_list {
	if {[string equal $entry "image/iso"]} {
		set idx [lsearch $include_list $entry]
		set include_list [lreplace $include_list $idx $idx]
		break
	}
}

#
# Override image/disk's run_image to a no-op (we handcraft the .img)
#
proc run_image { } { return true }

#
# === OVMF firmware pre-flight + resolution (mirror of the SATA envelope) ===
#
set ovmf_code /usr/share/edk2/x64/OVMF_CODE.4m.fd
set ovmf_vars /usr/share/edk2/x64/OVMF_VARS.4m.fd

if {![file exists $ovmf_code]} {
	puts ""
	puts "OVMF firmware missing: $ovmf_code"
	puts ""
	puts "Install the ovmf/edk2-ovmf package on this host:"
	puts "  sudo apt install ovmf          # Debian/Ubuntu"
	puts "  sudo dnf install edk2-ovmf     # Fedora"
	puts "  sudo pacman -S edk2-ovmf       # Arch"
	puts ""
	puts "(AGENTS.md §5.5 — the agent does NOT use sudo.)"
	exit -1
}
if {![file exists $ovmf_vars]} {
	puts ""
	puts "OVMF_VARS missing: $ovmf_vars"
	puts "(install the same ovmf/edk2-ovmf package as above.)"
	exit -1
}

exec mkdir -p bin
exec cp -f $ovmf_vars bin/OVMF_VARS.4m.fd

set ovmf_pinned_code [file normalize [file join [genode_dir] .. var ovmf OVMF_CODE.fd]]
set ovmf_pinned_vars [file normalize [file join [genode_dir] .. var ovmf OVMF_VARS.fd]]

if {[info exists ::env(SPONGE_OVMF_CODE)]} {
	set ovmf_code $::env(SPONGE_OVMF_CODE)
	puts "sponge-desktop-disk-uefi-nvme: OVMF_CODE = \$SPONGE_OVMF_CODE ($ovmf_code)"
} elseif {[file exists $ovmf_pinned_code]} {
	set ovmf_code $ovmf_pinned_code
	puts "sponge-desktop-disk-uefi-nvme: OVMF_CODE = var/ovmf/OVMF_CODE.fd (pinned 2024.02)"
} else {
	puts "sponge-desktop-disk-uefi-nvme: OVMF_CODE = /usr/share/edk2/x64/OVMF_CODE.4m.fd (host default; known to break the multiboot2 load path)"
}
if {[info exists ::env(SPONGE_OVMF_VARS)]} {
	set ovmf_vars $::env(SPONGE_OVMF_VARS)
	puts "sponge-desktop-disk-uefi-nvme: OVMF_VARS = \$SPONGE_OVMF_VARS ($ovmf_vars)"
} elseif {[file exists $ovmf_pinned_vars]} {
	set ovmf_vars $ovmf_pinned_vars
	puts "sponge-desktop-disk-uefi-nvme: OVMF_VARS = var/ovmf/OVMF_VARS.fd (pinned 2024.02)"
} else {
	puts "sponge-desktop-disk-uefi-nvme: OVMF_VARS = /usr/share/edk2/x64/OVMF_VARS.4m.fd (host default)"
}

#
# === Failure-channel selector ===
#
set fail_mode [expr {[info exists ::env(SPONGE_DISK_FAIL)] && $::env(SPONGE_DISK_FAIL) == "1"}]
if {$fail_mode} {
	puts "sponge-desktop-disk-uefi-nvme: FAILURE CHANNEL (corrupted system.config)"
}

#
# === Build — Tier-0 chain + desktop components (driver swap: ahci → nvme) ===
#
# Identical to the SATA envelope's build list with one swap:
#   driver/ahci → driver/nvme   (Phase 12 W2 sizing: caps 5000, ram 64M)
#
set build_components {
	core lib/ld init timer
	server/report_rom server/nitpicker
	driver/platform driver/acpi app/pci_decode
	driver/framebuffer/boot
	driver/ps2
	driver/usb_host/pc driver/usb_hid server/event_filter
	server/part_block server/vfs server/cached_fs_rom
	lib/vfs lib/vfs_rump
	server/wm app/window_layouter app/decorator app/pointer
	sponge_configd sponge_themed sponge_pkgd pkg_hello sponge-de
	app/qt6/examples/calculatorform sponge_files app/pdf_view
	server/terminal
	noux-pkg/bash-minimal noux-pkg/vim-minimal
	noux-pkg/coreutils-minimal noux-pkg/grep noux-pkg/sed
	noux-pkg/tar noux-pkg/less noux-pkg/findutils
	noux-pkg/diffutils noux-pkg/which
	test/alpha_probe
	qt6/base lib/libc lib/libm lib/stdcxx lib/mesa
	lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat
	lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter
	lib/zlib lib/libpng lib/blit lib/vfs_ttf lib/vfs_import lib/posix
	lib/ncurses lib/pcre
	driver/nvme
}

build $build_components

create_boot_directory

exec mkdir -p bin

# ========================================================================
# Stage /system/ directory (mirrors BIOS NVMe scenario lines 220-330)
# ========================================================================
#
# /system on disk is what Genode will read via the NVMe driver chain.
# The .img's P3 only carries the bootloader modules (bender/sel4/
# image.elf); the full /system tree lives on the NVMe disk's P3.
#
set sys_dir "[run_dir]/system"
exec mkdir -p "$sys_dir/bin"
exec mkdir -p "$sys_dir/lib"
exec mkdir -p "$sys_dir/init"

set empty_cfg [open "$sys_dir/config" w]
puts -nonewline $empty_cfg {<config/>}
close $empty_cfg

# --- desktop binaries → /system/bin/ ---
# (boot_fb also staged here even though it lives in Tier-0 —
# the structural gate e2ls-on-P3 checks for it as a build-marker.)
foreach b { init report_rom wm window_layouter decorator \
            sponge_configd sponge_themed sponge_pkgd sponge-de \
            alpha_probe hello terminal sponge_files calculatorform \
            pdf_view textedit boot_fb } {
	if {[file exists "bin/$b"]} {
		exec cp -fL "bin/$b" "$sys_dir/bin/$b"
	}
}

# --- shared libraries → /system/lib/ ---
set falkon_libs {
	libFalkonPrivate.lib.so
	libQt6WebEngineCore.lib.so
	libQt6WebEngineQuick.lib.so
	libQt6WebEngineWidgets.lib.so
	libQt6WebChannel.lib.so
	libQt6WebChannelQuick.lib.so
	libQt6PrintSupport.lib.so
	libQt6Qml.lib.so
	libQt6QmlMeta.lib.so
	libQt6QmlModels.lib.so
	libQt6QmlWorkerScript.lib.so
	libQt6Quick.lib.so
	libQt6QuickWidgets.lib.so
	libqtquick2plugin.lib.so
	libqtwebenginequickplugin.lib.so
	libworkerscriptplugin.lib.so
	nss3.lib.so
	nssckbi.lib.so
	freebl3.lib.so
	softokn3.lib.so
	libssl.lib.so
	libcrypto.lib.so
	libssh.lib.so
	curl.lib.so
	vfs_lwip.lib.so
	vfs_qtwebengine_shm.lib.so
	vfs_jitterentropy.lib.so
	vfs_xoroshiro.lib.so
	vfs_oss.lib.so
	ncurses.lib.so
}

foreach lib [glob -nocomplain bin/*.lib.so] {
	set libname [file tail $lib]
	if {[string match "ld-*.lib.so" $libname]} { continue }
	if {$libname eq "ld.lib.so"} { continue }
	if {[lsearch -exact $falkon_libs $libname] >= 0} { continue }
	if {$libname eq "rump.lib.so" || $libname eq "rump_fs.lib.so"} { continue }
	if {$libname eq "vfs_rump.lib.so"} { continue }
	exec cp -fL $lib "$sys_dir/lib/$libname"
}

# --- themes (flat) ---
foreach theme { default light } {
	set theme_src "${genode_dir}/repos/sponge/src/sponge-de/themes/${theme}.theme"
	if {[file exists $theme_src]} {
		exec cp -fL $theme_src "$sys_dir/${theme}.theme"
	}
}

# --- Qt6 tars (flat) ---
set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
if {[llength $dejavu_src] > 0} {
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf "$sys_dir/qt6_dejavusans.tar" -C "$staging" qt
	file delete -force "$staging"
}

if {[file exists "bin/qt6_libqgenode.tar"]} {
	exec cp -fL "bin/qt6_libqgenode.tar" "$sys_dir/qt6_libqgenode.tar"
}

# ----------------------------------------------------------------
# Bake-driven pkg metadata + index + payloads (Phase 15 W2, D15.8)
# ----------------------------------------------------------------
source [file join [file dirname [file normalize [info script]]] \
                    bake.inc]

bake::stage $sys_dir img

# ========================================================================
# Write /system/init/system.config — the nested system init config
# ========================================================================
# (verbatim copy of the BIOS NVMe scenario's nested system config —
#  the desktop composition is media-independent)

if {$fail_mode} {
	set sysconfig_fh [open "$sys_dir/init/system.config" w]
	puts $sysconfig_fh {<config THIS IS DELIBERATELY BROKEN XML><unclosed}
	close $sysconfig_fh
} else {
	set sysconfig_hid "[run_dir]/system.config.hid"
	set sysconfig_fh [open "$sysconfig_hid" w]
puts $sysconfig_fh {
config
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service Timer
  + service Gui
  + service Capture
  + service Event

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start report_rom | caps: 300 | ram: 8M
  + binary | name: bin/report_rom
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: layouter -> window_list       | report: wm -> window_list
    + policy | label: decorator -> pointer           | report: wm -> pointer
    + policy | label: decorator -> window_layout     | report: layouter -> window_layout
    + policy | label: wm -> focus                    | report: layouter -> focus
    + policy | label: wm -> resize_request           | report: layouter -> resize_request
    + policy | label: layouter -> hover              | report: decorator -> hover
    + policy | label: layouter -> decorator_margins  | report: decorator -> decorator_margins
    + policy | label: layouter -> rules              | report: layout_rules
    + policy | label: layouter -> focus_request      | report: wm -> focus_request
    + policy | label: sponge_configd -> config_request | report: alpha_probe -> config_request
    + policy | label: alpha_probe -> config_result     | report: sponge_configd -> config_result
    + policy | label: sponge_themed -> config          | report: sponge_configd -> config
    + policy | label: alpha_probe -> configd_config    | report: sponge_configd -> config
    + policy | label: alpha_probe -> config            | report: sponge_configd -> config
    + policy | label: sponge-de -> theme               | report: sponge_themed -> theme
    + policy | label: alpha_probe -> theme             | report: sponge_themed -> theme
    + policy | label: sponge_pkgd -> request     | report: alpha_probe -> request
    + policy | label: alpha_probe -> result       | report: sponge_pkgd -> result
    + policy | label: pkg_runtime -> config       | report: sponge_pkgd -> runtime
    + policy | label: sponge-de -> installed      | report: sponge_pkgd -> installed
    + policy | label: alpha_probe -> sponge_de_launcher | report: sponge-de -> launcher

+ start wm | caps: 250 | ram: 8M
  + binary | name: bin/wm
  + provides
    + service Gui
    + service Report
    + service ROM
  + config
    + policy | label_prefix: decorator | role: decorator
    + policy | label_prefix: layouter  | role: layouter
    + default-policy
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: focus          | + child report_rom
    + service ROM | label: resize_request | + child report_rom
    + service Report | label_last: shape  | + child report_rom
    + service Report                       | + child report_rom
    + service Gui                          | + parent
    + any-service
      + parent
      + any-child

+ start layouter | caps: 150 | ram: 4M
  + binary | name: bin/window_layouter
  + config | rules: rom
    + report | rules: yes
    + rules
      + screen screen
      + assign | label: sponge-de -> Sponge DE Demo | target: screen
               | xpos: 192 | ypos: 172 | width: 640 | height: 480 | maximized: no
      + assign | label_prefix: pkg_runtime | target: screen
               | xpos: 50 | ypos: 300 | width: 320 | height: 240 | maximized: no
    + press   | key: BTN_LEFT  | action: drag
      + release | key: BTN_LEFT | action: drop
  + route
    + service ROM | label_last: ld.lib.so     | + parent
    + service ROM | label: window_list       | + child report_rom
    + service ROM | label: focus_request     | + child report_rom
    + service ROM | label: hover             | + parent
    + service ROM | label: focus             | + parent
    + service ROM | label: decorator_margins | + child report_rom
    + service ROM | label: rules             | + child report_rom
    + service Report | label: rules           | + child report_rom | label: layout_rules
    + service Report                            | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start decorator | caps: 6000 | ram: 64M
  + binary | name: bin/decorator
  + config
    + controls
      + maximizer
      + title
    + default-policy
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: window_layout | + child report_rom
    + service ROM | label: pointer       | + child report_rom
    + service Report                      | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start sponge_configd | caps: 200 | ram: 16M
  + binary | name: bin/sponge_configd
  + config
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: config_request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_themed | caps: 200 | ram: 8M
  + binary | name: bin/sponge_themed
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: config       | + child report_rom
    + service ROM | label_last: default.theme | + parent
    + service ROM | label_last: light.theme   | + parent
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_pkgd | caps: 200 | ram: 16M
  + binary | name: bin/sponge_pkgd
  + config | binary_prefix: bin/
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 400 | ram: 32M
  + binary | name: bin/init
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: config | + child report_rom
    + service Gui | + child wm
    + any-service
      + parent
      + any-child

+ start sponge-de | caps: 8000 | ram: 128M
  + binary | name: bin/sponge-de
  + config
    + theme | source: themed
    + launcher | source: pkgd
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Gui | label_last: Sponge Panel   | + parent
    + service Gui | label_last: Sponge Launcher | + parent
    + service Gui                              | + child wm
    + service Report | label: shape | + child report_rom
    + service Report | label: input | + child report_rom
    + service Report | label: applied_theme | + child report_rom
    + service Report | label: launcher | + child report_rom
    + service ROM | label: installed | + child report_rom
    + service ROM | label: theme | + child report_rom
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child

+ start alpha_probe | caps: 6000 | ram: 16M
  + binary | name: bin/alpha_probe
  + config | skip_lz: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Capture | + parent
    + service Timer   | + parent
    + service ROM | label_last: result | + child report_rom
    + service ROM | label_last: config_result | + child report_rom
    + service ROM | label_last: configd_config | + child report_rom
    + service ROM | label_last: config | + child report_rom
    + service ROM | label_last: sponge_de_launcher | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child
-}
	close $sysconfig_fh

	set xml_content [exec [genode_dir]/tool/hid format --output-xml "$sysconfig_hid"]
	set sysconfig_final [open "$sys_dir/init/system.config" w]
	puts -nonewline $sysconfig_final $xml_content
	close $sysconfig_final
	file delete "$sysconfig_hid"
}

# ========================================================================
# Tier-0 init configuration (driver swap: ahci → nvme)
# ========================================================================

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: pci_decode -> system | report: acpi -> acpi
    + policy | label: platform -> devices  | report: pci_decode -> devices
    + policy | label: usb_hid -> report    | report: usb -> devices
    + policy | label_suffix: focus | report: nitpicker -> focus
    + policy | label_suffix: hover | report: nitpicker -> hover
    + policy | label: pointer -> xray | report: pointer-xray-none
    + policy | label: platform_info | report: platform -> platform_info

+ start acpi | caps: 350 | ram: 4M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service IO_MEM | + parent
    + service LOG    | + parent
    + service PD     | + parent
    + service RM     | + parent
    + service CPU    | + parent
    + service ROM    | + parent

+ start pci_decode | caps: 350 | ram: 2M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report              | + child report_rom
    + service ROM | label: system | + child report_rom
    + service IO_MEM              | + parent
    + service LOG                 | + parent
    + service PD                  | + parent
    + service RM                  | + parent
    + service CPU                 | + parent
    + service ROM                 | + parent

+ start platform | caps: 200 | ram: 3M | managing_system: yes
  + provides
    + service Platform
    + service Dma
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: devices | + child report_rom
    + service Report               | + child report_rom
    + service Timer                | + child timer
    + service IRQ                  | + parent
    + service IO_MEM               | + parent
    + service IO_PORT              | + parent
    + service ROM                  | + parent
    + service PD                   | + parent
    + service CPU                  | + parent
    + service LOG                  | + parent
  + config
    + report | devices: yes
    + policy | label_prefix: nvme | + pci | class: NVME
    + policy | label_prefix: ps2  | + device ps2
    + policy | label_prefix: usb  | info: yes | + pci | class: USB

+ start nvme | caps: 5000 | ram: 64M
  + provides | + service Block
  + config
    + report | ports: yes
    + policy | label_prefix: part_block | device: 0 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Platform | + child platform
    + service Dma      | + child platform
    + service Timer    | + child timer
    + service Report   | + child report_rom
    + service ROM      | + parent
    + service PD       | + parent
    + service CPU      | + parent
    + service LOG      | + parent

+ start part_block | caps: 200 | ram: 8M
  + provides | + service Block
  + config
    + report | partitions: no
    + policy | label_prefix: vfs | partition: 3 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Block | + child nvme
    + any-service
      + parent
      + any-child

+ start vfs | caps: 500 | ram: 64M
  + provides | + service File_system
  + config
    + vfs
      + rump | fs: ext2fs | ram: 48M | writeable: yes
    + policy | label_prefix: rom_sys | root: /system     | writeable: no
    + policy | label_prefix: rom_lib | root: /system/lib | writeable: no
  + route
    + service ROM | label_last: ld.lib.so     | + parent
    + service ROM | label_last: vfs.lib.so    | + parent
    + service ROM | label_last: vfs_rump.lib.so | + parent
    + service ROM | label_last: rump.lib.so   | + parent
    + service ROM | label_last: rump_fs.lib.so | + parent
    + service Block | + child part_block
    + any-service
      + parent
      + any-child

+ start rom_sys | caps: 500 | ram: 256M
  + binary cached_fs_rom
  + provides | + service ROM
  + route
    + service File_system | + child vfs
    + service ROM | label_last: ld.lib.so | + parent
    + any-service
      + parent
      + any-child

+ start rom_lib | caps: 500 | ram: 256M
  + binary cached_fs_rom
  + provides | + service ROM
  + route
    + service File_system | + child vfs
    + service ROM | label_last: ld.lib.so | + parent
    + any-service
      + parent
      + any-child

+ start nitpicker | caps: 20000 | ram: 256M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service Timer  | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    + report | focus: yes | hover: yes
    + domain pointer | layer: 0 | content: client | label: no | origin: pointer
    + domain panel | layer: 1 | content: client | label: no
                   | hover: always | focus: click | ypos: 0 | height: 28
    + domain launcher | layer: 4 | content: client | label: no
                      | hover: always | focus: click
                      | xpos: 0 | ypos: 28 | width: 341 | height: 480
    + domain default | layer: 3 | content: client | label: no
                     | hover: always | focus: click | ypos: 28 | height: -28
    + policy | label_prefix: pointer                  | domain: pointer
    + policy | label_prefix: system -> sponge-de -> Sponge Panel   | domain: panel
    + policy | label_prefix: system -> sponge-de -> Sponge Launcher | domain: launcher
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start pointer | caps: 100 | ram: 4M
  + provides
    + service Report
  + config | shapes: no
  + route
    + service Gui              | + child nitpicker
    + service ROM | label: hover | + child report_rom
    + service ROM | label: xray  | + child report_rom
    + any-service
      + parent
      + any-child

# Phase 15: boot_fb maps the whole GOP framebuffer and allocates a full-size
# Capture buffer. No trailing comment on the start line (HID-format silently
# falls back to <default> for the last attribute otherwise).
+ start fb | caps: 6000 | ram: 64M
  + binary boot_fb
  + route
    + service ROM | label: config        | + parent | label: fb.config
    + service ROM | label: platform_info | + parent
    + service Report                      | + child report_rom
    + service IO_MEM                      | + parent
    + service ROM                         | + parent
    + service PD                          | + parent
    + service CPU                         | + parent
    + service LOG                         | + parent
    + service Timer                       | + child timer
    + service Capture                     | + child nitpicker

+ start ps2 | caps: 100 | ram: 1280K
  + config
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Dma      | + child platform
    + service Platform | + child platform
    + service Event    | + child event_filter | label: ps2
    + service ROM      | + parent
    + service PD       | + parent
    + service CPU      | + parent
    + service LOG      | + parent
    + service Timer    | + child timer

+ start usb | caps: 200 | ram: 16M
  + binary pc_usb_host
  + provides | + service Usb
  + config
    + report | devices: yes
    + policy | label_prefix: usb_hid | + device | class: 0x3
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Dma                     | + child platform
    + service Platform                | + child platform
    + service Report | label: devices | + child report_rom
    + service ROM                     | + parent
    + service PD                      | + parent
    + service RM                      | + parent
    + service CPU                     | + parent
    + service LOG                     | + parent
    + service Timer                   | + child timer

+ start usb_hid | caps: 180 | ram: 10M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: report | + child report_rom
    + service ROM                 | + parent
    + service PD                  | + parent
    + service RM                  | + parent
    + service CPU                 | + parent
    + service LOG                 | + parent
    + service Timer               | + child timer
    + service Event               | + child event_filter | label: usb
    + service Usb                 | + child usb

+ start event_filter | caps: 90 | ram: 1280K
  + provides | + service Event
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: config | + parent | label: event_filter.config
    + service Event               | + child nitpicker
    + service ROM                 | + parent
    + service PD                  | + parent
    + service CPU                 | + parent
    + service LOG                 | + parent
    + service Timer               | + child timer

+ start system | caps: 20000 | ram: 1500M
  + binary | name: bin/init
  + route
    + service ROM | label: config | + child rom_sys | label: init/system.config
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label_suffix: .lib.so | + child rom_lib
    + service ROM | label_last: focus | + child report_rom
    + service ROM | label_last: hover | + child report_rom
    + service ROM | + child rom_sys
    + service Gui     | + child nitpicker
    + service Capture | + child nitpicker
    + service Event   | + child nitpicker
    + service Timer   | + child timer
    + service Report  | + child report_rom
    + any-service
      + parent
      + any-child
- }

#
# === Stage driver sub-init config + keyboard layouts (Tier-0 boot modules) ===
#
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { fb.config event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

#
# === Tier-0 boot module list ===
#
# Driver swap vs SATA: ahci → nvme. boot_fb stays (UEFI display).
#
set boot_modules { }
foreach m { core-sel4.a ld-sel4.lib.so init timer report_rom nitpicker platform acpi pci_decode \
            nvme part_block vfs cached_fs_rom \
            boot_fb ps2 pc_usb_host usb_hid event_filter pointer } {
	lappend boot_modules $m
}
foreach m { vfs.lib.so vfs_rump.lib.so rump.lib.so rump_fs.lib.so \
            en_us.chargen special.chargen \
            fb.config event_filter.config } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# === Assert Tier-0 budget ===
#
set image_elf "[run_dir]/boot/image.elf"
if {[file exists $image_elf]} {
	set size_bytes [file size $image_elf]
	set size_mib [expr {$size_bytes / 1048576}]
	puts "sponge-desktop-disk-uefi-nvme: image.elf = ${size_mib} MiB ($size_bytes bytes)"
	if {$size_mib > 80} {
		puts "sponge-desktop-disk-uefi-nvme: ERROR — Tier-0 budget exceeded (>80 MiB, §4.5)"
	}
}

#
# === Stage boot modules onto .img's P3 (/boot/) ===
#
# Only the bootloader modules land on the .img's P3 — the desktop
# /system tree is on the NVMe disk's P3 (assembled below).
#
exec mkdir -p "$sys_dir/boot"
foreach m { bender sel4 image.elf } {
	if {![file exists [run_dir]/boot/$m]} {
		puts "expected boot module [run_dir]/boot/$m after build_boot_image"
		exit -1
	}
	exec cp -f [run_dir]/boot/$m "$sys_dir/boot/$m"
}

#
# === Handcraft the UEFI bootloader .img ===
#
# Layout: P1=ESP (with GRUB2 EFI), P3=GENODE ext2 with /boot
# (bender/sel4/image.elf). NO P4 (the desktop's P4 is on the
# NVMe disk, not the bootloader .img).
#
set grub2_dir [get_grub2_dir]
# Phase 15: use the Sponge-owned full GRUB (run/fixtures/grubx64-full.efi,
# a Debian grub-mkimage 2.12 build with the complete module set). The
# vendored g2fg grub2_64.efi's multiboot2 handoff freezes on the real
# 17ZD90N Insyde firmware (15-3 bring-up log round 5).
set sponge_grub_efi "[genode_dir]/../run/fixtures/grubx64-full.efi"
if {![file exists $sponge_grub_efi]} {
	puts "GRUB2 EFI binary missing: $sponge_grub_efi"
	puts "This is the Sponge-owned full GRUB (see run/fixtures/README)."
	exit -1
}
if {![file exists $grub2_dir/boot/font.pf2]} {
	puts "GRUB2 font missing: $grub2_dir/boot/font.pf2"
	exit -1
}

set sgdisk    [installed_command sgdisk]
set mkfs_vfat [installed_command mkfs.vfat]
set mkfs_ext2 [installed_command mkfs.ext2]
set mcopy     [installed_command mcopy]
set e2cp      [installed_command e2cp]
set e2mkdir   [installed_command e2mkdir]

# Stage the ESP contents
set esp_stage [run_dir]/efi-stage
file delete -force $esp_stage
file mkdir $esp_stage/EFI/BOOT
file mkdir $esp_stage/boot/grub

exec cp -f $sponge_grub_efi                  $esp_stage/EFI/BOOT/BOOTX64.EFI
exec cp -f $grub2_dir/boot/font.pf2           $esp_stage/boot/font.pf2

# grub.cfg — reads bender/sel4/image.elf from (hd0,gpt3)/boot
set grub_body {
set timeout=0
set gfxpayload=2560x1600x32,1024x768x32,auto  # Phase 15: native 17ZD90N panel mode first (32bpp, boot_fb needs it), 1024x768x32 for OVMF, auto last
insmod gfxterm
insmod part_gpt
insmod ext2
set root=(hd0,gpt3)
terminal_output gfxterm
menuentry 'Genode on seL4 (UEFI/NVMe)' {
  insmod multiboot2
multiboot2 /boot/bender serial intel_hwp_performance phys_max=256M serial_fallback
  module2 /boot/sel4 sel4 disable_iommu console_port=0x3f8 debug_port=0x3f8
  module2 /boot/image.elf image.elf
}
}

set grub_fh [open $esp_stage/EFI/BOOT/grub.cfg "WRONLY CREAT TRUNC"]
puts -nonewline $grub_fh $grub_body
close $grub_fh

set grub_fh [open $esp_stage/boot/grub/grub.cfg "WRONLY CREAT TRUNC"]
puts -nonewline $grub_fh $grub_body
close $grub_fh

#
# Diagnostic boot mode (bake profile [boot] grub_mode = diagnostic,
# e.g. the `test` profile): replace the production hidden gfxterm
# menuentry with the text-mode SPONGE-DIAG template so every boot
# stage is visible on real hardware (15-3 bring-up).
#
if {[bake::boot_option grub_mode production] eq "diagnostic"} {
    set diag_cfg "${::genode_dir}/../run/fixtures/grub-diag.cfg"
    puts "bake: grub_mode=diagnostic — installing $diag_cfg as grub.cfg"
    exec cp -f $diag_cfg $esp_stage/EFI/BOOT/grub.cfg
    exec cp -f $diag_cfg $esp_stage/boot/grub/grub.cfg
}

# Build standalone FAT32 image for ESP
set esp_img [run_dir]/esp.img
exec dd if=/dev/zero of=$esp_img bs=1M count=64 2>/dev/null
exec $mkfs_vfat -n ESP $esp_img
exec $mcopy -i $esp_img -s $esp_stage/EFI ::/
exec $mcopy -i $esp_img -s $esp_stage/boot ::/

# Build standalone ext2 image for the bootloader GENODE (just /boot/)
set boot_img [run_dir]/genode-boot.img
exec dd if=/dev/zero of=$boot_img bs=1M count=32 2>/dev/null
exec $mkfs_ext2 -F -q -L GENODE $boot_img
exec $e2mkdir $boot_img:/boot
foreach m { bender sel4 image.elf } {
	exec $e2cp [run_dir]/boot/$m $boot_img:/boot/$m
}

# Assemble the bootloader .img (P1=ESP, P3=GENODE, no P4)
set gpt_img [run_dir].img
exec dd if=/dev/zero of=$gpt_img bs=1M count=128 2>/dev/null
exec $sgdisk --clear $gpt_img 2>/dev/null
exec $sgdisk --new=1:2048:+64M   --typecode=1:EF00 --change-name=1:ESP    $gpt_img 2>/dev/null
exec $sgdisk --new=3:0:+32M      --typecode=3:8300 --change-name=3:GENODE $gpt_img 2>/dev/null

set p1_info [exec $sgdisk -i 1 $gpt_img]
set p1_sector [lindex [regexp -inline {First sector: ([0-9]+)} $p1_info] 1]
exec dd if=$esp_img of=$gpt_img bs=512 seek=$p1_sector conv=notrunc 2>/dev/null

set p3_info [exec $sgdisk -i 3 $gpt_img]
set p3_sector [lindex [regexp -inline {First sector: ([0-9]+)} $p3_info] 1]
exec dd if=$boot_img of=$gpt_img bs=512 seek=$p3_sector conv=notrunc 2>/dev/null

file delete -force $esp_stage $esp_img $boot_img

#
# === Build the NVMe disk (the desktop's storage chain target) ===
#
# Mirrors run/sponge-desktop-disk-nvme.run lines 1020-1073: build a
# standalone ext2 with the full /system tree, then assemble a GPT
# disk (P3=GENODE + P4=SPONGE-DATA via tool/mkdata). The Genode-side
# nvme driver reads this disk; the .img's NVMe namespace is separate
# (one-namespace verified, Phase 12 W2).
#
set nvme_partition_ext2 [run_dir]/nvme_partition.ext2
exec dd if=/dev/zero of=$nvme_partition_ext2 bs=1M count=256 2>/dev/null
exec $mkfs_ext2 -F -q -L GENODE $nvme_partition_ext2

exec $e2mkdir $nvme_partition_ext2:/system
exec $e2mkdir $nvme_partition_ext2:/system/bin
exec $e2mkdir $nvme_partition_ext2:/system/lib
exec $e2mkdir $nvme_partition_ext2:/system/init

set sysdir_len [string length $sys_dir]
# The -not -path filter excludes ONLY the top-level /boot subdir
# (where the bootloader modules live on the .img's GENODE — not
# the NVMe disk's GENODE). Use a more specific match to avoid
# accidentally excluding /system/bin/boot_fb (the structural
# gate's marker).
foreach entry [lsort [exec find "$sys_dir" -mindepth 1 -not -path "*/system/boot" -not -path "*/system/boot/*"]] {
	set rel [string range $entry $sysdir_len end]
	if {[file isdirectory $entry]} {
		exec $e2mkdir $nvme_partition_ext2:/system$rel
	} else {
		exec $e2cp $entry $nvme_partition_ext2:/system$rel
	}
}

exec dd if=/dev/zero of=bin/nvme_disk.img bs=1M count=384 2>/dev/null
exec $sgdisk --clear --new=3:0:+256M --change-name=3:GENODE bin/nvme_disk.img 2>/dev/null
set p3_info [exec $sgdisk -i 3 bin/nvme_disk.img]
set p3_first [lindex [regexp -inline {First sector: ([0-9]+)} $p3_info] 1]
exec dd if=$nvme_partition_ext2 of=bin/nvme_disk.img bs=512 \
	seek=$p3_first conv=notrunc 2>/dev/null
exec rm -f $nvme_partition_ext2

#
# === QEMU wiring (UEFI pflash + .img auto-attach + NVMe root-port) ===
#
append qemu_args " -machine q35 -cpu Skylake-Client "
append qemu_args " -nographic -m 4G -snapshot "
append qemu_args " -device nec-usb-xhci,id=xhci -device usb-tablet "
append qemu_args " -drive if=pflash,format=raw,readonly=on,file=$ovmf_code "
append qemu_args " -drive if=pflash,format=raw,file=$ovmf_vars "
append qemu_args " -fw_cfg name=opt/org.tianocore/UninstallMemAttrProtocol,string=yes "
#
# The SPONGE_BOOT_NVME root-port + drive + -device nvme sequence is
# copied verbatim from run/sponge-boot.run's SPONGE_BOOT_NVME block
# and run/sponge-desktop-disk-nvme.run. The .img is the bootloader;
# bin/nvme_disk.img is the actual storage chain target.
#
append qemu_args " -device pcie-root-port,id=root_port1 "
append qemu_args " -drive id=disk0,file=bin/nvme_disk.img,format=raw,if=none "
append qemu_args " -device nvme,drive=disk0,serial=fnord,id=nvme0,bus=root_port1 "

#
# === Structural gates (D15.16 honest acceptance) ===
#
set structural_gates_passed 0
set structural_gates_total 0
set mdir [installed_command mdir]
set e2ls [installed_command e2ls]

# --- Gate 1: sgdisk -p on the .img shows P1 EF00 + P3 GENODE ---
incr structural_gates_total
set ptable [exec $sgdisk -p $gpt_img]
puts ""
puts "\[sponge-desktop-disk-uefi-nvme\] structural gate 1/N: sgdisk -p on bootloader .img"
puts $ptable
if {[regexp -line {^Number} $ptable] \
    && [regexp {EF00} $ptable] \
    && [regexp {8300} $ptable] \
    && [regexp {ESP} $ptable] \
    && [regexp {GENODE} $ptable]} {
    puts "\[sponge-desktop-disk-uefi-nvme\] PASS — bootloader .img has P1=EF00(ESP) + P3=8300(GENODE) + P2 absent"
    incr structural_gates_passed
} else {
    puts "\[sponge-desktop-disk-uefi-nvme\] FAIL — bootloader .img missing required partitions/labels"
}

# --- Gate 2: mdir on the .img's ESP shows efi/boot/bootx64.efi + grub.cfg ---
incr structural_gates_total
puts ""
puts "\[sponge-desktop-disk-uefi-nvme\] structural gate 2/N: mdir on bootloader .img ESP"
set esp_offset_bytes [expr {$p1_sector * 512}]
set esp_mdir [exec $mdir -i ${gpt_img}@@${esp_offset_bytes} -/ ]
puts $esp_mdir
if {([regexp -line -nocase {BOOTX64\.EFI} $esp_mdir] \
     || [regexp -line {BOOTX64} $esp_mdir]) \
    && ([regexp -line -nocase {grub\.cfg} $esp_mdir] \
        || [regexp -line -nocase {grub.*cfg} $esp_mdir])} {
    puts "\[sponge-desktop-disk-uefi-nvme\] PASS — bootloader .img ESP contains EFI/BOOT/BOOTX64.EFI and grub.cfg"
    incr structural_gates_passed
} else {
    puts "\[sponge-desktop-disk-uefi-nvme\] FAIL — bootloader .img ESP missing required boot files"
}

# --- Gate 3: e2ls on the NVMe disk's P3 shows /system/bake + boot_fb + pkg_*.xml ---
# e2ls doesn't understand GPT offsets, so we extract the P3 ext2 to
# a temp file first, then e2ls that.
incr structural_gates_total
puts ""
puts "\[sponge-desktop-disk-uefi-nvme\] structural gate 3/N: e2ls on NVMe disk P3"
set bake_present 0
set boot_fb_present 0
set pkg_xml_present 0
# Extract P3 from the NVMe disk. The .img has GPT header at sector 0
# and P3 starts at p3_first. We dump enough sectors to cover a 256 MiB
# P3 (the build size).
set p3_info_nvme [exec $sgdisk -i 3 bin/nvme_disk.img]
set p3_first_nvme [lindex [regexp -inline {First sector: ([0-9]+)} $p3_info_nvme] 1]
set nvme_p3_dump [run_dir]/nvme-p3-check.ext2
set nvme_p3_total_sectors [expr {256 * 1024 * 1024 / 512}]
set nvme_p3_count [expr {$nvme_p3_total_sectors - $p3_first_nvme}]
exec dd if=bin/nvme_disk.img of=$nvme_p3_dump bs=512 skip=$p3_first_nvme count=$nvme_p3_count 2>/dev/null
catch {exec $e2ls $nvme_p3_dump:/system/bake} bake_out
catch {exec $e2ls $nvme_p3_dump:/system/bin} bin_out
catch {exec $e2ls $nvme_p3_dump:/system} sysroot_out
puts "  /system/bake: $bake_out"
puts "  /system/bin:  $bin_out"
puts "  /system:      $sysroot_out"
if {[regexp {bake_manifest\.json} $bake_out]} {
    set bake_present 1
}
# e2ls may list multiple entries per line; check the entire output
# for the exact binary name (not just line-anchored ^).
if {[regexp {\mboot_fb\M} $bin_out]} {
    set boot_fb_present 1
}
if {[regexp {pkg_\w+\.xml} $sysroot_out]} {
    set pkg_xml_present 1
}
if {$bake_present && $boot_fb_present && $pkg_xml_present} {
    puts "\[sponge-desktop-disk-uefi-nvme\] PASS — NVMe disk P3 carries bake_manifest.json, /system/bin/boot_fb, and the profile's pkg_*.xml set"
    incr structural_gates_passed
} else {
    puts "\[sponge-desktop-disk-uefi-nvme\] FAIL — NVMe disk P3 missing required files (bake=$bake_present, boot_fb=$boot_fb_present, pkg_xml=$pkg_xml_present)"
}
file delete -force $nvme_p3_dump

#
# === Structural verification summary ===
#
puts ""
puts "\[sponge-desktop-disk-uefi-nvme\] host-side structural verification summary:"
puts "  $structural_gates_passed / $structural_gates_total gates passed"
puts ""
if {$structural_gates_passed != $structural_gates_total} {
    puts "\[sponge-desktop-disk-uefi-nvme\] ERROR — structural gate failure; aborting"
    exit 1
}

#
# === Bounded QEMU boot attempt (D15.16 honest gap) ===
#
# The vendored run framework's `run_genode_until` calls `exit -1`
# after 3 retries (each 180 s = 540 s), which would mask our
# "honest gap" message. We use a direct `expect` call (single
# timeout) so the script can capture the output, classify the
# W1 hang signature, and print the honest gap message before
# exit 0 (structure-gate acceptance) or exit 1 (signature not
# matched). See the matching block in sponge-desktop-disk-uefi.run
# for the full rationale.
#
if {![run_power_cycle]} {
    puts "\[sponge-desktop-disk-uefi-nvme\] run_power_cycle failed"
    exit 1
}
if {![run_load]} {
    puts "\[sponge-desktop-disk-uefi-nvme\] run_load failed"
    exit 1
}

set uefi_log [run_dir]/uefi-boot.log
puts ""
puts "\[sponge-desktop-disk-uefi-nvme\] starting bounded QEMU boot (≤180 s)"
puts "  serial log: $uefi_log"
puts "  expected: OVMF → GRUB2 → bender → seL4 → core warnings → hang"
puts "            (per W1 OVMF core-init hang, docs/evidence/phase15-uefi-boot-smoke.log)"

# Single-shot expect with the Genode banner as the wait_for_re.
# On timeout (the W1 expected outcome), the timeout arm fires and
# we capture the buffer + classify the hang signature.
#
# Tcl's `expect_out(buffer)` is only set on the matched arm
# (banner/eof pattern), NOT on the timeout arm. We use `log_file`
# to tee the serial output to a file as it arrives, and read the
# file after the timeout. The `log_file` is set up before the
# expect call so the timeout arm's "no buffer" issue is moot.
#
set uefi_log [run_dir]/uefi-boot.log
log_file -a $uefi_log
set timeout 180
expect {
    -i $qemu_spawn_id -re ".*Genode v.*" {
        puts "\[sponge-desktop-disk-uefi-nvme\] UNEXPECTED — QEMU reached the Genode v... banner"
    }
    eof {
        puts "\[sponge-desktop-disk-uefi-nvme\] QEMU exited (eof)"
    }
    timeout {
        puts "\[sponge-desktop-disk-uefi-nvme\] QEMU boot attempt timed out (expected per W1)"
    }
}
log_file

# Read the captured raw log (contains all serial output including
# the OVMF, GRUB, bender, seL4, core warnings, etc).
set fh [open $uefi_log r]
set output [read $fh]
close $fh
puts "\[sponge-desktop-disk-uefi-nvme\] serial log captured: $uefi_log ([string length $output] bytes)"

set hang_sig_1 "device memory in range"
set hang_sig_2 "unable to register range as RAM"
set banner "Genode v"
set has_warning_1 [regexp $hang_sig_1 $output]
set has_warning_2 [regexp $hang_sig_2 $output]
set has_banner [regexp $banner $output]

puts ""
if {$has_banner} {
    puts "\[sponge-desktop-disk-uefi-nvme\] UNEXPECTED — QEMU reached the Genode v... banner"
    puts "  (QEMU UEFI boot PASSED; the 15-3 real-hardware diagnostic is now"
    puts "   the binding test for this media)"
    puts "  exit 0 (host structural gates passed + QEMU reached the unexpected banner)"
    exit 0
} elseif {$has_warning_1 && $has_warning_2} {
    puts "\[sponge-desktop-disk-uefi-nvme\] W1 OVMF core-init hang signature CONFIRMED"
    puts "  (both core warnings present, banner absent — matches the W1"
    puts "   evidence log; see docs/evidence/phase15-uefi-boot-smoke.log)"
} else {
    puts "\[sponge-desktop-disk-uefi-nvme\] QEMU boot did NOT reach Genode core (banner absent)"
    puts "  (with the stock bender — no NOP patch — OVMF stops at the"
    puts "   bender/GRUB2 stage. The W1 evidence required a bender"
    puts "   NOP to get past this stage; per the W4 plan, the bender"
    puts "   stays STOCK and the 15-3 protocol documents the rebuild"
    puts "   fallback for real-hardware. The structural-gate acceptance"
    puts "   is unchanged.)"
}

puts ""
puts "  ================================================================"
puts "  UEFI product media structure verified; QEMU boot blocked by the"
puts "  known UEFI/QEMU W^X + bender NOP gap (see W1 evidence log:"
puts "  docs/evidence/phase15-uefi-boot-smoke.log; D15.16 pivot: the"
puts "  QEMU UEFI cell stays a documented gap; real-hardware"
puts "  verification is 15-3 on the 17ZD90N-VX7BK)."
puts "  ================================================================"
exit 0
