#
# \brief  Sponge DE window-manager verification scenario
# \author Sponge OS contributors
# \date   2026
#
# Boots the upstream Genode window-management stack (wm +
# window_layouter + decorator) around sponge-de, headlessly, and proves
# real WM behavior with the wm_probe component:
#
#   (a) the decorator/layouter pipeline places the "Sponge DE Demo"
#       window at the configured content geometry (decoration detected
#       via the layouter's window_layout ROM),
#   (b) a synthetic title-bar drag (Event injection into nitpicker,
#       seq-number-synchronized against the decorator's hover ROM)
#       actually MOVES the window (real WM behavior),
#   (c) wm_probe logs wm-probe: PASS.
#
# Architecture (flat, base-linux, headless — existing scenarios are not
# touched; this file is purely additive):
#
#   init
#   + timer
#   + report_rom        (the wm policy matrix + wm_probe relay policies;
#                        child names are exactly wm/layouter/decorator
#                        so the label-prefix role matching in wm works)
#   + nitpicker         (Gui/Capture/Event; reports focus/hover/xray;
#                        builtin click focus on the default domain — no
#                        pointer component, no focus ROM needed)
#   + wm                (caps 250 / ram 8M; role policies for decorator
#                        and layouter; routes its shape report to
#                        report_rom since there is no pointer component)
#   + layouter          (window_layouter; inline initial rules + dynamic
#                        rules report feedback for drag persistence)
#   + decorator         (motif; renders the title bar we drag)
#   + sponge-de         (Qt6 DE; panel Gui session bypasses wm straight
#                        to nitpicker, demo Gui session goes through wm)
#   + wm_probe          (plain component; Capture defines the panorama,
#                        Event injects the drag, ROMs verify the result)
#
# The Sponge Panel bypasses wm (it keeps its fixed nitpicker panel
# domain from run/sponge-de-test.run). Only the "Sponge DE Demo" window
# is routed through wm, so it gets decorated/movable. The panel is
# matched by label_prefix (the session label at nitpicker is
# "sponge-de -> Sponge Panel"); nitpicker's session-policy matcher only
# recognizes label / label_prefix / label_suffix, so label_last — used
# by an earlier draft — silently never matched and the panel fell into
# the default domain, where it received a full-screen mode and ended up
# covering the title bar.
#
# Control escape hatch (AGENTS.md §1.1): this scenario is headless. To
# view the decorated desktop on the host display, run/sponge-de.run
# remains the interactive variant (it uses fb_sdl directly, without wm).
#

build { core lib/ld init timer server/report_rom server/nitpicker \
         server/wm app/window_layouter app/decorator \
         sponge-de test/wm_probe \
         qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
         lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
         lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
         lib/zlib lib/libpng }

create_boot_directory

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: layouter -> window_list       | report: wm -> window_list
    + policy | label: decorator -> pointer           | report: wm -> pointer
    + policy | label: decorator -> window_layout     | report: layouter -> window_layout
    + policy | label: wm -> focus                    | report: layouter -> focus
    + policy | label: wm -> resize_request           | report: layouter -> resize_request
    + policy | label: layouter -> hover              | report: decorator -> hover
    + policy | label: layouter -> decorator_margins  | report: decorator -> decorator_margins
    + policy | label: layouter -> rules              | report: layout_rules
    + policy | label: layouter -> focus_request      | report: wm -> focus_request
    + policy | label: pointer -> hover               | report: nitpicker -> hover
    + policy | label: pointer -> xray                | report: nitpicker -> xray
    + policy | label: wm_probe -> window_layout      | report: layouter -> window_layout
    + policy | label: wm_probe -> hover              | report: decorator -> hover

+ start nitpicker | ram: 16M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer  | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    + report | focus: yes | hover: yes | xray: yes
    + domain panel | layer: 1 | content: client | label: no
                   | hover: always | ypos: 0 | height: 28
    + domain default | layer: 2 | content: client | label: no
                     | hover: always | focus: click
    + policy | label_prefix: sponge-de -> Sponge Panel | domain: panel
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start wm | caps: 250 | ram: 8M
  + provides
    + service Gui
    + service Report
    + service ROM
  + config
    + policy | label_prefix: decorator | role: decorator
    + policy | label_prefix: layouter  | role: layouter
    + default-policy
  + route
    + service ROM    | label: focus          | + child report_rom
    + service ROM    | label: resize_request | + child report_rom
    + service Report | label_last: shape     | + child report_rom
    + service Report                         | + child report_rom
    + service Gui                            | + child nitpicker
    + any-service
      + parent
      + any-child

+ start layouter | caps: 150 | ram: 4M
  + binary window_layouter
  + config | rules: rom
    + report | rules: yes
    + rules
      + screen screen
      + assign | label: sponge-de -> Sponge DE Demo | target: screen
               | xpos: 192 | ypos: 172 | width: 640 | height: 480 | maximized: no
    + press   | key: BTN_LEFT  | action: drag
      + release | key: BTN_LEFT | action: drop
  + route
    + service ROM    | label: window_list       | + child report_rom
    + service ROM    | label: focus_request     | + child report_rom
    + service ROM    | label: hover             | + child report_rom
    + service ROM    | label: decorator_margins | + child report_rom
    + service ROM    | label: rules             | + child report_rom
    + service Report | label: rules             | + child report_rom | label: layout_rules
    + service Report                            | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start decorator | caps: 350 | ram: 32M
  + config
    + controls
      + maximizer
      + title
    + default-policy
  + route
    + service ROM    | label: window_layout | + child report_rom
    + service ROM    | label: pointer       | + child report_rom
    + service Report                        | + child report_rom
    + any-service
      + child wm
      + parent
      + any-child

+ start sponge-de | caps: 300 | ram: 128M
  + config
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service Gui | label_last: Sponge Panel | + child nitpicker
    + service Gui                            | + child wm
    + service Report | + child report_rom
    + service ROM | label: default.theme | + parent
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child

+ start wm_probe | caps: 100 | ram: 16M
  + route
    + service Capture | + child nitpicker
    + service Event   | + child nitpicker
    + service Timer   | + child timer
    + service ROM     | label: window_layout | + child report_rom
    + service ROM     | label: hover         | + child report_rom
    + any-service
      + parent
      + any-child
- }

build_boot_image [build_artifacts]

#
# Qt6 shared libraries and runtime tars are built by separate cmake targets.
# Copy them into the boot directory (same staging as run/sponge-de-test.run).
#
foreach lib { libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
              libqgenode.lib.so \
              qt6_libqgenode.tar qt6_dejavusans.tar } {
	set src "bin/$lib"
	set dst "[run_dir]/genode/$lib"
	if {[file exists $src] && ![file exists $dst]} {
		exec cp -L $src $dst
	}
}

#
# The qt6_dejavusans.tar raw recipe is depot-only, so for a source build we
# mirror its content here (same as run/sponge-de-test.run).
#
set dejavu_dst "[run_dir]/genode/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavu_dst -C $staging qt
	file delete -force $staging
}

#
# The default theme is staged as a ROM module (sponge-de opens it as the
# "default.theme" ROM routed to the parent above).
#
set theme_src "${genode_dir}/repos/sponge/src/sponge-de/themes/default.theme"
set theme_dst "[run_dir]/genode/default.theme"
if {[file exists $theme_src] && ![file exists $theme_dst]} {
	exec cp -L $theme_src $theme_dst
}

#
# nitpicker uses the default domain's builtin click focus ("focus: click"):
# the synthetic press on the title bar focuses the decorator's Gui session
# directly, which is all the motion/press/release stream needs to flow into
# the wm. No external pointer component and no static focus ROM are needed.
#

#
# Harmless on base-linux (core runs natively); required for base-sel4/
# QEMU to avoid opening a graphical QEMU window.
#
append qemu_args " -nographic "

#
# Automated verification: wm_probe logs PASS once the decoration pipeline
# is confirmed and the synthetic title-bar drag moved the demo window.
# On timeout (probe did not reach PASS) the run tool errors out — that is
# the FAIL path. The timeout is generous because Qt's first paint under
# the software (softpipe) Mesa is slow.
#
run_genode_until {.*wm-probe: PASS.*} 180
