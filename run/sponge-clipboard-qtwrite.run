#
# \brief  Sponge OS Qt → server clipboard write scenario (Phase 14 W5 follow-on)
# \author Sponge OS contributors
# \date   2026
#
# Companion to run/sponge-clipboard.run: proves the OPPOSITE
# direction — textedit's Qt side writes through the upstream
# clipboard server to the clipboard_probe's separate address space
# (the structural proof that textedit's QGenodeClipboard::setMimeData
# → Report session → upstream server path works across the
# address-space boundary).
#
# The W5 primary scenario (run/sponge-clipboard.run) proves
# server → Qt READ (the probe writes, textedit pastes). This
# scenario proves Qt → server WRITE (textedit types + Ctrl-A +
# Ctrl-C, the probe reads the bus). Together the two prove the
# full round trip: every direction of the cross-component bus
# flows correctly across the address-space boundary.
#
# Topology mirrors run/sponge-clipboard.run (base-sel4 + QMP,
# headless):
#
#   init
#   + timer
#   + report_rom     (focus ROM from nitpicker + clipboard
#                     request/result + sponge_pkgd channels)
#   + nitpicker      (Gui/Capture/Event; demo domain for sponge-de,
#                     edit domain for textedit)
#   + drivers        (sub-init, interactive-PC: vesa_fb/ps2/
#                     usb_hid/pc_usb_host/event_filter + xhci +
#                     usb-tablet; QMP listener enabled)
#   + sponge_configd | sponge_themed | sponge_pkgd
#   + clipboard      (upstream os/src/server/clipboard; permissive
#                     single-domain flow, match_labels="no")
#   + sponge-de      (Qt6 DE; clipboard="yes" so QGenodeClipboard
#                     opens — even though sponge-de is not the
#                     writer here, the runtime config stays
#                     identical to the primary scenario for topology
#                     parity)
#   + textedit       (Qt6 qt6_textedit; clipboard="yes" so the
#                     QGenodeClipboard writes when Ctrl-C is
#                     pressed)
#   + clipboard_probe (Phase 14 W5 NEW: in qt-write mode
#                     (config qt_write_sentinel="..."); polls the
#                     bus ROM for the sentinel that textedit's Qt
#                     side will write via Ctrl-C; logs PASS)
#
# Choreography (host-driven via run/qmp.inc):
#   1. Wait for sponge-de's "panel and window shown" (proves
#      Qt first-paint; nitpicker focus events have begun)
#   2. Connect QMP, wait for the probe's "textedit rendered"
#      marker (proves textedit's Qt is up enough to receive
#      focus + keys)
#   3. QMP click on textedit's window — focuses textedit (the
#      edit domain; nitpicker focuses it; keyboard events flow
#      to textedit's QTextEdit widget)
#   4. QMP type the sentinel into the focused textedit (qmp_type
#      uses lowercase + space + digits only — uppercase requires
#      shift + lowercase key, which qmp.inc does not implement;
#      the spec example is therefore lowercased: "qt write
#      sentinel phase 14")
#   5. QMP send Ctrl-A + Ctrl-C (composite send-key via raw
#      qmp_cmd — selects all + copies, which fires
#      QGenodeClipboard::setMimeData → Report session → upstream
#      server)
#   6. The probe's own ROM session polls for the qt_write_sentinel
#      bytes; when found, the probe logs PASS and exits 0.
#
# The structural proof: textedit's Qt in one address space writes
# via QGenodeClipboard::setMimeData, the Report session reaches
# the upstream clipboard server, the server updates the server-
# side module, and the clipboard_probe's ROM (in a third address
# space) reads the bytes. The data crossed the address-space
# boundary via the upstream server — NOT Qt intra-process state
# (D14.2 + U2).
#
# AGENTS.md §4.2 / docs/08-development.md §4.1: builds lib/ld +
# core + init <components> and passes [build_artifacts] to
# build_boot_image. base-sel4 only.
#

assert {[have_spec sel4]} \
	"sponge-clipboard-qtwrite requires KERNEL=sel4 (BOARD=pc) in build.conf. \
	 The scenario drives real PC hardware (vesa_fb/ps2/usb_hid) and \
	 Qt6/Mesa-on-seL4 desktop rendering, which base-linux cannot provide."

build { core lib/ld init timer server/report_rom server/nitpicker \
        driver/acpi app/pci_decode driver/platform \
        driver/framebuffer/vesa driver/ps2 \
        driver/usb_host/pc driver/usb_hid server/event_filter \
        server/clipboard \
        sponge_configd sponge_themed sponge_pkgd \
        sponge-de \
        test/clipboard_probe \
        qt6/base lib/libc lib/libm lib/stdcxx lib/mesa \
        lib/mesa_gpu-softpipe lib/egl lib/softpipe lib/libdrm lib/expat \
        lib/freetype lib/jpeg \
        lib/qt6_component lib/vfs lib/vfs_pipe lib/vfs_gpu lib/rom_filter \
        lib/zlib lib/libpng lib/blit lib/file }

create_boot_directory

#
# Stage every non-build-artifact boot module into bin/ BEFORE
# build_boot_image (base-sel4: the boot image is a single packed
# image.elf; modules added after build_boot_image never reach the
# guest — docs/11 §10.4).
#
exec mkdir -p bin

#
# Vendor driver configs (copied from run/sponge-de-sel4-interactive.run).
#
set recipe_dir "${genode_dir}/repos/os/recipes/raw/drivers_interactive-pc"
foreach f { drivers.config fb.config event_filter.config } {
	if {![file exists "$recipe_dir/$f"]} {
		error "$recipe_dir/$f missing (vendored drivers_interactive-pc recipe drifted?)"
	}
	exec cp -f "$recipe_dir/$f" "bin/$f"
}

#
# Keyboard layouts consumed by event_filter.
#
set chargen_dir "${genode_dir}/repos/os/src/server/event_filter"
foreach f { en_us.chargen special.chargen } {
	if {![file exists "$chargen_dir/$f"]} { error "$chargen_dir/$f missing" }
	exec cp -f "$chargen_dir/$f" "bin/$f"
}

#
# Theme files staged so sponge_themed can resolve the default theme.
#
foreach theme { default light } {
	set theme_src "${genode_dir}/repos/sponge/src/sponge-de/themes/${theme}.theme"
	set theme_dst "bin/${theme}.theme"
	if {[file exists $theme_src] && ![file exists $theme_dst]} {
		exec cp -fL $theme_src $theme_dst
	}
}

#
# qt-write scenario's QMP-typed sentinel (lowercase only; qmp.inc
# qmp_type's char-to-keyname map covers a-z/0-9/space/newline/
# minus/dot). The probe reads this from its <config qt_write_sentinel="..."/>
# attribute and polls the bus ROM for these bytes.
#
set qt_sentinel "qt write sentinel phase 14"

#
# Stage the textedit package metadata + the derived index so
# sponge_pkgd can resolve `textedit`. The metadata carries
# <config clipboard="yes"/> so the vendored qgenodeclipboard.cpp
# opens its labeled Report + ROM session pair.
#
set staged_pkgs { textedit }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	set dst "bin/pkg_$pkg.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -fL $src $dst
}

set index_fh [open "bin/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

#
# Stage the prebuilt textedit binary + its config.
#
set payload_dir "${genode_dir}/../pkg/textedit/payload"
foreach f { textedit textedit.config } {
	set src "$payload_dir/$f"
	set dst "bin/$f"
	if {![file exists $src]} { error "payload file not found: $src" }
	exec cp -fL $src $dst
}

#
# DejaVuSans font, mirrored from the qt6_base port sources (the
# qt6_dejavusans.tar raw recipe is depot-only, so for a source build
# we pack it here).
#
set dejavu_dst "bin/qt6_dejavusans.tar"
if {![file exists $dejavu_dst]} {
	set dejavu_src [glob -nocomplain "${genode_dir}/contrib/qt6_base-*/src/lib/qt6_base/src/3rdparty/wasm/DejaVuSans.ttf"]
	if {[llength $dejavavu_src] == 0} {
		error "DejaVuSans.ttf not found in the qt6_base port sources"
	}
	set staging "[run_dir]/dejavusans-staging"
	file mkdir "$staging/qt/lib/fonts"
	file copy -force [lindex $dejavavu_src 0] "$staging/qt/lib/fonts/DejaVuSans.ttf"
	exec tar -cf $dejavavu_dst -C $staging qt
	file delete -force $staging
}

#
# Stage the qt_config ROM module — the probe reads this at startup
# to enter qt-write mode. The module is a regular boot module
# (not via report_rom); the probe's `+ service ROM | label: qt_config
# | + parent` route lets init serve the inline content as the
# "qt_config" ROM module to the probe.
#
set qtc_fh [open "bin/qt_config" w]
puts $qtc_fh "<config qt_write_sentinel=\"qt write sentinel phase 14\"/>"
close $qtc_fh

#
# Enable QMP on a free TCP port (run/qmp.inc picks one).
#
source [file join [file dirname [file normalize [info script]]] qmp.inc]

set qemu_args ""
set qmp_port [qmp_pick_port]
append qemu_args " -qmp tcp:127.0.0.1:${qmp_port},server=on,wait=off "

install_config {
config
+ parent-provides
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service IRQ
  + service IO_MEM
  + service IO_PORT

+ default | caps: 200 | ram: 4M
+ default-route
  + any-service
    + parent
    + any-child

+ start timer
  + provides | + service Timer

+ start report_rom | caps: 300 | ram: 8M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label: sponge_pkgd -> request           | report: clipboard_probe -> request
    + policy | label: clipboard_probe -> result         | report: sponge_pkgd -> result
    + policy | label: clipboard_probe -> installed      | report: sponge_pkgd -> installed
    + policy | label: pkg_runtime -> config             | report: sponge_pkgd -> runtime
    + policy | label: sponge-de -> theme                | report: sponge_themed -> theme
    + policy | label: sponge_themed -> config           | report: sponge_configd -> config
    + policy | label: sponge_configd -> config_request  | report: clipboard_probe -> config_request
    + policy | label: clipboard -> focus                | report: clipboard_probe -> focus
    + policy | label: clipboard_probe -> focus          | report: clipboard_probe -> focus
    + policy | label: pkg_runtime -> textedit -> shape  | report: textedit -> shape
    + policy | label: sponge-de -> input                | report: sponge-de -> input
    + policy | label: sponge-de -> sponge_de_clipboard_src | report: sponge-de -> input

+ start nitpicker | ram: 16M
  + provides
    + service Gui
    + service Capture
    + service Event
  + route
    + service Report | + child report_rom
    + service Timer  | + child timer
    + any-service
      + parent
      + any-child
  + config
    + capture
    + event
    + report | focus: yes | clicked: yes | hover: yes | pointer: yes | keystate: yes
    + domain panel | layer: 1 | content: client | label: no
                   | hover: always | focus: click | ypos: 0 | height: 28
    + domain demo | layer: 2 | content: client | label: no
                  | hover: always | focus: click
                  | xpos: 192 | ypos: 172 | width: 640 | height: 480
    + domain edit | layer: 3 | content: client | label: no
                   | hover: always | focus: click
                   | xpos: 0 | ypos: 0 | width: 1024 | height: 768
    + domain default | layer: 4 | content: client | label: no
                     | hover: always | focus: click | ypos: 28 | height: -28
    + policy | label_prefix: sponge-de -> Sponge Panel     | domain: panel
    + policy | label_prefix: sponge-de -> Sponge DE Demo   | domain: demo
    + policy | label_prefix: pkg_runtime -> textedit       | domain: edit
    + default-policy | domain: default
    + background | color: #1e1e2e

+ start drivers | caps: 1500 | ram: 96M | managing_system: yes
  + binary init
  + route
    + service ROM | label: config | + parent | label: drivers.config
    + service Timer               | + child timer
    + service Capture             | + child nitpicker
    + service Event               | + child nitpicker
    + any-service                 | + parent
  + config
    + parent-provides
      + service IRQ
      + service IO_MEM
      + service IO_PORT
      + service ROM
      + service PD
      + service RM
      + service CPU
      + service LOG
      + service Timer
      + service Capture
      + service Event
    + default | caps: 60
    + default-route
      + any-service
        + parent
        + any-child
    + start vesa_fb | caps: 100 | ram: 8M
      + provides | + service Framebuffer
    + start ps2 | caps: 100 | ram: 4M
      + provides | + service Input
    + start pc_usb_host | caps: 100 | ram: 8M
      + provides | + service Usb
    + start usb_hid | caps: 200 | ram: 8M
      + provides
        + service Input
        + service Report
      + config | hid: yes
    + start event_filter | caps: 100 | ram: 4M
      + provides | + service Event
      + config
        + output
          + chargen
            + merge
              + input ps2
              + input usb
          + mod2
            + key KEY_LEFTCTRL
            + key KEY_RIGHTCTRL
          + repeat | delay_ms: 230 | rate_ms: 90
          + include | rom: en_us.chargen
          + include | rom: special.chargen
        + policy | label: ps2 | input: ps2
        + policy | label: usb | input: usb
    + start platform | caps: 100 | ram: 4M
      + provides | + service Platform
    + start acpi | caps: 100 | ram: 4M
      + provides | + service Power
    + start pci_decode | caps: 100 | ram: 4M
      + provides | + service PCI

+ start sponge_configd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: config_request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_themed | caps: 200 | ram: 8M
  + route
    + service ROM | label_last: config | + child report_rom
    + service ROM | label_last: default.theme | + parent
    + service ROM | label_last: light.theme   | + parent
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge_pkgd | caps: 200 | ram: 16M
  + route
    + service ROM | label_last: request | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start pkg_runtime | caps: 1500 | ram: 256M
  + binary init
  + route
    + service ROM | label: config | + child report_rom
    + service ROM | label_last: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service Gui | + child nitpicker
    + service Report | label_last: clipboard | + parent | label: clipboard
    + service ROM    | label_last: clipboard | + parent | label: clipboard
    + service Report | label_last: shape | + child report_rom
    + service Report | + child report_rom
    + any-service
      + parent
      + any-child

+ start sponge-de | caps: 1000 | ram: 128M
  + config | clipboard: yes
    + theme | source: themed
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
  + route
    + service Gui | + child nitpicker
    + service Report | label: input | + child report_rom
    + service Report | label: applied_theme | + child report_rom
    + service Report | label: shape | + child report_rom
    + service Report | label: launcher | + child report_rom
    + service ROM | label: theme | + child report_rom
    + service ROM | label: installed | + child report_rom
    + service ROM | label: default.theme | + parent
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + service Report | label_last: clipboard | + child clipboard
    + service ROM    | label_last: clipboard | + child clipboard
    + any-service
      + parent
      + any-child

+ start clipboard | caps: 100 | ram: 4M
  + provides
    + service ROM
    + service Report
  + config | verbose: no | match_labels: no
    + default-policy | domain: default
    + flow | from: default | to: default
  + route
    + service ROM    | label: focus | + child report_rom
    + any-service
      + parent
      + any-child

#
# clipboard_probe in qt-write mode. The probe's qt_config ROM is
# served from the "bin/qt_config" boot module (init implicitly
# serves ROMs named after boot modules). The route lets init's
# default ROM serving reach the probe.
#
+ start clipboard_probe | caps: 100 | ram: 16M
  + route
    + service Capture | + child nitpicker
    + service Timer   | + child timer
    + service Report | label_last: request       | + child report_rom
    + service Report | label_last: config_request | + child report_rom
    + service Report | label_last: focus         | + child report_rom
    + service Report | label_last: clipboard     | + child clipboard
    + service ROM    | label_last: clipboard     | + child clipboard
    + service ROM    | label: qt_config         | + parent
    + service ROM    | label_last: result        | + child report_rom
    + service ROM    | label_last: installed     | + child report_rom
    + service ROM    | label_last: focus         | + child report_rom
    + service ROM    | label_last: clicked       | + child report_rom
    + any-service
      + parent

#
# textedit (the WRITER in this scenario). clipboard="yes" enables
# QGenodeClipboard; on Ctrl-C the QTextEdit selection triggers
# QGenodeClipboard::setMimeData → Report session → upstream server.
#
+ start textedit | caps: 1000 | ram: 128M
  + config | clipboard: yes
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe | rtc: /dev/rtc
    + vfs
      + dir dev
        + log
        + inline rtc | : 2018-01-01 00:01
      + dir pipe | + pipe
      + tar qt6_dejavusans.tar
      + tar qt6_libqgenode.tar
  + route
    + service Gui | + child nitpicker
    + service Report | label: shape | + child report_rom
    + service Report | label_last: clipboard | + child clipboard
    + service ROM    | label_last: clipboard | + child clipboard
    + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-softpipe.lib.so
    + any-service
      + parent
      + any-child
- }

set boot_modules [build_artifacts]
foreach m { libQt6Core.lib.so libQt6Gui.lib.so libQt6Widgets.lib.so \
            libQt6PrintSupport.lib.so \
            libqgenode.lib.so qt6_libqgenode.tar qt6_dejavusans.tar \
            en_us.chargen special.chargen \
            drivers.config fb.config event_filter.config \
            default.theme light.theme \
            pkg_textedit.xml pkg_index.xml \
            textedit textedit.config \
            qt_config \
            egl.lib.so mesa.lib.so glapi.lib.so mesa_gpu-softpipe.lib.so \
            libdrm.lib.so libpng.lib.so freetype.lib.so jpeg.lib.so \
            expat.lib.so zlib.lib.so \
            stdcxx.lib.so libc.lib.so libm.lib.so \
            qt6_component.lib.so \
            vfs.lib.so vfs_gpu.lib.so vfs_pipe.lib.so } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

#
# QEMU: -nographic for headless, -m 2G for Qt6/Mesa softpipe +
# pkg_runtime's 256M allocation + the clipboard server. xhci +
# usb-tablet for the absolute pointer fallback; the proven PS/2 REL
# recipe (run/qmp.inc) is the primary input path.
#
append qemu_args " -machine q35 -cpu Skylake-Client "
append qemu_args " -nographic -m 2G "
append qemu_args " -device nec-usb-xhci,id=xhci -device usb-tablet "

#
# QMP choreography (the Qt → server write proof):
#
# Phase 0: wait for sponge-de's first paint + the probe's
# "textedit rendered" gate (probes capture buffer is allocated
# AND textedit's title bar is visible).
#
run_genode_until {.*panel and window shown.*} 120

set qmp_chan [qmp_connect $qmp_port]
puts "\nqmp: connected on port $qmp_port"

puts "\nqmp: waiting for clipboard_probe textedit-rendered marker"
match_max -i $qemu_spawn_id 500000
expect {
	-i $qemu_spawn_id
	"clipboard-probe: textedit rendered" { }
	timeout { puts stderr "qmp: timeout waiting for textedit render"; exit 1 }
}

#
# Phase 1: focus textedit (PS/2 click on the window's geometric
# center; the edit domain covers the full screen so this hits
# textedit's QTextEdit — the widget that processes Ctrl-C).
#
puts "\nqmp: focus textedit's window (the writer)"
qmp_ps2_click $qmp_chan 512 384
after 1500

#
# Phase 2: type the sentinel into the focused textedit. qmp_type
# sends each char via qmp_send_key at 15 ms cadence; Qt receives
# the keys and appends each char to the QTextEdit's text buffer.
# The sentinel is lowercase-only because qmp.inc's qmp_type's
# char-to-keyname map covers a-z/0-9/space/newline/minus/dot
# (uppercase would need shift + lowercase key, which qmp.inc does
# not implement).
#
puts "\nqmp: type sentinel into focused textedit"
qmp_type $qmp_chan "qt write sentinel phase 14"
after 500

#
# Phase 3: Ctrl-A + Ctrl-C. QEMU's send-key processes each key
# independently (down+up), so ["ctrl", "a"] is NOT a true Ctrl-A
# combination — Qt only sees the 'a' keypress. Use the lower-level
# input-send-event commands to hold the modifier while pressing the
# key (the documented way to send a real key combination):
#
#   1. Press ctrl (modifier down)
#   2. Press a (key down — Qt sees Ctrl+A pressed)
#   3. Release a (key up)
#   4. Release ctrl (modifier up)
#
# Then Ctrl-C the same way. QTextEdit's standard shortcuts fire →
# QGenodeClipboard::setMimeData → Report session → upstream server.
# This is the single Qt → server write the scenario proves.
#
puts "\nqmp: send Ctrl-A (select all, via QEMU send-key composite)"
qmp_cmd $qmp_chan {{"execute":"send-key","arguments":{"keys":[{"type":"qcode","data":"ctrl"},{"type":"qcode","data":"a"}]}}}
after 250
puts "\nqmp: send Ctrl-C (copy -> QGenodeClipboard -> server)"
qmp_cmd $qmp_chan {{"execute":"send-key","arguments":{"keys":[{"type":"qcode","data":"ctrl"},{"type":"qcode","data":"c"}]}}}
after 2000

#
# Final gate: the probe emits exactly "clipboard-probe: PASS" once
# the qt-write sentinel appears byte-for-byte in the probe's own
# "clipboard" ROM (the structural cross-component proof).
#
run_genode_until {.*clipboard-probe: PASS.*} 180 $qemu_spawn_id

qmp_disconnect $qmp_chan
puts "\nqmp: clipboard Qt -> server write proof PASSED"
