# Sponge OS default theme
# Mocha-inspired dark palette
# See docs/10-theme-format.md for the format specification.

[meta]
version = 1

[colors]
panel_bg       = #1e1e2e
panel_text     = #cdd6f4
accent         = #89b4fa
separator      = #45475a
window_bg      = #313244
window_border  = #45475a
title_text     = #cdd6f4
error_bg       = #f38ba8
error_text     = #f38ba8
success_bg     = #a6e3a1
success_text   = #a6e3a1
warning_bg     = #f9e2af
warning_text   = #f9e2af

[fonts]
default_family = DejaVu Sans
default_size   = 11
title_size     = 12

[layout]
panel_position = top
panel_height   = 28
padding        = 8
margin         = 4
launcher_width = 48

[window]
border_radius = 6
border_width  = 1
shadow_radius = 8
