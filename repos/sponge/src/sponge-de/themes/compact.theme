# Sponge OS compact theme
# Palette + layout differences from default.theme: tighter padding/margin,
# narrower launcher toggle, smaller default font. Per Phase 11 plan W3:
#   - panel_height is intentionally present as a DOCUMENTED NO-OP for v1
#     (the effective panel height comes from configd panel.height, default
#     28 — see docs/10-theme-format.md §4.4).
#   - panel_position is intentionally absent (configd owns it, D2.2).
#   - panel.popup_* keys are NOT included here; they were removed in
#     Phase 14 W11 along with `icon_size` and the Phase-11 deprecated
#     `error`/`success`/`warning` aliases (see §4.2/§4.4).
# See docs/10-theme-format.md for the format specification.

[meta]
version = 1

[colors]
panel_bg       = #181825
panel_text     = #bac2de
accent         = #89b4fa
separator      = #313244
window_bg      = #11111b
window_border  = #313244
title_text     = #bac2de
error_bg       = #f38ba8
error_text     = #f38ba8
success_bg     = #a6e3a1
success_text   = #a6e3a1
warning_bg     = #f9e2af
warning_text   = #f9e2af

[fonts]
default_family = DejaVu Sans
default_size   = 10
title_size     = 12

[layout]
panel_height   = 24
padding        = 4
margin         = 2
launcher_width = 32

[window]
border_radius = 6
border_width  = 1
shadow_radius = 8
