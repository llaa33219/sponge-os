#
# \brief  Sponge OS Phase 8 P3 — persistence on SPONGE-DATA (P4)
# \author Sponge OS contributors
# \date   2026
#
# Proves that sponge_pkgd's installed-set store survives a reboot when
# backed by a writable ext2 filesystem on the SPONGE-DATA partition
# (docs/14-boot-storage-architecture.md §6 persistence model, §4.4 boot
# flow vfs_data). This closes the Alpha limitation "installs do not
# persist across reboots on seL4 media" by giving pkgd's existing
# <vfs>-activated store (docs/12-package-format.md §13, already proven
# on base-linux lx_fs via run/sponge-pkg-persist.run) a real writable
# filesystem on the install media's fourth GPT partition.
#
# === Why a separate scenario (not extending sponge-desktop-disk.run) ===
#
# sponge-desktop-disk.run is the P2-proven desktop regression gate: it
# boots the FULL Qt6 desktop from the GENODE partition and gates on
# alpha-probe: PASS (~900 s under softpipe Mesa). Folding a two-boot
# persistence test into it would (a) double its wall time, (b) change
# its semantics from "desktop renders from disk" to "desktop renders
# AND store survives", and (c) require the P4 grow step which is not
# part of P2's claim. This scenario follows the repo's own separation
# convention — run/sponge-pkg-persist.run (base-linux) is distinct from
# run/sponge-pkg-install.run — and keeps the P2 gate pristine. The P3
# claim is narrower: pkgd's store persists on P4. A focused, headless
# scenario proves exactly that, faster.
#
# === Architecture (docs/14 §4.4, Tier-0 chain + vfs_data) ===
#
#   GRUB → bender → seL4 (image.elf = Tier 0 only, boot modules)
#     └─ init
#         ├─ timer, report_rom
#         ├─ platform/acpi/pci_decode
#         ├─ ahci (Block, the boot disk)
#         ├─ part_block → Block/P4 (partition pinned BY NUMBER)
#         ├─ vfs_data: Vfs_block(P4) + <rump fs="ext2fs" writeable="yes"/>
#         │     → File_system (writable, backs pkgd's store)
#         ├─ sponge_pkgd (config carries <vfs> → persistent store on P4)
#         ├─ pkg_runtime (nested init, config from pkgd's "runtime" report)
#         └─ pkg_seq_probe (drives install/list across the Report/ROM channel)
#
# All of the above are boot modules (image.elf). This scenario does NOT
# serve binaries from disk — that is P2's job, already proven. P3
# isolates the NEW claim: a writable ext2 on P4 backs pkgd's store and
# survives a reboot. P3 (the GENODE partition) exists on the image
# (image/disk makes it) but is unused here; P4 (SPONGE-DATA) is the
# target.
#
# === The two-boot proof (base-sel4, same .img, NO QEMU snapshot) ===
#
# The Genode run framework's power_on/qemu attaches the disk image as
# `-drive format=raw,file=<img>` with NO -snapshot
# (genode/tool/run/power_on/qemu:117). Writes land on the host file.
# Between two run_genode_until calls, QEMU is terminated and respawned
# against the SAME [run_dir].img, so boot 2 reads what boot 1 wrote.
#
# On base-sel4, boot modules (including pkg_probe_config) are baked into
# image.elf and CANNOT be swapped between boots (unlike base-linux where
# lx_fs-backed boot modules are plain files). The probe config is
# therefore identical on both boots: `install hello; list expect hello`.
# The DIFFERENTIATING evidence between the boots is sponge_pkgd's
# construct-time log line:
#
#   boot 1 (fresh P4):  "sponge_pkgd: no installed-set store — starting empty"
#   boot 2 (store present): "sponge_pkgd: restored 1 root(s) from store"
#
# The boot-2 "restored" line is the adversarial proof: it can ONLY appear
# if pkgd opened and parsed /store/installed.xml from P4 on this boot.
# If QEMU had discarded boot 1's writes, pkgd would log "no installed-
# set store" instead and the boot-2 gate would time out (bounded FAIL).
#
# The misleading_success_output class is further defeated by a HOST-SIDE
# readback: between the two boots, the scenario extracts P4 from the
# image file with dd and reads /store/installed.xml with e2cp —
# independent of any guest log. The bytes must be on the image.
#
# === P4 creation (docs/14 §4.3) ===
#
# After image/disk produces [run_dir].img (P1+P2+P3), this run script
# invokes tool/mkdata (a Mojo host-side helper, AGENTS.md §3.5) to grow
# the image and add P4 (SPONGE-DATA, ext2) via the documented sequence:
# truncate -s +N, sgdisk --delete=3, --move-second-header, --new=3,
# --new=4, mkfs.ext2 -E offset=..., sgdisk --hybrid. tool/mkdata is
# idempotent (a second run is a verified no-op). The run script then
# pre-creates /store on P4 (e2mkdir via a dd extract/write-back) so
# pkgd's STORE_PATH "/store/installed.xml" is writable on a fresh P4.
#
# === Failure channel (acceptance gate 4) ===
#
# SPONGE_PERSIST_RO=1 in the environment makes vfs_data's policy
# writeable=no (read-only P4). pkgd's _save_store then fails to open the
# store for write and logs "sponge_pkgd: cannot open store for write" —
# an honest, bounded error (docs/12 §13.3: "A failed write is logged but
# never blocks the install/remove"). The install still succeeds in
# memory; the store is simply NOT persisted. The scenario gates on the
# error line and confirms via host-side readback that NO store file
# appeared on P4 (write refused, not corrupted). One boot, bounded.
#
# base-sel4 only.
#
# Build + run (default two-boot persistence):
#   make -C genode/build/x86_64 run/sponge-persist-disk \
#       KERNEL=sel4 BOARD=pc RUN_OPT="--include image/disk"
#
# Failure channel:
#   SPONGE_PERSIST_RO=1 make -C genode/build/x86_64 run/sponge-persist-disk \
#       KERNEL=sel4 BOARD=pc RUN_OPT="--include image/disk"
#

assert {[have_spec sel4]} \
	"sponge-persist-disk requires KERNEL=sel4 (BOARD=pc)."

##
# Ensure essential run-framework plugins are loaded (RUN_OPT override on
# the make command line discards build.conf's accumulated --include lines).
#
proc ensure_plugin_loaded { name } {
	if {![have_include $name]} {
		set path [genode_dir]/tool/run/$name
		puts "sourcing $path (missing from RUN_OPT, restored by run script)"
		source $path
		global include_list
		lappend include_list $name
	}
}

ensure_plugin_loaded boot_dir/sel4
ensure_plugin_loaded power_on/qemu
ensure_plugin_loaded log/qemu

#
# Mode selectors.
#
set ro_mode [expr {[info exists ::env(SPONGE_PERSIST_RO)] && $::env(SPONGE_PERSIST_RO) == "1"}]
if {$ro_mode} {
	puts "sponge-persist-disk: FAILURE CHANNEL (read-only P4, write must be refused)"
}

#
# P4 data-area size for this scenario. The installed-set store is a few
# hundred bytes; 64 MiB is generous headroom for ext2 structures + rump
# cache while keeping the .img small for fast QEMU boot. tool/mkdata
# accepts --data-size; the production default (docs/14 §4.3) is 1 GiB.
#
set data_mib 64

#
# Build — Tier-0 storage chain + pkgd/probe. No desktop, no Qt6, no
# display drivers (headless persistence proof).
#
set build_components {
	core lib/ld init timer
	server/report_rom
	driver/platform driver/acpi app/pci_decode
	driver/ahci
	server/part_block server/vfs
	lib/vfs lib/vfs_rump
	sponge_pkgd pkg_hello test/pkg_seq_probe
}

build $build_components

create_boot_directory

#
# On base-sel4 every boot module must land in bin/ BEFORE build_boot_image.
#
exec mkdir -p bin

# ========================================================================
# init configuration (Tier 0, HID → handled by the run framework)
# ========================================================================
#
# Modeled on run/sponge-boot.run (storage chain) + run/sponge-pkg-persist.run
# (pkgd/probe topology). The vfs_data component is a SECOND instance of the
# `vfs` binary (<binary name="vfs"/>) opening Block/P4 and exposing a
# writable ext2 File_system for sponge_pkgd's store.
#
# The rump/vfs chain libs (vfs.lib.so, vfs_rump.lib.so, rump.lib.so,
# rump_fs.lib.so) are shared boot modules — both the (unused here) vfs
# and vfs_data load them from core ROM.
#

set data_writeable [expr {$ro_mode ? "no" : "yes"}]

install_config [subst {
config
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service IO_PORT
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default-route
  + any-service
    + parent
    + any-child
+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer

+ start report_rom | ram: 4M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    #
    # Storage-chain inter-driver routing (same as sponge-boot.run): acpi
    # reports the ACPI table pci_decode reads as "system"; pci_decode
    # reports the device tree platform reads as "devices". Without these,
    # platform/pci_decode crash on a denied ROM and the storage chain
    # never comes up (ahci/part_block/vfs_data all depend on platform).
    #
    + policy | label: pci_decode -> system | report: acpi -> acpi
    + policy | label: platform -> devices  | report: pci_decode -> devices
    #
    # pkgd <-> probe channel (same labels as sponge-pkg-persist.run).
    #
    + policy | label: sponge_pkgd -> request  | report: pkg_seq_probe -> request
    + policy | label: pkg_seq_probe -> result | report: sponge_pkgd -> result
    + policy | label: pkg_runtime -> config   | report: sponge_pkgd -> runtime

+ start acpi | caps: 350 | ram: 4M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report | + child report_rom
    + service IO_MEM | + parent
    + service LOG    | + parent
    + service PD     | + parent
    + service RM     | + parent
    + service CPU    | + parent
    + service ROM    | + parent

+ start pci_decode | caps: 350 | ram: 2M
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Report              | + child report_rom
    + service ROM | label: system | + child report_rom
    + service IO_MEM              | + parent
    + service LOG                 | + parent
    + service PD                  | + parent
    + service RM                  | + parent
    + service CPU                 | + parent
    + service ROM                 | + parent

+ start platform | caps: 200 | ram: 3M | managing_system: yes
  + provides
    + service Platform
    + service Dma
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: devices | + child report_rom
    + service Report               | + child report_rom
    + service Timer                | + child timer
    + service IRQ                  | + parent
    + service IO_MEM               | + parent
    + service IO_PORT              | + parent
    + service ROM                  | + parent
    + service PD                   | + parent
    + service CPU                  | + parent
    + service LOG                  | + parent
  + config
    + report | devices: yes
    + policy | label_prefix: ahci | + pci | class: AHCI

#
# ahci → Block. The QEMU q35 machine auto-attaches image/disk's
# -drive format=raw,file=<img> to the ICH9 SATA (AHCI) controller.
# docs/14 §11 risk 1: ram 128M / caps 5000 (DMA-able memory pool).
#
+ start ahci | caps: 5000 | ram: 128M
  + provides | + service Block
  + config
    + report | ports: yes
    + policy | label_prefix: part_block | device: 0 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Platform | + child platform
    + service Dma      | + child platform
    + service Timer    | + child timer
    + service Report   | + child report_rom
    + service ROM      | + parent
    + service PD       | + parent
    + service CPU      | + parent
    + service LOG      | + parent

#
# part_block: pin partition 4 BY NUMBER (docs/14 §4.4 — never auto-probe).
# The policy routes vfs_data's Block session to P4 (SPONGE-DATA).
#
+ start part_block | caps: 200 | ram: 8M
  + provides | + service Block
  + config
    + report | partitions: no
    + policy | label_prefix: vfs_data | partition: 4 | writeable: yes
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service Block | + child ahci
    + any-service
      + parent
      + any-child

#
# vfs_data: a SECOND `vfs` binary instance. Opens Block/P4 (label
# "vfs_data" → part_block policy → partition 4) and mounts it via rump
# ext2fs as a writable File_system. This is the docs/14 §4.4 vfs_data
# box. The rump fs ram pool (48M) is the dominant RAM cost; Sculpt
# sizes a single rump at up to 128M (docs/14 §11 risk 2).
#
# The policy exposes the P4 root to sponge_pkgd. pkgd's <vfs><fs/></vfs>
# mounts this session at its VFS root, so pkgd's STORE_PATH
# "/store/installed.xml" maps to P4:/store/installed.xml (the /store
# directory is pre-created on P4 by this run script, below).
#
+ start vfs_data | caps: 500 | ram: 64M
  + binary vfs
  + provides | + service File_system
  + config
    + vfs
      + rump | fs: ext2fs | ram: 48M | writeable: $data_writeable
    + policy | label_prefix: sponge_pkgd | root: / | writeable: $data_writeable
  + route
    + service ROM | label_last: ld.lib.so       | + parent
    + service ROM | label_last: vfs.lib.so      | + parent
    + service ROM | label_last: vfs_rump.lib.so | + parent
    + service ROM | label_last: rump.lib.so     | + parent
    + service ROM | label_last: rump_fs.lib.so  | + parent
    + service Block | + child part_block
    + any-service
      + parent
      + any-child

#
# sponge_pkgd: the <vfs> node in its <config> activates persistence
# (docs/12 §13.4). <fs/> mounts the vfs_data File_system session at the
# VFS root; pkgd writes /store/installed.xml through it. binary_prefix
# "bin/" makes the generated pkg_runtime <start> nodes resolve hello
# from the boot modules.
#
+ start sponge_pkgd | caps: 200 | ram: 16M
  + config | binary_prefix: bin/
    + vfs
      + fs
  + route
    + service ROM | label_last: ld.lib.so   | + parent
    + service ROM | label_last: request     | + child report_rom
    + service File_system                    | + child vfs_data
    + service Report                         | + child report_rom
    + any-service
      + parent
      + any-child

#
# pkg_runtime: a nested init whose <config> is regenerated by sponge_pkgd
# (relayed by report_rom as the "runtime" ROM). It hosts the installed
# packages' <start> nodes (hello, on install/restore).
#
+ start pkg_runtime | caps: 400 | ram: 32M
  + binary init
  + route
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | label: config | + child report_rom
    + any-service
      + parent
      + any-child

#
# pkg_seq_probe: drives the install/list sequence against sponge_pkgd
# over the Report/ROM channel. Its step list is a boot module
# (pkg_probe_config) so it is identical on both boots (base-sel4 boot
# modules are baked into image.elf). The differentiating evidence between
# the boots is pkgd's construct-time log line, not the probe's steps.
#
+ start pkg_seq_probe | caps: 200 | ram: 8M
  + route
    + service ROM | label_last: ld.lib.so   | + parent
    + service Timer                         | + child timer
    + service ROM | label_last: result      | + child report_rom
    + service ROM | label: config           | + parent | label: pkg_probe_config
    + service Report                        | + child report_rom
    + any-service
      + parent
      + any-child
- }]

#
# Stage package metadata + the derived index (same scheme as the other
# pkg scenarios). The hello binary is a build artifact, staged by
# build_boot_image.
#
set staged_pkgs { hello }
foreach pkg $staged_pkgs {
	set src "${genode_dir}/../pkg/$pkg/metadata.xml"
	set dst "[run_dir]/genode/pkg_$pkg.xml"
	if {![file exists $src]} {
		error "package metadata not found: $src"
	}
	exec cp -L $src $dst
}

set index_fh [open "[run_dir]/genode/pkg_index.xml" w]
puts $index_fh "<packages>"
foreach pkg $staged_pkgs {
	puts $index_fh "  <pkg name=\"$pkg\"/>"
}
puts $index_fh "</packages>"
close $index_fh

#
# The probe's step list. Identical on both boots (base-sel4 constraint):
#   1. install hello
#   2. list — assert hello appears
# On boot 1 (fresh P4) pkgd starts empty and installs hello. On boot 2
# pkgd RESTORES hello from the store on construct, so the install is
# idempotent (pkgd's _add_root no-ops on an already-present root) and the
# list still finds hello. The boot-2 proof is the "restored" log line,
# not a different step list.
#
proc write_probe_config { } {
	set fh [open "[run_dir]/genode/pkg_probe_config" w]
	puts $fh "<config>"
	puts $fh {  <step op="install" pkg="hello"/>}
	puts $fh {  <step op="list" expect="hello"/>}
	puts $fh "</config>"
	close $fh
}
write_probe_config

#
# Boot module list. The vfs+rump chain libs are transitive deps of
# lib/vfs_rump, not in build_artifacts, so list them explicitly (same
# pattern as run/sponge-boot.run). On base-sel4, boot_dir/sel4 auto-
# injects ld.lib.so (docs/11 §10.4).
#
set boot_modules [build_artifacts]
foreach m { vfs.lib.so vfs_rump.lib.so rump.lib.so rump_fs.lib.so } {
	lappend boot_modules $m
}

build_boot_image $boot_modules

# ========================================================================
# Post-build: grow P4 (SPONGE-DATA) onto the image
# ========================================================================
#
# image/disk just produced [run_dir].img with P1+P2+P3 and NO free space
# (it resize2fs -M's P3 and moves the backup GPT to the image end). P4
# cannot be added by a bare sgdisk --new; tool/mkdata runs the docs/14
# §4.3 grow/repartition sequence. It is idempotent: if P4 already exists
# (re-run), it is a verified no-op.
#
set img_path "[run_dir].img"
set mkdata "${genode_dir}/../tool/mkdata"

puts "sponge-persist-disk: creating P4 (SPONGE-DATA, $data_mib MiB) on $img_path"
#
# Note: tool/mkdata is a Mojo tool whose runtime emits a harmless
# Crashpad-init warning to stderr. Tcl's exec treats unredirected
# stderr as an error, so merge stderr into stdout with 2>@1 — catch
# then fires only on a real non-zero exit, not on the warning.
#
set mkdata_rc [catch {
	exec $mkdata "$img_path" --data-size $data_mib 2>@1
} mkdata_out]
puts $mkdata_out
if {$mkdata_rc != 0} {
	puts stderr "sponge-persist-disk: ERROR — tool/mkdata failed (rc=$mkdata_rc)"
	exit 1
}

#
# Sanity gate (1): sgdisk -p (print partition table) on the produced
# image shows 4 partitions and P4 is named SPONGE-DATA. This is the
# first acceptance criterion. (Note: the task/docs say "sgdisk -l", but
# in gptfdisk -l is --load-backup=file; the partition-listing flag is
# -p / --print. This scenario uses the correct -p.)
#
puts "sponge-persist-disk: sgdisk -p verification"
set sgdisk [installed_command sgdisk]
set listing [exec $sgdisk -p "$img_path" 2>@1]
puts $listing
if {![regexp {Number\s} $listing]} {
	puts stderr "sponge-persist-disk: ERROR — sgdisk -l produced no partition table"
	exit 1
}
# Count partition rows (lines starting with a number after the header).
set part_count [regexp -all -line {^\s*\d+\s} $listing]
if {$part_count < 4} {
	puts stderr "sponge-persist-disk: ERROR — expected >=4 partitions, sgdisk -l shows $part_count"
	exit 1
}
puts "sponge-persist-disk: OK — $part_count partitions present"
# Confirm P4 is named SPONGE-DATA.
set p4_info [exec $sgdisk -i 4 "$img_path" 2>@1]
if {![regexp {Partition name: 'SPONGE-DATA'} $p4_info]} {
	puts stderr "sponge-persist-disk: ERROR — P4 is not named SPONGE-DATA:"
	puts stderr $p4_info
	exit 1
}
puts "sponge-persist-disk: OK — P4 = SPONGE-DATA"

#
# Pre-create /store on P4 so pkgd's STORE_PATH "/store/installed.xml" is
# writable on a fresh filesystem. e2mkdir operates on a standalone ext2
# file, so extract P4 (dd by sector), mkdir, and write it back. The
# /store directory is the single subdirectory pkgd needs; the store file
# itself is created by pkgd on the first install.
#
set p4_first_info [exec $sgdisk -i 4 "$img_path" 2>@1]
set p4_first [regexp -inline {First sector: ([0-9]+)} $p4_first_info]
set p4_first [lindex $p4_first 1]
set p4_last_info [regexp -inline {Last sector: ([0-9]+)} $p4_first_info]
# p4_first_info already contains both; re-parse last sector from it.
set p4_last [regexp -inline {Last sector: ([0-9]+)} $p4_first_info]
set p4_last [lindex $p4_last 1]
set p4_count [expr {$p4_last - $p4_first + 1}]

puts "sponge-persist-disk: pre-creating /store on P4 (sectors $p4_first..$p4_last)"
set p4_extract "[run_dir].p4.ext2"
exec dd if=$img_path of=$p4_extract bs=512 skip=$p4_first count=$p4_count 2>/dev/null
set e2mkdir [installed_command e2mkdir]
exec $e2mkdir $p4_extract:/store 2>@1
# Write the (now /store-bearing) ext2 back into the image at P4's offset.
exec dd if=$p4_extract of=$img_path bs=512 seek=$p4_first conv=notrunc 2>/dev/null
exec rm -f $p4_extract

#
# Record the image sha256 BEFORE boot 1. Comparing it to the sha256
# AFTER boot 1 proves boot 1's write actually mutated the image file
# (defeats the stale_state / misleading_success_output class — a
# snapshot-discarding QEMU would leave the sha unchanged).
#
set sha_before [exec sha256sum $img_path 2>@1]
puts "sponge-persist-disk: image sha256 BEFORE boot 1: $sha_before"

# ========================================================================
# QEMU
# ========================================================================
#
# -m 1G: base-sel4 minimum + the rump ext2fs cache (48M) + ahci DMA pool.
# -nographic: headless (serial only) — this scenario has no display.
# The image attaches via image/disk's auto -drive (no -snapshot, so
# writes persist to the .img file between boots — see power_on/qemu:117).
#
append qemu_args " -nographic -m 1G "

# Helper: extract P4 from the image and read /store/installed.xml via
# e2cp. Returns the file contents (empty string if absent). This is the
# misleading_success_output defense: the store bytes are read from the
# IMAGE FILE on the host, independent of any guest log.
proc read_store_from_image { } {
	global img_path p4_first p4_count
	set tmp "[run_dir].p4_readback.ext2"
	catch { exec dd if=$img_path of=$tmp bs=512 skip=$p4_first count=$p4_count 2>/dev/null }
	if {![file exists $tmp]} { return "" }
	set data ""
	catch {
		set e2cp [installed_command e2cp]
		set data [exec $e2cp $tmp:/store/installed.xml /dev/stdout 2>/dev/null]
	}
	catch { exec rm -f $tmp }
	return $data
}

if {$ro_mode} {
	#
	# FAILURE CHANNEL (acceptance gate 4): read-only P4. pkgd's _save_store
	# fails to open the store for write (the vfs_data policy is
	# writeable=no) and logs "sponge_pkgd: cannot open store for write"
	# — an honest, bounded error (docs/12 §13.3). The install still
	# succeeds in memory; the store is NOT persisted. We gate on the
	# error line and confirm via host-side readback that NO store file
	# appeared on P4 (write refused, not corrupted).
	#
	puts "\n--- failure channel: read-only P4 (write must be refused) ---"
	run_genode_until {.*sponge_pkgd: cannot open store for write.*} 120

	# Host-side corroboration: the store file must NOT exist on P4 (the
	# write was refused, not silently dropped or corrupted).
	set store_data [read_store_from_image]
	if {[string length $store_data] > 0} {
		puts stderr "sponge-persist-disk: FAILURE CHANNEL ERROR — store file appeared on read-only P4:"
		puts stderr $store_data
		exit 1
	}
	puts "sponge-persist-disk: FAILURE CHANNEL — write refused on read-only P4 (bounded, honest; no store on P4)"
	puts "sponge-persist-disk: done (failure channel)"

} else {
	#
	# ---------- boot 1: install hello (writes the store to P4) ----------
	#
	puts "\n--- boot 1: install hello (writes the persistent store to P4) ---"
	run_genode_until {.*pkg-seq-probe: PASS.*} 120

	#
	# Host-side corroboration (misleading_success_output defense): the
	# store file MUST exist on P4 and contain hello. This is independent
	# of the probe's PASS — it reads the bytes off the image file.
	#
	set store_data [read_store_from_image]
	if {[string length $store_data] == 0} {
		puts stderr "sponge-persist-disk: ERROR — store not written to P4 by boot 1"
		exit 1
	}
	if {![regexp {<root name="hello"/>} $store_data]} {
		puts stderr "sponge-persist-disk: ERROR — store does not name hello: $store_data"
		exit 1
	}
	puts "--- boot 1: store on P4 contains hello (host-side e2cp readback) ---"
	puts "    store bytes: $store_data"

	#
	# Image sha256 AFTER boot 1: must DIFFER from before (the write
	# mutated the image file — a snapshot-discarding QEMU would leave it
	# unchanged, which we catch here).
	#
	set sha_after [exec sha256sum $img_path 2>@1]
	puts "sponge-persist-disk: image sha256 AFTER boot 1:  $sha_after"
	if {$sha_before eq $sha_after} {
		puts stderr "sponge-persist-disk: ERROR — image unchanged after boot 1 (QEMU discarded writes? -snapshot?)"
		exit 1
	}
	puts "sponge-persist-disk: OK — image mutated by boot 1 (sha256 differs)"

	#
	# Terminate boot 1's QEMU explicitly. The Genode run framework's
	# run_power_on spawns a fresh QEMU for each run_genode_until WITHOUT
	# killing the previous one — on base-sel4 that leaves boot 1's QEMU
	# alive and holding the image's OFD write lock, so boot 2's QEMU
	# aborts with "Failed to get write lock". Closing + waiting the
	# spawn_id releases the lock before boot 2 spawns. (On base-linux
	# this is a non-issue because run_power_on respawns ./core, not a
	# long-lived QEMU.)
	#
	global qemu_spawn_id
	puts "sponge-persist-disk: terminating boot 1 QEMU to release the image lock"
	catch { close -i $qemu_spawn_id }
	catch { wait -i $qemu_spawn_id }
	after 1000

	#
	# ---------- boot 2: pkgd restores from the store on P4 ----------
	#
	# A FRESH QEMU boots against the SAME [run_dir].img. pkgd reads
	# /store/installed.xml from P4 on construct and logs "restored N
	# root(s) from store". This line is IMPOSSIBLE unless boot 1's write
	# survived on the image — the adversarial persistence proof. If the
	# write were discarded, pkgd would log "no installed-set store"
	# instead and this gate would time out (bounded FAIL).
	#
	puts "\n--- boot 2: pkgd must restore from P4 (same image, fresh QEMU) ---"
	run_genode_until {.*sponge_pkgd: restored [0-9]+ root.*from store.*} 120

	#
	# Second host-side readback: the store is still on P4 (boot 2 did not
	# corrupt it; it read it).
	#
	set store_data2 [read_store_from_image]
	if {![regexp {<root name="hello"/>} $store_data2]} {
		puts stderr "sponge-persist-disk: ERROR — store missing/corrupt after boot 2: $store_data2"
		exit 1
	}
	puts "--- boot 2: store still on P4 (read back, intact) ---"

	puts "\nTest succeeded: installed set restored from SPONGE-DATA (P4) after reboot\n"
}
