+    /* 'w' (119)*/ {0x00,0x00,0xC6,0xC6,0xD6,0xFE,0xEE,0xC6},
+    /* 'x' (120)*/ {0x00,0x00,0xC6,0x6C,0x38,0x6C,0xC6,0xC6},
+    /* 'y' (121)*/ {0x00,0x00,0xC6,0xC6,0xC6,0x7E,0x06,0x7C},
+    /* 'z' (122)*/ {0x00,0x00,0xFE,0x0C,0x38,0x60,0xC0,0xFE},
+    /* '{' (123)*/ {0x1C,0x30,0x30,0xE0,0x30,0x30,0x30,0x1C},
+    /* '|' (124)*/ {0x18,0x18,0x18,0x00,0x00,0x18,0x18,0x18},
+    /* '}' (125)*/ {0x70,0x18,0x18,0x0E,0x18,0x18,0x18,0x70},
+    /* '~' (126)*/ {0x76,0xDC,0x00,0x00,0x00,0x00,0x00,0x00},
+};
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                             */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Recompute the cached base_vaddr from the current
+ * in_kernel_window state. Call after a paging-mode change.
+ */
+static void fbc_recompute_base(void)
+{
+    if (fbc.in_kernel_window) {
+        fbc.base_vaddr = (uint32_t *)paddr_to_pptr((paddr_t)fbc.phys);
+    } else {
+        fbc.base_vaddr = (uint32_t *)(fbc_uintptr)fbc.phys;
+    }
+}
+
+/*
+ * Clear one scanline of the framebuffer to the background
+ * color. y is in PIXEL units. Safe to call before paging is
+ * fully on as long as fbc.base_vaddr is valid.
+ */
+static void fbc_clear_pixel_row(uint32_t y, uint32_t pixel_rows)
+{
+    uint32_t i;
+    uint32_t words_per_line;
+
+    if (y >= fbc.height) {
+        return;
+    }
+    if (y + pixel_rows > fbc.height) {
+        pixel_rows = fbc.height - y;
+    }
+
+    words_per_line = fbc.pitch >> 2;
+    for (i = 0; i < pixel_rows; i++) {
+        uint32_t *line = fbc.base_vaddr
+            + (fbc_uintptr)y * (fbc_uintptr)words_per_line
+            + (fbc_uintptr)i * (fbc_uintptr)words_per_line;
+        memset(line, 0, (unsigned long)fbc.width * sizeof(uint32_t));
+    }
+}
+
+/*
+ * Render one glyph at the current cursor position. The glyph
+ * is taken from the embedded font (or rendered as a filled
+ * block for unsupported code points). After rendering the
+ * cursor advances one column; the caller handles wrapping,
+ * newlines, and scrolling.
+ */
+static void fbc_render_glyph(uint8_t ch)
+{
+    uint32_t       px, py;
+    uint32_t      *base;
+    const uint8_t *glyph;
+    uint32_t       row_idx, bit_idx;
+    uint32_t       words_per_line;
+
+    /* Out-of-range code points render as a filled 8x8 block,
+     * which preserves cursor alignment. Same for non-printable
+     * control characters (the caller handles \n / \r / \b; any
+     * other < 0x20 or DEL gets the placeholder block). */
+    if (ch >= 32u && ch <= 126u) {
+        glyph = fbc_font[ch - 32u];
+    } else {
+        glyph = NULL;
+    }
+
+    px = fbc.col * FBC_CHAR_W;
+    py = fbc.row * FBC_CHAR_H;
+    words_per_line = fbc.pitch >> 2;
+    base = fbc.base_vaddr
+         + (fbc_uintptr)py * (fbc_uintptr)words_per_line
+         + (fbc_uintptr)px;
+
+    for (row_idx = 0; row_idx < FBC_CHAR_H; row_idx++) {
+        uint32_t *line = base
+            + (fbc_uintptr)row_idx * (fbc_uintptr)words_per_line;
+        uint8_t  bits = glyph ? glyph[row_idx] : 0xFFu;
+        for (bit_idx = 0; bit_idx < FBC_CHAR_W; bit_idx++) {
+            /* MSB = leftmost pixel */
+            uint32_t mask = (uint32_t)1u << (7u - bit_idx);
+            line[bit_idx] = (bits & mask) ? fbc.fg : fbc.bg;
+        }
+    }
+}
+
+/*
+ * Scroll the framebuffer up by one text row (8 pixels). The
+ * topmost text row is discarded; the bottommost text row is
+ * cleared to background. Used when the cursor would fall off
+ * the bottom of the screen.
+ */
+static void fbc_scroll_up(void)
+{
+    fbc_uintptr row_bytes;
+    uint8_t    *dst;
+    uint8_t    *src;
+    fbc_uintptr bytes_to_move;
+
+    row_bytes = (fbc_uintptr)fbc.pitch;
+    dst = (uint8_t *)fbc.base_vaddr;
+    src = (uint8_t *)fbc.base_vaddr + (fbc_uintptr)FBC_CHAR_H * row_bytes;
+
+    if (fbc.row == 0) {
+        /* Already at top — just clear the current row. */
+        fbc_clear_pixel_row(0, FBC_CHAR_H);
+        return;
+    }
+
+    bytes_to_move = (fbc_uintptr)(fbc.height - FBC_CHAR_H) * row_bytes;
+    fbc_memmove(dst, src, bytes_to_move);
+    fbc_clear_pixel_row(fbc.height - FBC_CHAR_H, FBC_CHAR_H);
+}
+
+/*
+ * Advance the cursor by one column. Wrap to the next row at
+ * the right edge; scroll when the bottom is reached.
+ */
+static void fbc_advance_col(void)
+{
+    fbc.col++;
+    if (fbc.col >= fbc.cols) {
+        fbc.col = 0;
+        fbc.row++;
+        if (fbc.row >= fbc.rows) {
+            fbc.row = fbc.rows - 1;
+            fbc_scroll_up();
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API (called from boot_sys.c and pc99 machine/io.c)          */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Called from try_boot_sys_mbi2() right after the
+ * MULTIBOOT2_TAG_FB tag is parsed. At this point paging is
+ * on (head.S set CR0.PG before calling boot_sys) but the
+ * active PML4 is the temporary boot_pml4, which identity-
+ * maps the first 4 GiB via 2 MiB pages. The FB is therefore
+ * accessed via its physical address.
+ *
+ * No-op (and leaves fbc.enabled = 0) when:
+ *   - fb_info.addr == 0                       (no tag)
+ *   - bpp != 32 or type != 1                  (not RGB32)
+ *   - phys >= PADDR_TOP  (not in direct map; 512 GiB)
+ *   - width or pitch is implausibly small
+ */
+void fb_console_init(void)
+{
+    uint64_t phys;
+    uint32_t bpp;
+    uint8_t  type;
+    uint32_t width, height, pitch;
+    uint32_t cols, rows;
+
+    /* Zero the state so a later fb_console_enter_kernel_window
+     * is a true no-op when init disabled us. */
+    memset(&fbc, 0, sizeof(fbc));
+    fbc.fg = FBC_FG_DEFAULT;
+    fbc.bg = FBC_BG_DEFAULT;
+
+    phys  = boot_state.fb_info.addr;
+    pitch = boot_state.fb_info.pitch;
+    width = boot_state.fb_info.width;
+    height = boot_state.fb_info.height;
+    bpp   = boot_state.fb_info.bpp;
+    type  = boot_state.fb_info.type;
+
+    if (phys == 0) {
+        return;  /* no multiboot2 FB tag */
+    }
+    if (bpp != 32 || type != 1) {
+        return;  /* not RGB32 */
+    }
+    if (phys >= (uint64_t)PADDR_TOP) {
+        return;  /* outside the kernel's direct map */
+    }
+    if (width < FBC_CHAR_W || height < FBC_CHAR_H) {
+        return;  /* sub-glyph screen — impossible to render */
+    }
+    if (pitch < width * (bpp >> 3)) {
+        return;  /* pitch doesn't fit one scanline */
+    }
+
+    cols = width  / FBC_CHAR_W;
+    rows = height / FBC_CHAR_H;
+    if (cols > FBC_COLS_MAX) { cols = FBC_COLS_MAX; }
+    if (rows > FBC_ROWS_MAX) { rows = FBC_ROWS_MAX; }
+
+    fbc.phys            = phys;
+    fbc.pitch           = pitch;
+    fbc.width           = width;
+    fbc.height          = height;
+    fbc.bpp             = bpp;
+    fbc.cols            = cols;
+    fbc.rows            = rows;
+    fbc.col             = 0;
+    fbc.row             = 0;
+    fbc.in_kernel_window = 0;
+    fbc.enabled         = 1;
+
+    /* Identity-map addressing: phys == VA. */
+    fbc_recompute_base();
+
+    /* Clear the screen to background so the first character
+     * starts at a known-good pixel state. */
+    {
+        uint32_t y;
+        for (y = 0; y < height; y++) {
+            fbc_clear_pixel_row(y, 1);
+        }
+    }
+
+    /* Emit a short banner so the operator can tell on real
+     * hardware that the FB console came up (proves the
+     * patch is alive before any kernel_putDebugChar fires). */
+    {
+        static const char banner[] = "sel4 fb console: ready\n";
+        const char *p = banner;
+        while (*p) {
+            fb_console_putchar(*p++);
+        }
+    }
+}
+
+/*
+ * Called from try_boot_sys_node() right after
+ * setCurrentVSpaceRoot(). Switches the cached base_vaddr
+ * from identity-mapped to the kernel-window mapping (the
+ * permanent kernel PML4 maps paddr + PPTR_BASE_OFFSET).
+ *
+ * No-op if fb_console_init() disabled the console.
+ */
+void fb_console_enter_kernel_window(void)
+{
+    if (!fbc.enabled) {
+        return;
+    }
+    fbc.in_kernel_window = 1;
+    fbc_recompute_base();
+}
+
+/*
+ * Render one ASCII character. Called from
+ * kernel_putDebugChar() AFTER the UART write so the FB
+ * console mirrors the kernel's existing log channel. Honors
+ * \n (newline), \r (carriage return, no-op because we wrap
+ * on column overflow), \b (backspace: clear current cell).
+ *
+ * No-op if the console is disabled. NEVER crashes a boot.
+ */
+void fb_console_putchar(char c)
+{
+    uint8_t ch;
+
+    if (!fbc.enabled) {
+        return;
+    }
+
+    ch = (uint8_t)c;
+
+    switch (ch) {
+    case '\n':
+        /* Newline: advance to next row, clear the new cell row
+         * to end-of-line background so leftover pixels from a
+         * longer previous line don't bleed into the new line. */
+        fbc.col = 0;
+        fbc.row++;
+        if (fbc.row >= fbc.rows) {
+            fbc.row = fbc.rows - 1;
+            fbc_scroll_up();
+        } else {
+            fbc_clear_pixel_row(fbc.row * FBC_CHAR_H, FBC_CHAR_H);
+        }
+        return;
+
+    case '\r':
+        /* Carriage return: column reset only. */
+        fbc.col = 0;
+        return;
+
+    case '\b':
+        /* Backspace: clear the current cell, then move cursor
+         * back. The uart_console_putchar already emitted a CR
+         * before LF, so the kernel printf path produces pairs
+         * ("\r\n") — we treat \r as a no-op for cursor
+         * purposes and let \n handle row advance. */
+        if (fbc.col > 0) {
+            fbc.col--;
+        }
+        {
+            uint32_t words_per_line = fbc.pitch >> 2;
+            uint32_t px = fbc.col * FBC_CHAR_W;
+            uint32_t py = fbc.row * FBC_CHAR_H;
+            uint32_t *base = fbc.base_vaddr
+                + (fbc_uintptr)py * (fbc_uintptr)words_per_line
+                + (fbc_uintptr)px;
+            uint32_t row_idx;
+            for (row_idx = 0; row_idx < FBC_CHAR_H; row_idx++) {
+                uint32_t *line = base
+                    + (fbc_uintptr)row_idx * (fbc_uintptr)words_per_line;
+                memset(line, 0, FBC_CHAR_W * sizeof(uint32_t));
+            }
+        }
+        return;
+
+    default:
+        fbc_render_glyph(ch);
+        fbc_advance_col();
+        return;
+    }
+}
