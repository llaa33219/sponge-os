+    /* 'c' (99) */ {0x00,0x00,0x7C,0xC6,0xC0,0xC0,0xC6,0x7C},
+    /* 'd' (100)*/ {0x06,0x06,0x7E,0xC6,0xC6,0xC6,0xC6,0x7E},
+    /* 'e' (101)*/ {0x00,0x00,0x7C,0xC6,0xFE,0xC0,0xC0,0x7C},
