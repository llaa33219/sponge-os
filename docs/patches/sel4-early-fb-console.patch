diff --git a/src/kernel/sel4/src/arch/x86/kernel/fb_console.c b/src/kernel/sel4/src/arch/x86/kernel/fb_console.c
index e69de29bb..aaa1ba4f3f1d 100644
--- a/src/kernel/sel4/src/arch/x86/kernel/fb_console.c
+++ b/src/kernel/sel4/src/arch/x86/kernel/fb_console.c
@@ -0,0 +1,763 @@
+/*
+ * Copyright 2026, Sponge OS contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Sponge OS Phase 15 W3 + W4 — early framebuffer text console.
+ *
+ * The vendored seL4 kernel's boot log AND the Genode core log
+ * (which flows through the SysDebugPutChar syscall →
+ * kernel_putchar → kernel_putDebugChar on x86 pc99) must appear
+ * on the GOP framebuffer on real hardware with no serial port
+ * (LG gram 17ZD90N Ice Lake — UEFI-only, no COM1). The kernel
+ * is a debug build, so printf is wired and writes to UART COM1
+ * — invisible. Bender's 0xB8000 VGA-text writes are also
+ * invisible under UEFI GOP. Only the GOP framebuffer is visible
+ * (the firmware's logo proves the panel works).
+ *
+ * This file provides a minimal 8x8 ASCII text console that
+ * mirrors every character written through kernel_putDebugChar
+ * onto the GOP framebuffer. The console is DISABLED when no
+ * multiboot2 framebuffer tag was supplied (boot_state.fb_info
+ * .addr == 0) or the mode is not 32 bpp RGB (bpp != 32 or
+ * type != 1). When the framebuffer physical address is outside
+ * the kernel's direct-mapped physical memory window
+ * (PADDR_TOP = 512 GiB) it is also disabled. In every other
+ * case it stays out of the way — the normal UART path is
+ * unchanged. The console NEVER crashes a boot.
+ *
+ * === HIGH-FB DEFERRED-INIT PATH (Phase 15 W4) ===
+ *
+ * Phase 15 W4 added support for framebuffers whose physical
+ * address is GREATER THAN OR EQUAL TO 4 GiB. Real hardware
+ * evidence (the LG gram 17ZD90N Insyde H2O, UEFI-only, 8 GiB,
+ * whose GOP framebuffer sits above 4 GiB) shows that some
+ * modern firmwares place the GOP LFB above the 4 GiB boundary.
+ * The boot_pml4 set up by head.S identity-maps ONLY the first
+ * 4 GiB of physical memory (2 MiB pages, capped at 0x100000000).
+ * Writing to a >4 GiB physical address from the identity-mapped
+ * kernel window faults the kernel with #PF W:1 P:1 the moment
+ * it is touched — the fault happens inside the very first
+ * memset we issue to clear the screen, so the kernel dies before
+ * a single byte reaches the framebuffer.
+ *
+ * The fix is to defer every write to the framebuffer until
+ * after setCurrentVSpaceRoot(), at which point the kernel's
+ * permanent PML4 is active and paddr_to_pptr() (which adds
+ * PPTR_BASE_OFFSET and gets the kernel-window VA) covers
+ * phys < PADDR_TOP = 2^39 on x86_64 — well above 4 GiB. The
+ * fixed sequence is:
+ *
+ *   phys <  4 GiB : clear + banner in fb_console_init()
+ *                   (boot_pml4 identity map is valid for the
+ *                   whole FB; we paint eagerly).
+ *   phys >= 4 GiB : clear + banner deferred to
+ *                   fb_console_enter_kernel_window() (called
+ *                   immediately after setCurrentVSpaceRoot()).
+ *                   fb_console_putchar() silently no-ops while
+ *                   the deferred init is pending so the console
+ *                   NEVER writes to a >4 GiB address through
+ *                   the boot_pml4 identity map.
+ *
+ * The four new fields (phys_high, deferred_init_pending,
+ * banner_printed, early_putchar_hits) make this state machine
+ * explicit and inspectable; the banner + the no-op gate are
+ * the only behavioral changes versus W3. Every existing guard
+ * (no-tag / non-RGB32 / phys >= PADDR_TOP / implausible
+ * width-pitch) is preserved verbatim.
+ *
+ * === TWO-PHASE PAGING INITIALIZATION (unchanged from W3) ===
+ *
+ * Two-phase init matches the kernel's two paging modes on
+ * x86_64:
+ *
+ *   1. fb_console_init() is called from try_boot_sys_mbi2()
+ *      right after the MULTIBOOT2_TAG_FB tag is parsed. At
+ *      this point paging is on (head.S set CR0.PG before
+ *      calling boot_sys) but the active page tables are the
+ *      temporary boot_pml4, which identity-maps the first
+ *      4 GiB via 2 MiB pages. The FB is therefore accessed
+ *      via its PHYSICAL address.
+ *
+ *   2. fb_console_enter_kernel_window() is called from
+ *      try_boot_sys_node() right after setCurrentVSpaceRoot().
+ *      From this point onward, the kernel's permanent PML4 is
+ *      active and the FB must be accessed via
+ *      paddr_to_pptr(phys). We update the cached base pointer
+ *      and, for phys >= 4 GiB, paint the deferred clear +
+ *      banner.
+ *
+ * The kernel_putDebugChar hook (in src/plat/pc99/machine/io.c)
+ * calls fb_console_putchar() AFTER the UART write. The hook
+ * only fires when CONFIG_PRINTING is enabled, which the Sponge
+ * OS kernel build does (kernel-sel4-pc.mk sets both
+ * CONFIG_PRINTING=y and CONFIG_DEBUG_BUILD=y).
+ *
+ * === FONT ===
+ *
+ * The 8x8 font is hand-crafted for ASCII 32..126 (95 glyphs).
+ * 95 * 8 bytes = 760 bytes — small enough that the kernel's
+ * .rodata grows by well under 1 KiB. Glyphs cover the printable
+ * range used by the kernel boot log and Genode core's log;
+ * control chars (< 0x20) and DEL (0x7F) are rendered as
+ * placeholder blocks. The font is intentionally compact —
+ * readability over coverage of obscure code points.
+ *
+ * === LIFETIME / BOOT-TIME GUARANTEES ===
+ *
+ * This file is intentionally NOT marked BOOT_CODE: it must
+ * remain live for the entire lifetime of the kernel because
+ * userland's SysDebugPutChar traps into kernel_putchar AFTER
+ * boot completes. Once paging is on, the file relies only on
+ * standard kernel headers (machine.h, arch/kernel/boot_sys.h,
+ * stdint.h, string.h). The freestanding kernel does NOT
+ * declare memmove / uintptr_t, so this file defines both
+ * locally (fbc_memmove + a uintptr_t typedef) to keep its
+ * kernel-build surface self-contained.
+ */
+
+#include <config.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <machine.h>
+#include <arch/kernel/boot_sys.h>
+
+/* ------------------------------------------------------------------ */
+/* Local typedefs / helpers (kernel is freestanding; uintptr_t is     */
+/* not declared anywhere in the vendored sel4 headers)                */
+/* ------------------------------------------------------------------ */
+
+typedef uint64_t fbc_uintptr;
+
+/* The kernel ships memcpy / memzero / memset but not memmove.
+ * memmove is required for fb_console scrolling (FB rows may
+ * overlap when src/dst ranges are close). This local
+ * implementation is byte-by-byte forward-safe, which is what
+ * an FB scroll needs (src < dst, no backward copy hazard). */
+static void *fbc_memmove(void *dst, const void *src, fbc_uintptr n)
+{
+    uint8_t       *d = (uint8_t *)dst;
+    const uint8_t *s = (const uint8_t *)src;
+    fbc_uintptr   i;
+
+    if (d == s || n == 0) {
+        return dst;
+    }
+    if (d < s) {
+        for (i = 0; i < n; i++) {
+            d[i] = s[i];
+        }
+    } else {
+        for (i = n; i > 0; i--) {
+            d[i - 1] = s[i - 1];
+        }
+    }
+    return dst;
+}
+
+/* ------------------------------------------------------------------ */
+/* Configuration                                                       */
+/* ------------------------------------------------------------------ */
+
+#define FBC_CHAR_W        8u   /* glyph width  in pixels              */
+#define FBC_CHAR_H        8u   /* glyph height in pixels              */
+#define FBC_COLS_MAX    256u   /* hard upper bound on cols (sanity)   */
+#define FBC_ROWS_MAX    128u   /* hard upper bound on rows (sanity)   */
+#define FBC_FG_DEFAULT  0x00FFFFFFu  /* XRGB white                  */
+#define FBC_BG_DEFAULT  0x00000000u  /* XRGB black                  */
+
+/*
+ * Phase 15 W4 — high-FB boundary. The boot_pml4 identity-maps
+ * the first 4 GiB only. Any phys >= 4 GiB is NOT identity-mapped
+ * at the point fb_console_init() runs, so writing to it from
+ * the identity map faults the kernel. Defer ALL drawing until
+ * after setCurrentVSpaceRoot().
+ */
+#define FBC_HIGH_PADDR_THRESHOLD  0x100000000ULL  /* 4 GiB */
+
+/* ------------------------------------------------------------------ */
+/* State                                                               */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The console state. All fields are 32/64-bit aligned to keep the
+ * data path tight. base_vaddr is the current virtual pointer the
+ * putchar path uses — it changes when the kernel switches its
+ * PML4 (see fb_console_enter_kernel_window).
+ *
+ * phys_high + deferred_init_pending are the W4 state machine for
+ * the >4 GiB FB. See the file header "HIGH-FB DEFERRED-INIT
+ * PATH" for the contract.
+ */
+static struct {
+    uint64_t phys;               /* physical address of the framebuffer   */
+    uint32_t *base_vaddr;        /* current VA: identity-mapped or kernel */
+    uint32_t  pitch;             /* bytes per scanline                    */
+    uint32_t  width;             /* pixels per scanline                   */
+    uint32_t  height;            /* scanlines                             */
+    uint32_t  bpp;               /* bits per pixel                        */
+    uint32_t  cols;              /* text columns that fit on screen       */
+    uint32_t  rows;              /* text rows    that fit on screen       */
+    uint32_t  col;               /* current cursor column                 */
+    uint32_t  row;               /* current cursor row                    */
+    uint32_t  fg;                /* foreground pixel value                */
+    uint32_t  bg;                /* background pixel value                */
+    uint8_t   enabled;           /* 1 = render, 0 = no-op                 */
+    uint8_t   in_kernel_window;  /* 1 = use paddr_to_pptr, 0 = identity   */
+    /*
+     * phys_high: 1 iff phys >= 4 GiB. Captured at init time.
+     *            Controls the deferred-init path.
+     * deferred_init_pending: 1 iff clear + banner were skipped
+     *            in init() because the FB is high and must be
+     *            painted in enter_kernel_window() instead. Once
+     *            cleared (== 0), putchar() may proceed.
+     * reserved0: explicit padding for the fbc struct alignment.
+     */
+    uint8_t   phys_high;
+    uint8_t   deferred_init_pending;
+    uint8_t   reserved0[1];
+} fbc;
+
+/* ------------------------------------------------------------------ */
+/* 8x8 font (ASCII 32..126, MSB = leftmost pixel of each row)         */
+/* ------------------------------------------------------------------ */
+
+static const uint8_t fbc_font[95][FBC_CHAR_H] = {
+    /* ' ' (32) */ {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00},
+    /* '!' (33) */ {0x18,0x18,0x18,0x18,0x18,0x00,0x18,0x00},
+    /* '"' (34) */ {0x6C,0x6C,0x6C,0x00,0x00,0x00,0x00,0x00},
+    /* '#' (35) */ {0x6C,0x6C,0xFE,0x6C,0xFE,0x6C,0x6C,0x00},
+    /* '$' (36) */ {0x18,0x7E,0xC0,0x7C,0x06,0xFC,0x18,0x00},
+    /* '%' (37) */ {0xC6,0xCC,0x18,0x30,0x60,0xC6,0x86,0x00},
