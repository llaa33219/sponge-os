+    /* 'Q' (81) */ {0x7C,0xC6,0xC6,0xC6,0xC6,0xD6,0xDE,0x7C},
+    /* 'R' (82) */ {0xFC,0xC6,0xC6,0xC6,0xFC,0xD8,0xCC,0xC6},
+    /* 'S' (83) */ {0x7C,0xC6,0xC0,0x7C,0x06,0x06,0xC6,0x7C},
+    /* 'T' (84) */ {0xFF,0x18,0x18,0x18,0x18,0x18,0x18,0x18},
+    /* 'U' (85) */ {0xC6,0xC6,0xC6,0xC6,0xC6,0xC6,0xC6,0x7C},
+    /* 'V' (86) */ {0xC6,0xC6,0xC6,0xC6,0xC6,0xC6,0x6C,0x38},
+    /* 'W' (87) */ {0xC6,0xC6,0xC6,0xC6,0xD6,0xFE,0xEE,0xC6},
+    /* 'X' (88) */ {0xC6,0xC6,0x6C,0x38,0x38,0x6C,0xC6,0xC6},
