+    /* 'J' (74) */ {0x1E,0x0C,0x0C,0x0C,0x0C,0xCC,0xCC,0x78},
+    /* 'K' (75) */ {0xC6,0xCC,0xD8,0xF0,0xF0,0xD8,0xCC,0xC6},
+    /* 'L' (76) */ {0xC0,0xC0,0xC0,0xC0,0xC0,0xC0,0xC0,0xFE},
+    /* 'M' (77) */ {0xC6,0xEE,0xFE,0xFE,0xD6,0xC6,0xC6,0xC6},
+    /* 'N' (78) */ {0xC6,0xE6,0xF6,0xFE,0xDE,0xCE,0xC6,0xC6},
