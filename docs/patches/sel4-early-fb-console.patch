+/*
+ * Copyright 2026, Sponge OS contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Sponge OS Phase 15 W3 — early framebuffer text console
+ * (companion header to src/arch/x86/kernel/fb_console.c).
+ *
+ * Declares the three entry points used by:
+ *   - src/arch/x86/kernel/boot_sys.c (fb_console_init,
+ *     fb_console_enter_kernel_window) at the kernel's two
+ *     paging-mode transitions.
+ *   - src/plat/pc99/machine/io.c kernel_putDebugChar()
+ *     (fb_console_putchar) to mirror every character the
+ *     kernel emits onto the GOP framebuffer.
+ *
+ * No-op on every API when the console is disabled (no
+ * multiboot2 FB tag, non-RGB32 mode, or phys outside the
+ * kernel's direct map). The console NEVER crashes a boot.
+ */
+
+#pragma once
+
+/*
+ * Called from try_boot_sys_mbi2() after the MULTIBOOT2_TAG_FB
+ * tag is parsed. At that point paging is on with the boot_pml4
+ * (identity-map of the first 4 GiB), so the FB is reached via
+ * its physical address. Captures the FB geometry, clears the
+ * screen to background, and emits a short "sel4 fb console:
+ * ready" banner so the operator can confirm the patch is alive
+ * before any kernel_putDebugChar fires.
+ */
+void fb_console_init(void);
+
+/*
+ * Called from try_boot_sys_node() right after
+ * setCurrentVSpaceRoot(). Switches the cached framebuffer VA
+ * from the boot_pml4 identity map to the kernel's permanent
+ * PML4 (paddr + PPTR_BASE_OFFSET). No-op when the console is
+ * disabled.
+ */
+void fb_console_enter_kernel_window(void);
+
+/*
+ * Render one ASCII character on the GOP framebuffer. Called
+ * from kernel_putDebugChar() AFTER the existing UART write so
+ * the FB mirrors the kernel's existing log channel. Handles
+ * \n, \r, \b, and printable ASCII. No-op when the console is
+ * disabled.
+ */
+void fb_console_putchar(char c);
