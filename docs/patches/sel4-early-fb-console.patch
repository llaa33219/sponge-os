+++ b/src/kernel/sel4/include/arch/x86/arch/kernel/fb_console.h
@@ -0,0 +1,95 @@
+/*
+ * Copyright 2026, Sponge OS contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Sponge OS Phase 15 W3 + W4 — early framebuffer text console
+ * (companion header to src/arch/x86/kernel/fb_console.c).
+ *
+ * Declares the three entry points used by:
+ *   - src/arch/x86/kernel/boot_sys.c (fb_console_init,
+ *     fb_console_enter_kernel_window) at the kernel's two
+ *     paging-mode transitions.
+ *   - src/plat/pc99/machine/io.c kernel_putDebugChar()
+ *     (fb_console_putchar) to mirror every character the
+ *     kernel emits onto the GOP framebuffer.
+ *
+ * No-op on every API when the console is disabled (no
+ * multiboot2 FB tag, non-RGB32 mode, or phys outside the
+ * kernel's direct map). The console NEVER crashes a boot.
+ *
+ * === W4 HIGH-FB DEFERRED-INIT CONTRACT ===
+ *
+ * The boot_pml4 set up by head.S identity-maps the first
+ * 4 GiB of physical memory only. For framebuffers whose
+ * physical address is >= 4 GiB (e.g. the LG gram 17ZD90N
+ * Insyde H2O GOP framebuffer, ~0x800000000 on q35 with
+ * virtio-vga) every write through the identity-mapped VA
+ * would #PF the kernel. The W4 fix is:
+ *
+ *   * fb_console_init() captures the geometry but does NOT
+ *     paint the clear + banner when phys >= 4 GiB; it sets
+ *     an internal deferred-init flag instead.
+ *   * fb_console_putchar() no-ops while the deferred-init
+ *     flag is set, so the console cannot touch the
+ *     identity-mapped VA for a high FB.
+ *   * fb_console_enter_kernel_window() (called from
+ *     try_boot_sys_node() right after
+ *     setCurrentVSpaceRoot()) switches the cached base_vaddr
+ *     to paddr_to_pptr(phys) and then paints the deferred
+ *     clear + banner. From this point on putchar() works
+ *     normally.
+ *
+ * On phys < 4 GiB the W3 eager-paint behavior is preserved
+ * (clear + banner are painted in fb_console_init() via the
+ * boot_pml4 identity map, exactly as before).
+ */
+
+#pragma once
+
+/*
+ * Called from try_boot_sys_mbi2() after the MULTIBOOT2_TAG_FB
+ * tag is parsed. At that point paging is on with the boot_pml4
+ * (identity-map of the first 4 GiB), so the FB is reached via
+ * its physical address.
+ *
+ * For phys >= 4 GiB this routine captures the geometry, arms
+ * the deferred-init flag, and returns WITHOUT touching the FB
+ * — the boot_pml4 does NOT identity-map a >4 GiB address and
+ * any write would fault the kernel. The deferred clear +
+ * banner are painted in fb_console_enter_kernel_window()
+ * after the permanent kernel PML4 is active.
+ *
+ * For phys < 4 GiB this routine captures the geometry, clears
+ * the screen to background, and emits a short "sel4 fb
+ * console: ready" banner so the operator can confirm the
+ * patch is alive before any kernel_putDebugChar fires.
+ */
+void fb_console_init(void);
+
+/*
+ * Called from try_boot_sys_node() right after
+ * setCurrentVSpaceRoot(). Switches the cached framebuffer VA
+ * from the boot_pml4 identity map to the kernel's permanent
+ * PML4 (paddr + PPTR_BASE_OFFSET). For phys >= 4 GiB this is
+ * also where the deferred clear + banner are painted — the
+ * kernel window covers phys < PADDR_TOP (512 GiB) so a high
+ * FB is reachable here but not from the identity map.
+ *
+ * No-op when the console is disabled.
+ */
+void fb_console_enter_kernel_window(void);
+
+/*
+ * Render one ASCII character on the GOP framebuffer. Called
+ * from kernel_putDebugChar() AFTER the existing UART write so
+ * the FB mirrors the kernel's existing log channel. Handles
+ * \n, \r, \b, and printable ASCII.
+ *
+ * No-op when the console is disabled OR when the deferred-init
+ * flag is set (W4 — a high-FB console that has not yet
+ * switched to the kernel window). The deferred-init guard is
+ * what makes the "never touch the FB through the identity
+ * map when phys >= 4 GiB" invariant structurally true.
+ */
+void fb_console_putchar(char c);

