+    /* 'F' (70) */ {0xFE,0xC0,0xC0,0xFC,0xC0,0xC0,0xC0,0xC0},
+    /* 'G' (71) */ {0x7C,0xC6,0xC0,0xC0,0xCE,0xC6,0xC6,0x7C},
