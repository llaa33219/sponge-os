diff --git a/standalone/mbi2.c b/standalone/mbi2.c
index 6469a26..6650e1d 100644
--- a/standalone/mbi2.c
+++ b/standalone/mbi2.c
@@ -134,6 +134,21 @@ int check_mem (struct ph64 const * p, uint32_t const binary, uint8_t ** var)
         continue;
 
       if (in_range(p, m->addr, m->len)) {
+        /* Sponge OS Phase 15: tolerate overlaps with firmware regions
+         * that are safe to reuse once ExitBootServices has run — ACPI
+         * reclaim (type 3) and NVS (type 4) in the multiboot2 map.
+         * OVMF places an NVS region at 0x800000 that overlaps the
+         * seL4 kernel phdr (0x20835f..0x802c60); refusing it blocks
+         * every UEFI boot even though nothing calls EFI runtime
+         * services afterwards. Reserved (type 2) and bad (type 5)
+         * stay hard errors. */
+        if (m->type == 3 || m->type == 4) {
+          printf("Bender: tolerating overlap with reclaimable region %llx+%llx type=%u (phdr %llx+%llx)\n",
+                 (unsigned long long)m->addr, (unsigned long long)m->len,
+                 m->type, (unsigned long long)p->p_paddr,
+                 (unsigned long long)p->p_memsz);
+          continue;
+        }
         printf("Reserved memory %llx+%llx type=%u overlaps with phdr %llx+%llx\n",
                m->addr, m->len, m->type, p->p_paddr, p->p_memsz);
         return ERROR_NA;
@@ -141,6 +156,49 @@ int check_mem (struct ph64 const * p, uint32_t const binary, uint8_t ** var)
     }
   }
 
+  /* Sponge OS Phase 15: the stock in_ram check requires the phdr to be
+   * fully contained in ONE mmap region, which UEFI fragmentation
+   * breaks (the seL4 kernel phdr straddles a type-1 / type-4
+   * boundary). Recompute in_ram as union coverage: the phdr is
+   * usable iff every sub-range is covered by a usable region
+   * (type 1 available, or reclaimable type 3/4 — the same set the
+   * overlap check above tolerates). */
+  {
+    uintptr_t const p_start = p->p_paddr;
+    uintptr_t const p_end   = p->p_paddr + p->p_memsz;
+    uintptr_t covered = p_start;
+
+    for (unsigned pass = 0; pass < 64 && covered < p_end; pass++) {
+      uintptr_t prev = covered;
+
+      for (struct mbi2_tag *i = mbi2_first(multiboot); i; i = mbi2_next(i)) {
+        if (i->type != MBI2_TAG_MEMORY)
+          continue;
+
+        struct mbi2_memory_map {
+          uint32_t entry_size;
+          uint32_t entry_version;
+        } const * h = (struct mbi2_memory_map const *) (i + 1);
+
+        struct mbi2_memory const * m = (struct mbi2_memory const *)(h + 1);
+        unsigned elements = (i->size - sizeof(i) - sizeof(h)) / h->entry_size;
+
+        for (unsigned j = 0; j < elements; m++, j++) {
+          if (m->type != 1 /* MMAP_AVAIL */ && m->type != 3 && m->type != 4)
+            continue;
+          uintptr_t m_end = m->addr + m->len;
+          if (m->addr <= covered && covered < m_end && m_end > covered)
+            covered = (m_end < p_end) ? m_end : p_end;
+        }
+      }
+
+      if (covered == prev)
+        break;  /* no further progress */
+    }
+
+    in_ram = (covered >= p_end);
+  }
+
   /* check that p does not overlap with bender binary */
   if (overlap_bender_binary(p))
     return ERROR_NA;
