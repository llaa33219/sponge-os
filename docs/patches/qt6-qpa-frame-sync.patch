+bool QGenodePlatformWindow::_previous_frame_consumed()
+{
+	Genode::Mutex::Guard guard(_sync_lock);
+
+	if (!_awaiting_consumed)
+		return true;
+
+	if (_sync_count != _sync_at_refresh) {
+		_awaiting_consumed = false;
+		return true;
+	}
+
+	return false;
+}
+
+void QGenodePlatformWindow::_handle_sync()
+{
+	/*
+	 * Runs on the Genode entrypoint, once per composited frame. Keep it
+	 * to a counter increment: it must not block the entrypoint and must
+	 * not touch Qt.
+	 */
+	Genode::Mutex::Guard guard(_sync_lock);
+	_sync_count++;
+}
+
 void QGenodePlatformWindow::refresh(int x, int y, int w, int h)
 {
 	if (qnpw_verbose)
 	    qDebug("QGenodePlatformWindow::refresh(%d, %d, %d, %d)", x, y, w, h);
 
+	{
+		Genode::Mutex::Guard guard(_sync_lock);
+		_sync_at_refresh   = _sync_count;
+		_awaiting_consumed = true;
+	}
+
 	_framebuffer_session.refresh(x, y, w, h);
 }
 
+void QGenodePlatformWindow::wait_for_frame()
+{
+	/*
+	 * Back-pressure, and only where it is needed.
+	 *
+	 * If the compositor acknowledged the previous frame before this one
+	 * is submitted, there is nothing queued ahead of it and this
+	 * returns immediately - a client that keeps up pays not even a
+	 * poll. If a frame IS still in flight, wait (bounded) for the sync
+	 * that proves it was consumed, so the number of frames ahead of the
+	 * compositor stays bounded instead of growing without limit.
+	 *
+	 * The wait is bounded by SYNC_WAIT_STEPS x SYNC_WAIT_STEP_MS. On
+	 * expiry it proceeds unpaced: a missing sync (a server that lost
+	 * its framebuffer client, a driver that stopped updating, a
+	 * capture-less topology that never emits syncs at all) degrades to
+	 * the pre-patch behaviour and can never hang the application.
+	 */
+	if (!_previous_frame_consumed())
+		return;
+
+	for (unsigned i = 0; i < SYNC_WAIT_STEPS; i++) {
+
+		if (_previous_frame_consumed())
+			return;
+
+		usleep(SYNC_WAIT_STEP_MS * 1000);
+	}
+
+	/* Timeout - let this frame through unpaced. */
+	Genode::Mutex::Guard guard(_sync_lock);
+	_awaiting_consumed = false;
+}
+
 EGLSurface QGenodePlatformWindow::eglSurface(EGLConfig egl_config)
 {
 	if (_egl_surface == EGL_NO_SURFACE) {
