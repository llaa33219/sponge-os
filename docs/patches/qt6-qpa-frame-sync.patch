+void QGenodePlatformWindow::_handle_sync()
+{
+	/*
+	 * Runs on the Genode entrypoint, once per composited frame. It must
+	 * not block the entrypoint and must not touch Qt, so it only
+	 * counts the signal and asks the proxy thread to announce it. The
+	 * announcement is edge-triggered so that a burst of syncs costs at
+	 * most one proxy wakeup.
+	 */
+	bool announce = false;
+
+	{
+		Genode::Mutex::Guard guard(_sync_lock);
+		_sync_count++;
+		if (!_sync_announced) {
+			_sync_announced = true;
+			announce = true;
+		}
+	}
+
+	if (announce)
+		_signal_proxy.frame_sync();
+}
+
+void QGenodePlatformWindow::_frame_sync()
+{
+	unsigned long count = 0;
+
+	{
+		Genode::Mutex::Guard guard(_sync_lock);
+		_sync_announced = false;
+		count = _sync_count;
+	}
+
+	bool const consumed = (count > _sync_at_submit);
+	_sync_seen = count;
+
+	/* syncs flow again, so the bounded staleness guard is not evidence */
+	_stale_streak     = 0;
+	_pacing_enabled   = true;
+
+	if (consumed)
+		_frame_in_flight = false;
+
+	if (_flush_pending)
+		_submit_pending();
+}
+
+void QGenodePlatformWindow::_stale_flush()
+{
+	if (!_flush_pending) {
+		_stale_timer.stop();
+		return;
+	}
+
+	/*
+	 * A missed sync must never wedge the application: flush the
+	 * accumulated damage anyway. After STALE_STREAK_MAX consecutive
+	 * unacknowledged flushes the server clearly does not acknowledge
+	 * frames at all, so pacing self-disables for this window and the
+	 * submit path degrades to the pre-patch behaviour.
+	 */
+	if (++_stale_streak >= STALE_STREAK_MAX) {
+		_pacing_enabled = false;
+		_stale_timer.stop();
+		_stat_stale++;
+		qWarning("QGenodePlatformWindow: sync never acknowledged - "
+		         "frame coalescing disabled");
+	}
+
+	_submit_pending();
+}
+
+void QGenodePlatformWindow::_submit_pending()
+{
+	QRegion const accumulated = _pending_region;
+	Submit_fn   const submit    = _pending_submit;
+
+	_pending_region = QRegion();
+	_pending_submit = Submit_fn();
+	_flush_pending  = false;
+	_stale_timer.stop();
+
+	if (accumulated.isEmpty() || !submit)
+		return;
+
+	submit(accumulated);
+
+	_stat_submitted++;
+	_frame_in_flight = _pacing_enabled;
+	_sync_at_submit  = _sync_seen;
+	_stat_coalesced++;
+}
+
+bool QGenodePlatformWindow::begin_frame(QRegion const &region,
+                                        Submit_fn const &submit)
+{
+	/*
+	 * A client that keeps up never reaches the deferral branch: the
+	 * compositor's acknowledgement always arrives first, so the common
+	 * path costs one comparison and never allocates.
+	 */
+	if (_pacing_enabled && _frame_in_flight) {
+
+		if (_pending_region.isEmpty())
+			_pending_region = region;
+		else
+			_pending_region = _pending_region.united(region);
+
+		_pending_submit = submit;
+		_flush_pending  = true;
+		_stale_streak   = 0;
+
+		if (!_stale_timer.isActive())
+			_stale_timer.start(STALE_FLUSH_MS);
+
+		_stat_deferred++;
+
+		/*
+		 * Self-gating telemetry: the first deferral and every
+		 * COALESCE_LOG_EVERY-th one are logged, so an application that
+		 * never needed coalescing logs nothing at all and the absence of
+		 * these lines is itself the "never needed" answer.
+		 */
+		if (_stat_deferred == 1 ||
+		    (_stat_deferred % COALESCE_LOG_EVERY) == 0)
+			qWarning() << "QGenodePlatformWindow: frame coalesced"
+			           << "deferred="  << _stat_deferred
+			           << "submitted=" << _stat_submitted
+			           << "coalesced=" << _stat_coalesced
+			           << "stale="     << _stat_stale;
+
+		return false;
+	}
+
+	_pending_region = QRegion();
+	_flush_pending  = false;
+	_stale_timer.stop();
+
+	return true;
+}
+
+void QGenodePlatformWindow::frame_submitted()
+{
+	_stat_submitted++;
+	_frame_in_flight = _pacing_enabled;
+	_sync_at_submit  = _sync_seen;
+}
+
+void QGenodePlatformWindow::cancel_pending_frame()
+{
+	_pending_region = QRegion();
+	_pending_submit = Submit_fn();
+	_flush_pending  = false;
+	_stale_timer.stop();
+}
